# 后端环境变量模板（复制为 .env 后填写；.env 含敏感信息禁止提交 Git）

# 项目名称（FastAPI 文档标题等展示用途）
PROJECT_NAME=无足鸟古诗词学习助手
# API 路由前缀（一般无需修改）
API_V1_STR=/api/v1

# 数据库连接（开发：本机 MariaDB；生产：mysql+asyncmy://bai_backend:<密码>@mariadb:3306/wuzuniao_bai?charset=utf8mb4）
DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/wuzuniao_bai?charset=utf8mb4

# 接口文档开关（/docs /redoc /openapi.json；开发保持 true，生产部署脚本自动置 false）
DOCS_ENABLED=true

# ==================== auth 统一认证服务 ====================
# auth 服务基础地址（调用 /internal/* 接口使用；生产为 https://auth.wuzuniao.com）
AUTH_BASE_URL=http://localhost:11000
# 令牌签发方标识（须与 auth 服务 .env 的 ISSUER 完全一致，否则验签不通过；生产为 https://auth.wuzuniao.com）
AUTH_ISSUER=http://localhost:11000
# 服务间通信令牌（与 auth 服务 .env 的 SERVICE_TOKEN 一致；调用 /internal/* 时携带）
AUTH_SERVICE_TOKEN=
# 本项目在 auth oauth_clients 表登记的第一方 client_id（登录请求显式携带）
AUTH_CLIENT_ID=bai
# 令牌撤销增量同步间隔（秒）：决定「改密码/退出/删号后旧令牌在本服务的最大残留窗口」
REVOCATION_SYNC_INTERVAL_SECONDS=300

# CORS 允许的源（逗号分隔；小程序/App 请求不携带 Origin，不受 CORS 限制）
# 是否放行本地开发源（任意 localhost/127.0.0.1 端口；开发保持 true，生产部署脚本自动置 false）
CORS_ALLOW_LOCALHOST=true
CORS_ALLOW_ORIGINS=https://bai.wuzuniao.com

# 微信小程序凭证（与微信小程序后台一致；AppSecret 仅存后端，严禁下发前端）
WX_APPID=
WX_APP_SECRET=

# ==================== 腾讯云 COS 对象存储（书籍文件云端同步） ====================
# 永久密钥仅存后端（严禁下发前端）；经 STS GetFederationToken 换取按用户目录隔离的
# 临时密钥后签发预签名 URL，前端持 URL 直传/直取 COS
COS_SECRET_ID=
COS_SECRET_KEY=
# 桶全名（形如 bai-books-1253379498）与地域
COS_BUCKET=
COS_REGION=ap-guangzhou
# 腾讯云 APPID（Policy 资源六段式 uid 段）
COS_APPID=
# 自定义源站域名（须已在 COS 控制台绑定桶并配 HTTPS 证书；留空回退桶默认域名）
COS_CUSTOM_DOMAIN=
# STS 临时凭证有效期（秒）
COS_CRED_SECONDS=1800

# ==================== 转发封面临时存储（划词分享卡片） ====================
# 微信真机不接受本地临时文件路径作转发封面，封面 PNG 上传后端经 URL 提供；
# 目录按 TTL 轮询清理（后台任务每日一轮）。默认相对 backend 运行目录，可不配置
SHARE_COVER_DIR=share_covers
SHARE_COVER_TTL_DAYS=7

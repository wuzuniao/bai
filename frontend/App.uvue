<script setup lang="uts">
	import { fetchPreferences, syncQuiet } from '@/api/reading.uts'
	import { applyCloudPreferences } from '@/utils/books.uts'
	import { hasAccessToken } from '@/utils/request.uts'
	import { initLocale, t } from '@/utils/i18n.uts'
	// 词典注册（公共段：导航/验证码/通用按钮）
	import '@/utils/locales/common.uts'
	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('App Launch')
		// 恢复上次语言选择（profile 语言开关持久化于 app_locale）
		initLocale()
		// WEB 端 SSO 恢复已收敛至 store 初始化（stores/user.uts loadUserFromStorage：
		// 本地无令牌时经父域 Cookie 平台令牌异步交换恢复，N34）
		// 云端偏好预取：落本地缓存（reader_settings/reader_font/bookshelf_style），
		// 各组件首帧读取本地键即可拿到云端值；未登录不发请求（走本地默认）
		if (hasAccessToken()) {
			syncQuiet(fetchPreferences().then((res) => {
				if (res.code == 0) {
					// uts2js（小程序/H5）的 UTSJSONObject 无 getUTSJSONObject 方法，嵌套对象索引访问（与 request.uts 解析约定一致）
					applyCloudPreferences(res.data == null ? null : (res.data!['prefs'] as UTSJSONObject | null))
				}
				return res
			}))
		}
	})

	onAppShow(() => {
		console.log('App Show')
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: t('common.exitHint'),
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style lang="scss">
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
</style>

<script setup lang="uts">
	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('App Launch')
		// WEB 端 SSO 恢复已收敛至 store 初始化（stores/user.uts loadUserFromStorage：
		// 本地无令牌时经父域 Cookie 平台令牌异步交换恢复，N34）
	})

	onAppShow(() => {
		console.log('App Show')
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style lang="scss">
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}

	/* 右箭头（CSS 三角形）：列表项右侧指示箭头，纯 border 绘制 */
	.u-arrow-right {
		width: 0;
		height: 0;
		border-top: 12rpx solid transparent;
		border-bottom: 12rpx solid transparent;
		border-left: 15rpx solid $bai-mute;
	}
</style>

/**
 * 阅读共享类型与常量（reader 页面与阅读组件共用）
 * 跨章说明：同一本书各章段落数不同，凡「按段索引取内容」处必须携带章 id 并按所在章取段落。
 * 划线/想法/书签云端真源（按书籍隔离，本地仅缓存）：打开书籍时页面调 setActiveBookId
 * 锁定当前书籍并拉取云端覆盖缓存，写入类工具本地即写 + 云端静默跟随。
 */

import { upsertUnderline, createThought, replaceBookmarks, savePreferences, fetchBookNotes, fetchBookBookmarks, syncQuiet } from '../api/reading.uts'
import { hasAccessToken } from './request.uts'
// 共享类型抽离到 readerTypes.ts：UTS 编译器对 type-only 导入会改写为 *.ts 路径（HBuilderX 5.33），
// 类型留在 .uts 会报“未导出”。本文件导入供内部使用并再导出给调用方。
import type { Chapter, Bookmark, Paragraph, NoteRecord, FontOption, UnderlineEntry, Thought, SpanSeg, SelSpan, ShareQuoteCtx, ReaderSettings, TextMetrics, ParaRect } from './readerTypesDefs.ts'

/** 章节标题卷级单位字（章/回/卷/节/篇/话/集/部）与标题名之间补一个空格（不限开头格式；已有空格或无单位字原样返回） */
export function spacedChapterTitle(title : string) : string {
	const units = '章回卷节篇话集部'
	for (let i = 0; i < title.length; i++) {
		if (units.indexOf(title.charAt(i)) >= 0) {
			if (i + 1 < title.length && title.charAt(i + 1) != ' ') {
				return title.substring(0, i + 1) + ' ' + title.substring(i + 1)
			}
			break
		}
	}
	return title
}

/** 字体选项表（默认思源黑体，未安装时经回退链落到系统黑体） */
export const FONT_OPTIONS : FontOption[] = [
	{ key: 'sourcehan', label: '思源黑体', family: "'Source Han Sans SC', 'Noto Sans SC', sans-serif" } as FontOption,
	{ key: 'system', label: '系统黑体', family: 'sans-serif' } as FontOption,
	{ key: 'songti', label: '宋体', family: "'Source Han Serif SC', 'SimSun', serif" } as FontOption,
	{ key: 'kaiti', label: '楷体', family: 'KaiTi, STKaiti, serif' } as FontOption
]

/** 按 key 取字体选项（未命中回退默认项） */
export function fontOptionOf(key : string) : FontOption {
	for (let i = 0; i < FONT_OPTIONS.length; i++) {
		if (FONT_OPTIONS[i].key == key) {
			return FONT_OPTIONS[i]
		}
	}
	return FONT_OPTIONS[0]
}

/** 恢复本地存储的字体 key（未存/校验失败回落默认；reader 页与设置面板共用同一恢复口径） */
export function loadStoredFontKey() : string {
	const stored : any = uni.getStorageSync('reader_font')
	if (typeof stored == 'string') {
		const key = stored as string
		for (let i = 0; i < FONT_OPTIONS.length; i++) {
			if (FONT_OPTIONS[i].key == key) {
				return key
			}
		}
	}
	return FONT_OPTIONS[0].key
}

/** ===== 划线与想法（本地缓存读写：SelectionPopover 组件写入，阅读页/目录抽屉读取；云端真源、写入即静默跟随） ===== */

/** 位置比较（章/段/字符字典序，章 id 升序即阅读顺序）：负=前小于后，0=相等 */
export function comparePos(cid1 : number, origin1 : number, idx1 : number, cid2 : number, origin2 : number, idx2 : number) : number {
	if (cid1 != cid2) {
		return cid1 - cid2
	}
	if (origin1 != origin2) {
		return origin1 - origin2
	}
	return idx1 - idx2
}

/** 选区规范化：保证 from 端点在 to 端点之前（拖动反向越过时端点互换后的防御） */
export function normalizeSpan(s : SelSpan) : SelSpan {
	if (comparePos(s.fromCid, s.fromOrigin, s.fromStart, s.toCid, s.toOrigin, s.toEnd) > 0) {
		return {
			fromCid: s.toCid,
			fromOrigin: s.toOrigin,
			fromStart: s.toEnd,
			toCid: s.fromCid,
			toOrigin: s.fromOrigin,
			toEnd: s.fromStart
		} as SelSpan
	}
	return s
}

/** 句末标点集（句号/叹号/问号结句，逗号不结句；阅读页句界扫描与首页诗行间句界共用） */
export const SENTENCE_END_CHARS : string = '。！？!?…'

/** 判定想法覆盖某章某段落的某字符（位置字典序落在 [from, to] 闭区间内；跨段跨章，章 id 升序即阅读顺序） */
export function thoughtCovers(t : Thought, cid : number, origin : number, charIdx : number) : boolean {
	return comparePos(t.fromCid, t.fromOrigin, t.fromStart, cid, origin, charIdx) <= 0
		&& comparePos(cid, origin, charIdx, t.toCid, t.toOrigin, t.toEnd) <= 0
}

/** 想法记录 → 其选区区间（长按命中想法恢复完整选区用） */
export function spanOfThought(t : Thought) : SelSpan {
	return {
		fromCid: t.fromCid,
		fromOrigin: t.fromOrigin,
		fromStart: t.fromStart,
		toCid: t.toCid,
		toOrigin: t.toOrigin,
		toEnd: t.toEnd
	} as SelSpan
}

/** 命中某章某段落某字符位置的想法（长按恢复选区/点击查看想法共用；无命中返回 null） */
export function thoughtAt(thoughts : Thought[], cid : number, origin : number, charIdx : number) : Thought | null {
	for (const t of thoughts) {
		if (thoughtCovers(t, cid, origin, charIdx)) {
			return t
		}
	}
	return null
}

/** 选区关联想法内容（区间与选区相交的首个想法，拖动微调后仍关联；无则空串） */
export function thoughtTextOfSpan(s : SelSpan, thoughts : Thought[]) : string {
	const n = normalizeSpan(s)
	for (const t of thoughts) {
		const tEndAfterSpanFrom = comparePos(t.toCid, t.toOrigin, t.toEnd, n.fromCid, n.fromOrigin, n.fromStart) >= 0
		const tStartBeforeSpanEnd = comparePos(t.fromCid, t.fromOrigin, t.fromStart, n.toCid, n.toOrigin, n.toEnd) <= 0
		if (tEndAfterSpanFrom && tStartBeforeSpanEnd) {
			return t.content
		}
	}
	return ''
}

/**
 * 选区覆盖段序列（划线按项写入所在章）：跨章时按各章真实段落数展开（滚动模式多章正文长度各异，
 * 不能套用当前章段落数），段长由 parasOf 提供——阅读页传章段落表、首页诗传虚拟行段
 */
export function buildSpanSegs(s0 : SelSpan, parasOf : (cid : number) => Paragraph[]) : SpanSeg[] {
	const s = normalizeSpan(s0)
	const segs : SpanSeg[] = []
	const fromParas = parasOf(s.fromCid)
	const fromTextLen = fromParas[s.fromOrigin].text.length
	if (s.toCid == s.fromCid && s.toOrigin == s.fromOrigin) {
		if (s.toEnd >= s.fromStart) {
			segs.push({ cid: s.fromCid, origin: s.fromOrigin, start: s.fromStart, end: s.toEnd } as SpanSeg)
		}
		return segs
	}
	segs.push({ cid: s.fromCid, origin: s.fromOrigin, start: s.fromStart, end: fromTextLen - 1 } as SpanSeg)
	if (s.toCid == s.fromCid) {
		// 同章跨段：中间段取起点章真实段落数
		for (let o = s.fromOrigin + 1; o < s.toOrigin && o < fromParas.length; o++) {
			segs.push({ cid: s.fromCid, origin: o, start: 0, end: fromParas[o].text.length - 1 } as SpanSeg)
		}
	} else {
		// 跨章：各章按自身真实段落数展开（滚动模式多章正文长度各异，不能套用当前章段落数）
		for (let o = s.fromOrigin + 1; o < fromParas.length; o++) {
			segs.push({ cid: s.fromCid, origin: o, start: 0, end: fromParas[o].text.length - 1 } as SpanSeg)
		}
		for (let c = s.fromCid + 1; c < s.toCid; c++) {
			const midParas = parasOf(c)
			for (let o = 0; o < midParas.length; o++) {
				segs.push({ cid: c, origin: o, start: 0, end: midParas[o].text.length - 1 } as SpanSeg)
			}
		}
		const toParas = parasOf(s.toCid)
		for (let o = 0; o < s.toOrigin && o < toParas.length; o++) {
			segs.push({ cid: s.toCid, origin: o, start: 0, end: toParas[o].text.length - 1 } as SpanSeg)
		}
	}
	segs.push({ cid: s.toCid, origin: s.toOrigin, start: 0, end: s.toEnd } as SpanSeg)
	return segs
}

// 划线/想法/书签/设置的本地存储 key（缓存真源收口本文件，外部一律经下方读写工具访问；
// 划线/想法/书签按书籍隔离（key 带云端书籍 id），设置与书架样式为全局键）
let activeBookId : number = 0
/** 书籍锁定标志：setActiveBookId 后为 true。0 为首页诗《无题》虚拟书（云端 reading_notes 以
 *  book_id=0 存储，无 user_books 行，cid=0 唯一章、origin=诗行序号），key 同样有效；
 *  未锁定（启动初始态）时读写工具按空表/忽略处理 */
let bookLocked : boolean = false
const UNDERLINE_STORAGE_KEY = 'reader_underlines'
const THOUGHT_STORAGE_KEY = 'reader_thoughts'
const BOOKMARK_STORAGE_KEY = 'reader_bookmarks'
const SETTINGS_STORAGE_KEY = 'reader_settings'

/** 首页诗虚拟书 id：云端 reading_notes 以 book_id=0 存储《无题》笔记（无 user_books 行，不进书架、无进度；阅读页进度/时长/书签按此跳过） */
export const VIRTUAL_BOOK_ID : number = 0

/** 锁定当前阅读书籍（打开书籍/首页诗时由页面调用；划线/想法/书签读写与云端同步按此 id 定位） */
export function setActiveBookId(bookId : number) : void {
	activeBookId = bookId
	bookLocked = true
}

/** 当前书籍存储 key（未锁书时返回 null，读写工具按空表/忽略处理；负数 id 为离线导入待同步书籍，同样本地可读写） */
function bookScopedKey(prefix : string) : string | null {
	return bookLocked ? prefix + activeBookId : null
}

/** 读取本地阅读设置（损坏/缺项容错返回默认值） */
export function loadSettings() : ReaderSettings {
	let s = { fontSize: 18, pageTurn: '滚动', theme: 'light', fontKey: 'sourcehan' } as ReaderSettings
	const stored : any = uni.getStorageSync(SETTINGS_STORAGE_KEY)
	if (typeof stored == 'string' && (stored as string).length > 0) {
		const parsed = JSON.parse<ReaderSettings>(stored as string)
		if (parsed != null) {
			s = parsed
		}
	}
	// 字号钳制到有效范围，防止外部修改导致排版异常
	if (s.fontSize < 12) {
		s.fontSize = 12
	}
	if (s.fontSize > 36) {
		s.fontSize = 36
	}
	return s
}

/** 持久化阅读设置（本地缓存即写 + 云端偏好整包静默跟随） */
export function saveSettings(s : ReaderSettings) : void {
	uni.setStorageSync(SETTINGS_STORAGE_KEY, JSON.stringify(s))
	pushPreferencesQuiet()
}

/** 书架卡片样式持久化（书架页调用；随偏好整包云端跟随） */
export function saveBookshelfStyle(style : string) : void {
	uni.setStorageSync('bookshelf_style', style)
	pushPreferencesQuiet()
}

/** 偏好整包云端跟随（阅读设置四项 + 书架样式；静默同步） */
function pushPreferencesQuiet() : void {
	const s = loadSettings()
	const prefs = {} as UTSJSONObject
	prefs['fontSize'] = s.fontSize
	prefs['pageTurn'] = s.pageTurn
	prefs['theme'] = s.theme
	prefs['fontKey'] = s.fontKey
	const style : any = uni.getStorageSync('bookshelf_style')
	prefs['bookshelfStyle'] = typeof style == 'string' ? style as string : 'plain'
	syncQuiet(savePreferences(prefs))
}

/** 读取本地书签列表（当前书籍缓存；空/未锁书/损坏容错返回空表） */
export function loadBookmarks() : Bookmark[] {
	const key = bookScopedKey(BOOKMARK_STORAGE_KEY)
	if (key == null) {
		return [] as Bookmark[]
	}
	const stored : any = uni.getStorageSync(key)
	if (typeof stored == 'string' && (stored as string).length > 0) {
		const list = JSON.parse<Array<Bookmark>>(stored as string)
		if (list != null) {
			return list
		}
	}
	return [] as Bookmark[]
}

/** 持久化书签列表（当前书籍缓存即写 + 云端整表替换静默跟随） */
export function saveBookmarksToStorage(list : Bookmark[]) : void {
	const key = bookScopedKey(BOOKMARK_STORAGE_KEY)
	if (key == null) {
		return
	}
	uni.setStorageSync(key, JSON.stringify(list))
	if (activeBookId > 0) {
		syncQuiet(replaceBookmarks(activeBookId, bookmarksToCloudItems(list)))
	}
}

// ==================== 云端拉取结果落缓存（打开书籍时调用，云端为准覆盖本地） ====================

/** 云端划线对象 → UnderlineEntry（ranges 为扁平数组 [s1,e1,...]） */
export function underlineFromCloud(obj : UTSJSONObject) : UnderlineEntry | null {
	const cid = obj.getNumber('cid')
	const origin = obj.getNumber('origin')
	if (cid == null || origin == null) {
		return null
	}
	const ranges : number[][] = []
	const flat = obj.getArray<number>('ranges')
	if (flat != null) {
		let i = 0
		while (i + 1 < flat.length) {
			ranges.push([flat[i], flat[i + 1]])
			i += 2
		}
	}
	return { cid: cid, origin: origin, ranges: ranges } as UnderlineEntry
}

/** 云端想法对象 → Thought */
export function thoughtFromCloud(obj : UTSJSONObject) : Thought | null {
	const fromCid = obj.getNumber('from_cid')
	const fromOrigin = obj.getNumber('from_origin')
	const fromStart = obj.getNumber('from_start')
	const toCid = obj.getNumber('to_cid')
	const toOrigin = obj.getNumber('to_origin')
	const toEnd = obj.getNumber('to_end')
	if (fromCid == null || fromOrigin == null || fromStart == null || toCid == null || toOrigin == null || toEnd == null) {
		return null
	}
	return {
		fromCid: fromCid,
		fromOrigin: fromOrigin,
		fromStart: fromStart,
		toCid: toCid,
		toOrigin: toOrigin,
		toEnd: toEnd,
		quote: obj.getString('quote') ?? '',
		content: obj.getString('content') ?? ''
	} as Thought
}

/** 云端书签对象 → Bookmark */
export function bookmarkFromCloud(obj : UTSJSONObject) : Bookmark | null {
	const chapterId = obj.getNumber('chapter_id')
	const pageIndex = obj.getNumber('page_index')
	if (chapterId == null || pageIndex == null) {
		return null
	}
	return { chapterId: chapterId, pageIndex: pageIndex } as Bookmark
}

/** 云端划线列表落当前书籍缓存（打开书籍拉取后调用） */
export function storeUnderlines(entries : UnderlineEntry[]) : void {
	const key = bookScopedKey(UNDERLINE_STORAGE_KEY)
	if (key == null) {
		return
	}
	uni.setStorageSync(key, JSON.stringify(entries))
}

/** 云端想法列表落当前书籍缓存 */
export function storeThoughts(list : Thought[]) : void {
	const key = bookScopedKey(THOUGHT_STORAGE_KEY)
	if (key == null) {
		return
	}
	uni.setStorageSync(key, JSON.stringify(list))
}

/** 云端书签列表落当前书籍缓存 */
export function storeBookmarks(list : Bookmark[]) : void {
	const key = bookScopedKey(BOOKMARK_STORAGE_KEY)
	if (key == null) {
		return
	}
	uni.setStorageSync(key, JSON.stringify(list))
}

// ==================== 云端笔记/书签拉取落缓存（打开书籍与首页诗共用，云端为准覆盖本地） ====================

/** 云端 notes 响应 data → 划线列表（缺省/损坏项跳过） */
function underlinesFromCloudData(data : UTSJSONObject) : UnderlineEntry[] {
	const list : UnderlineEntry[] = []
	const raw = data.getArray('underlines')
	if (raw != null) {
		raw.forEach((el) => {
			const e = underlineFromCloud(el as UTSJSONObject)
			if (e != null) {
				list.push(e)
			}
		})
	}
	return list
}

/** 云端 notes 响应 data → 想法列表（缺省/损坏项跳过） */
function thoughtsFromCloudData(data : UTSJSONObject) : Thought[] {
	const list : Thought[] = []
	const raw = data.getArray('thoughts')
	if (raw != null) {
		raw.forEach((el) => {
			const t = thoughtFromCloud(el as UTSJSONObject)
			if (t != null) {
				list.push(t)
			}
		})
	}
	return list
}

/**
 * 云端笔记（划线/想法）拉取并落当前书籍缓存（云端为准覆盖本地）。
 * 未登录不发请求；失败静默保留本地缓存（离线容错，镜像由调用方刷新）
 */
export async function fetchNotesToCache(bookId : number) : Promise<void> {
	if (!hasAccessToken()) {
		return
	}
	try {
		const res = await fetchBookNotes(bookId)
		if (res.code == 0 && res.data != null) {
			storeUnderlines(underlinesFromCloudData(res.data!))
			storeThoughts(thoughtsFromCloudData(res.data!))
		}
	} catch (e) {
		console.warn('云端笔记拉取失败，使用本地缓存', e)
	}
}

/** 云端书签拉取并落当前书籍缓存（未登录不发请求；失败静默保留本地缓存） */
export async function fetchBookmarksToCache(bookId : number) : Promise<void> {
	if (!hasAccessToken()) {
		return
	}
	try {
		const res = await fetchBookBookmarks(bookId)
		if (res.code == 0 && res.data != null) {
			const bms : Bookmark[] = []
			const rawB = res.data!.getArray('list')
			if (rawB != null) {
				rawB.forEach((el) => {
					const b = bookmarkFromCloud(el as UTSJSONObject)
					if (b != null) {
						bms.push(b)
					}
				})
			}
			storeBookmarks(bms)
		}
	} catch (e) {
		console.warn('云端书签拉取失败，使用本地缓存', e)
	}
}

/** 读取本地书架卡片样式（缺省/非法回退 plain；云端偏好由 App 启动/书架刷新落缓存） */
export function loadBookshelfStyle() : string {
	const stored : any = uni.getStorageSync('bookshelf_style')
	if (typeof stored == 'string' && ((stored as string) == 'plain' || (stored as string) == 'photo')) {
		return stored as string
	}
	return 'plain'
}

/** 读取本地划线记录（当前书籍缓存；空/未锁书/损坏容错返回空表） */
export function loadUnderlines() : UnderlineEntry[] {
	const key = bookScopedKey(UNDERLINE_STORAGE_KEY)
	if (key == null) {
		return [] as UnderlineEntry[]
	}
	const stored : any = uni.getStorageSync(key)
	if (typeof stored == 'string' && (stored as string).length > 0) {
		const list = JSON.parse<Array<UnderlineEntry>>(stored as string)
		if (list != null) {
			return list
		}
	}
	return [] as UnderlineEntry[]
}

/** 读取本地想法记录（当前书籍缓存；空/未锁书/损坏容错返回空表） */
export function loadThoughts() : Thought[] {
	const key = bookScopedKey(THOUGHT_STORAGE_KEY)
	if (key == null) {
		return []
	}
	const stored : any = uni.getStorageSync(key)
	if (typeof stored == 'string' && (stored as string).length > 0) {
		const list = JSON.parse<Array<Thought>>(stored as string)
		if (list != null) {
			return list
		}
	}
	return []
}

/** 统计指定书籍的本地缓存划线+想法条数（书架/统计页汇总用；key 与容错口径与本文件读写单点一致） */
export function countCachedNotes(bookId : number) : number {
	let n = 0
	const keys : string[] = [UNDERLINE_STORAGE_KEY + bookId, THOUGHT_STORAGE_KEY + bookId]
	for (let i = 0; i < keys.length; i++) {
		const stored : any = uni.getStorageSync(keys[i])
		if (typeof stored == 'string' && (stored as string).length > 0) {
			const arr = JSON.parse<UTSJSONObject[]>(stored as string)
			if (arr != null) {
				n += arr.length
			}
		}
	}
	return n
}

/** 查找章+段落的划线记录 */
export function findUnderlineEntry(list : UnderlineEntry[], cid : number, origin : number) : UnderlineEntry | null {
	for (let i = 0; i < list.length; i++) {
		const e = list[i]
		if (e.cid == cid && e.origin == origin) {
			return e
		}
	}
	return null
}

/** 划线区间扁平化（云端传输格式 [s1,e1,s2,e2,...]） */
function flatRanges(entry : UnderlineEntry) : number[] {
	const flat : number[] = []
	for (const u of entry.ranges) {
		flat.push(u[0])
		flat.push(u[1])
	}
	return flat
}

/** 书签列表 → 云端传输项（[{chapter_id, page_index}]） */
function bookmarksToCloudItems(list : Bookmark[]) : UTSJSONObject[] {
	const items : UTSJSONObject[] = []
	for (let i = 0; i < list.length; i++) {
		const item = {} as UTSJSONObject
		item['chapter_id'] = list[i].chapterId
		item['page_index'] = list[i].pageIndex
		items.push(item)
	}
	return items
}

/**
 * 对划线记录表应用单段区间（原地修改并返回是否需要持久化）：
 * add=true 恒并入（写想法时确保划线），add=false 为切换（选中区域已完全划线则取消）；
 * 区间清空的记录整条移除，避免存储留空壳
 */
function applySegUnderline(list : UnderlineEntry[], cid : number, origin : number, start : number, end : number, add : boolean) : void {
	let entry = findUnderlineEntry(list, cid, origin)
	if (entry == null) {
		entry = { cid: cid, origin: origin, ranges: [] } as UnderlineEntry
		list.push(entry)
	}
	let covered = 0
	for (const u of entry.ranges) {
		const lo = Math.max(u[0], start)
		const hi = Math.min(u[1] + 1, end + 1)
		if (hi > lo) {
			covered += hi - lo
		}
	}
	const isCovered = covered == end - start + 1
	const result : number[][] = []
	for (const u of entry.ranges) {
		if (u[1] < start || u[0] > end) {
			result.push(u)
			continue
		}
		if (u[0] < start) {
			result.push([u[0], start - 1])
		}
		if (u[1] > end) {
			result.push([end + 1, u[1]])
		}
	}
	if (add || !isCovered) {
		result.push([start, end])
	}
	entry.ranges = result
	if (entry.ranges.length == 0) {
		const idx = list.indexOf(entry)
		if (idx >= 0) {
			list.splice(idx, 1)
		}
	}
}

/** 选区跨段划线应用：按段序列逐段写入当前书籍缓存，被改动段逐段云端 upsert（划线/写想法共用收口） */
export function applySpanUnderlineToStorage(segs : SpanSeg[], add : boolean) : void {
	const key = bookScopedKey(UNDERLINE_STORAGE_KEY)
	if (key == null) {
		return
	}
	const list = loadUnderlines()
	// 被改动段去重登记（同段可被多个切片命中），结束后按最终区间云端同步
	const touched : string[] = []
	for (const seg of segs) {
		if (seg.end < seg.start) {
			continue
		}
		applySegUnderline(list, seg.cid, seg.origin, seg.start, seg.end, add)
		const k = seg.cid.toString() + ':' + seg.origin.toString()
		if (touched.indexOf(k) < 0) {
			touched.push(k)
		}
	}
	uni.setStorageSync(key, JSON.stringify(list))
	// 云端同步条件：锁定的虚拟书 0（首页诗）与真实书同步，离线待同步书籍（负数 id）不同步
	if (bookLocked && activeBookId >= 0) {
		for (const k of touched) {
			const sep = k.indexOf(':')
			const cid = parseInt(k.substring(0, sep))
			const origin = parseInt(k.substring(sep + 1))
			// 云端传输为扁平区间（[s1,e1,s2,e2]），本地存储保持区间对结构不变
			const entry = findUnderlineEntry(list, cid, origin)
			syncQuiet(upsertUnderline(activeBookId, cid, origin, entry != null ? flatRanges(entry) : [] as number[]))
		}
	}
}

/** 想法记录写入（当前书籍缓存即写 + 云端静默跟随） */
export function saveThought(t : Thought) : void {
	const key = bookScopedKey(THOUGHT_STORAGE_KEY)
	if (key == null) {
		return
	}
	const list = loadThoughts()
	list.push(t)
	uni.setStorageSync(key, JSON.stringify(list))
	// 云端同步条件：锁定的虚拟书 0（首页诗）与真实书同步，离线待同步书籍（负数 id）不同步
	if (bookLocked && activeBookId >= 0) {
		syncQuiet(createThought(activeBookId, t.fromCid, t.fromOrigin, t.fromStart, t.toCid, t.toOrigin, t.toEnd, t.quote, t.content))
	}
}

// ==================== 离线导入书籍登录同步（本地负数 id → 云端 id 迁移） ====================

/** 读取指定书籍 id 的笔记缓存原文（迁移用，绕过 activeBookId 锁定；非字符串返回空串） */
function readNoteStorageRaw(key : string) : string {
	const stored : any = uni.getStorageSync(key)
	return typeof stored == 'string' ? stored as string : ''
}

/** 划线缓存迁移：本地数据先逐段回补云端（upsert 幂等），全部成功后才迁移缓存 key */
async function migrateUnderlinesStorage(oldId : number, newId : number) : Promise<void> {
	const raw = readNoteStorageRaw(UNDERLINE_STORAGE_KEY + oldId)
	if (raw.length == 0) {
		return
	}
	const list = JSON.parse<Array<UnderlineEntry>>(raw)
	if (list == null) {
		// 缓存损坏不可用：丢弃旧 key 不阻塞迁移（与读取方容错口径一致）
		uni.removeStorageSync(UNDERLINE_STORAGE_KEY + oldId)
		return
	}
	for (let i = 0; i < list.length; i++) {
		const entry = list[i]
		// 云端传输为扁平区间（[s1,e1,s2,e2]），空数组=整段取消
		await upsertUnderline(newId, entry.cid, entry.origin, flatRanges(entry))
	}
	uni.setStorageSync(UNDERLINE_STORAGE_KEY + newId, raw)
	uni.removeStorageSync(UNDERLINE_STORAGE_KEY + oldId)
}

/** 想法缓存迁移：逐条云端写入（云端无去重键，仅该类迁移中途失败重试才可能重复） */
async function migrateThoughtsStorage(oldId : number, newId : number) : Promise<void> {
	const raw = readNoteStorageRaw(THOUGHT_STORAGE_KEY + oldId)
	if (raw.length == 0) {
		return
	}
	const list = JSON.parse<Array<Thought>>(raw)
	if (list == null) {
		uni.removeStorageSync(THOUGHT_STORAGE_KEY + oldId)
		return
	}
	for (let i = 0; i < list.length; i++) {
		const t = list[i]
		await createThought(newId, t.fromCid, t.fromOrigin, t.fromStart, t.toCid, t.toOrigin, t.toEnd, t.quote, t.content)
	}
	uni.setStorageSync(THOUGHT_STORAGE_KEY + newId, raw)
	uni.removeStorageSync(THOUGHT_STORAGE_KEY + oldId)
}

/** 书签缓存迁移：本地整表先云端替换（幂等），成功后迁移缓存 key */
async function migrateBookmarksStorage(oldId : number, newId : number) : Promise<void> {
	const raw = readNoteStorageRaw(BOOKMARK_STORAGE_KEY + oldId)
	if (raw.length == 0) {
		return
	}
	const list = JSON.parse<Array<Bookmark>>(raw)
	if (list == null) {
		uni.removeStorageSync(BOOKMARK_STORAGE_KEY + oldId)
		return
	}
	await replaceBookmarks(newId, bookmarksToCloudItems(list))
	uni.setStorageSync(BOOKMARK_STORAGE_KEY + newId, raw)
	uni.removeStorageSync(BOOKMARK_STORAGE_KEY + oldId)
}

/** 笔记迁移收口：划线→想法→书签逐类先回补云端、成功后迁移缓存 key；任一类失败抛错中断
 * （该类 key 不迁移，books.uts 据此整本保留待同步态，重试只补失败类，不重复上传已成功类）
 */
export async function relocateBookNotes(oldId : number, newId : number) : Promise<void> {
	await migrateUnderlinesStorage(oldId, newId)
	await migrateThoughtsStorage(oldId, newId)
	await migrateBookmarksStorage(oldId, newId)
	if (activeBookId == oldId) {
		activeBookId = newId
	}
}

/** 想法去重比对：选区端点与内容完全一致视为同一条（云端想法无去重键，回补仅推差集防重复） */
function containsThought(list : Thought[], t : Thought) : boolean {
	for (let i = 0; i < list.length; i++) {
		const c = list[i]
		if (c.fromCid == t.fromCid && c.fromOrigin == t.fromOrigin && c.fromStart == t.fromStart && c.toCid == t.toCid && c.toOrigin == t.toOrigin && c.toEnd == t.toEnd && c.content == t.content) {
			return true
		}
	}
	return false
}

/**
 * 登录回补（复用云端行的离线书）：把本地缓存笔记推回云端。
 * 划线逐段 upsert、书签整表替换均幂等可全量重推；想法云端无去重键，
 * 与传入的云端已有列表按去重键比对，仅推本地有而云端无的差集。
 * 任一推送失败即抛错（调用方保持 dirty 待下次回补，已成功类型幂等不产生重复）
 */
export async function repushBookNotes(bookId : number, cloudThoughts : Thought[]) : Promise<void> {
	const uRaw = readNoteStorageRaw(UNDERLINE_STORAGE_KEY + bookId)
	if (uRaw.length > 0) {
		const ulist = JSON.parse<Array<UnderlineEntry>>(uRaw)
		if (ulist != null) {
			for (let i = 0; i < ulist.length; i++) {
				const e = ulist[i]
				await upsertUnderline(bookId, e.cid, e.origin, flatRanges(e))
			}
		}
	}
	const bRaw = readNoteStorageRaw(BOOKMARK_STORAGE_KEY + bookId)
	if (bRaw.length > 0) {
		const blist = JSON.parse<Array<Bookmark>>(bRaw)
		if (blist != null) {
			await replaceBookmarks(bookId, bookmarksToCloudItems(blist))
		}
	}
	const tRaw = readNoteStorageRaw(THOUGHT_STORAGE_KEY + bookId)
	if (tRaw.length > 0) {
		const tlist = JSON.parse<Array<Thought>>(tRaw)
		if (tlist != null) {
			for (let i = 0; i < tlist.length; i++) {
				const t = tlist[i]
				if (!containsThought(cloudThoughts, t)) {
					await createThought(bookId, t.fromCid, t.fromOrigin, t.fromStart, t.toCid, t.toOrigin, t.toEnd, t.quote, t.content)
				}
			}
		}
	}
}
/**
 * 划线/想法卡片列表组装（目录抽屉数据源）：
 * 划线区间派生卡片并关联想法（想法覆盖的划线区间不再单出划线卡），无匹配区间的想法独立成卡；
 * 按 章/段落/位置 升序。章节段落未注入（首帧渲染早于书籍加载）或记录指向已不存在的章时跳过，避免越界。
 */
export function buildNoteRecords(underlines : UnderlineEntry[], thoughts : Thought[], chapterParas : Paragraph[][]) : NoteRecord[] {
	const records : NoteRecord[] = []
	const usedThoughts : boolean[] = thoughts.map(() : boolean => false)
	for (const e of underlines) {
		// 划线文本按记录所在章取：跨章划线的卡片引用不能用当前章段落数组
		const paras = e.cid >= 0 && e.cid < chapterParas.length ? chapterParas[e.cid] : ([] as Paragraph[])
		const p = paras[e.origin]
		if (p == null) {
			continue
		}
		for (const u of e.ranges) {
			const quote = p.text.slice(u[0], u[1] + 1)
			let content = ''
			for (let ti = 0; ti < thoughts.length; ti++) {
				const t = thoughts[ti]
				if (t.fromCid == e.cid && t.fromOrigin == e.origin && t.fromStart == u[0] && t.toCid == e.cid && t.toOrigin == e.origin && t.toEnd == u[1]) {
					content = t.content
					usedThoughts[ti] = true
					break
				}
			}
			records.push({ cid: e.cid, origin: e.origin, qStart: u[0], quote: quote, content: content } as NoteRecord)
		}
	}
	for (let ti = 0; ti < thoughts.length; ti++) {
		if (!usedThoughts[ti]) {
			const t = thoughts[ti]
			records.push({ cid: t.fromCid, origin: t.fromOrigin, qStart: t.fromStart, quote: t.quote, content: t.content } as NoteRecord)
		}
	}
	records.sort((a : NoteRecord, b : NoteRecord) : number => {
		if (a.cid != b.cid) {
			return a.cid - b.cid
		}
		if (a.origin != b.origin) {
			return a.origin - b.origin
		}
		return a.qStart - b.qStart
	})
	return records
}

/**
 * 分享卡片内容快照组装：上下文渐出四段 + 引文 + 关联想法 + 出处。
 * 跨段选区取首段前文/末段后文（前文各留 24 字窗口、后文各留 25 字窗口，中点对半分档）；
 * 想法与选区区间相交即关联（拖动微调后仍展示），出处取选区终点章标题。
 */
export function buildShareQuoteCtx(s : SelSpan, fromText : string, toText : string, thoughts : Thought[], quoteText : string, sourceTitle : string, bookTitle : string) : ShareQuoteCtx {
	const ctxStart = Math.max(0, s.fromStart - 24)
	const ctxEnd = Math.min(toText.length, s.toEnd + 25)
	const before = fromText.slice(ctxStart, s.fromStart)
	const after = toText.slice(s.toEnd + 1, ctxEnd)
	const halfB = Math.ceil(before.length / 2)
	const halfA = Math.floor(after.length / 2)
	// 选区与想法区间相交即展示（拖动微调后仍关联，判定收口 thoughtTextOfSpan）
	const thoughtText = thoughtTextOfSpan(s, thoughts)
	return {
		farBefore: before.slice(0, halfB),
		nearBefore: before.slice(halfB),
		quote: quoteText,
		nearAfter: after.slice(0, halfA),
		farAfter: after.slice(halfA),
		thoughtText: thoughtText,
		source: sourceTitle,
		bookTitle: bookTitle
	} as ShareQuoteCtx
}

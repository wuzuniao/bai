// 书籍数据层：云端元数据为准，本地存储仅做缓存（书架/阅读页共享收口）
// 正文保存于本机不上传云端（path 为本机字段，path='' 表示本设备无正文）：
// 小程序/App 为沙盒文件 uni.env.USER_DATA_PATH/books/，Web 端为 IndexedDB 虚拟键 'webbooks/<id>.<ext>'（见 webfs.uts，键路径与沙盒同构）；
// 云端按 (用户, 书名) 唯一：重导入同名书复用同一 id，换设备重新导入后进度与笔记按书名自动关联；
// 进度/时长均为「本地即时写缓存 + 云端静默跟随」，页面进入时以云端数据覆盖本地缓存

import {
	fetchBookNotes,
	fetchBooks,
	registerBook,
	updateBookProgress,
	updateBookOrder,
	deleteBook,
	reportMinutes,
	fetchReadingStats,
	reportReadingSessions,
	syncQuiet
} from '../api/reading.uts'
import { hasAccessToken } from './request.uts'
import { relocateBookNotes, repushBookNotes, thoughtFromCloud, Thought } from './readerTypes.uts'
import { t, tf } from './i18n'
// 词典注册（书籍数据层文案）
import './locales/books.uts'
// #ifdef WEB
import { webFsDelete, webFsRename } from './webfs'
// #endif

/** 书架书籍（书架页展示与排序的唯一数据源；云端字段 + 本机 path 合并结果） */
export type LocalBook = {
	/** 云端书籍 id（导入登记时由后端分配） */
	id: number
	/** 书名（导入时取文件名去扩展名） */
	title: string
	/** 作者署名（本地导入无作者信息，恒为空串；封面深灰卡布局位） */
	author: string
	/** 导入文件格式大写水印（TXT/PDF），封面角落展示 */
	format: string
	/** 正文文件在沙盒中的路径（'' 表示本设备无正文，需重新导入同名文件） */
	path: string
	/** 文件字节数 */
	size: number
	/** 导入时间戳（ms） */
	addedAt: number
	/** 最近阅读时间戳（ms，0=未读） */
	lastReadAt: number
	/** 上次阅读到的章节 id（-1=未读；PDF 书恒为 -1，进度用 lastPercent） */
	lastChapter: number
	/** 章内页码 0-based（txt 恢复定位） */
	lastPageIndex: number
	/** 滚动模式滚动位置 px（txt 恢复定位） */
	lastScrollTop: number
	/** 最近阅读百分比（0-100，仅 PDF 书使用；txt 书恒为 0） */
	lastPercent: number
	/** PDF 首页高/宽比（页面 wrapper 等比布局依据；txt 书为 0） */
	pdfRatio: number
	/** 章节总数（txt=解析章节数，含序章；PDF=页数） */
	chapterCount: number
	/** 第一章前有前置内容并生成序章（导入时固化） */
	hasPreface: boolean
	/** 离线改动待回补（未登录复用云端行导入/阅读后置位；登录回补成功清除） */
	dirty: boolean
}

/** 阅读进度（txt：章节/页码/滚动位置） */
export type BookProgress = {
	chapterId: number
	/** 章内页码（0-based） */
	pageIndex: number
	/** 滚动模式的滚动位置（px） */
	scrollTop: number
}

/** PDF 阅读进度（滚动位置百分比 + 首页宽高比，用于布局与恢复定位） */
export type PdfProgress = {
	percent: number
	/** 首页高/宽比（页面 wrapper 等比布局依据） */
	ratio: number
}

const STORAGE_BOOKS = 'bookshelf_books_v2'
const STORAGE_STATS = 'reading_stats'
/** 旧版本地真源存储 key（云化后废弃，首次进入书架统一清理） */
const LEGACY_BOOKS = 'bookshelf_books'
const LEGACY_UNDERLINES = 'reader_underlines'
const LEGACY_THOUGHTS = 'reader_thoughts'
const LEGACY_BOOKMARKS = 'reader_bookmarks'

// ==================== 缓存读写 ====================

/** 从宽松 JSON 对象还原 LocalBook（字段缺失/类型不符返回 null） */
function bookFromObject(obj : UTSJSONObject) : LocalBook | null {
	const id = obj.getNumber('id')
	const title = obj.getString('title')
	const format = obj.getString('format')
	if (id == null || title == null || format == null) {
		return null
	}
	return {
		id: id,
		title: title,
		author: obj.getString('author') ?? '',
		format: format,
		path: obj.getString('path') ?? '',
		size: obj.getNumber('size') ?? 0,
		addedAt: obj.getNumber('addedAt') ?? 0,
		lastReadAt: obj.getNumber('lastReadAt') ?? 0,
		lastChapter: obj.getNumber('lastChapter') ?? -1,
		lastPageIndex: obj.getNumber('lastPageIndex') ?? 0,
		lastScrollTop: obj.getNumber('lastScrollTop') ?? 0,
		lastPercent: obj.getNumber('lastPercent') ?? 0,
		pdfRatio: obj.getNumber('pdfRatio') ?? 0,
		chapterCount: obj.getNumber('chapterCount') ?? 0,
		hasPreface: obj.getBoolean('hasPreface') == true,
		dirty: obj.getBoolean('dirty') == true
	} as LocalBook
}

/** 读取本地缓存书架列表（顺序即云端手动排序结果） */
export function loadBooks() : LocalBook[] {
	const stored : any = uni.getStorageSync(STORAGE_BOOKS)
	if (typeof stored != 'string' || (stored as string).length == 0) {
		return []
	}
	const result : LocalBook[] = []
	const arr = JSON.parse<UTSJSONObject[]>(stored as string)
	if (arr != null) {
		for (let i = 0; i < arr.length; i++) {
			const book = bookFromObject(arr[i])
			if (book != null) {
				result.push(book)
			}
		}
	}
	return result
}

/** 书架列表缓存写入（仅本地；云端顺序同步走 syncBookOrder） */
export function saveBooks(list : LocalBook[]) : void {
	uni.setStorageSync(STORAGE_BOOKS, JSON.stringify(list))
}

/** 云端手动排序跟随（拖拽落定后调用；静默同步） */
export function syncBookOrder(list : LocalBook[]) : void {
	const items : UTSJSONObject[] = []
	for (let i = 0; i < list.length; i++) {
		const item = {} as UTSJSONObject
		item['id'] = list[i].id
		item['sort_order'] = i
		items.push(item)
	}
	syncQuiet(updateBookOrder(items))
}

/** 缓存内按 id 定位书籍 */
function findCached(bookId : number, list : LocalBook[]) : number {
	for (let i = 0; i < list.length; i++) {
		if (list[i].id == bookId) {
			return i
		}
	}
	return -1
}

/** 按书架顺序查找书籍（缓存未命中返回 null） */
export function findBook(bookId : number) : LocalBook | null {
	const list = loadBooks()
	const i = findCached(bookId, list)
	return i >= 0 ? list[i] : null
}

// ==================== 云端同步（拉取覆盖缓存） ====================

/** 东八区时间串（YYYY-MM-DD HH:mm:ss）→ ms（解析失败返回 0） */
function cnDatetimeToMs(s : string) : number {
	// 固定格式拆分解析（避免 iOS 对 '-' 分隔串的 Date.parse 兼容问题）
	const datePart = s.substring(0, 10).split('-')
	const timePart = s.length > 10 ? s.substring(11, Math.min(s.length, 19)).split(':') : ([] as string[])
	if (datePart.length == 3) {
		const y = parseInt(datePart[0])
		const mo = parseInt(datePart[1])
		const d = parseInt(datePart[2])
		const hh = timePart.length > 0 ? parseInt(timePart[0]) : 0
		const mi = timePart.length > 1 ? parseInt(timePart[1]) : 0
		const ss = timePart.length > 2 ? parseInt(timePart[2]) : 0
		return new Date(y, mo - 1, d, hh, mi, ss).getTime()
	}
	return 0
}

/** 云端书籍对象 → LocalBook（path 留待与本地缓存合并） */
function bookFromCloud(obj : UTSJSONObject) : LocalBook | null {
	const id = obj.getNumber('id')
	const title = obj.getString('title')
	const format = obj.getString('format')
	if (id == null || title == null || format == null) {
		return null
	}
	const lastReadRaw = obj.getString('last_read_at')
	const createdRaw = obj.getString('created_at')
	return {
		id: id,
		title: title,
		author: obj.getString('author') ?? '',
		format: format,
		path: '',
		size: obj.getNumber('size') ?? 0,
		addedAt: createdRaw == null ? 0 : cnDatetimeToMs(createdRaw),
		lastReadAt: lastReadRaw == null ? 0 : cnDatetimeToMs(lastReadRaw),
		lastChapter: obj.getNumber('last_chapter') ?? -1,
		lastPageIndex: obj.getNumber('last_page_index') ?? 0,
		lastScrollTop: obj.getNumber('last_scroll_top') ?? 0,
		lastPercent: obj.getNumber('last_percent') ?? 0,
		pdfRatio: obj.getNumber('pdf_ratio') ?? 0,
		chapterCount: obj.getNumber('chapter_count') ?? 0,
		hasPreface: obj.getBoolean('has_preface') == true,
		dirty: false
	} as LocalBook
}

/**
 * 云端书架拉取并覆盖缓存（页面进入时调用；云端为准，本机仅回填 path）。
 * 云端失败时静默保留缓存（离线容错），返回当前可用列表
 */
export async function fetchBooksFromCloud() : Promise<LocalBook[]> {
	// 未登录：不发请求，书架展示本地缓存（默认空书架 + 添加格）
	if (!hasAccessToken()) {
		return loadBooks()
	}
	// 先同步离线导入书籍（注册云端并迁移 id），避免下方云端覆盖清掉未同步数据
	await syncPendingBooks()
	// 离线会话流水补传（登录态；置于书籍迁移之后，负数 id 已归位再传）
	await flushPendingSessions()
	try {
		const res = await fetchBooks()
		if (res.code == 0 && res.data != null) {
			const arr = res.data!.getArray('list')
			const cloud : LocalBook[] = []
			if (arr != null) {
				for (let i = 0; i < arr.length; i++) {
					const b = bookFromCloud(arr[i])
					if (b != null) {
						cloud.push(b)
					}
				}
			}
			// 本机正文文件路径回填（云端无 path 概念）；复用云端行的离线书（dirty）回补离线进度与笔记
			const local = loadBooks()
			const merged : LocalBook[] = []
			for (let i = 0; i < cloud.length; i++) {
				const book = cloud[i]
				const li = findCached(book.id, local)
				if (li >= 0) {
					book.path = local[li].path
					book.dirty = local[li].dirty
					if (local[li].dirty && await reconcileDirtyBook(book, local[li])) {
						book.dirty = false
					}
				}
				merged.push(book)
			}
			// 仍未同步成功的离线导入书籍保留在书架最前（对齐新增置顶语义；注册失败容错，下次书架进入再试）
			const pendings : LocalBook[] = []
			for (let i = 0; i < local.length; i++) {
				if (local[i].id < 0) {
					pendings.push(local[i])
				}
			}
			const mergedAll : LocalBook[] = []
			for (let i = 0; i < pendings.length; i++) {
				mergedAll.push(pendings[i])
			}
			for (let i = 0; i < merged.length; i++) {
				mergedAll.push(merged[i])
			}
			saveBooks(mergedAll)
		}
	} catch (e) {
		// 网络失败：保留本地缓存（云端为准的补偿由下次成功拉取完成）
		console.warn('云端书架拉取失败，使用本地缓存', e)
	}
	return loadBooks()
}

/**
 * 复用云端行的离线书回补：进度本地较新时覆盖合并结果并回写云端（与迁移同款比较口径）；
 * 笔记经 repushBookNotes 差集回补。返回是否全部成功（失败保持 dirty 下次再试，本地数据不丢）
 */
async function reconcileDirtyBook(book : LocalBook, localBook : LocalBook) : Promise<boolean> {
	try {
		if (localBook.lastReadAt > book.lastReadAt && (localBook.lastChapter >= 0 || localBook.lastPercent > 0)) {
			const fields = {} as UTSJSONObject
			if (localBook.lastChapter >= 0) {
				fields['last_chapter'] = localBook.lastChapter
				fields['last_page_index'] = localBook.lastPageIndex
				fields['last_scroll_top'] = localBook.lastScrollTop
			}
			if (localBook.lastPercent > 0) {
				fields['last_percent'] = Math.round(localBook.lastPercent)
				fields['pdf_ratio'] = localBook.pdfRatio
			}
			await updateBookProgress(book.id, fields)
			book.lastChapter = localBook.lastChapter
			book.lastPageIndex = localBook.lastPageIndex
			book.lastScrollTop = localBook.lastScrollTop
			book.lastPercent = localBook.lastPercent
			book.pdfRatio = localBook.pdfRatio
			book.lastReadAt = localBook.lastReadAt
		}
		const notesRes = await fetchBookNotes(book.id)
		const cloudThoughts : Thought[] = []
		if (notesRes.code == 0 && notesRes.data != null) {
			const rawT = notesRes.data!.getArray('thoughts')
			if (rawT != null) {
				rawT.forEach((el) => {
					const t = thoughtFromCloud(el as UTSJSONObject)
					if (t != null) {
						cloudThoughts.push(t)
					}
				})
			}
		}
		await repushBookNotes(book.id, cloudThoughts)
		return true
	} catch (e) {
		console.warn('离线改动回补失败，保留待同步标记：' + book.title, e)
		return false
	}
}

/** 本设备离线改动是否待回补（复用云端行的离线书；reader 据此跳过云端笔记拉取覆盖） */
export function isBookDirty(bookId : number) : boolean {
	const book = findBook(bookId)
	return book != null && book.dirty
}

// ==================== 阅读进度 ====================

/** txt 阅读进度持久化（缓存即写 + 云端静默跟随；进度字段存书籍记录内） */
export function saveBookProgress(bookId : number, p : BookProgress) : void {
	const list = loadBooks()
	const i = findCached(bookId, list)
	if (i < 0) {
		return
	}
	list[i].lastChapter = p.chapterId
	list[i].lastPageIndex = p.pageIndex
	list[i].lastScrollTop = p.scrollTop
	saveBooks(list)
	const fields = {} as UTSJSONObject
	fields['last_chapter'] = p.chapterId
	fields['last_page_index'] = p.pageIndex
	fields['last_scroll_top'] = p.scrollTop
	syncQuiet(updateBookProgress(bookId, fields))
}

/** 读取 txt 阅读进度（来自书籍记录；未读返回 null） */
export function loadBookProgress(bookId : number) : BookProgress | null {
	const book = findBook(bookId)
	if (book == null || book.lastChapter < 0) {
		return null
	}
	return { chapterId: book.lastChapter, pageIndex: book.lastPageIndex, scrollTop: book.lastScrollTop } as BookProgress
}

/** PDF 阅读进度持久化（缓存即写 + 云端静默跟随） */
export function savePdfProgress(bookId : number, p : PdfProgress) : void {
	const list = loadBooks()
	const i = findCached(bookId, list)
	if (i < 0) {
		return
	}
	list[i].lastPercent = Math.round(p.percent)
	list[i].pdfRatio = p.ratio
	saveBooks(list)
	const fields = {} as UTSJSONObject
	fields['last_percent'] = Math.round(p.percent)
	fields['pdf_ratio'] = p.ratio
	syncQuiet(updateBookProgress(bookId, fields))
}

/** 读取 PDF 阅读进度（来自书籍记录；未读过返回 null） */
export function loadPdfProgress(bookId : number) : PdfProgress | null {
	const book = findBook(bookId)
	if (book == null || (book.lastPercent <= 0 && book.pdfRatio <= 0)) {
		return null
	}
	return { percent: book.lastPercent, ratio: book.pdfRatio } as PdfProgress
}

/** 回写阅读状态到书籍记录（最近阅读时刻 + 章节位置/百分比；书架 meta 与排序依据） */
export function updateBookReading(bookId : number, chapterId : number, percent : number = -1) : void {
	const list = loadBooks()
	const i = findCached(bookId, list)
	if (i < 0) {
		return
	}
	const fields = {} as UTSJSONObject
	if (chapterId >= 0) {
		list[i].lastChapter = chapterId
		fields['last_chapter'] = chapterId
	}
	if (percent >= 0) {
		list[i].lastPercent = percent
		fields['last_percent'] = percent
	}
	list[i].lastReadAt = Date.now()
	saveBooks(list)
	syncQuiet(updateBookProgress(bookId, fields))
}

/** 删除书籍：本地正文与页图缓存清理；deleteCloud 且为云端书籍（id>0）时一并删云端（笔记/书签后端级联）；缓存列表由调用方过滤后 saveBooks */
export function removeBookData(book : LocalBook, deleteCloud : boolean) : void {
	// #ifdef WEB
	if (book.path.length > 0) {
		// IndexedDB 键删除（容错忽略），无 PDF 页图缓存目录
		webFsDelete(book.path)
	}
	if (deleteCloud && book.id > 0) {
		syncQuiet(deleteBook(book.id))
	}
	return
	// #endif
	// #ifndef WEB
	if (book.path.length > 0) {
		try {
			uni.getFileSystemManager().unlinkSync(book.path)
		} catch (e) {
			// 文件可能已被系统清理，忽略
		}
	}
	try {
		uni.getFileSystemManager().rmdirSync(uni.env.USER_DATA_PATH + '/pdf_cache/' + book.id, true)
	} catch (e) {
		// 缓存目录不存在（txt 书）忽略
	}
	if (deleteCloud && book.id > 0) {
		syncQuiet(deleteBook(book.id))
	}
	// #endif
}

/** 本机新增/覆盖一本书的缓存记录（按 id 去重，追加到末尾） */
function upsertLocalBook(book : LocalBook) : void {
	const list = loadBooks()
	const i = findCached(book.id, list)
	if (i >= 0) {
		list.splice(i, 1)
	}
	list.push(book)
	saveBooks(list)
}

/**
 * 导入登记响应落地：解析云端完整书籍记录（同用户同名书复用行时含存量进度与笔记状态）
 * 与本机正文路径合并写入缓存；解析失败返回 null
 */
export function applyRegisteredBook(data : UTSJSONObject, path : string) : LocalBook | null {
	const book = bookFromCloud(data)
	if (book == null) {
		return null
	}
	book.path = path
	upsertLocalBook(book)
	return book
}

// ==================== 离线导入（未登录先存本地，登录后同步云端） ====================

/**
 * 离线导入分配本地书籍 id：同书名复用已有离线行（对齐云端「同用户书名唯一」语义），
 * 否则取现有最小 id 再减一（负数与云端正数 id 天然隔离）。仅计算不落库，正文文件据此命名
 */
export function nextPendingBookId(title : string) : number {
	const list = loadBooks()
	for (let i = 0; i < list.length; i++) {
		if (list[i].id < 0 && list[i].title == title) {
			return list[i].id
		}
	}
	// 同书名已有云端行（本设备无离线行）：复用其 id 合并为一本（置 dirty，登录后回补离线进度与笔记）
	for (let i = 0; i < list.length; i++) {
		if (list[i].id > 0 && list[i].title == title) {
			return list[i].id
		}
	}
	let minId = 0
	for (let i = 0; i < list.length; i++) {
		if (list[i].id < minId) {
			minId = list[i].id
		}
	}
	return minId - 1
}

/** 离线导入落地：元数据仅存本地缓存（登录后由 syncPendingBooks 注册云端），按书名复用离线行 */
export function applyPendingImport(title : string, format : string, size : number, chapterCount : number, hasPreface : boolean, path : string) : void {
	const list = loadBooks()
	for (let i = 0; i < list.length; i++) {
		const book = list[i]
		if (book.id < 0 && book.title == title) {
			book.format = format
			book.size = size
			book.chapterCount = chapterCount
			book.hasPreface = hasPreface
			book.path = path
			saveBooks(list)
			return
		}
		// 同书名云端行（进度为云端/本机缓存现值）：合并为一本——正文指向新导入文件，
		// 置 dirty 待登录回补离线改动（进度保留现值，离线阅读从既有进度继续）
		if (book.id > 0 && book.title == title) {
			book.format = format
			book.size = size
			book.chapterCount = chapterCount
			book.hasPreface = hasPreface
			book.path = path
			book.dirty = true
			saveBooks(list)
			return
		}
	}
	// 新增离线书插到书架最前（对齐云端「新增书置顶」语义：最后添加的第一行第一个）
	list.unshift({
		id: nextPendingBookId(title),
		title: title,
		author: '',
		format: format,
		path: path,
		size: size,
		addedAt: Date.now(),
		lastReadAt: 0,
		lastChapter: -1,
		lastPageIndex: 0,
		lastScrollTop: 0,
		lastPercent: 0,
		pdfRatio: 0,
		chapterCount: chapterCount,
		hasPreface: hasPreface,
		dirty: false
	} as LocalBook)
	saveBooks(list)
}

/** 沙盒文件删除（容错忽略；Web 端为 IndexedDB 键删除） */
function discardSandboxFile(path : string) : void {
	// #ifdef WEB
	webFsDelete(path)
	return
	// #endif
	// #ifndef WEB
	try {
		uni.getFileSystemManager().unlinkSync(path)
	} catch (e) {
		// 忽略
	}
	// #endif
}

/**
 * 沙盒文件按新 id 改名（先拷贝后删源；拷贝失败时源仍有效可整体重试）。
 * 幂等：源存在性前置检查——源已不存在且目标已就位视为上次迁移已完成直接成功，
 * 目标也不存在才报错；检查先于删目标，防止残留记录重跑迁移时误删已改名的正文
 */
async function renameSandboxFile(from : string, to : string) : Promise<void> {
	if (from == to) {
		return
	}
	// #ifdef WEB
	// IndexedDB 键改名（幂等语义在 webFsRename 内对齐：源失+目标在=已完成直接成功）
	await webFsRename(from, to)
	return
	// #endif
	// #ifndef WEB
	const fs = uni.getFileSystemManager()
	try {
		fs.accessSync(from)
	} catch (e) {
		try {
			fs.accessSync(to)
			return
		} catch (e2) {
			throw new Error(t('books.contentMoveFail'))
		}
	}
	try {
		try {
			fs.unlinkSync(to)
		} catch (e) {
			// 目标不存在属正常
		}
		await new Promise<void>((resolve, reject) => {
			fs.copyFile({
				srcPath: from,
				destPath: to,
				success: (_res) => { resolve() },
				fail: (_err) => { reject(new Error(t('books.fileMoveFail'))) }
			})
		})
		discardSandboxFile(from)
	} catch (e) {
		throw new Error(t('books.contentMoveFail'))
	}
	// #endif
}

/** 单本离线书籍迁移：登记响应落地为云端记录（id 迁移 + 离线数据回补）；失败抛出保留待同步态 */
async function migratePendingBook(book : LocalBook, data : UTSJSONObject) : Promise<void> {
	const newId = data.getNumber('id') ?? 0
	if (newId <= 0) {
		throw new Error(t('books.cloudIdInvalid'))
	}
	// 离线期间的划线/想法/书签先回补云端（失败抛出，重试只补失败类）
	await relocateBookNotes(book.id, newId)
	// 暂存会话流水的 book_id 随迁（负数本地 id → 云端正数 id，后续补传按书统计可归位）
	relocatePendingSessions(book.id, newId)
	// 进度合并：本地最近阅读晚于云端才回写（同名书跨设备已有更新进度时以云端为准）
	const cloudReadMs = cnDatetimeToMs(data.getString('last_read_at') ?? '')
	if (book.lastReadAt > cloudReadMs && (book.lastChapter >= 0 || book.lastPercent > 0)) {
		const fields = {} as UTSJSONObject
		if (book.lastChapter >= 0) {
			fields['last_chapter'] = book.lastChapter
			fields['last_page_index'] = book.lastPageIndex
			fields['last_scroll_top'] = book.lastScrollTop
		}
		if (book.lastPercent > 0) {
			fields['last_percent'] = Math.round(book.lastPercent)
			fields['pdf_ratio'] = book.pdfRatio
		}
		await updateBookProgress(newId, fields)
	}
	// 正文文件按云端 id 改名（对侧格式残留一并清理，PDF 页图缓存目录随旧 id 废弃重渲染）
	let newPath = book.path
	if (book.path.length > 0) {
		const slash = book.path.lastIndexOf('/')
		const dirPrefix = slash >= 0 ? book.path.substring(0, slash + 1) : ''
		const dot = book.path.lastIndexOf('.')
		const ext = dot > slash ? book.path.substring(dot + 1) : 'txt'
		newPath = dirPrefix + newId + '.' + ext
		await renameSandboxFile(book.path, newPath)
		discardSandboxFile(dirPrefix + newId + '.' + (ext == 'txt' ? 'pdf' : 'txt'))
		// #ifndef WEB
		try {
			uni.getFileSystemManager().rmdirSync(uni.env.USER_DATA_PATH + '/pdf_cache/' + book.id, true)
		} catch (e) {
			// txt 书或目录不存在忽略
		}
		// #endif
	}
	// 本地记录替换为云端记录（本地进度较新时保留本地值）
	const cloudBook = bookFromCloud(data)
	if (cloudBook == null) {
		throw new Error(t('books.cloudParseFail'))
	}
	cloudBook.path = newPath
	if (book.lastReadAt > cloudReadMs) {
		cloudBook.lastChapter = book.lastChapter
		cloudBook.lastPageIndex = book.lastPageIndex
		cloudBook.lastScrollTop = book.lastScrollTop
		cloudBook.lastPercent = book.lastPercent
		cloudBook.pdfRatio = book.pdfRatio
		cloudBook.lastReadAt = book.lastReadAt
	}
	upsertLocalBook(cloudBook)
	// 移除旧离线记录：upsertLocalBook 按新 id 去重，不清旧负数行；残留会使书架出现双同名书，
	// 且下次同步重跑迁移时把已改名的正文当作源，误删新正文文件
	const stale = loadBooks()
	const si = findCached(book.id, stale)
	if (si >= 0) {
		stale.splice(si, 1)
		saveBooks(stale)
	}
}

/**
 * 登录后同步离线导入书籍（书架进入时经 fetchBooksFromCloud 调用，登录态已确认）：
 * 逐本云端登记（同名复用行）→ id 迁移 → 离线进度/笔记回补；任一本失败仅告警并保留待同步态，
 * 下次书架进入再试（每本独立容错，不阻断其余同步与书架刷新）
 */
async function syncPendingBooks() : Promise<void> {
	const list = loadBooks()
	const pending : LocalBook[] = []
	for (let i = 0; i < list.length; i++) {
		if (list[i].id < 0) {
			pending.push(list[i])
		}
	}
	// 按导入时间升序注册：后端新增书置顶（最小序），后导入的后注册获得更小序，连续导入仍保持「最后添加最前」
	pending.sort((a : LocalBook, b : LocalBook) : number => a.addedAt - b.addedAt)
	for (let i = 0; i < pending.length; i++) {
		const book = pending[i]
		try {
			const res = await registerBook(book.title, book.format, book.size, book.chapterCount, book.hasPreface)
			if (res.code == 0 && res.data != null) {
				await migratePendingBook(book, res.data!)
			}
		} catch (e) {
			console.warn('离线导入书籍同步失败，保留本地待下次再试：' + book.title, e)
		}
	}
}

// ==================== 阅读时长（按日云端统计 + 本地缓存镜像） ====================

/** 阅读时长统计缓存（today/total 分钟数；date 为今日值归属日期，跨天 today 归零） */
type ReadingStatsCache = {
	today: number
	total: number
}

/** 统计缓存日期戳（'YYYY-MM-DD'，客户端本地日期，设备时区按东八区约定） */
function statsTodayKey() : string {
	const d = new Date()
	const p = (n : number) : string => (n < 10 ? '0' + n : '' + n)
	return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate())
}

/** 读取统计缓存（today/total 分钟数；损坏容错归零；date 非当日则 today 归零仅保留 total） */
function loadStats() : ReadingStatsCache {
	const stored : any = uni.getStorageSync(STORAGE_STATS)
	if (typeof stored == 'string' && (stored as string).length > 0) {
		const obj = JSON.parse<UTSJSONObject>(stored as string)
		if (obj != null) {
			const today = obj.getNumber('today') ?? 0
			const total = obj.getNumber('total') ?? 0
			if (obj.getString('date') == statsTodayKey()) {
				return { today: today, total: total }
			}
			return { today: 0, total: total }
		}
	}
	return { today: 0, total: 0 }
}

function saveStats(today : number, total : number) : void {
	const obj = {} as UTSJSONObject
	obj['today'] = today
	obj['total'] = total
	obj['date'] = statsTodayKey()
	uni.setStorageSync(STORAGE_STATS, JSON.stringify(obj))
}

/** 今日已读分钟数（书架统计卡展示；缓存镜像，云端为准由 fetchReadingStatsFromCloud 覆盖） */
export function getTodayMinutes() : number {
	return loadStats().today
}

/** 累计阅读分钟数（福利页展示） */
export function getTotalMinutes() : number {
	return loadStats().total
}

/** 云端阅读统计拉取并覆盖缓存（页面进入时调用；未登录走本地缓存） */
export async function fetchReadingStatsFromCloud() : Promise<void> {
	if (!hasAccessToken()) {
		return
	}
	try {
		const res = await fetchReadingStats()
		if (res.code == 0 && res.data != null) {
			saveStats(res.data!.getNumber('today_minutes') ?? 0, res.data!.getNumber('total_minutes') ?? 0)
		}
	} catch (e) {
		console.warn('云端阅读统计拉取失败', e)
	}
}

/** 累计今日阅读分钟数（由 addReadingSession 统一入口调用）：本地镜像即写 + 云端上报按响应回正（未登录仅记本地） */
function addTodayMinutes(mins : number) : void {
	if (mins <= 0) {
		return
	}
	const cur = loadStats()
	saveStats(cur.today + mins, cur.total + mins)
	if (!hasAccessToken()) {
		return
	}
	reportMinutes(mins).then((res) => {
		// 以服务端累计回正（多端同日累加不重不漏）
		if (res.code == 0 && res.data != null) {
			saveStats(res.data!.getNumber('today_minutes') ?? 0, res.data!.getNumber('total_minutes') ?? 0)
			// 云端时长确认后自动发放已达成的阅读档位奖励（清单由后端返回），全局提示到账
			notifyAutoClaimed(res.data!)
		}
	}, (e) => {
		console.warn('阅读时长上报失败', e)
	})
}

/** 阅读档位自动领取提示：时长上报响应携带本次自动发放清单（tier_minutes/reward，后端已入账）；
结算发生在阅读页 onHide/onUnload，页面级提示不可见，故用全局 toast */
function notifyAutoClaimed(data : UTSJSONObject) : void {
	const arr = data.getArray('claimed')
	if (arr == null || arr.length == 0) {
		return
	}
	let sum = 0
	for (let i = 0; i < arr.length; i++) {
		sum += arr[i].getNumber('reward') ?? 0
	}
	uni.showToast({ title: tf('books.rewardAutoN', [sum.toString()]), icon: 'none' })
}

// ==================== 阅读会话流水（按书/时段明细账；本地暂存 + 登录后补传） ====================

const STORAGE_SESSIONS = 'reading_sessions_pending'
/** 暂存队列上限（长期未登录防无限增长；超出丢最旧） */
const SESSIONS_PENDING_CAP = 500

/** 暂存会话条目（字段名与上报接口对齐；offline=记录时未登录，补传时需聚合时长，在线条目已由分钟上报计入防双计） */
type PendingSession = {
	book_id: number
	source: string
	started_at: string
	ended_at: string
	minutes: number
	offline: boolean
}

/** ms → 'YYYY-MM-DD HH:mm:ss'（客户端本地时刻格式化，与 cnDatetimeToMs 解析口径互逆；设备时区按东八区约定） */
function cnFormatMs(ms: number) : string {
	const d = new Date(ms)
	const p = (n: number) : string => (n < 10 ? '0' + n : '' + n)
	return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds())
}

function loadPendingSessions() : PendingSession[] {
	const stored : any = uni.getStorageSync(STORAGE_SESSIONS)
	if (typeof stored == 'string' && (stored as string).length > 0) {
		const obj = JSON.parse<UTSJSONObject>(stored as string)
		const arr = obj == null ? null : obj.getArray('list')
		const list : PendingSession[] = []
		if (arr != null) {
			for (let i = 0; i < arr.length; i++) {
				const o = arr[i]
				const bookId = o.getNumber('book_id')
				const minutes = o.getNumber('minutes')
				if (bookId == null || minutes == null) {
					continue
				}
				list.push({
					book_id: bookId,
					source: o.getString('source') ?? 'txt',
					started_at: o.getString('started_at') ?? '',
					ended_at: o.getString('ended_at') ?? '',
					minutes: minutes,
					// 旧版条目无该字段：均产生于未登录期（登录态条目即时直传），默认按离线补聚合
					offline: o.getBoolean('offline') ?? true
				} as PendingSession)
			}
		}
		return list
	}
	return []
}

function savePendingSessions(list : PendingSession[]) : void {
	const arr : UTSJSONObject[] = []
	for (let i = 0; i < list.length; i++) {
		const s = list[i]
		const o = {} as UTSJSONObject
		o['book_id'] = s.book_id
		o['source'] = s.source
		o['started_at'] = s.started_at
		o['ended_at'] = s.ended_at
		o['minutes'] = s.minutes
		o['offline'] = s.offline
		arr.push(o)
	}
	const wrap = {} as UTSJSONObject
	wrap['list'] = arr
	uni.setStorageSync(STORAGE_SESSIONS, JSON.stringify(wrap))
}

/** 阅读会话入账（reader/pdfreader 结算统一入口）：时长统计走既有 addTodayMinutes；流水本地暂存 + 在线即传（失败保留待补传） */
export function addReadingSession(bookId : number, source : string, startedMs : number, endedMs : number) : void {
	const mins = Math.floor((endedMs - startedMs) / 60000)
	if (mins <= 0) {
		return
	}
	addTodayMinutes(mins)
	const list = loadPendingSessions()
	list.push({
		book_id: bookId,
		source: source,
		started_at: cnFormatMs(startedMs),
		ended_at: cnFormatMs(endedMs),
		minutes: mins,
		// 未登录记录：登录后补传时需聚合时长（已登录条目时长经 addTodayMinutes→分钟上报计入）
		offline: !hasAccessToken()
	} as PendingSession)
	while (list.length > SESSIONS_PENDING_CAP) {
		list.shift()
	}
	savePendingSessions(list)
	if (hasAccessToken()) {
		flushPendingSessions()
	}
}

/** flush 进行中标记（防结算直传与书架补传并发重传同一条目） */
let sessionsFlushing = false

/**
 * 暂存会话流水只读快照（未登录统计页本地兜底用，plain 对象避免暴露内部类型）
 * 返回元素字段：book_id / started_at（'YYYY-MM-DD HH:mm:ss'）/ minutes
 */
export function exportPendingSessionRows() : UTSJSONObject[] {
	const list = loadPendingSessions()
	const rows : UTSJSONObject[] = []
	for (let i = 0; i < list.length; i++) {
		const s = list[i]
		const o = {} as UTSJSONObject
		o['book_id'] = s.book_id
		o['started_at'] = s.started_at
		o['minutes'] = s.minutes
		rows.push(o)
	}
	return rows
}

/**
 * 暂存会话补传（登录态调用；书架进入时机触发）：
 * 批量上报全部暂存条目——请求成功即清空（含后端跳过的无效条目，重试无意义），
 * 请求失败整体保留下次再试
 */
export async function flushPendingSessions() : Promise<void> {
	if (!hasAccessToken() || sessionsFlushing) {
		return
	}
	const list = loadPendingSessions()
	if (list.length == 0) {
		return
	}
	sessionsFlushing = true
	try {
		const arr : UTSJSONObject[] = []
		for (let i = 0; i < list.length; i++) {
			const s = list[i]
			const o = {} as UTSJSONObject
			o['book_id'] = s.book_id
			o['source'] = s.source
			o['started_at'] = s.started_at
			o['ended_at'] = s.ended_at
			o['minutes'] = s.minutes
			o['aggregate_minutes'] = s.offline
			arr.push(o)
		}
		const res = await reportReadingSessions(arr)
		if (res.code == 0) {
			savePendingSessions([])
		}
	} catch (e) {
		console.warn('会话流水补传失败，保留待下次', e)
	} finally {
		sessionsFlushing = false
	}
}

/** 离线书注册成功后，暂存会话流水的 book_id 随迁（负数本地 id → 云端正数 id） */
function relocatePendingSessions(oldId : number, newId : number) : void {
	const list = loadPendingSessions()
	let changed = false
	for (let i = 0; i < list.length; i++) {
		if (list[i].book_id == oldId) {
			list[i].book_id = newId
			changed = true
		}
	}
	if (changed) {
		savePendingSessions(list)
	}
}

// ==================== 偏好缓存应用（云端 → 本地键） ====================

/**
 * 云端偏好应用到本地缓存（App 启动/页面进入时调用）：
 * bookshelfStyle → bookshelf_style；阅读设置四项 → reader_settings + reader_font。
 * 键名与既有读取方（bookshelf 页 / SettingsPanel / ReaderControl）保持不变，本地读取零改动
 */
export function applyCloudPreferences(prefs : UTSJSONObject | null) : void {
	if (prefs == null) {
		return
	}
	const style = prefs.getString('bookshelfStyle')
	if (style == 'plain' || style == 'photo') {
		uni.setStorageSync('bookshelf_style', style)
	}
	const fontSize = prefs.getNumber('fontSize')
	const pageTurn = prefs.getString('pageTurn')
	const theme = prefs.getString('theme')
	const fontKey = prefs.getString('fontKey')
	if (fontSize != null || pageTurn != null || theme != null || fontKey != null) {
		const cur = loadCachedReaderSettings()
		const next = {} as UTSJSONObject
		next['fontSize'] = fontSize ?? cur['fontSize']
		next['pageTurn'] = pageTurn ?? cur['pageTurn']
		next['theme'] = theme ?? cur['theme']
		next['fontKey'] = fontKey ?? cur['fontKey']
		uni.setStorageSync('reader_settings', JSON.stringify(next))
		if (fontKey != null) {
			uni.setStorageSync('reader_font', fontKey)
		}
	}
}

/** 读取本地 reader_settings 缓存（缺项容错，供合并云端偏好用） */
function loadCachedReaderSettings() : UTSJSONObject {
	const stored : any = uni.getStorageSync('reader_settings')
	if (typeof stored == 'string' && (stored as string).length > 0) {
		const obj = JSON.parse<UTSJSONObject>(stored as string)
		if (obj != null) {
			return obj
		}
	}
	const def = {} as UTSJSONObject
	def['fontSize'] = 18
	def['pageTurn'] = '滚动'
	def['theme'] = 'light'
	def['fontKey'] = 'sourcehan'
	return def
}

// ==================== 旧版本地真源清理（云化一次性） ====================

/**
 * 清理云化前的本地旧书数据（正文文件 + 进度 + 旧笔记/书签/划线 key）。
 * 幂等：旧 key 不存在即空操作；旧时长按日 key 无法枚举，属无害残留
 */
export function cleanupLegacyBooks() : void {
	const stored : any = uni.getStorageSync(LEGACY_BOOKS)
	if (typeof stored != 'string' || (stored as string).length == 0) {
		return
	}
	try {
		const arr = JSON.parse<UTSJSONObject[]>(stored as string)
		if (arr != null) {
			for (let i = 0; i < arr.length; i++) {
				const path = arr[i].getString('path')
				if (path != null && path.length > 0) {
					// #ifndef WEB
					try {
						uni.getFileSystemManager().unlinkSync(path)
					} catch (e) {
						// 文件可能已被系统清理，忽略
					}
					// #endif
				}
				const id = arr[i].getString('id')
				if (id != null && id.length > 0) {
					try {
						uni.removeStorageSync('reader_progress_' + id)
					} catch (e) {
						// 忽略
					}
					try {
						uni.removeStorageSync('pdf_progress_' + id)
					} catch (e) {
						// 忽略
					}
				}
			}
		}
	} catch (e) {
		// 旧数据损坏按已清理处理
	}
	try {
		uni.removeStorageSync(LEGACY_BOOKS)
	} catch (e) {
		// 忽略
	}
	try {
		uni.removeStorageSync(LEGACY_UNDERLINES)
	} catch (e) {
		// 忽略
	}
	try {
		uni.removeStorageSync(LEGACY_THOUGHTS)
	} catch (e) {
		// 忽略
	}
	try {
		uni.removeStorageSync(LEGACY_BOOKMARKS)
	} catch (e) {
		// 忽略
	}
}

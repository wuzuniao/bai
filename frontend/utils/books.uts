// 书籍数据层：云端元数据为准，本地存储仅做缓存（书架/阅读页共享收口）
// 正文文件保存于应用沙盒 uni.env.USER_DATA_PATH/books/ 下不上传云端（path 为本机字段，path='' 表示本设备无正文）；
// 云端按 (用户, 书名) 唯一：重导入同名书复用同一 id，换设备重新导入后进度与笔记按书名自动关联；
// 进度/时长均为「本地即时写缓存 + 云端静默跟随」，页面进入时以云端数据覆盖本地缓存

import {
	fetchBooks,
	registerBook,
	updateBookProgress,
	updateBookOrder,
	deleteBook,
	reportMinutes,
	fetchReadingStats,
	syncQuiet
} from '../api/reading.uts'
import { hasAccessToken } from './request.uts'

/** 书架书籍（书架页展示与排序的唯一数据源；云端字段 + 本机 path 合并结果） */
export type LocalBook = {
	/** 云端书籍 id（导入登记时由后端分配） */
	id: number
	/** 书名（导入时取文件名去扩展名） */
	title: string
	/** 作者署名（本地导入无作者信息，恒为空串；封面深灰卡布局位） */
	author: string
	/** 导入文件格式大写水印（TXT/PDF），封面角落展示 */
	format: string
	/** 正文文件在沙盒中的路径（'' 表示本设备无正文，需重新导入同名文件） */
	path: string
	/** 文件字节数 */
	size: number
	/** 导入时间戳（ms） */
	addedAt: number
	/** 最近阅读时间戳（ms，0=未读） */
	lastReadAt: number
	/** 上次阅读到的章节 id（-1=未读；PDF 书恒为 -1，进度用 lastPercent） */
	lastChapter: number
	/** 章内页码 0-based（txt 恢复定位） */
	lastPageIndex: number
	/** 滚动模式滚动位置 px（txt 恢复定位） */
	lastScrollTop: number
	/** 最近阅读百分比（0-100，仅 PDF 书使用；txt 书恒为 0） */
	lastPercent: number
	/** PDF 首页高/宽比（页面 wrapper 等比布局依据；txt 书为 0） */
	pdfRatio: number
	/** 章节总数（txt=解析章节数，含序章；PDF=页数） */
	chapterCount: number
	/** 第一章前有前置内容并生成序章（导入时固化） */
	hasPreface: boolean
}

/** 阅读进度（txt：章节/页码/滚动位置） */
export type BookProgress = {
	chapterId: number
	/** 章内页码（0-based） */
	pageIndex: number
	/** 滚动模式的滚动位置（px） */
	scrollTop: number
}

/** PDF 阅读进度（滚动位置百分比 + 首页宽高比，用于布局与恢复定位） */
export type PdfProgress = {
	percent: number
	/** 首页高/宽比（页面 wrapper 等比布局依据） */
	ratio: number
}

const STORAGE_BOOKS = 'bookshelf_books_v2'
const STORAGE_STATS = 'reading_stats'
/** 旧版本地真源存储 key（云化后废弃，首次进入书架统一清理） */
const LEGACY_BOOKS = 'bookshelf_books'
const LEGACY_UNDERLINES = 'reader_underlines'
const LEGACY_THOUGHTS = 'reader_thoughts'
const LEGACY_BOOKMARKS = 'reader_bookmarks'

// ==================== 缓存读写 ====================

/** 从宽松 JSON 对象还原 LocalBook（字段缺失/类型不符返回 null） */
function bookFromObject(obj : UTSJSONObject) : LocalBook | null {
	const id = obj.getNumber('id')
	const title = obj.getString('title')
	const format = obj.getString('format')
	if (id == null || title == null || format == null) {
		return null
	}
	return {
		id: id,
		title: title,
		author: obj.getString('author') ?? '',
		format: format,
		path: obj.getString('path') ?? '',
		size: obj.getNumber('size') ?? 0,
		addedAt: obj.getNumber('addedAt') ?? 0,
		lastReadAt: obj.getNumber('lastReadAt') ?? 0,
		lastChapter: obj.getNumber('lastChapter') ?? -1,
		lastPageIndex: obj.getNumber('lastPageIndex') ?? 0,
		lastScrollTop: obj.getNumber('lastScrollTop') ?? 0,
		lastPercent: obj.getNumber('lastPercent') ?? 0,
		pdfRatio: obj.getNumber('pdfRatio') ?? 0,
		chapterCount: obj.getNumber('chapterCount') ?? 0,
		hasPreface: obj.getBoolean('hasPreface') == true
	} as LocalBook
}

/** 读取本地缓存书架列表（顺序即云端手动排序结果） */
export function loadBooks() : LocalBook[] {
	const stored : any = uni.getStorageSync(STORAGE_BOOKS)
	if (typeof stored != 'string' || (stored as string).length == 0) {
		return []
	}
	const result : LocalBook[] = []
	const arr = JSON.parse<UTSJSONObject[]>(stored as string)
	if (arr != null) {
		for (let i = 0; i < arr.length; i++) {
			const book = bookFromObject(arr[i])
			if (book != null) {
				result.push(book)
			}
		}
	}
	return result
}

/** 书架列表缓存写入（仅本地；云端顺序同步走 syncBookOrder） */
export function saveBooks(list : LocalBook[]) : void {
	uni.setStorageSync(STORAGE_BOOKS, JSON.stringify(list))
}

/** 云端手动排序跟随（拖拽落定后调用；静默同步） */
export function syncBookOrder(list : LocalBook[]) : void {
	const items : UTSJSONObject[] = []
	for (let i = 0; i < list.length; i++) {
		const item = {} as UTSJSONObject
		item['id'] = list[i].id
		item['sort_order'] = i
		items.push(item)
	}
	syncQuiet(updateBookOrder(items))
}

/** 缓存内按 id 定位书籍 */
function findCached(bookId : number, list : LocalBook[]) : number {
	for (let i = 0; i < list.length; i++) {
		if (list[i].id == bookId) {
			return i
		}
	}
	return -1
}

/** 按书架顺序查找书籍（缓存未命中返回 null） */
export function findBook(bookId : number) : LocalBook | null {
	const list = loadBooks()
	const i = findCached(bookId, list)
	return i >= 0 ? list[i] : null
}

// ==================== 云端同步（拉取覆盖缓存） ====================

/** 东八区时间串（YYYY-MM-DD HH:mm:ss）→ ms（解析失败返回 0） */
function cnDatetimeToMs(s : string) : number {
	// 固定格式拆分解析（避免 iOS 对 '-' 分隔串的 Date.parse 兼容问题）
	const datePart = s.substring(0, 10).split('-')
	const timePart = s.length > 10 ? s.substring(11, Math.min(s.length, 19)).split(':') : ([] as string[])
	if (datePart.length == 3) {
		const y = parseInt(datePart[0])
		const mo = parseInt(datePart[1])
		const d = parseInt(datePart[2])
		const hh = timePart.length > 0 ? parseInt(timePart[0]) : 0
		const mi = timePart.length > 1 ? parseInt(timePart[1]) : 0
		const ss = timePart.length > 2 ? parseInt(timePart[2]) : 0
		return new Date(y, mo - 1, d, hh, mi, ss).getTime()
	}
	return 0
}

/** 云端书籍对象 → LocalBook（path 留待与本地缓存合并） */
function bookFromCloud(obj : UTSJSONObject) : LocalBook | null {
	const id = obj.getNumber('id')
	const title = obj.getString('title')
	const format = obj.getString('format')
	if (id == null || title == null || format == null) {
		return null
	}
	const lastReadRaw = obj.getString('last_read_at')
	const createdRaw = obj.getString('created_at')
	return {
		id: id,
		title: title,
		author: obj.getString('author') ?? '',
		format: format,
		path: '',
		size: obj.getNumber('size') ?? 0,
		addedAt: createdRaw == null ? 0 : cnDatetimeToMs(createdRaw),
		lastReadAt: lastReadRaw == null ? 0 : cnDatetimeToMs(lastReadRaw),
		lastChapter: obj.getNumber('last_chapter') ?? -1,
		lastPageIndex: obj.getNumber('last_page_index') ?? 0,
		lastScrollTop: obj.getNumber('last_scroll_top') ?? 0,
		lastPercent: obj.getNumber('last_percent') ?? 0,
		pdfRatio: obj.getNumber('pdf_ratio') ?? 0,
		chapterCount: obj.getNumber('chapter_count') ?? 0,
		hasPreface: obj.getBoolean('has_preface') == true
	} as LocalBook
}

/**
 * 云端书架拉取并覆盖缓存（页面进入时调用；云端为准，本机仅回填 path）。
 * 云端失败时静默保留缓存（离线容错），返回当前可用列表
 */
export async function fetchBooksFromCloud() : Promise<LocalBook[]> {
	// 未登录：不发请求，书架展示本地缓存（默认空书架 + 添加格）
	if (!hasAccessToken()) {
		return loadBooks()
	}
	try {
		const res = await fetchBooks()
		if (res.code == 0 && res.data != null) {
			const arr = res.data!.getArray('list')
			const cloud : LocalBook[] = []
			if (arr != null) {
				for (let i = 0; i < arr.length; i++) {
					const b = bookFromCloud(arr[i])
					if (b != null) {
						cloud.push(b)
					}
				}
			}
			// 本机正文文件路径回填（云端无 path 概念）
			const local = loadBooks()
			const merged : LocalBook[] = []
			for (let i = 0; i < cloud.length; i++) {
				const book = cloud[i]
				const li = findCached(book.id, local)
				if (li >= 0) {
					book.path = local[li].path
				}
				merged.push(book)
			}
			saveBooks(merged)
		}
	} catch (e) {
		// 网络失败：保留本地缓存（云端为准的补偿由下次成功拉取完成）
		console.warn('云端书架拉取失败，使用本地缓存', e)
	}
	return loadBooks()
}

// ==================== 阅读进度 ====================

/** txt 阅读进度持久化（缓存即写 + 云端静默跟随；进度字段存书籍记录内） */
export function saveBookProgress(bookId : number, p : BookProgress) : void {
	const list = loadBooks()
	const i = findCached(bookId, list)
	if (i < 0) {
		return
	}
	list[i].lastChapter = p.chapterId
	list[i].lastPageIndex = p.pageIndex
	list[i].lastScrollTop = p.scrollTop
	saveBooks(list)
	const fields = {} as UTSJSONObject
	fields['last_chapter'] = p.chapterId
	fields['last_page_index'] = p.pageIndex
	fields['last_scroll_top'] = p.scrollTop
	syncQuiet(updateBookProgress(bookId, fields))
}

/** 读取 txt 阅读进度（来自书籍记录；未读返回 null） */
export function loadBookProgress(bookId : number) : BookProgress | null {
	const book = findBook(bookId)
	if (book == null || book.lastChapter < 0) {
		return null
	}
	return { chapterId: book.lastChapter, pageIndex: book.lastPageIndex, scrollTop: book.lastScrollTop } as BookProgress
}

/** PDF 阅读进度持久化（缓存即写 + 云端静默跟随） */
export function savePdfProgress(bookId : number, p : PdfProgress) : void {
	const list = loadBooks()
	const i = findCached(bookId, list)
	if (i < 0) {
		return
	}
	list[i].lastPercent = Math.round(p.percent)
	list[i].pdfRatio = p.ratio
	saveBooks(list)
	const fields = {} as UTSJSONObject
	fields['last_percent'] = Math.round(p.percent)
	fields['pdf_ratio'] = p.ratio
	syncQuiet(updateBookProgress(bookId, fields))
}

/** 读取 PDF 阅读进度（来自书籍记录；未读过返回 null） */
export function loadPdfProgress(bookId : number) : PdfProgress | null {
	const book = findBook(bookId)
	if (book == null || (book.lastPercent <= 0 && book.pdfRatio <= 0)) {
		return null
	}
	return { percent: book.lastPercent, ratio: book.pdfRatio } as PdfProgress
}

/** 回写阅读状态到书籍记录（最近阅读时刻 + 章节位置/百分比；书架 meta 与排序依据） */
export function updateBookReading(bookId : number, chapterId : number, percent : number = -1) : void {
	const list = loadBooks()
	const i = findCached(bookId, list)
	if (i < 0) {
		return
	}
	const fields = {} as UTSJSONObject
	if (chapterId >= 0) {
		list[i].lastChapter = chapterId
		fields['last_chapter'] = chapterId
	}
	if (percent >= 0) {
		list[i].lastPercent = percent
		fields['last_percent'] = percent
	}
	list[i].lastReadAt = Date.now()
	saveBooks(list)
	syncQuiet(updateBookProgress(bookId, fields))
}

/** 删除书籍：本地正文与页图缓存清理 + 云端删除（笔记/书签后端级联）；缓存列表由调用方过滤后 saveBooks */
export function removeBookData(book : LocalBook) : void {
	if (book.path.length > 0) {
		try {
			uni.getFileSystemManager().unlinkSync(book.path)
		} catch (e) {
			// 文件可能已被系统清理，忽略
		}
	}
	try {
		uni.getFileSystemManager().rmdirSync(uni.env.USER_DATA_PATH + '/pdf_cache/' + book.id, true)
	} catch (e) {
		// 缓存目录不存在（txt 书）忽略
	}
	syncQuiet(deleteBook(book.id))
}

/** 本机新增/覆盖一本书的缓存记录（按 id 去重，追加到末尾） */
function upsertLocalBook(book : LocalBook) : void {
	const list = loadBooks()
	const i = findCached(book.id, list)
	if (i >= 0) {
		list.splice(i, 1)
	}
	list.push(book)
	saveBooks(list)
}

/**
 * 导入登记响应落地：解析云端完整书籍记录（同用户同名书复用行时含存量进度与笔记状态）
 * 与本机正文路径合并写入缓存；解析失败返回 null
 */
export function applyRegisteredBook(data : UTSJSONObject, path : string) : LocalBook | null {
	const book = bookFromCloud(data)
	if (book == null) {
		return null
	}
	book.path = path
	upsertLocalBook(book)
	return book
}

// ==================== 阅读时长（按日云端统计 + 本地缓存镜像） ====================

/** 阅读时长统计缓存（today/total 分钟数） */
type ReadingStatsCache = {
	today: number
	total: number
}

/** 读取统计缓存（today/total 分钟数；损坏容错归零） */
function loadStats() : ReadingStatsCache {
	const stored : any = uni.getStorageSync(STORAGE_STATS)
	if (typeof stored == 'string' && (stored as string).length > 0) {
		const obj = JSON.parse<UTSJSONObject>(stored as string)
		if (obj != null) {
			return { today: obj.getNumber('today') ?? 0, total: obj.getNumber('total') ?? 0 }
		}
	}
	return { today: 0, total: 0 }
}

function saveStats(today : number, total : number) : void {
	const obj = {} as UTSJSONObject
	obj['today'] = today
	obj['total'] = total
	uni.setStorageSync(STORAGE_STATS, JSON.stringify(obj))
}

/** 今日已读分钟数（书架统计卡展示；缓存镜像，云端为准由 fetchReadingStatsFromCloud 覆盖） */
export function getTodayMinutes() : number {
	return loadStats().today
}

/** 累计阅读分钟数（福利页展示） */
export function getTotalMinutes() : number {
	return loadStats().total
}

/** 云端阅读统计拉取并覆盖缓存（页面进入时调用；未登录走本地缓存） */
export async function fetchReadingStatsFromCloud() : Promise<void> {
	if (!hasAccessToken()) {
		return
	}
	try {
		const res = await fetchReadingStats()
		if (res.code == 0 && res.data != null) {
			saveStats(res.data!.getNumber('today_minutes') ?? 0, res.data!.getNumber('total_minutes') ?? 0)
		}
	} catch (e) {
		console.warn('云端阅读统计拉取失败', e)
	}
}

/** 累计今日阅读分钟数（阅读页 onHide/onUnload 结算）：本地镜像即写 + 云端上报按响应回正（未登录仅记本地） */
export function addTodayMinutes(mins : number) : void {
	if (mins <= 0) {
		return
	}
	const cur = loadStats()
	saveStats(cur.today + mins, cur.total + mins)
	if (!hasAccessToken()) {
		return
	}
	reportMinutes(mins).then((res) => {
		// 以服务端累计回正（多端同日累加不重不漏）
		if (res.code == 0 && res.data != null) {
			saveStats(res.data!.getNumber('today_minutes') ?? 0, res.data!.getNumber('total_minutes') ?? 0)
		}
	}, (e) => {
		console.warn('阅读时长上报失败', e)
	})
}

// ==================== 偏好缓存应用（云端 → 本地键） ====================

/**
 * 云端偏好应用到本地缓存（App 启动/页面进入时调用）：
 * bookshelfStyle → bookshelf_style；阅读设置四项 → reader_settings + reader_font。
 * 键名与既有读取方（bookshelf 页 / SettingsPanel / ReaderControl）保持不变，本地读取零改动
 */
export function applyCloudPreferences(prefs : UTSJSONObject | null) : void {
	if (prefs == null) {
		return
	}
	const style = prefs.getString('bookshelfStyle')
	if (style == 'plain' || style == 'photo') {
		uni.setStorageSync('bookshelf_style', style)
	}
	const fontSize = prefs.getNumber('fontSize')
	const pageTurn = prefs.getString('pageTurn')
	const theme = prefs.getString('theme')
	const fontKey = prefs.getString('fontKey')
	if (fontSize != null || pageTurn != null || theme != null || fontKey != null) {
		const cur = loadCachedReaderSettings()
		const next = {} as UTSJSONObject
		next['fontSize'] = fontSize ?? cur['fontSize']
		next['pageTurn'] = pageTurn ?? cur['pageTurn']
		next['theme'] = theme ?? cur['theme']
		next['fontKey'] = fontKey ?? cur['fontKey']
		uni.setStorageSync('reader_settings', JSON.stringify(next))
		if (fontKey != null) {
			uni.setStorageSync('reader_font', fontKey)
		}
	}
}

/** 读取本地 reader_settings 缓存（缺项容错，供合并云端偏好用） */
function loadCachedReaderSettings() : UTSJSONObject {
	const stored : any = uni.getStorageSync('reader_settings')
	if (typeof stored == 'string' && (stored as string).length > 0) {
		const obj = JSON.parse<UTSJSONObject>(stored as string)
		if (obj != null) {
			return obj
		}
	}
	const def = {} as UTSJSONObject
	def['fontSize'] = 18
	def['pageTurn'] = '滚动'
	def['theme'] = 'light'
	def['fontKey'] = 'sourcehan'
	return def
}

// ==================== 旧版本地真源清理（云化一次性） ====================

/**
 * 清理云化前的本地旧书数据（正文文件 + 进度 + 旧笔记/书签/划线 key）。
 * 幂等：旧 key 不存在即空操作；旧时长按日 key 无法枚举，属无害残留
 */
export function cleanupLegacyBooks() : void {
	const stored : any = uni.getStorageSync(LEGACY_BOOKS)
	if (typeof stored != 'string' || (stored as string).length == 0) {
		return
	}
	try {
		const arr = JSON.parse<UTSJSONObject[]>(stored as string)
		if (arr != null) {
			for (let i = 0; i < arr.length; i++) {
				const path = arr[i].getString('path')
				if (path != null && path.length > 0) {
					try {
						uni.getFileSystemManager().unlinkSync(path)
					} catch (e) {
						// 文件可能已被系统清理，忽略
					}
				}
				const id = arr[i].getString('id')
				if (id != null && id.length > 0) {
					try {
						uni.removeStorageSync('reader_progress_' + id)
					} catch (e) {
						// 忽略
					}
					try {
						uni.removeStorageSync('pdf_progress_' + id)
					} catch (e) {
						// 忽略
					}
				}
			}
		}
	} catch (e) {
		// 旧数据损坏按已清理处理
	}
	try {
		uni.removeStorageSync(LEGACY_BOOKS)
	} catch (e) {
		// 忽略
	}
	try {
		uni.removeStorageSync(LEGACY_UNDERLINES)
	} catch (e) {
		// 忽略
	}
	try {
		uni.removeStorageSync(LEGACY_THOUGHTS)
	} catch (e) {
		// 忽略
	}
	try {
		uni.removeStorageSync(LEGACY_BOOKMARKS)
	} catch (e) {
		// 忽略
	}
}

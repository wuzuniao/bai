/**
 * 活动奖励共享配置与工具（活动页 reward.uvue / 书架统计卡 bookshelf.uvue 共用）
 * --------------------------------------------------------------------------
 * - 档位数额与后端 services/reward_service.py 的 READING_TIERS 同步维护
 *   （后端为发放真源，本配置仅驱动展示；数值变更须两处同步）
 * - 状态取值与后端一致：locked=未达成 / claimable=已达成未领 / claimed=已领取
 * - title 字段存 i18n key（渲染层经 t() 取词，随语言切换刷新）
 */
import { t } from './i18n'
// 词典注册（档位标题/时长单位文案）
import './locales/rewards.uts'
// 共享类型抽离到 rewards.ts：UTS 编译器对 type-only 导入会改写为 *.ts 路径（HBuilderX 5.33），
// 类型留在 .uts 会报“未导出”。本文件导入供内部使用并再导出给调用方。
import type { RewardTier } from './rewardsDefs.ts'

export const REWARD_TIERS: RewardTier[] = [
	{ minutes: 5, badge: "5'", title: 'rewards.tierTitle5', base: 1, bonus: 0 } as RewardTier,
	{ minutes: 30, badge: "30'", title: 'rewards.tierTitle30', base: 6, bonus: 0 } as RewardTier,
	{ minutes: 120, badge: '2h', title: 'rewards.tierTitle120', base: 24, bonus: 10 } as RewardTier,
	{ minutes: 360, badge: '6h', title: 'rewards.tierTitle360', base: 72, bonus: 30 } as RewardTier,
	{ minutes: 720, badge: '12h', title: 'rewards.tierTitle720', base: 144, bonus: 60 } as RewardTier,
]

/** 档位领取总额（基础 + 额外赠送） */
export function tierTotalReward(base: number, bonus: number) : number {
	return base + bonus
}

/**
 * 剩余分钟数 → 文案（与活动页档位卡「还差 X 解锁」口径一致）
 * 分钟单位不计小数：先向上取整并显式转 Int（Math.ceil 返回 number，直接拼接会得到 5.0），
 * 不足 1 分钟按 1 分钟提示；<60 → "X 分钟"；≥60 → "X 小时" / "X 小时 Y 分钟"
 */
export function fmtRemainMinutes(mins: number) : string {
	const total = Math.max(0, Math.ceil(mins))
	const h = Math.floor(total / 60).toInt()
	const r = (total % 60).toInt()
	if (h > 0 && r > 0) {
		return h + ' ' + t('rewards.hour') + ' ' + r + ' ' + t('rewards.minute')
	}
	if (h > 0) {
		return h + ' ' + t('rewards.hour')
	}
	return r + ' ' + t('rewards.minute')
}

/**
 * 分钟数 → 分钟整数文本（分钟单位不计小数）
 * 用于「今日已读 / 总阅读时长」等直接展示分钟数值的位置；向下取整（已读不夸大），
 * 与 fmtRemainMinutes 的剩余时长向上取整口径区分
 */
export function fmtMinuteCount(mins: number) : string {
	return Math.floor(mins).toInt().toString()
}

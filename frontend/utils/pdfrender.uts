// PDF 逐页渲染（App 端）：原计划 Android 用 android.graphics.pdf.PdfRenderer 把各页渲染为
// 等比 JPEG 存沙盒缓存（API 21+，无第三方依赖，无需自定义基座）。
// 现状：关闭蒸汽模式（项目规范 3.4）后原生引擎可用，但 vdom codegen 对
// Bitmap.createBitmap 重载的解析存在缺陷（createBitmap(Int, Int) 实参正确仍报无候选），
// 暂以「当前端暂不支持」降级；原生实现见 git 历史（stores 迁移前的 utils/pdfrender.uts），
// 待 HBuilderX 修复 codegen 或改用 UTS 插件封装后恢复。
import type { PdfSession } from './pdfrenderDefs.ts'
import { t } from './i18n'
// 词典注册（PDF 渲染层文案）
import './locales/pdfrender.uts'

/** 打开 PDF 渲染会话（Android 端 codegen 缺陷期间统一 reject） */
export function openPdfSession(path : string) : Promise<PdfSession> {
	return new Promise<PdfSession>((_resolve, reject) => {
		reject(new Error(t('pdfrender.platformUnsupported')))
	})
}

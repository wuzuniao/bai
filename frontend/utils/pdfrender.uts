// PDF 逐页渲染（App 端）：把 PDF 各页渲染为等比 JPEG 存沙盒缓存，供阅读页逐页展示
// Android 用系统 android.graphics.pdf.PdfRenderer（API 21+，无第三方依赖，无需自定义基座）；
// iOS 端待真机环境按 PDFKit（PDFDocument + PDFPage.thumbnail）补齐，当前提示不支持。
// 渲染由阅读页在主线程逐页调度（单页数十毫秒，间歇让出保持交互），不依赖跨线程分发。

// 共享类型抽离到 pdfrender.ts：UTS 编译器对 type-only 导入会改写为 *.ts 路径（HBuilderX 5.33），
// 类型留在 .uts 会报“未导出”。本文件导入供内部使用并再导出给调用方。
import type { PdfPageDim, PdfSession } from './pdfrenderDefs.ts'

import { t } from './i18n'
// 词典注册（PDF 渲染层文案）
import './locales/pdfrender.uts'
// #ifdef APP-ANDROID
import PdfRenderer from "android.graphics.pdf.PdfRenderer"
import ParcelFileDescriptor from "android.os.ParcelFileDescriptor"
import Bitmap from "android.graphics.Bitmap"
import CompressFormat from "android.graphics.Bitmap$CompressFormat"
import File from "java.io.File"
import FileOutputStream from "java.io.FileOutputStream"
// #endif

/** 打开 PDF 渲染会话（不支持的平台 reject） */
export function openPdfSession(path : string) : Promise<PdfSession> {
	// #ifdef APP-ANDROID
	return new Promise<PdfSession>((resolve, reject) => {
		try {
			const fd = ParcelFileDescriptor.open(new File(path), ParcelFileDescriptor.MODE_READ_ONLY)
			const renderer = new PdfRenderer(fd)
			resolve({
				pageCount: renderer.pageCount,
				renderPage: (index : number, outPath : string, targetWidth : number) : Promise<void> => {
					return new Promise<void>((resolve2, reject2) => {
						try {
							const page = renderer.openPage(index)
							// 目标高按页比例等比（width/height 为 PDF point 值）
							const targetH = Math.max(1, Math.round(targetWidth * page.height / page.width))
							const bmp = Bitmap.createBitmap(targetWidth, targetH)
							// mode 0 = RENDER_MODE_FOR_DISPLAY
							page.render(bmp, null, null, 0)
							const fos = new FileOutputStream(new File(outPath))
							bmp.compress(CompressFormat.JPEG, 85, fos)
							fos.close()
							bmp.recycle()
							page.close()
							resolve2()
						} catch (e) {
							reject2(new Error(t('pdfrender.pageRenderFail')))
						}
					})
				},
				pageSize: (index : number) : Promise<PdfPageDim> => {
					return new Promise<PdfPageDim>((resolve2, reject2) => {
						try {
							const page = renderer.openPage(index)
							const dim = { w: page.width, h: page.height } as PdfPageDim
							page.close()
							resolve2(dim)
						} catch (e) {
							reject2(new Error(t('pdfrender.pageInfoFail')))
						}
					})
				},
				close: () : void => {
					try { renderer.close() } catch (e) { /* 忽略 */ }
					try { fd.close() } catch (e) { /* 忽略 */ }
				}
			} as PdfSession)
		} catch (e) {
			reject(new Error(t('pdfrender.openFail')))
		}
	})
	// #endif
	// #ifndef APP-ANDROID
	return new Promise<PdfSession>((_resolve, reject) => {
		reject(new Error(t('pdfrender.platformUnsupported')))
	})
	// #endif
}

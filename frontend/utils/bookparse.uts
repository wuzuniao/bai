// 书籍导入管线：文件编码识别 → 章节解析 → 沙盒落盘入库
// 端差异收口：文件选择由调用方（书架页）按端条件编译完成，本文件只处理已选中的本地文件

import { applyRegisteredBook, nextPendingBookId, applyPendingImport } from './books'
import { registerBook } from '../api/reading.uts'
import { hasAccessToken } from './request.uts'
// #ifdef MP-WEIXIN
import { decodeGbkBytes } from './gbk'
// #endif
// #ifdef APP
import { openPdfSession } from './pdfrender'
// #endif
// #ifdef APP-ANDROID
import Charset from 'java.nio.charset.Charset'
// #endif

/** 解析后的章（目录标题 + 正文页眉/大标题拆分 + 该章段落） */
export type ParsedChapter = {
	/** 目录标题（完整标题行） */
	title: string
	/** 正文页章节标签（如：第 12 章；无编号章为整行标题） */
	label: string
	/** 正文页大标题（编号后标题部分） */
	contentTitle: string
	/** 章内段落（非空行） */
	paragraphs: string[]
	/** 序章标记（第一章前的前置内容生成；打开时仅对导入时标记 hasPreface 的书保留，保证旧书章 id 与存量进度对齐） */
	preface: boolean
}

/** 标题行拆分结果（raw=原始行，label=编号前缀，contentTitle=编号后标题） */
type ParsedTitleParts = {
	raw : string
	label : string
	contentTitle : string
}

/** 分块读取块大小（字节）：大文件分块读规避整读的内存峰值（uni-app x 官方建议单次读取不超过 16M） */
const READ_CHUNK_BYTES = 1024 * 1024

/** 采样检测字符串中是否存在 UTF-8 解码替换符（出现即视为非 UTF-8 编码，大概率 GBK） */
function looksMisencoded(text : string) : boolean {
	const sampleLen = text.length < 20000 ? text.length : 20000
	let bad = 0
	for (let i = 0; i < sampleLen; i++) {
		if (text.charCodeAt(i) == 0xFFFD) {
			bad++
			if (bad > 5) {
				return true
			}
		}
	}
	return false
}

// #ifdef MP-WEIXIN
/**
 * latin1 解码的块尾探测串中，被切断多字节字符占用的字节数（0..3）：
 * latin1 每字节映射为一字符，charCodeAt 即原始字节值；utf-8 续字节为 10xxxxxx，
 * 从块尾向前找字符首字节并按其高位判定字符总长，总长超过块内实际占用即被切断
 */
function incompleteTailBytes(tail : string) : number {
	for (let i = tail.length - 1; i >= 0; i--) {
		const b = tail.charCodeAt(i)
		if ((b & 0xC0) != 0x80) {
			const charLen = b >= 0xF0 ? 4 : (b >= 0xE0 ? 3 : (b >= 0xC0 ? 2 : 1))
			const used = tail.length - i
			return charLen > used ? used : 0
		}
	}
	return tail.length
}

/** 微信端分块读取 GBK 文本：latin1 逐块读字节（每字符=一字节），GBK 双字节跨块时块尾截 1 字节配对，块内码表解码 */
function readGbkChunkedMp(path : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		const fs = uni.getFileSystemManager()
		let size = 0
		try {
			size = fs.statSync(path).size
		} catch (e) {
			reject(new Error('文件读取失败'))
			return
		}
		if (size == 0) {
			resolve('')
			return
		}
		let pos = 0
		const parts : string[] = []
		while (pos < size) {
			let len = Math.min(READ_CHUNK_BYTES, size - pos)
			// 非末块：块尾字节是 GBK 双字节首字节（0x81-0xFE）时截 1 字节到下一块配对解码
			if (pos + len < size) {
				try {
					const tail = fs.readFileSync(path, 'latin1', pos + len - 1, 1) as string
					const b = tail.charCodeAt(0)
					if (b >= 0x81 && b <= 0xFE) {
						len -= 1
					}
				} catch (e) {
					// 探测失败按原边界读取
				}
			}
			if (len <= 0) {
				reject(new Error('文件读取失败'))
				return
			}
			try {
				const chunk = fs.readFileSync(path, 'latin1', pos, len)
				if (typeof chunk != 'string') {
					reject(new Error('文件读取失败'))
					return
				}
				parts.push(decodeGbkBytes(chunk as string))
			} catch (e) {
				reject(new Error('文件读取失败'))
				return
			}
			pos += len
		}
		resolve(parts.join(''))
	})
}

/** 微信端分块读取 utf-8 文本（每块 1MB，块边界做字符对齐；末块后拼接结果，GBK 检测交由调用方） */
function readTextFileChunkedMp(path : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		const fs = uni.getFileSystemManager()
		let size = 0
		try {
			size = fs.statSync(path).size
		} catch (e) {
			reject(new Error('文件读取失败'))
			return
		}
		if (size == 0) {
			resolve('')
			return
		}
		let pos = 0
		let text = ''
		while (pos < size) {
			let len = Math.min(READ_CHUNK_BYTES, size - pos)
			// 非末块：探测块尾 4 字节（utf-8 字符最长 4 字节，窗口内必含字符首字节），
			// 截去被切断字符的前缀字节，下一块从该字符首字节重读，保证字符完整解码
			if (pos + len < size) {
				try {
					const tail = fs.readFileSync(path, 'latin1', pos + len - 4, 4) as string
					len -= incompleteTailBytes(tail)
					if (len <= 0) {
						reject(new Error('文件读取失败'))
						return
					}
				} catch (e) {
					// 探测失败按原边界读取（最多损失块尾一个字符）
				}
			}
			try {
				const chunk = fs.readFileSync(path, 'utf-8', pos, len)
				if (typeof chunk != 'string') {
					reject(new Error('文件读取失败'))
					return
				}
				text = text + (chunk as string)
			} catch (e) {
				reject(new Error('文件读取失败'))
				return
			}
			pos += len
		}
		resolve(text)
	})
}
// #endif

// #ifdef APP-ANDROID
/**
 * 块尾对齐：返回本块可安全解码的字节数（GBK 双字节跨块截 1；utf-8 截去被切断字符的前缀字节）
 * 仅在非末块调用，u8 为本块实际读取内容的字节视图
 */
function alignedTailLen(u8 : Uint8Array, len : number, isGbk : boolean) : number {
	if (isGbk) {
		const b = u8[len - 1]
		return b >= 0x81 && b <= 0xFE ? len - 1 : len
	}
	for (let i = len - 1; i >= 0 && i >= len - 4; i--) {
		const b = u8[i]
		if ((b & 0xC0) != 0x80) {
			const charLen = b >= 0xF0 ? 4 : (b >= 0xE0 ? 3 : (b >= 0xC0 ? 2 : 1))
			const used = len - i
			return charLen > used ? len - used : len
		}
	}
	return len
}

/**
 * Android 端分块读取文本：fd（openSync/readSync/closeSync）分块读 ArrayBuffer，
 * 逐块用 java.nio Charset 解码（UTF-8 与 GBK 同一函数不同字符集名；块边界字符对齐后无切断）
 */
function readChunkedApp(path : string, charsetName : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		const fs = uni.getFileSystemManager()
		let fd = 0
		let size = 0
		try {
			fd = fs.openSync(path, 'r')
			size = fs.statSync(path).size
		} catch (e) {
			if (fd > 0) {
				try {
					fs.closeSync(fd)
				} catch (e2) {
					// 忽略
				}
			}
			reject(new Error('文件读取失败'))
			return
		}
		const closeQuiet = () : void => {
			try {
				fs.closeSync(fd)
			} catch (e) {
				// 忽略
			}
		}
		if (size == 0) {
			closeQuiet()
			resolve('')
			return
		}
		const charset = Charset.forName(charsetName)
		const isGbk = charsetName == 'GBK'
		let pos = 0
		const sb = new StringBuilder()
		while (pos < size) {
			let len = Math.min(READ_CHUNK_BYTES, size - pos)
			const ab = new ArrayBuffer(len)
			let readLen = 0
			try {
				readLen = fs.readSync(ab, fd, pos, 0, len)
			} catch (e) {
				closeQuiet()
				reject(new Error('文件读取失败'))
				return
			}
			if (readLen <= 0) {
				break
			}
			// 非末块：块边界字符对齐，被切断字符整字节留给下一块
			let adjusted = readLen
			if (pos + readLen < size) {
				adjusted = alignedTailLen(new Uint8Array(ab), readLen, isGbk)
			}
			try {
				const bb = ab.toByteBuffer()
				bb.rewind()
				bb.limit(adjusted)
				sb.append(charset.decode(bb).toString())
			} catch (e) {
				closeQuiet()
				reject(new Error('文件读取失败'))
				return
			}
			pos += adjusted
		}
		closeQuiet()
		resolve(sb.toString())
	})
}
// #endif

/** 读取文本文件并自动识别编码（utf-8 优先，含替换符时按 GBK 重读；微信/Android 分块读规避大文件整读内存峰值） */
export function readTextFile(path : string) : Promise<string> {
	// #ifdef MP-WEIXIN
	return new Promise<string>((resolve, reject) => {
		readTextFileChunkedMp(path).then((text : string) => {
			if (!looksMisencoded(text)) {
				resolve(text)
				return
			}
			// 非 UTF-8（大概率 GBK）：微信端无系统级 GBK 解码，latin1 分块读字节后按码表解码
			readGbkChunkedMp(path).then((gbkText : string) => {
				resolve(gbkText)
			}, (_e : Error | null) => {
				reject(new Error('文件读取失败'))
			})
		}, (e : Error | null) => {
			reject(e != null ? e : new Error('文件读取失败'))
		})
	})
	// #endif
	// #ifdef APP-ANDROID
	return new Promise<string>((resolve, reject) => {
		readChunkedApp(path, 'UTF-8').then((text : string) => {
			if (!looksMisencoded(text)) {
				resolve(text)
				return
			}
			// 非 UTF-8（大概率 GBK）：java.nio GBK 分块解码
			readChunkedApp(path, 'GBK').then((gbkText : string) => {
				resolve(gbkText)
			}, (_e : Error | null) => {
				reject(new Error('文件读取失败'))
			})
		}, (e : Error | null) => {
			reject(e != null ? e : new Error('文件读取失败'))
		})
	})
	// #endif
	// #ifdef APP-IOS
	return new Promise<string>((resolve, reject) => {
		let text = ''
		try {
			const raw = uni.getFileSystemManager().readFileSync(path, 'utf-8')
			text = raw as string
		} catch (e) {
			reject(new Error('文件读取失败'))
			return
		}
		if (!looksMisencoded(text)) {
			resolve(text)
			return
		}
		reject(new Error('该文件编码暂不支持'))
	})
	// #endif
	// #ifndef MP-WEIXIN || APP
	return new Promise<string>((_resolve, reject) => {
		reject(new Error('该文件编码暂不支持'))
	})
	// #endif
}

/** 编号章前缀（第X章/回/节/卷/部/篇/集幕；Chapter n） */
const RE_NUMBERED = /^第[0-9一二三四五六七八九十百千万零〇两]+\s*[章回节卷部篇集幕]/
const RE_CHAPTER_EN = /^(Chapter|CHAPTER)\s*\d+/
/** 常见特殊章（序章/楔子等，仅短行视为标题避免误判正文） */
const RE_SPECIAL = /^(序章|楔子|引子|前言|序言|尾声|终章|后记|番外|外传|附录)/

/** 章节标题行判定 */
function isChapterLine(t : string) : boolean {
	if (t.length > 50) {
		return false
	}
	if (RE_NUMBERED.test(t)) {
		return true
	}
	if (RE_CHAPTER_EN.test(t)) {
		return true
	}
	return RE_SPECIAL.test(t) && t.length <= 30
}

/** 从标题行拆分章节标签与大标题（无编号章标签=整行） */
function splitChapterTitle(t : string) : ParsedTitleParts {
	const m = RE_NUMBERED.exec(t)
	if (m != null) {
		const label = m[0]
		const rest = t.substring(label.length).trim().replace(/^[\s．.、:：\-—～~]+/, '').trim()
		return { raw: t, label: label, contentTitle: rest.length > 0 ? rest : label } as ParsedTitleParts
	}
	const mc = RE_CHAPTER_EN.exec(t)
	if (mc != null) {
		const label2 = mc[0]
		const rest2 = t.substring(label2.length).trim().replace(/^[\s．.、:：\-—～~]+/, '').trim()
		return { raw: t, label: label2, contentTitle: rest2.length > 0 ? rest2 : label2 } as ParsedTitleParts
	}
	return { raw: t, label: t, contentTitle: t } as ParsedTitleParts
}

/** 从纯文本解析章节：标题行扫为候选起点，候选间无正文的连续标题（目录块）自动剔除 */
export function parseChapters(text : string, bookTitle : string) : ParsedChapter[] {
	const normalized = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n')
	const lines = normalized.split('\n')
	// 候选章节起点（行索引 + 标题拆分）
	const startIdx : number[] = []
	const starts : ParsedTitleParts[] = []
	for (let i = 0; i < lines.length; i++) {
		const t = lines[i].trim()
		if (t.length == 0 || !isChapterLine(t)) {
			continue
		}
		startIdx.push(i)
		starts.push(splitChapterTitle(t))
	}
	const result : ParsedChapter[] = []
	if (startIdx.length == 0) {
		// 无章节标题：全书单章
		result.push({ title: bookTitle, label: '', contentTitle: bookTitle, preface: false, paragraphs: collectParagraphs(lines, 0, lines.length) } as ParsedChapter)
		return result
	}
	for (let k = 0; k < startIdx.length; k++) {
		const from = startIdx[k] + 1
		const to = k < startIdx.length - 1 ? startIdx[k + 1] : lines.length
		// 章起点与下一章起点之间无正文 → 目录块标题行：剔除（不生成章，标题行丢弃）
		let hasBody = false
		for (let i = from; i < to; i++) {
			if (lines[i].trim().length > 0) {
				hasBody = true
				break
			}
		}
		if (!hasBody) {
			continue
		}
		result.push({ title: starts[k].raw, label: starts[k].label, contentTitle: starts[k].contentTitle, preface: false, paragraphs: collectParagraphs(lines, from, to) } as ParsedChapter)
	}
	if (result.length == 0) {
		// 全部候选均为目录块：按单章兜底
		result.push({ title: bookTitle, label: '', contentTitle: bookTitle, preface: false, paragraphs: collectParagraphs(lines, 0, lines.length) } as ParsedChapter)
		return result
	}
	// 第一章前的前置内容（书名/作者/简介等）：生成「序」章置于第一章前，进入书籍默认从文件最开始阅读
	if (startIdx[0] > 0) {
		const prefaceParas = collectParagraphs(lines, 0, startIdx[0])
		if (prefaceParas.length > 0) {
			result.unshift({ title: '序', label: '序', contentTitle: '序', preface: true, paragraphs: prefaceParas } as ParsedChapter)
		}
	}
	return result
}

/** 收集 [from, to) 行区间内的非空行（trim 后） */
function collectParagraphs(lines : string[], from : number, to : number) : string[] {
	const paras : string[] = []
	for (let i = from; i < to && i < lines.length; i++) {
		const t = lines[i].trim()
		if (t.length > 0) {
			paras.push(t)
		}
	}
	return paras
}

/** 确保沙盒书籍目录存在（mkdir 的「已存在」错误码各端不一致不可靠，失败后以 access 复验目录实际可达为准） */
function ensureBooksDir(dir : string) : Promise<void> {
	return new Promise<void>((resolve, reject) => {
		uni.getFileSystemManager().mkdir({
			dirPath: dir,
			recursive: true,
			success: (_res) => { resolve() },
			fail: (_err) => {
				try {
					uni.getFileSystemManager().accessSync(dir)
					resolve()
				} catch (e) {
					reject(new Error('本地目录创建失败'))
				}
			}
		})
	})
}

/** 复制选中的文件到沙盒（临时路径会被系统回收，必须先落盘；目标已存在时先删除，支持同名书覆盖导入） */
function copyToSandbox(srcPath : string, destPath : string) : Promise<void> {
	return new Promise<void>((resolve, reject) => {
		try {
			// 同名书重导入时目标正文已存在，部分端 copyFile 对已存在目标直接失败，先删后拷
			uni.getFileSystemManager().unlinkSync(destPath)
		} catch (e) {
			// 目标不存在属正常
		}
		uni.getFileSystemManager().copyFile({
			srcPath: srcPath,
			destPath: destPath,
			success: (_res) => { resolve() },
			fail: (_err) => { reject(new Error('文件保存失败')) }
		})
	})
}

/** 从文件名提取书名（去扩展名，去首尾空白） */
function titleFromFileName(fileName : string) : string {
	const dot = fileName.lastIndexOf('.')
	const base = dot > 0 ? fileName.substring(0, dot) : fileName
	const title = base.trim()
	return title.length > 0 ? title : '未命名书籍'
}

/** 清理导入中途落盘的文件（失败路径回收） */
function discardFile(path : string) : void {
	try {
		uni.getFileSystemManager().unlinkSync(path)
	} catch (e) {
		// 忽略
	}
}

/** 导入一本书：复制落盘解析 → 登录态云端登记（后端分配 id，同名书复用）/ 未登录本地负数 id 落地（登录后同步云端）→ 以 id 命名入库 */
export async function importBook(fileName : string, tempPath : string, size : number) : Promise<void> {
	const dot = fileName.lastIndexOf('.')
	const ext = dot >= 0 ? fileName.substring(dot + 1).toLowerCase() : ''
	if (ext != 'txt' && ext != 'pdf') {
		throw new Error('暂不支持该格式，当前支持 TXT / PDF')
	}
	const bookTitle = titleFromFileName(fileName)
	if (bookTitle.length > 200) {
		// 与后端登记校验对齐：离线导入无服务端校验，超限会导致登录后同步永久失败
		throw new Error('书名过长（超 200 字），请重命名文件后重试')
	}
	const dir = uni.env.USER_DATA_PATH + '/books'
	await ensureBooksDir(dir)
	// 先以临时名落盘（正文解析需真实文件），id 分配后再改名；随机后缀防批量导入同毫秒自撞
	const workPath = dir + '/_import_' + Date.now().toString() + '_' + Math.floor(Math.random() * 100000).toString() + '.' + ext
	await copyToSandbox(tempPath, workPath)
	let chapterCount = 0
	let hasPreface = false
	if (ext == 'txt') {
		// txt：读文本（含编码识别）解析章节
		let text = ''
		try {
			text = await readTextFile(workPath)
		} catch (e) {
			discardFile(workPath)
			throw e
		}
		const parsed = parseChapters(text, titleFromFileName(fileName))
		chapterCount = parsed.length
		// 序章存在性导入时固化：打开时据此决定保留序章（新书）或剔除（无序章历史书，保证章 id 与存量进度对齐）
		hasPreface = parsed.length > 0 && parsed[0].preface
	} else {
		// PDF：原文件保留，仅取页数用于书架展示（首次阅读时按页渲染为图片缓存）
		// #ifdef APP
		try {
			const session = await openPdfSession(workPath)
			chapterCount = session.pageCount
			session.close()
		} catch (e) {
			discardFile(workPath)
			// 透传渲染器文案（损坏 / 端不支持）
			throw e
		}
		// #endif
		// #ifndef APP
		discardFile(workPath)
		throw new Error('当前端暂不支持 PDF 导入，请使用 APP 端')
		// #endif
	}
	// 章节数与后端登记校验对齐：离线导入无服务端校验，超限会导致登录后同步永久失败
	if (chapterCount > 100000) {
		discardFile(workPath)
		throw new Error('章节过多，无法导入')
	}
	if (hasAccessToken()) {
		// 云端登记（同用户同名书复用已有 id，进度与笔记自动关联；失败即导入失败，云端为准）
		let registered : UTSJSONObject | null = null
		try {
			const res = await registerBook(bookTitle, ext.toUpperCase(), size, chapterCount, hasPreface)
			if (res.code == 0 && res.data != null) {
				registered = res.data
			}
		} catch (e) {
			registered = null
		}
		let bookId = 0
		if (registered != null) {
			bookId = registered!.getNumber('id') ?? 0
		}
		if (bookId <= 0) {
			discardFile(workPath)
			throw new Error('云端登记失败，请检查网络后重试')
		}
		// 以云端 id 命名正文文件；重导入换格式时清理旧格式残留
		const bodyPath = dir + '/' + bookId + '.' + ext
		if (bodyPath != workPath) {
			await copyToSandbox(workPath, bodyPath)
			discardFile(workPath)
		}
		if (ext == 'txt') {
			discardFile(dir + '/' + bookId + '.pdf')
		} else {
			discardFile(dir + '/' + bookId + '.txt')
		}
		applyRegisteredBook(registered!, bodyPath)
	} else {
		// 未登录离线导入：本地负数 id 命名正文，元数据仅存本地缓存（登录后书架进入时同步云端）
		const pendingId = nextPendingBookId(bookTitle)
		const bodyPath = dir + '/' + pendingId + '.' + ext
		await copyToSandbox(workPath, bodyPath)
		discardFile(workPath)
		if (ext == 'txt') {
			discardFile(dir + '/' + pendingId + '.pdf')
		} else {
			discardFile(dir + '/' + pendingId + '.txt')
		}
		applyPendingImport(bookTitle, ext.toUpperCase(), size, chapterCount, hasPreface, bodyPath)
	}
}

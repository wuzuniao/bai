// 书籍导入管线：文件编码识别 → 章节解析 → 沙盒落盘入库
// 端差异收口：文件选择由调用方（书架页）按端条件编译完成，本文件只处理已选中的本地文件

import { applyRegisteredBook, nextPendingBookId, applyPendingImport, loadBooks, setBookFileLocal, discardSandboxFile, discardCrossFormatFile } from './books'
import type { LocalBook } from './booksDefs.ts'
import { registerBook } from '../api/reading.uts'
import { fetchDownloadUrl, fetchUploadUrl, fetchCloudObjects } from '../api/cos.uts'
import { sanitizeTitle, readBookBytes, writeBookBytes, cosPut, cosGetBytesOrNull, isCloudMissingError, CLOUD_MISSING_ERR, downloadBook } from './cloudsync.uts'
import { booksDir } from './bookpaths.uts'
import { hasAccessToken } from './request.uts'
import { t } from './i18n'
// 词典注册（导入管线文案）
import './locales/bookparse.uts'
// 目录解析与本地缓存（与阅读页共用同一份章节扫描逻辑）
import type { CatalogChapter } from './bookcatalogDefs.ts'
import { scanCatalogFromText, saveCatalogForBook } from './bookcatalog.uts'
// 分章正文（仅 APP 端；目录缓存与正文换代时同步作废旧排版缓存）
import { splitBookToChapters } from './bookchapters.uts'
import { clearSavedLayouts } from './paginationcache.uts'
// #ifdef MP-WEIXIN
import { decodeGbkBytes } from './gbk'
// #endif
// #ifdef APP
import { openPdfSession } from './pdfrender'
// #endif
// #ifdef APP-ANDROID
import Charset from 'java.nio.charset.Charset'
// #endif
// #ifdef WEB
import { webFsCopy, webReadTextFile } from './webfs'
// #endif

// 共享类型抽离到 bookparse.ts：UTS 编译器对 type-only 导入会改写为 *.ts 路径（HBuilderX 5.33），
// 类型留在 .uts 会报“未导出”。本文件导入供内部使用并再导出给调用方。
import type { SyncResult } from './bookparseDefs.ts'

/** 分块读取块大小（字节）：大文件分块读规避整读的内存峰值（uni-app x 官方建议单次读取不超过 16M） */
const READ_CHUNK_BYTES = 1024 * 1024

/** 采样检测字符串中是否存在 UTF-8 解码替换符（出现即视为非 UTF-8 编码，大概率 GBK） */
function looksMisencoded(text : string) : boolean {
	const sampleLen = text.length < 20000 ? text.length : 20000
	let bad = 0
	for (let i = 0; i < sampleLen; i++) {
		if ((text.charCodeAt(i) ?? 0) == 0xFFFD) {
			bad++
			if (bad > 5) {
				return true
			}
		}
	}
	return false
}

// #ifdef MP-WEIXIN
/**
 * latin1 解码的块尾探测串中，被切断多字节字符占用的字节数（0..3）：
 * latin1 每字节映射为一字符，charCodeAt 即原始字节值；utf-8 续字节为 10xxxxxx，
 * 从块尾向前找字符首字节并按其高位判定字符总长，总长超过块内实际占用即被切断
 */
function incompleteTailBytes(tail : string) : number {
	for (let i = tail.length - 1; i >= 0; i--) {
		const b = tail.charCodeAt(i) ?? 0
		if ((b & 0xC0) != 0x80) {
			const charLen = b >= 0xF0 ? 4 : (b >= 0xE0 ? 3 : (b >= 0xC0 ? 2 : 1))
			const used = tail.length - i
			return charLen > used ? used : 0
		}
	}
	return tail.length
}

/** 微信端分块读取 GBK 文本：latin1 逐块读字节（每字符=一字节），GBK 双字节跨块时块尾截 1 字节配对，块内码表解码 */
function readGbkChunkedMp(path : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		const fs = uni.getFileSystemManager()
		let size = 0
		try {
			size = fs.statSync(path).size
		} catch (e) {
			reject(new Error(t('bookparse.readFail')))
			return
		}
		if (size == 0) {
			resolve('')
			return
		}
		let pos = 0
		const parts : string[] = []
		while (pos < size) {
			let len = Math.min(READ_CHUNK_BYTES, size - pos)
			// 非末块：块尾字节是 GBK 双字节首字节（0x81-0xFE）时截 1 字节到下一块配对解码
			if (pos + len < size) {
				try {
					const tail = fs.readFileSync(path, 'latin1', pos + len - 1, 1) as string
					const b = tail.charCodeAt(0) ?? 0
					if (b >= 0x81 && b <= 0xFE) {
						len -= 1
					}
				} catch (e) {
					// 探测失败按原边界读取
				}
			}
			if (len <= 0) {
				reject(new Error(t('bookparse.readFail')))
				return
			}
			try {
				const chunk = fs.readFileSync(path, 'latin1', pos, len)
				if (typeof chunk != 'string') {
					reject(new Error(t('bookparse.readFail')))
					return
				}
				parts.push(decodeGbkBytes(chunk as string))
			} catch (e) {
				reject(new Error(t('bookparse.readFail')))
				return
			}
			pos += len
		}
		resolve(parts.join(''))
	})
}

/** 微信端分块读取 utf-8 文本（每块 1MB，块边界做字符对齐；末块后拼接结果，GBK 检测交由调用方） */
function readTextFileChunkedMp(path : string) : Promise<string> {
	return new Promise<string>((resolve, reject) => {
		const fs = uni.getFileSystemManager()
		let size = 0
		try {
			size = fs.statSync(path).size
		} catch (e) {
			reject(new Error(t('bookparse.readFail')))
			return
		}
		if (size == 0) {
			resolve('')
			return
		}
		let pos = 0
		let text = ''
		while (pos < size) {
			let len = Math.min(READ_CHUNK_BYTES, size - pos)
			// 非末块：探测块尾 4 字节（utf-8 字符最长 4 字节，窗口内必含字符首字节），
			// 截去被切断字符的前缀字节，下一块从该字符首字节重读，保证字符完整解码
			if (pos + len < size) {
				try {
					const tail = fs.readFileSync(path, 'latin1', pos + len - 4, 4) as string
					len -= incompleteTailBytes(tail)
					if (len <= 0) {
						reject(new Error(t('bookparse.readFail')))
						return
					}
				} catch (e) {
					// 探测失败按原边界读取（最多损失块尾一个字符）
				}
			}
			try {
				const chunk = fs.readFileSync(path, 'utf-8', pos, len)
				if (typeof chunk != 'string') {
					reject(new Error(t('bookparse.readFail')))
					return
				}
				text = text + (chunk as string)
			} catch (e) {
				reject(new Error(t('bookparse.readFail')))
				return
			}
			pos += len
		}
		resolve(text)
	})
}
// #endif


/** 读取文本文件并自动识别编码（utf-8 优先，含替换符时按 GBK 重读；微信/Android 分块读规避大文件整读内存峰值，iOS 端整读无分块） */
export function readTextFile(path : string) : Promise<string> {
	// #ifdef MP-WEIXIN
	return new Promise<string>((resolve, reject) => {
		readTextFileChunkedMp(path).then((text : string) => {
			if (!looksMisencoded(text)) {
				resolve(text)
				return
			}
			// 非 UTF-8（大概率 GBK）：微信端无系统级 GBK 解码，latin1 分块读字节后按码表解码
			readGbkChunkedMp(path).then((gbkText : string) => {
				resolve(gbkText)
			}, (_e : Error | null) => {
				reject(new Error(t('bookparse.readFail')))
			})
		}, (e : Error | null) => {
			reject(e != null ? e : new Error(t('bookparse.readFail')))
		})
	})
	// #endif
	// #ifdef APP-ANDROID
	return new Promise<string>((resolve, reject) => {
		try {
			const fsm = uni.getFileSystemManager()
			// vdom 引擎的 FS 同步 API 为 options-object 风格且 readSync/statSync 不可用（项目规范 3.4），
			// 改整读：UTF-8 优先，检出乱码后按 ArrayBuffer + UTS TextDecoder('gbk') 解码；
			// readFileSync 返回可空 string，空即读取失败
			const text = fsm.readFileSync(path, 'utf-8')
			if (text == null) {
				reject(new Error(t('bookparse.readFail')))
				return
			}
			// readFileSync 返回 any：空判断后 as string 收窄
			const textStr = text as string
			if (!looksMisencoded(textStr)) {
				resolve(textStr)
				return
			}
			// 非 UTF-8（GBK 等）：vdom 的 readFileSync 编码白名单仅 utf-8 / base64（传 binary 抛 1200002），
			// 不带编码读取返回 ArrayBuffer，交给 UTS TextDecoder('gbk')（Android 4.31+ 支持）解码
			const raw = fsm.readFileSync(path, null)
			if (raw == null) {
				reject(new Error(t('bookparse.readFail')))
				return
			}
			resolve(new TextDecoder('gbk').decode(raw as ArrayBuffer))
		} catch (e) {
			reject(new Error(t('bookparse.readFail')))
		}
	})
	// #endif
	// #ifdef APP-IOS
	return new Promise<string>((resolve, reject) => {
		let text = ''
		try {
			const raw = uni.getFileSystemManager().readFileSync(path, 'utf-8')
			text = raw as string
		} catch (e) {
			reject(new Error(t('bookparse.readFail')))
			return
		}
		if (!looksMisencoded(text)) {
			resolve(text)
			return
		}
		reject(new Error(t('bookparse.encodingUnsupported')))
	})
	// #endif
	// #ifdef WEB
	return webReadTextFile(path)
	// #endif
	// #ifndef MP-WEIXIN || APP || WEB
	return new Promise<string>((_resolve, reject) => {
		reject(new Error(t('bookparse.encodingUnsupported')))
	})
	// #endif
}

/** 确保沙盒书籍目录存在（mkdir 的「已存在」错误码各端不一致不可靠，失败后以 access 复验目录实际可达为准） */
function ensureBooksDir(dir : string) : Promise<void> {
	// #ifdef WEB
	// IndexedDB 键命名空间无需建目录
	return new Promise<void>((resolve) => {
		resolve()
	})
	// #endif
	// #ifndef WEB
	return new Promise<void>((resolve, reject) => {
		uni.getFileSystemManager().mkdir({
			dirPath: dir,
			recursive: true,
			success: (_res) => { resolve() },
			fail: (_err) => {
				try {
					uni.getFileSystemManager().accessSync(dir)
					resolve()
				} catch (e) {
					reject(new Error(t('bookparse.dirCreateFail')))
				}
			}
		})
	})
	// #endif
}

/** 复制选中的文件到沙盒（临时路径会被系统回收，必须先落盘；目标已存在时覆盖，支持同名书覆盖导入） */
async function copyToSandbox(srcPath : string, destPath : string) : Promise<void> {
	// #ifdef WEB
	// webpick:// 暂存引用 → IndexedDB 入库；键到键复制由 webFsCopy 统一处理
	await webFsCopy(srcPath, destPath)
	return
	// #endif
	// #ifndef WEB
	return new Promise<void>((resolve, reject) => {
		try {
			// 同名书重导入时目标正文已存在，部分端 copyFile 对已存在目标直接失败，先删后拷
			uni.getFileSystemManager().unlinkSync(destPath)
		} catch (e) {
			// 目标不存在属正常
		}
		uni.getFileSystemManager().copyFile({
			srcPath: srcPath,
			destPath: destPath,
			success: (_res) => { resolve() },
			fail: (_err) => { reject(new Error(t('bookparse.saveFail'))) }
		})
	})
	// #endif
}

/** 从文件名提取书名（去扩展名，去首尾空白） */
function titleFromFileName(fileName : string) : string {
	const dot = fileName.lastIndexOf('.')
	const base = dot > 0 ? fileName.substring(0, dot) : fileName
	const title = base.trim()
	return title.length > 0 ? title : t('bookparse.untitled')
}

/**
 * 目录缓存 + 分章正文落盘（导入/云端恢复登记拿到书籍 id 后调用）：
 * 目录缓存使首次开书免全书扫描；分章正文让开书只读当前章（仅 APP 端，其余端为空操作）。
 * 拆分失败不影响导入（下次开书走整文路径并重建），仅告警
 */
async function persistCatalogAndChapters(bookId : number, fileSize : number, chapters : CatalogChapter[], text : string) : Promise<void> {
	if (chapters.length == 0) {
		return
	}
	saveCatalogForBook(bookId, fileSize, chapters)
	// 正文换代（重导入同名书复用同一 id）：旧排版缓存作废
	clearSavedLayouts(bookId)
	try {
		await splitBookToChapters(bookId, text, chapters)
	} catch (e) {
		console.warn('分章正文写入失败（下次开书按整文重建）', e)
	}
}

/** 导入一本书：复制落盘解析 → 登录态云端登记（后端分配 id，同名书复用）/ 未登录本地负数 id 落地（登录后同步云端）→ 以 id 命名入库 */
export async function importBook(fileName : string, tempPath : string, size : number) : Promise<void> {
	const dot = fileName.lastIndexOf('.')
	const ext = dot >= 0 ? fileName.substring(dot + 1).toLowerCase() : ''
	if (ext != 'txt' && ext != 'pdf') {
		throw new Error(t('bookparse.formatUnsupported'))
	}
	const bookTitle = titleFromFileName(fileName)
	if (bookTitle.length > 200) {
		// 与后端登记校验对齐：离线导入无服务端校验，超限会导致登录后同步永久失败
		throw new Error(t('bookparse.titleTooLong'))
	}
	const dir = booksDir()
	await ensureBooksDir(dir)
	// 先以临时名落盘（正文解析需真实文件），id 分配后再改名；随机后缀防批量导入同毫秒自撞
	const workPath = dir + '/_import_' + Date.now().toString() + '_' + Math.floor(Math.random() * 100000).toString() + '.' + ext
	await copyToSandbox(tempPath, workPath)
	let chapterCount = 0
	let hasPreface = false
	// txt 目录条目与全文（扫描产物：登记拿到书籍 id 后写入目录缓存并按章拆分正文，首次开书即命中）
	let catalog : CatalogChapter[] = []
	let bookText = ''
	if (ext == 'txt') {
		// txt：读文本（含编码识别）扫描目录
		try {
			bookText = await readTextFile(workPath)
		} catch (e) {
			discardSandboxFile(workPath)
			throw e
		}
		catalog = scanCatalogFromText(bookText, titleFromFileName(fileName))
		chapterCount = catalog.length
		// 序章存在性导入时固化：打开时据此决定保留序章（新书）或剔除（无序章历史书，保证章 id 与存量进度对齐）
		hasPreface = catalog.length > 0 && catalog[0].preface
	} else {
		// PDF：原文件保留，仅取页数用于书架展示（首次阅读时按页渲染为图片缓存）
		// #ifdef APP
		try {
			const session = await openPdfSession(workPath)
			chapterCount = session.pageCount
			session.close()
		} catch (e) {
			discardSandboxFile(workPath)
			// 透传渲染器文案（损坏 / 端不支持）
			throw e
		}
		// #endif
		// #ifndef APP
		discardSandboxFile(workPath)
		throw new Error(t('bookparse.pdfUnsupported'))
		// #endif
	}
	// 章节数与后端登记校验对齐：离线导入无服务端校验，超限会导致登录后同步永久失败
	if (chapterCount > 100000) {
		discardSandboxFile(workPath)
		throw new Error(t('bookparse.tooManyChapters'))
	}
	if (hasAccessToken()) {
		// 云端登记（同用户同名书复用已有 id，进度与笔记自动关联；失败即导入失败，云端为准）
		let registered : UTSJSONObject | null = null
		try {
			const res = await registerBook(bookTitle, ext.toUpperCase(), size, chapterCount, hasPreface)
			if (res.code == 0 && res.data != null) {
				registered = res.data
			}
		} catch (e) {
			registered = null
		}
		let bookId = 0
		if (registered != null) {
			bookId = registered!.getNumber('id') ?? 0
		}
		if (bookId <= 0) {
			discardSandboxFile(workPath)
			throw new Error(t('bookparse.registerFail'))
		}
		// 以云端 id 命名正文文件；重导入换格式时清理旧格式残留
		const bodyPath = dir + '/' + bookId + '.' + ext
		if (bodyPath != workPath) {
			await copyToSandbox(workPath, bodyPath)
			discardSandboxFile(workPath)
		}
		if (ext == 'txt') {
			discardCrossFormatFile(bodyPath, ext)
		} else {
			discardCrossFormatFile(bodyPath, ext)
		}
		applyRegisteredBook(registered!, bodyPath)
		await persistCatalogAndChapters(bookId, size, catalog, bookText)
	} else {
		// 未登录离线导入：本地负数 id 命名正文，元数据仅存本地缓存（登录后书架进入时同步云端）
		const pendingId = nextPendingBookId(bookTitle)
		const bodyPath = dir + '/' + pendingId + '.' + ext
		await copyToSandbox(workPath, bodyPath)
		discardSandboxFile(workPath)
		if (ext == 'txt') {
			discardCrossFormatFile(bodyPath, ext)
		} else {
			discardCrossFormatFile(bodyPath, ext)
		}
		applyPendingImport(bookTitle, ext.toUpperCase(), size, chapterCount, hasPreface, bodyPath)
		await persistCatalogAndChapters(pendingId, size, catalog, bookText)
	}
}

// ==================== 云端同步（书架一键双向同步 + 空书架云端恢复） ====================
// 口径：差异=单边存在——本地有正文且云端无同名对象 → 上传；本地无正文且云端有 → 下载；
// 云端有对象但本地无书行 → 反向建档（下载→解析→登记）下载；两边都有同名书视为已一致跳过
// （无可靠文件级比对依据，且避免互相覆盖）。

/** 云端清单条目（title/format 为后端已剥离用户目录前缀的解析结果；匹配键 = sanitizeTitle(title).小写扩展名） */
type CloudItem = {
	title: string
	format: string
	size: number
}

/** 单本上传（取预签名 → 读本地字节 → PUT 直传；失败抛错） */
async function uploadBook(book : LocalBook) : Promise<void> {
	const urlRes = await fetchUploadUrl(sanitizeTitle(book.title), book.format.toLowerCase())
	if (urlRes.code != 0 || urlRes.data == null) {
		throw new Error(urlRes.msg)
	}
	const url = urlRes.data!.getString('url') ?? ''
	if (url.length == 0) {
		throw new Error('empty upload url')
	}
	const buf = await readBookBytes(book.path)
	await cosPut(url, buf)
}

/** 单本下载落盘（不登记；restoreBookFromCloud 内部用） */
async function downloadBytesToWork(title : string, format : string) : Promise<string | null> {
	const ext = format.toLowerCase()
	const urlRes = await fetchDownloadUrl(sanitizeTitle(title), ext)
	if (urlRes.code != 0 || urlRes.data == null) {
		return null
	}
	const url = urlRes.data!.getString('url') ?? ''
	if (url.length == 0) {
		return null
	}
	const buf = await cosGetBytesOrNull(url)
	if (buf == null) {
		throw new Error(CLOUD_MISSING_ERR)
	}
	const dir = booksDir()
	await ensureBooksDir(dir)
	// 随机后缀防批量恢复同毫秒自撞（与导入管线临时名同策略）
	const workPath = dir + '/_restore_' + Date.now().toString() + '_' + Math.floor(Math.random() * 100000).toString() + '.' + ext
	await writeBookBytes(workPath, buf)
	return workPath
}

/**
 * 云端恢复建档（三态）：0=成功；1=云端对象实际不存在（404，删除竞态/孤儿行，静默跳过）；
 * 2=失败（网络/登记/解析等）
 */
export async function restoreBookFromCloud(title : string, format : string, size : number) : Promise<number> {
	try {
		const ok = await restoreBookFromCloudInner(title, format, size)
		return ok ? 0 : 2
	} catch (e) {
		if (isCloudMissingError(e)) {
			return 1
		}
		console.warn('云端恢复建档失败', title, e)
		return 2
	}
}

/** 恢复建档主流程：下载 → 解析元数据（txt 章节数/序章，PDF 取页数）→ 登记业务库 → 以云端 id 命名入库 */
async function restoreBookFromCloudInner(title : string, format : string, size : number) : Promise<boolean> {
	const ext = format.toLowerCase()
	const workPath = await downloadBytesToWork(title, format)
	if (workPath == null) {
		return false
	}
	// 元数据解析（与导入管线同口径）
	let chapterCount = 0
	let hasPreface = false
	// txt 目录条目与全文（扫描产物，登记拿到书籍 id 后写入目录缓存并按章拆分）
	let catalog : CatalogChapter[] = []
	let bookText = ''
	if (ext == 'txt') {
		try {
			bookText = await readTextFile(workPath)
		} catch (e) {
			discardSandboxFile(workPath)
			return false
		}
		catalog = scanCatalogFromText(bookText, title)
		chapterCount = catalog.length
		hasPreface = catalog.length > 0 && catalog[0].preface
	} else {
		// PDF：仅 App 端取页数用于书架展示（其余端 PDF 无法阅读，不恢复）
		// #ifdef APP
		try {
			const session = await openPdfSession(workPath)
			chapterCount = session.pageCount
		} catch (e) {
			discardSandboxFile(workPath)
			return false
		}
		// #endif
		// #ifndef APP
		discardSandboxFile(workPath)
		return false
		// #endif
	}
	// 登记业务库（同用户同名书复用行并回填元数据）
	let registered : UTSJSONObject | null = null
	try {
		const res = await registerBook(title, format.toUpperCase(), size, chapterCount, hasPreface)
		if (res.code == 0 && res.data != null) {
			registered = res.data
		}
	} catch (e) {
		registered = null
	}
	if (registered == null) {
		discardSandboxFile(workPath)
		return false
	}
	const bookId = registered!.getNumber('id') ?? 0
	if (bookId <= 0) {
		discardSandboxFile(workPath)
		return false
	}
	// 以云端 id 命名入库（换格式残留清理与导入管线同口径）
	const dir = booksDir()
	const bodyPath = dir + '/' + bookId.toString() + '.' + ext
	if (bodyPath != workPath) {
		await copyToSandbox(workPath, bodyPath)
		discardSandboxFile(workPath)
	}
	if (ext == 'txt') {
		discardCrossFormatFile(bodyPath, ext)
	} else {
		discardCrossFormatFile(bodyPath, ext)
	}
	applyRegisteredBook(registered!, bodyPath)
	await persistCatalogAndChapters(bookId, size, catalog, bookText)
	return true
}

/** 一次性双向同步（书架「云端同步」入口调用）：返回统计结果，云端清单拉取失败整体抛错 */
export async function runBookSync() : Promise<SyncResult> {
	const res = await fetchCloudObjects()
	if (res.code != 0 || res.data == null) {
		throw new Error(res.msg)
	}
	// 云端对象清单（title/format 为后端已剥离用户目录前缀的解析结果）
	const cloud : CloudItem[] = []
	const arr = res.data!.getArray('items')
	if (arr != null) {
		for (let i = 0; i < arr.length; i++) {
			const obj = arr[i] as UTSJSONObject
			const title = obj.getString('title') ?? ''
			const format = (obj.getString('format') ?? '').toUpperCase()
			if (title.length == 0 || (format != 'TXT' && format != 'PDF')) {
				continue
			}
			cloud.push({ title: title, format: format, size: obj.getNumber('size') ?? 0 } as CloudItem)
		}
	}
	// 本地书行按匹配键索引（键 = 书名.小写扩展名，与云端条目同构）
	const bookByKey = new Map<string, LocalBook>()
	const books = loadBooks()
	for (let i = 0; i < books.length; i++) {
		const b = books[i]
		bookByKey.set(sanitizeTitle(b.title) + '.' + b.format.toLowerCase(), b)
	}
	const result : SyncResult = { uploaded: 0, downloaded: 0, restored: 0, failed: 0 }
	for (let i = 0; i < cloud.length; i++) {
		const matchKey = sanitizeTitle(cloud[i].title) + '.' + cloud[i].format.toLowerCase()
		const book = bookByKey.get(matchKey)
		try {
			if (book == null) {
				// 云端有、本地无书行 → 反向建档恢复（1=云端对象实际不存在，静默跳过）
				const code = await restoreBookFromCloud(cloud[i].title, cloud[i].format, cloud[i].size)
				if (code == 0) {
					result.restored++
				} else if (code == 2) {
					result.failed++
				}
			} else if (book.path.length == 0) {
				// 本地有书行、无正文 → 下载
				await downloadBook(book)
				result.downloaded++
			}
			// 本地有正文（无论云端有无）不在此处理：上传差异在下方本地遍历补齐
		} catch (e) {
			if (isCloudMissingError(e)) {
				// 云端对象实际不存在（删除竞态/孤儿行）：静默跳过不计失败
				continue
			}
			console.warn('云端同步单本失败', cloud[i].title, e)
			result.failed++
		}
	}
	// 上传差异：本地有正文且云端无同名对象
	const cloudSet = new Map<string, boolean>()
	for (let i = 0; i < cloud.length; i++) {
		cloudSet.set(sanitizeTitle(cloud[i].title) + '.' + cloud[i].format.toLowerCase(), true)
	}
	for (let i = 0; i < books.length; i++) {
		const book = books[i]
		if (book.path.length == 0 || (book.format != 'TXT' && book.format != 'PDF')) {
			continue
		}
		if (cloudSet.has(sanitizeTitle(book.title) + '.' + book.format.toLowerCase())) {
			continue
		}
		try {
			await uploadBook(book)
			result.uploaded++
		} catch (e) {
			console.warn('云端同步单本失败', book.title, e)
			result.failed++
		}
	}
	return result
}

/** 空书架云端恢复（静默）：逐本检查本地缓存无同名书时反向建档下载，返回恢复本数 */
export async function restoreEmptyShelfFromCloud() : Promise<number> {
	const res = await fetchCloudObjects()
	if (res.code != 0 || res.data == null) {
		return 0
	}
	const arr = res.data!.getArray('items')
	if (arr == null || arr.length == 0) {
		return 0
	}
	const localKeys = new Map<string, boolean>()
	const books = loadBooks()
	for (let i = 0; i < books.length; i++) {
		localKeys.set(sanitizeTitle(books[i].title) + '.' + books[i].format.toLowerCase(), true)
	}
	let restored = 0
	for (let i = 0; i < arr.length; i++) {
		const obj = arr[i] as UTSJSONObject
		const title = obj.getString('title') ?? ''
		const format = (obj.getString('format') ?? '').toUpperCase()
		if (title.length == 0 || (format != 'TXT' && format != 'PDF')) {
			continue
		}
		if (localKeys.has(sanitizeTitle(title) + '.' + format.toLowerCase())) {
			continue
		}
		if ((await restoreBookFromCloud(title, format, obj.getNumber('size') ?? 0)) == 0) {
			restored++
		}
	}
	return restored
}

/**
 * 指纹登录词典段（utils/biometric.uts）
 * 模块载入时注册进 i18n 全局词典；biometric.uts 引入本文件即完成注册。
 */
import { registerDict, Dict } from '../i18n'

const zh: Dict = new Map<string, string>([
	['biometric.authContent', '指纹验证已登录']
])

const en: Dict = new Map<string, string>([
	['biometric.authContent', 'Verify your fingerprint to sign in']
])

registerDict(zh, en)

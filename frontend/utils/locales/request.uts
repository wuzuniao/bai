/**
 * 请求层词典段（utils/request.uts）
 * 模块载入时注册进 i18n 全局词典；request.uts 引入本文件即完成注册。
 */
import { registerDict, Dict } from '../i18n'

const zh: Dict = new Map<string, string>([
	['request.expired', '登录已过期，请重新登录'],
	['request.notLoggedIn', '未登录'],
	['request.tooFrequent', '操作过于频繁，请稍后再试'],
	['request.failed', '请求失败'],
	['request.networkFail', '网络请求失败，请检查网络后重试']
])

const en: Dict = new Map<string, string>([
	['request.expired', 'Session expired, please sign in again'],
	['request.notLoggedIn', 'Not signed in'],
	['request.tooFrequent', 'Too many requests, please try again later'],
	['request.failed', 'Request failed'],
	['request.networkFail', 'Network request failed, please check your connection and retry']
])

registerDict(zh, en)

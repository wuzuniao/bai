/**
 * 外部链接提示词典段（utils/link.uts）
 * 模块载入时注册进 i18n 全局词典；link.uts 引入本文件即完成注册。
 */
import { registerDict } from '../i18n'

const zh = new Map<string, string>([
	['link.copied', '链接已复制，请在浏览器中打开'],
	['link.copyFail', '复制失败，请重试']
])

const en = new Map<string, string>([
	['link.copied', 'Link copied — open it in your browser'],
	['link.copyFail', 'Copy failed, try again']
])

registerDict(zh, en)

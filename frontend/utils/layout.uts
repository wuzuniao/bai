/**
 * 页面布局尺寸计算（跨页面复用的顶部避让逻辑）
 */

/** 主内容限宽（px，宽屏适配）：内容列居中的上限宽度（pdfreader 正文区、书架浮层对齐等 JS 几何使用；
 *  阅读页 reader 不限宽不使用本常量）。
 *  Web 端 480 与 rpx 冻结基准（pages.json globalStyle WEB 分支）同值，卡片尺寸与原 body 480px 限宽时期一致；
 *  App 端 750 与页面 CSS 限宽同值；微信端原生 rpx 随窗口换算。
 *  注意：页面 CSS 里的 max-width 无法引用常量，以条件编译写死同值，两处必须同步修改 */
// #ifdef WEB
export const CONTENT_CAP_PX = 480
// #endif
// #ifndef WEB
export const CONTENT_CAP_PX = 750
// #endif

/**
 * rpx→px 换算（与 CSS rpx 口径一致）。
 * vdom 引擎（项目规范 3.4）下 uni.upx2px 不存在（App-Android 编译报 API 不支持），故自行换算；
 * 基准钳制与 pages.json globalStyle 的 rpxCalcMaxDeviceWidth 同口径：Web 端 480、App 端 750、
 * 小程序端不钳制（原生 rpx 即按屏宽换算）。
 */
export function rpxToPx(rpx : number) : number {
	const win = uni.getWindowInfo()
	// #ifdef WEB
	return rpx * Math.min(win.windowWidth, 480) / 480
	// #endif
	// #ifdef MP-WEIXIN
	return rpx * win.windowWidth / 750
	// #endif
	// App（Android/iOS）与其他端：基准钳制 750，与 globalStyle 非 WEB 分支同口径
	return rpx * Math.min(win.windowWidth, 750) / 750
}

// 共享类型抽离到 layout.ts：UTS 编译器对 type-only 导入会改写为 *.ts 路径（HBuilderX 5.33），
// 类型留在 .uts 会报“未导出”。本文件导入供内部使用并再导出给调用方。
import type { CapsuleRect } from './layoutDefs.ts'

/** 微信小程序胶囊按钮矩形（条件编译内聚：非微信端恒返回 null），各页面导航避让据此换算 */
export function mpCapsuleRect() : CapsuleRect | null {
	// #ifdef MP-WEIXIN
	const capsule = uni.getMenuButtonBoundingClientRect()
	if (capsule.height > 0) {
		return { top: capsule.top, left: capsule.left, height: capsule.height } as CapsuleRect
	}
	// #endif
	return null
}

/** 折叠屏窗口宽度变化自愈（微信端专属实现，其他端空实现）：折叠/展开切换后 wxss rpx 基准、
 *  JS 度量与滚动位置三方同步不可靠，实测出现布局残留错乱（内容上下压叠、行被底部导航叠住）。
 *  防抖 400ms 且宽度变化超阈值后 redirectTo 重载当前页，全部按新窗口重新初始化；
 *  阅读进度经持久化恢复，无数据损失。reloadUrl 由调用页传入自身完整路径（含参数）。 */
// #ifdef MP-WEIXIN
let resizeReloadTimer = -1
let resizeReloadW = 0
let resizeReloadInited = false
// #endif
export function scheduleResizeReload(width : number, reloadUrl : string) : void {
	// #ifdef MP-WEIXIN
	// 首次调用仅记录基准（页面 onShow 也会触发，避免冷启动误重载）
	if (!resizeReloadInited) {
		resizeReloadInited = true
		resizeReloadW = width
		return
	}
	if (Math.abs(width - resizeReloadW) < 8) {
		return
	}
	resizeReloadW = width
	if (resizeReloadTimer >= 0) {
		clearTimeout(resizeReloadTimer)
	}
	resizeReloadTimer = setTimeout(() : void => {
		resizeReloadTimer = -1
		uni.redirectTo({ url: reloadUrl })
	}, 400)
	// #endif
}

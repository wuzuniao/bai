/**
 * 外部链接打开辅助
 * --------------------------------------------------------------------------
 * 服务协议/隐私政策为外部页面（auth.wuzuniao.com），应用内不建 web-view 页，
 * 统一复制链接并提示用户在浏览器打开。
 */
import { t } from './i18n'
// 词典注册（链接提示文案）
import './locales/link.uts'

export function openExternalLink(url: string) : void {
	uni.setClipboardData({
		data: url,
		success: () => {
			uni.showToast({ title: t('link.copied'), icon: 'none' })
		},
		fail: () => {
			uni.showToast({ title: t('link.copyFail'), icon: 'none' })
		}
	})
}

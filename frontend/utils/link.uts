/**
 * 外部链接打开辅助
 * --------------------------------------------------------------------------
 * 服务协议/隐私政策为外部页面（auth.wuzuniao.com），应用内不建 web-view 页，
 * 统一复制链接并提示用户在浏览器打开。
 */
export function openExternalLink(url: string) : void {
	uni.setClipboardData({
		data: url,
		success: () => {
			uni.showToast({ title: '链接已复制，请在浏览器中打开', icon: 'none' })
		},
		fail: () => {
			uni.showToast({ title: '复制失败', icon: 'none' })
		}
	})
}

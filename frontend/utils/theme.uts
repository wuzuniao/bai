/**
 * 运行时颜色唯一定义处（JS 侧）
 *
 * SCSS 样式中的颜色一律引用 uni.scss 的 $bai-* 令牌（编译期）；
 * 此处集中管理无法使用 SCSS 变量的运行时颜色：阅读页动态主题与内联样式取值。
 * 浅色主题取值与 uni.scss 令牌保持一致（真源：根目录 DESIGN_bai.md）。
 */

// 共享类型抽离到 theme.ts：UTS 编译器对 type-only 导入会改写为 *.ts 路径（HBuilderX 5.33），
// 类型留在 .uts 会报“未导出”。本文件导入供内部使用并再导出给调用方。
import type { ReaderTheme } from './themeDefs.ts'

/** 日间主题（画布 canvas-soft + 墨色文字，取自 DESIGN_bai.md） */
export const READER_THEME_LIGHT: ReaderTheme = {
	readerBg: '#f4f4f2',
	bodyColor: '#0e0f0c',
	titleColor: '#0e0f0c',
	labelColor: '#0e0f0c',
	mutedColor: '#868685',
	chapterTextColor: '#0e0f0c',
	menuTopBg: 'rgba(244, 244, 242, 0.95)',
	menuBottomBg: 'rgba(244, 244, 242, 0.98)',
	menuBorderColor: '#e9e9e6',
	activeBlue: '#1e40af',
	/** 书签遮罩：浅色纸面上用深色半透明，白字白图标清晰 */
	maskBg: 'rgba(14, 15, 12, 0.65)',
	maskTextColor: '#ffffff',
	/** 划词气泡：日间墨黑卡片 */
	popoverBg: '#0e0f0c',
	/** 书签遮罩同款深色投影（向上） */
	panelShadow: '0px -5px 20px rgba(0, 0, 0, 0.1)',
	/** 日间控件：白底墨字 */
	controlBg: '#ffffff',
	controlBorder: '#e9e9e6',
	controlText: '#0e0f0c',
	/** 浅色纸面用墨色半透明加深（与书签遮罩的暗底惯例一致） */
	coverMaskBg: 'rgba(0, 0, 0, 0.45)',
	thoughtPanelBg: '#ffffff'
} as ReaderTheme

/** 夜间主题（深色纸面） */
export const READER_THEME_NIGHT: ReaderTheme = {
	readerBg: '#121212',
	bodyColor: '#d4d4d4',
	titleColor: '#f3f4f6',
	labelColor: '#9ca3af',
	mutedColor: '#a0a0a0',
	chapterTextColor: '#d4d4d4',
	/** 控制框面板比暗底（#121212）提亮一档，避免与页面背景融合 */
	menuTopBg: 'rgba(44, 44, 44, 0.98)',
	menuBottomBg: 'rgba(44, 44, 44, 0.98)',
	menuBorderColor: 'rgba(255, 255, 255, 0.14)',
	activeBlue: '#60a5fa',
	/** 书签遮罩：暗色纸面上用浅色半透明进行视觉区分，深色文字 */
	maskBg: 'rgba(244, 244, 242, 0.9)',
	maskTextColor: '#0e0f0c',
	/** 划词气泡：夜间提亮一档与暗底区分 */
	popoverBg: '#2c2c2c',
	/** 控制栏投影：暗底上切换为白色光晕，强度足以与背景区分 */
	panelShadow: '0px -8px 36px rgba(255, 255, 255, 0.18)',
	/** 夜间控件：灰底白字，与暗面板区分且文字突出 */
	controlBg: '#3a3a3a',
	controlBorder: 'rgba(255, 255, 255, 0.12)',
	controlText: '#f3f4f6',
	/** 暗色纸面用浅白半透明提亮（与浮层的暗底区分惯例一致） */
	coverMaskBg: 'rgba(255, 255, 255, 0.24)',
	/** 夜间随浮层底色提亮 */
	thoughtPanelBg: 'rgba(44, 44, 44, 0.98)'
} as ReaderTheme

/** 暖米黄纸张主题（阅读背景色板第二选项，浮层与弱化色同日间） */
export const READER_THEME_PAPER: ReaderTheme = {
	readerBg: '#fbf4e6',
	bodyColor: '#2b261d',
	titleColor: '#2b261d',
	labelColor: '#2b261d',
	mutedColor: '#868685',
	chapterTextColor: '#2b261d',
	menuTopBg: 'rgba(244, 244, 242, 0.95)',
	menuBottomBg: 'rgba(244, 244, 242, 0.98)',
	menuBorderColor: '#e9e9e6',
	activeBlue: '#1e40af',
	maskBg: 'rgba(14, 15, 12, 0.65)',
	maskTextColor: '#ffffff',
	popoverBg: '#0e0f0c',
	panelShadow: '0px -5px 20px rgba(0, 0, 0, 0.1)',
	/** 纸张主题浮层与弱化色同日间，控件同为白底墨字 */
	controlBg: '#ffffff',
	controlBorder: '#e9e9e6',
	controlText: '#0e0f0c',
	coverMaskBg: 'rgba(0, 0, 0, 0.45)',
	thoughtPanelBg: '#ffffff'
} as ReaderTheme

/** 输入框占位内联样式（placeholder-style 仅接受字符串，无法引用 SCSS 变量） */
export const PLACEHOLDER_STYLE: string = 'color: #868685'

/** 主题 key → ReaderTheme 解析（未知 key 回落日间）：阅读页与控制框/设置组件共用同一解析，新增主题只改此处 */
export function readerThemeOf(key : string) : ReaderTheme {
	if (key == 'night') {
		return READER_THEME_NIGHT
	}
	if (key == 'paper') {
		return READER_THEME_PAPER
	}
	return READER_THEME_LIGHT
}

/** 主题图标路径：夜间使用 -light 白色变体（阅读页控制框与书签面板共用） */
export function readerThemeIcon(name : string, night : boolean) : string {
	return '/static/icons/' + name + (night ? '-light' : '') + '.svg'
}

/**
 * 底部悬浮导航栏单项数据类型
 * 尺寸字段均为 rpx 值（750 设计稿基准，Figma 390 宽 × 1.923 换算）
 */
export type BottomNavItem = {
	/** 唯一标识 */
	key: string
	/** 按钮文字 */
	text: string
	/** 未激活图标路径 */
	icon: string
	/** 激活图标路径 */
	iconActive: string
	/** 图标宽度（rpx） */
	iconWidth: number
	/** 图标高度（rpx） */
	iconHeight: number
}

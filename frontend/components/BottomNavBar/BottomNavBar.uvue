<template>
	<view class="navbar-layer">
		<view class="navbar-pill">
			<view
				v-for="(item, index) in items"
				:key="item.key"
				class="nav-btn"
				:class="item.key === active ? 'nav-btn-active' : 'nav-btn-idle'"
				@click="onTap(index)"
			>
				<image
					class="nav-icon"
					:src="item.key === active ? item.iconActive : item.icon"
					:style="'width:' + item.iconWidth + 'rpx;height:' + item.iconHeight + 'rpx'"
				/>
				<text class="nav-text" :class="item.key === active ? 'nav-text-active' : ''">{{ item.text }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { BottomNavItem } from './navItem.uts'

	/** 导航项定义（含目标路径）：导航数据与页面跳转均由本组件统一管理，页面仅需传入 active */
	const items : BottomNavItem[] = [
		{
			key: 'home',
			text: '首页',
			icon: '/static/icons/home.svg',
			iconActive: '/static/icons/home-active.svg',
			iconWidth: 31,
			iconHeight: 31,
			path: '/pages/index/index'
		} as BottomNavItem,
		{
			key: 'bookshelf',
			text: '书架',
			icon: '/static/icons/bookshelf.svg',
			iconActive: '/static/icons/bookshelf-active.svg',
			iconWidth: 38,
			iconHeight: 38,
			path: '/pages/reading/bookshelf'
		} as BottomNavItem,
		{
			key: 'mine',
			text: '我的',
			icon: '/static/icons/mine.svg',
			iconActive: '/static/icons/mine-active.svg',
			iconWidth: 31,
			iconHeight: 31,
			path: '/pages/user/settings'
		} as BottomNavItem
	]

	const props = defineProps<{
		/** 当前激活项 key（home / bookshelf / mine） */
		active: string
	}>()

	const emit = defineEmits(['change'])

	function onTap(index: number) : void {
		// 每次点击均通知页面（如书架页借此关闭浮层菜单）
		emit('change', index)
		if (items[index].key === props.active) {
			return
		}
		const target : BottomNavItem = items[index]
		const targetRoute : string = target.path.substring(1)
		// 目标页已在页面栈中则回退到该层，否则替换当前页，页面栈深恒定不增长
		const pages = getCurrentPages()
		for (let i = pages.length - 1; i >= 0; i--) {
			if (pages[i].route === targetRoute) {
				uni.navigateBack({ delta: pages.length - 1 - i })
				return
			}
		}
		uni.redirectTo({ url: target.path })
	}
</script>

<style lang="scss">
	/* 定位层：悬浮于视口底部（fixed 全端一致：App 相对页面、小程序/Web 相对视口，不随内容滚动） */
	.navbar-layer {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 46rpx;
		flex-direction: row;
		justify-content: center;
	}

	/* 白色胶囊容器（Stitch 原始文件: 343x54, 内留白 7, 项间距 23.1, 圆角 pill, 描边 弱文本/10%） */
	.navbar-pill {
		width: 660rpx;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 13rpx;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-pill;
		border: 1px solid rgba($bai-mute, 0.1);
		box-shadow: $bai-shadow-nav;
	}

	/* 导航项：左右各留 22rpx，相邻两项间距 44rpx（Figma 23.1px），两端空隙由容器居中产生 */
	.nav-btn {
		margin-left: 22rpx;
		margin-right: 22rpx;
	}

	/* 激活项：墨黑胶囊（Figma: padding 10x20, gap 8, 背景 墨黑令牌） */
	.nav-btn-active {
		flex-direction: row;
		align-items: center;
		padding: 20rpx 38rpx;
		background-color: $bai-ink;
		border-radius: $bai-rounded-pill;
	}

	/* 未激活项：透明底（Figma: padding 10x16, gap 6） */
	.nav-btn-idle {
		flex-direction: row;
		align-items: center;
		padding: 20rpx 31rpx;
		border-radius: $bai-rounded-pill;
	}

	.nav-text {
		margin-left: 12rpx;
		font-size: 27rpx;
		line-height: 38rpx;
		font-weight: 600;
		color: $bai-ink;
	}

	.nav-text-active {
		margin-left: 15rpx;
		color: $bai-on-primary;
	}
</style>

<template>
	<!-- 实高占位层：宽度与各页主内容列同口径（Web 480 / 其余 750，条件编译），
		 宽屏时返回键对齐内容列左缘而非视口缘；按钮以 margin-top 撑开状态栏高度、随层占位。
		 原为「零高锚定层 + absolute 越界」：vdom 原生渲染下越界子元素被裁剪（绘制与触摸同时失效，
		 真机返回键点击无效的根因），改实高占位后无越界即无裁剪。
		 Web 端不渲染返回键（2026-10-22：浏览器自带返回，站内返回图标冗余；阅读页不受影响——
		 reader/pdfreader 返回键在各自页面内实现，不经本组件） -->
	<view class="back-button">
		<!-- #ifndef WEB -->
		<view class="back-button__inner" :style="'margin-top:' + topPx + 'px'" @click="handleClick">
			<image class="back-button__icon" src="/static/icons/arrow-back.svg" mode="aspectFit" />
		</view>
		<!-- #endif -->
	</view>
</template>

<script setup lang="uts">
	/**
	 * BackButton —— 次级页面返回按钮组件
	 * 全项目唯一返回图标 arrow-back.svg（墨色），定位规则：状态栏高度驱动（margin-top 撑位），
	 * 左上角（锚定限宽内容列）。页面栈为空（如分享直达）时回退首页。
	 * vdom 实测（规范 3.4）：absolute 越界子元素在原生渲染下被裁剪，按钮必须实高占位。
	 */

	// 距顶部偏移（px）：取系统状态栏高度，Web 端无状态栏回退 44
	const topPx = ref(44)
	const win = uni.getWindowInfo()
	if (win.statusBarHeight > 0) {
		topPx.value = win.statusBarHeight
	}

	function handleClick() : void {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/index/index' })
		}
	}
</script>

<style lang="scss">
	.back-button {
		width: 100%;
		/* #ifdef WEB */
		max-width: 480px;
		/* #endif */
		/* #ifndef WEB */
		max-width: 750px;
		/* #endif */
		margin-left: auto;
		margin-right: auto;
	}

	.back-button__inner {
		/* App 端 80rpx 恒等于 40px（rpx 钳 750），按钮区总高 = 状态栏 + 40px，与原悬浮设计等距 */
		margin-left: 48rpx;
		width: 80rpx;
		height: 80rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.back-button__icon {
		width: 80rpx;
		height: 80rpx;
	}
</style>

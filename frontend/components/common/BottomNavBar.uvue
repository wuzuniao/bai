<template>
	<view class="navbar-layer">
		<view class="navbar-pill">
			<view
				v-for="(item, index) in items"
				:key="item.key"
				class="nav-btn"
				:class="item.key === active ? 'nav-btn-active' : 'nav-btn-idle'"
				@click="onTap(index)"
			>
				<image
					class="nav-icon"
					:src="item.key === active ? item.iconActive : item.icon"
					:style="'width:' + item.iconWidth + 'rpx;height:' + item.iconHeight + 'rpx'"
				/>
				<text class="nav-text" :class="item.key === active ? 'nav-text-active' : ''">{{ navText(item.key) }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import type { BottomNavItem } from './navItemDefs.ts'
	import { t } from '@/utils/i18n.uts'
	// 词典注册（底部导航文案）
	import '@/utils/locales/common.uts'

	/** 导航项定义（含目标路径）：导航数据与页面跳转均由本组件统一管理，页面仅需传入 active；
	 *  文案经 navText 动态取词（随语言切换） */
	const items : BottomNavItem[] = [
		{
			key: 'home',
			icon: '/static/icons/home.svg',
			iconActive: '/static/icons/home-active.svg',
			iconWidth: 31,
			iconHeight: 31,
			path: '/pages/index/index'
		} as BottomNavItem,
		{
			key: 'bookshelf',
			icon: '/static/icons/bookshelf.svg',
			iconActive: '/static/icons/bookshelf-active.svg',
			iconWidth: 38,
			iconHeight: 38,
			path: '/pages/reading/bookshelf'
		} as BottomNavItem,
		{
			key: 'mine',
			icon: '/static/icons/mine.svg',
			iconActive: '/static/icons/mine-active.svg',
			iconWidth: 31,
			iconHeight: 31,
			path: '/pages/user/settings'
		} as BottomNavItem
	]

	/** 导航项文案（渲染期取词，随语言切换刷新） */
	function navText(key: string) : string {
		if (key === 'home') {
			return t('nav.home')
		}
		if (key === 'bookshelf') {
			return t('nav.bookshelf')
		}
		return t('nav.mine')
	}

	const props = defineProps<{
		/** 当前激活项 key（home / bookshelf / mine） */
		active: string
	}>()

	const emit = defineEmits(['change'])

	function onTap(index: number) : void {
		// 每次点击均通知页面（如书架页借此关闭浮层菜单）
		emit('change', index)
		if (items[index].key === props.active) {
			return
		}
		// 统一经 reLaunch 进入目标页：关闭全部页面后重开目标，任一入口均为全新实例、
		// 页面栈恒为单层（无栈残留导致的回退旧实例/动画方向不一），与 BackButton 空栈回首页同模式
		uni.reLaunch({ url: items[index].path })
	}
</script>

<style lang="scss">
	/* 定位层：悬浮于视口底部（fixed 全端一致：App 相对页面、小程序/Web 相对视口，不随内容滚动） */
	.navbar-layer {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 46rpx;
		flex-direction: row;
		justify-content: center;
	}

	/* 白色胶囊容器：宽度包裹内容（不固定宽，随文案长度自适应，中英文均贴合三个按钮） */
	.navbar-pill {
		flex-direction: row;
		align-items: center;
		padding: 13rpx 20rpx;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-pill;
		border: 1px solid rgba($bai-mute, 0.1);
	}

	/* 导航项：左右各留 12rpx（英文文案较宽，收紧边距保证中英文均收进胶囊宽度） */
	.nav-btn {
		margin-left: 12rpx;
		margin-right: 12rpx;
	}

	/* 激活项：墨黑胶囊（Figma: padding 10x20, gap 8, 背景 墨黑令牌；水平内边距收紧防英文溢出） */
	.nav-btn-active {
		flex-direction: row;
		align-items: center;
		padding: 20rpx 30rpx;
		background-color: $bai-ink;
		border-radius: $bai-rounded-pill;
	}

	/* 未激活项：透明底（Figma: padding 10x16, gap 6） */
	.nav-btn-idle {
		flex-direction: row;
		align-items: center;
		padding: 20rpx 22rpx;
		border-radius: $bai-rounded-pill;
	}

	.nav-text {
		margin-left: 12rpx;
		font-size: 27rpx;
		line-height: 38rpx;
		font-weight: 600;
		color: $bai-ink;
		lines: 1;
		text-overflow: ellipsis;
	}

	.nav-text-active {
		margin-left: 15rpx;
		color: $bai-on-primary;
	}
</style>

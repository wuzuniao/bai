<template>
	<view class="page-shell">
		<BackButton />
		<scroll-view class="page-shell__scroll" direction="vertical" :show-scrollbar="false" @scrolltolower="onScrollBottom">
			<view class="page-shell__canvas" :class="center ? 'page-shell__canvas--center' : ''" :style="'padding-top:' + mainTop + 'px' + (center && appViewportH > 0 ? ';min-height:' + appViewportH + 'px' : '')">
				<PageHeader v-if="title.length > 0" :title="title" :desc="desc" />
				<slot />
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * PageShell —— 次级页面骨架组件（返回按钮 + 滚动画布 + 页头）
	 * --------------------------------------------------------------------------
	 * 收敛 user 子包与活动页共用的页面壳：BackButton 定位（组件实高占位，vdom 越界
	 * 裁剪见规范 3.4）、画布左右 48rpx/底部 64rpx 内边距与 PageHeader。
	 * center=true 用于登录/注册/找回等表单页（画布垂直居中 + 占满视口高）；
	 * title 传空串时不渲染 PageHeader（标题在卡片内的页面）。
	 * 站内信页为原生滚动（onReachBottom 触底分页）不适用本组件；reward 页边距
	 * 为 Stitch 390 基准（38rpx）亦不套用。
	 * scrolltolower 事件向上转发：宿主页触底懒加载分页（如阅读统计页排行列表），
	 * 不监听的页面无影响。
	 */
	import BackButton from '@/components/common/BackButton.uvue'
	import PageHeader from '@/components/common/PageHeader.uvue'

	const props = defineProps<{
		/** 页头主标题（空串不渲染页头） */
		title: string
		/** 页头副标题/描述 */
		desc: string
		/** 画布垂直居中（登录/注册/找回表单页） */
		center: boolean
	}>()

	const emit = defineEmits(['scrolltolower'])

	// 画布顶部留白：非 Web 端返回按钮已实高占位（状态栏 + 40px），画布只留按钮下 12px
	const mainTop = ref(12)
	// Web 端不渲染返回键，页头距顶 32px
	// #ifdef WEB
	mainTop.value = 32
	// #endif
	/** App 视口高（px）：App 不支持 min-height: 100vh，表单页居中所需最小高度由窗口高注入 */
	const appViewportH = ref(0)
	// #ifdef APP
	appViewportH.value = uni.getWindowInfo().windowHeight
	// #endif

	function onScrollBottom() : void {
		emit('scrolltolower')
	}
</script>

<style lang="scss">
	.page-shell {
		flex: 1;
		position: relative;
		background-color: $bai-canvas-soft;
	}

	.page-shell__scroll {
		flex: 1;
	}

	.page-shell__canvas {
		width: 100%;
		/* #ifdef WEB */
		max-width: 480px;
		/* #endif */
		/* #ifndef WEB */
		max-width: 750px;
		/* #endif */
		margin-left: auto;
		margin-right: auto;
		padding-left: 48rpx;
		padding-right: 48rpx;
		padding-bottom: 64rpx;
		box-sizing: border-box;
		flex-direction: column;
	}

	/* 表单页画布：垂直居中并占满视口（登录/注册/找回；App 不支持 100vh，最小高度由 appViewportH 内联注入） */
	.page-shell__canvas--center {
		/* #ifndef APP */
		min-height: 100vh;
		/* #endif */
		padding-bottom: 72rpx;
		justify-content: center;
		align-items: center;
	}
</style>

<template>
	<view class="control-root">
		<!-- 顶部导航菜单（Stitch: 返回/书名，呼出态从顶部滑入；内容行与小程序胶囊同行） -->
		<view
			class="menu-top"
			:class="visible && !settingsOpen ? '' : 'menu-top-hidden'"
			:style="'background-color:' + theme.menuTopBg + ';border-color:' + theme.menuBorderColor + ';padding-top:' + navTop + 'px'"
		>
			<view class="menu-top-inner" :style="'height:' + navHeight + 'px'">
				<view class="menu-top-left">
					<view class="round-btn" @click="onBack">
						<image class="round-btn-icon" :src="themeIcon('arrow-back')" />
					</view>
					<text class="book-name" :style="'color:' + theme.titleColor">{{ bookTitle }}</text>
				</view>
			</view>
		</view>

		<!-- 底部控制面板（Stitch: 设置面板 + 听书悬浮球 + 三项导航，呼出态从底部滑入；抽屉打开时保持显示，三控制项不随子项变化） -->
		<view
			class="menu-bottom"
			:class="visible || drawerOpen ? '' : 'menu-bottom-hidden'"
			:style="'background-color:' + theme.menuBottomBg + ';border-color:' + theme.menuBorderColor + ';box-shadow:' + theme.panelShadow"
		>
			<!-- 目录抽屉（与设置面板一致：作为控制栏内容块向上弹出，与设置面板互斥） -->
			<view v-if="drawerOpen" class="drawer-panel" :style="'height:' + drawerPanelHeight + 'px'">
				<view class="settings-grip-row">
					<view class="settings-grip"></view>
				</view>
				<view class="drawer-header">
					<view :class="drawerTab === 'catalog' ? 'drawer-tab-active' : 'drawer-tab-plain'" @click="switchDrawerTab('catalog')">
						<text :class="drawerTab === 'catalog' ? 'drawer-tab-title' : 'drawer-tab-plain'">目录</text>
						<text v-if="drawerTab === 'catalog'" class="drawer-tab-sort" @click="onSortTap($event)">{{ orderDesc ? '↓↑' : '⇅' }}</text>
					</view>
					<view :class="drawerTab === 'note' ? 'drawer-tab-active' : 'drawer-tab-plain'" @click="switchDrawerTab('note')">
						<text :class="drawerTab === 'note' ? 'drawer-tab-title' : 'drawer-tab-plain'">想法/划线</text>
					</view>
					<view :class="drawerTab === 'bookmark' ? 'drawer-tab-active' : 'drawer-tab-plain'" @click="switchDrawerTab('bookmark')">
						<text :class="drawerTab === 'bookmark' ? 'drawer-tab-title' : 'drawer-tab-plain'">书签</text>
					</view>
				</view>
				<scroll-view class="drawer-list" direction="vertical" :show-scrollbar="false">
					<!-- 目录页 -->
					<view v-if="drawerTab === 'catalog'">
						<view
							v-for="(ch, ci) in displayChapters"
							:key="ch.id"
							class="chapter-item"
							@click="onSelectChapter(ch)"
						>
							<text class="chapter-item-text" :class="ch.active ? 'chapter-item-text-active' : ''" :style="'color:' + (ch.active ? theme.activeBlue : theme.chapterTextColor)">{{ ch.title }}</text>
						</view>
					</view>
					<!-- 想法/划线页：划线记录卡片（宿主 notes 随划线与取消划线实时同步） -->
					<view v-else-if="drawerTab === 'note'">
						<view v-if="notes.length == 0" class="bookmark-empty">
							<text class="bookmark-empty-text" :style="'color:' + theme.mutedColor">暂无划线记录，长按正文即可划线</text>
						</view>
						<view
							v-for="(r, ri) in notes"
							:key="ri"
							class="note-item"
							@click="onGoNote(r)"
						>
							<text class="note-item-text" :style="'color:' + theme.mutedColor">{{ r.quote }}</text>
							<text v-if="r.content.length > 0" class="note-item-content" :style="'color:' + theme.chapterTextColor">{{ r.content }}</text>
						</view>
					</view>
					<!-- 书签页 -->
					<view v-else>
						<view v-if="bookmarks.length == 0" class="bookmark-empty">
							<text class="bookmark-empty-text" :style="'color:' + theme.mutedColor">书签列表为空，正文下滑即可添加书签</text>
						</view>
						<view
							v-for="(bm, bi) in bookmarks"
							:key="bi"
							class="bookmark-item"
							@click="onGoBookmark(bm)"
						>
							<image class="bookmark-item-icon" :src="themeIcon('reader-bookmark-active')" />
							<text class="bookmark-item-text" :style="'color:' + theme.chapterTextColor">{{ bookmarkLabel(bm) }}</text>
						</view>
					</view>
				</scroll-view>
			</view>
			<!-- 设置面板（Stitch: 字号/背景/翻页，展开时隐藏顶栏与听书球） -->
			<view v-if="settingsOpen" class="settings-panel">
				<view class="settings-grip-row">
					<view class="settings-grip"></view>
				</view>
				<view class="settings-row">
					<text class="settings-label" :style="'color:' + theme.mutedColor">字号</text>
					<view class="settings-row-body">
						<view class="stepper-group">
							<view class="stepper-btn" :style="'background-color:' + theme.controlBg + ';border-color:' + theme.controlBorder" @click="changeFontSize(-1)">
								<text class="stepper-text" :style="'color:' + theme.controlText">A⁻</text>
							</view>
							<text class="stepper-val" :style="'color:' + theme.titleColor">{{ fontSize }}</text>
							<view class="stepper-btn" :style="'background-color:' + theme.controlBg + ';border-color:' + theme.controlBorder" @click="changeFontSize(1)">
								<text class="stepper-text" :style="'color:' + theme.controlText">A⁺</text>
							</view>
						</view>
						<view class="font-btn" :style="'background-color:' + theme.controlBg + ';border-color:' + theme.controlBorder" @click="toggleFontList">
							<text class="font-btn-text" :style="'color:' + theme.controlText">{{ fontListOpen ? '请选择' : currentFontLabel }}</text>
						</view>
					</view>
				</view>
				<!-- 字体选择列表（选择后点保存本地持久化） -->
				<view v-if="fontListOpen" class="font-select">
					<view class="font-select-list">
						<view
							v-for="(f, fi) in fontOptions"
							:key="f.key"
							class="page-turn-btn font-option"
							:class="pendingFontKey === f.key ? 'page-turn-active' : 'page-turn-idle'"
							:style="pendingFontKey === f.key ? '' : 'background-color:' + theme.controlBg + ';border-color:' + theme.controlBorder"
							@click="selectFont(f.key)"
						>
							<text class="page-turn-text" :class="pendingFontKey === f.key ? 'page-turn-text-active' : ''" :style="pendingFontKey === f.key ? '' : 'color:' + theme.controlText">{{ f.label }}</text>
						</view>
					</view>
					<view class="font-save-row">
						<view class="font-cancel-btn" @click="cancelFontSelect">
							<text class="font-cancel-btn-text">取消</text>
						</view>
						<view class="font-save-btn" :style="nightMode ? 'background-color:#f3f4f6' : ''" @click="saveFont">
							<text class="font-save-btn-text" :style="nightMode ? 'color:#0e0f0c' : ''">保存</text>
						</view>
					</view>
				</view>
				<view class="settings-row">
					<text class="settings-label" :style="'color:' + theme.mutedColor">背景</text>
					<view class="settings-row-body">
						<view class="swatch-group">
							<view
								class="swatch swatch-white"
								:class="selectedBg === READER_THEME_LIGHT.readerBg ? 'swatch-active' : ''"
								@click="changeReaderBg(READER_THEME_LIGHT.readerBg)"
							></view>
							<view
								class="swatch swatch-milky"
								:class="selectedBg === READER_THEME_PAPER.readerBg ? 'swatch-active' : ''"
								@click="changeReaderBg(READER_THEME_PAPER.readerBg)"
							></view>
						</view>
					</view>
				</view>
				<view class="settings-row">
					<text class="settings-label" :style="'color:' + theme.mutedColor">翻页</text>
					<view class="page-turn-group">
						<view
							v-for="(m, mi) in pageTurnModes"
							:key="mi"
							class="page-turn-btn"
							:class="pageTurn === m ? 'page-turn-active' : 'page-turn-idle'"
							:style="pageTurn === m ? '' : 'background-color:' + theme.controlBg + ';border-color:' + theme.controlBorder"
							@click="selectPageTurn(m)"
						>
							<text class="page-turn-text" :class="pageTurn === m ? 'page-turn-text-active' : ''" :style="pageTurn === m ? '' : 'color:' + theme.controlText">{{ m }}</text>
						</view>
					</view>
				</view>
			</view>
			<!-- 听书悬浮球（Stitch: 黑底 64px 圆，"听" 28px/900，设置/抽屉展开时隐藏） -->
			<view v-if="!settingsOpen && !drawerOpen" class="listen-wrap">
				<view class="listen-btn" @click="onListen">
					<text class="listen-text">听</text>
				</view>
			</view>
			<!-- 底部三项导航（Stitch: 目录/夜间/设置） -->
			<view class="bottom-nav">
				<view class="bottom-nav-btn" @click="onToggleDrawer">
					<image class="bottom-nav-icon" :src="themeIcon('reader-catalog')" />
					<text class="bottom-nav-text" :style="'color:' + theme.titleColor">目录</text>
				</view>
				<view class="bottom-nav-btn" @click="toggleNightMode">
					<image class="bottom-nav-icon" :src="nightMode ? '/static/icons/reader-sun.svg' : themeIcon('reader-moon')" />
					<text class="bottom-nav-text" :style="'color:' + theme.titleColor">{{ nightMode ? '白天' : '夜晚' }}</text>
				</view>
				<view class="bottom-nav-btn" @click="onToggleSettings">
					<image class="bottom-nav-icon" :src="themeIcon('reader-settings')" />
					<text class="bottom-nav-text" :style="'color:' + theme.titleColor">设置</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { READER_THEME_LIGHT, READER_THEME_NIGHT, READER_THEME_PAPER, ReaderTheme } from '@/utils/theme.uts'
	import { Chapter, Bookmark, NoteRecord, ReaderSettings, FONT_OPTIONS, fontOptionOf, loadSettings, saveSettings, loadBookmarks, saveBookmarksToStorage } from '@/utils/readerTypes.uts'

	/**
	 * ReaderControl —— 阅读页上下控制框（可复用组件）
	 * --------------------------------------------------------------
	 * 职责：单击正文呼出的顶部导航菜单（返回/书名）与底部控制面板
	 * （目录抽屉[目录/想法划线/书签三页签] + 设置面板[字号/字体/背景/翻页] +
	 * 听书悬浮球 + 目录/夜间/设置三项导航）的渲染与功能。
	 * 设置真源在组件：字号/字体/背景/翻页/日夜的调节动作、持久化
	 * （reader_settings / reader_font）与提示全部内聚，变更经 change
	 * 事件上行宿主应用渲染（宿主持镜像驱动排版/主题）。
	 * 书签真源在组件：添加/移除（宿主下拉手势落定经 ref 调
	 * addBookmark/removeBookmark）、持久化（reader_bookmarks）与目录
	 * 卡片展示内聚，变更经 bookmarksChanged 事件通知宿主重读（旗帜渲染）。
	 * 目录点击/书签跳转/想法卡片跳转经事件上行（导航与正文渲染耦合宿主）。
	 */
	const props = defineProps<{
		/** 菜单呼出态（单击正文空白切换） */
		visible: boolean
		/** 设置面板展开（展开时隐藏顶栏与听书球） */
		settingsOpen: boolean
		/** 目录抽屉打开（抽屉打开时底栏保持显示） */
		drawerOpen: boolean
		/** 顶部导航书名 */
		bookTitle: string
		/** 目录章节列表（正序全量；当前章高亮由 activeChapterId 驱动） */
		chapters: Chapter[]
		/** 当前阅读章节 id（目录高亮） */
		activeChapterId: number
		/** 想法/划线记录卡片列表（宿主按划线/想法本地存储派生） */
		notes: NoteRecord[]
	}>()

	const emit = defineEmits(['back', 'toggleDrawer', 'toggleSettings', 'listen', 'selectChapter', 'goBookmark', 'goNote', 'toast', 'change', 'bookmarksChanged'])

	/** ===== 阅读设置（真源：组件内调节/持久化，change 事件上行宿主应用渲染） ===== */
	/** 当前主题 key：light / night / paper */
	const themeKey = ref('light')
	/** 正文字号（12-36） */
	const fontSize = ref(18)
	/** 当前翻页模式 */
	const pageTurn = ref('滚动')
	/** 当前生效字体 key */
	const fontKey = ref('sourcehan')
	/** 当前背景色（与主题色板比较决定选中态） */
	const selectedBg = ref(READER_THEME_LIGHT.readerBg)

	/** 翻页模式选项（APP 端多「仿真」） */
	// #ifdef APP
	const pageTurnModes = ['滚动', '仿真', '覆盖', '平移']
	// #endif
	// #ifndef APP
	const pageTurnModes = ['滚动', '覆盖', '平移']
	// #endif

	/** 恢复本地设置（宿主自行恢复渲染镜像，两侧读同一存储真源保持一致；翻页模式做端侧支持校验，历史"仿真"设置在非 APP 端回退默认） */
	{
		const s = loadSettings()
		fontSize.value = s.fontSize
		pageTurn.value = pageTurnModes.indexOf(s.pageTurn) >= 0 ? s.pageTurn : pageTurnModes[0]
		themeKey.value = s.theme
		selectedBg.value = s.theme == 'paper' ? READER_THEME_PAPER.readerBg : (s.theme == 'night' ? READER_THEME_NIGHT.readerBg : READER_THEME_LIGHT.readerBg)
		// 字体沿用独立 key（历史版本存储结构不变）
		const storedFont : any = uni.getStorageSync('reader_font')
		if (typeof storedFont == 'string') {
			const key = storedFont as string
			for (let i = 0; i < FONT_OPTIONS.length; i++) {
				if (FONT_OPTIONS[i].key == key) {
					fontKey.value = key
					break
				}
			}
		}
	}

	/** 字体选项与当前生效字体名（按钮展示） */
	const fontOptions = FONT_OPTIONS
	const currentFontLabel = computed(() : string => {
		return fontOptionOf(fontKey.value).label
	})

	/** 主题（成组解析自 utils/theme.uts：正文/浮层/遮罩/控件色） */
	const theme = computed<ReaderTheme>(() : ReaderTheme => {
		if (themeKey.value == 'night') {
			return READER_THEME_NIGHT
		}
		if (themeKey.value == 'paper') {
			return READER_THEME_PAPER
		}
		return READER_THEME_LIGHT
	})
	const nightMode = computed(() : boolean => {
		return themeKey.value == 'night'
	})

	/** 变更上行：设置载荷通知宿主应用渲染 */
	function emitChange() : void {
		emit('change', {
			fontSize: fontSize.value,
			pageTurn: pageTurn.value,
			theme: themeKey.value,
			fontKey: fontKey.value
		} as ReaderSettings)
	}

	/** 字号调节（12-36 钳制 + 持久化 + 上行） */
	function changeFontSize(delta : number) : void {
		const next = fontSize.value + delta
		if (next < 12 || next > 36) {
			return
		}
		fontSize.value = next
		saveSettings({ fontSize: fontSize.value, pageTurn: pageTurn.value, theme: themeKey.value, fontKey: fontKey.value } as ReaderSettings)
		emitChange()
	}

	/** 应用字体选择（更新生效字体并持久化） */
	function applyFont(key : string) : void {
		fontKey.value = key
		uni.setStorageSync('reader_font', key)
		emitChange()
		emit('toast', '字体已保存')
	}

	/** 背景色板切换（正文与标题色随主题成组切换，由宿主应用） */
	function changeReaderBg(bg : string) : void {
		selectedBg.value = bg
		const key = bg == READER_THEME_PAPER.readerBg ? 'paper' : 'light'
		themeKey.value = key
		saveSettings({ fontSize: fontSize.value, pageTurn: pageTurn.value, theme: themeKey.value, fontKey: fontKey.value } as ReaderSettings)
		emitChange()
	}

	/** 翻页模式选择（Stitch: 单选高亮 + toast） */
	function selectPageTurn(mode : string) : void {
		pageTurn.value = mode
		saveSettings({ fontSize: fontSize.value, pageTurn: pageTurn.value, theme: themeKey.value, fontKey: fontKey.value } as ReaderSettings)
		emitChange()
		emit('toast', '已切换至【' + mode + '】模式')
	}

	/** 日/夜切换（主题成组切换） */
	function toggleNightMode() : void {
		themeKey.value = nightMode.value ? 'light' : 'night'
		selectedBg.value = nightMode.value ? READER_THEME_NIGHT.readerBg : READER_THEME_LIGHT.readerBg
		saveSettings({ fontSize: fontSize.value, pageTurn: pageTurn.value, theme: themeKey.value, fontKey: fontKey.value } as ReaderSettings)
		emitChange()
		emit('toast', nightMode.value ? '已切换至夜晚模式' : '已切换至白天模式')
	}

	/** 主题图标路径：夜间使用 -light 白色变体 */
	function themeIcon(name: string) : string {
		return '/static/icons/' + name + (nightMode.value ? '-light' : '') + '.svg'
	}

	/** 顶部导航内容行（px）：与小程序胶囊同行对齐（状态栏高度起、行高 40px） */
	const navTop = ref(44)
	const navHeight = ref(40)
	/** 目录抽屉高度（px）：抽屉顶对齐小程序控制项（胶囊）下方 8px，并扣除控制行自身高度（152rpx） */
	const drawerPanelHeight = ref(500)
	{
		const win = uni.getWindowInfo()
		if (win.statusBarHeight > 0) {
			navTop.value = win.statusBarHeight
		}
		const navH = uni.upx2px(152)
		// #ifdef MP-WEIXIN
		const capsule = uni.getMenuButtonBoundingClientRect()
		if (capsule.height > 0) {
			drawerPanelHeight.value = win.windowHeight - (capsule.top + capsule.height + 8) - navH
		} else {
			drawerPanelHeight.value = win.windowHeight - (navTop.value + navHeight.value + 8) - navH
		}
		// #endif
		// #ifndef MP-WEIXIN
		drawerPanelHeight.value = win.windowHeight - (navTop.value + navHeight.value + 8) - navH
		// #endif
	}

	/** 目录安全读取：越界或数据未注入时返回空壳章（书签文案兜底） */
	function chapterAt(id : number) : Chapter {
		const c = props.chapters[id]
		if (c != null) {
			return c
		}
		return { id: id, title: '', label: '', contentTitle: '', active: false } as Chapter
	}

	/** 书签条目文案（章节标题 · 第 N 页，页码 1-based 展示） */
	function bookmarkLabel(bm : Bookmark) : string {
		const ch = chapterAt(bm.chapterId)
		return ch.title + ' · 第 ' + (bm.pageIndex + 1) + ' 页'
	}

	/** ===== 书签（真源：组件内增删/持久化，目录卡片直接展示；宿主经 ref 调增删） ===== */
	const bookmarks = ref<Bookmark[]>([])
	{
		bookmarks.value = loadBookmarks()
	}

	/** 当前页是否已有书签 */
	function indexOfBookmark(chapterId : number, pageIndex : number) : number {
		for (let i = 0; i < bookmarks.value.length; i++) {
			const b = bookmarks.value[i]
			if (b.chapterId == chapterId && b.pageIndex == pageIndex) {
				return i
			}
		}
		return -1
	}

	/** 添加当前页书签（宿主下拉落定调用；已有则忽略） */
	function addBookmark(chapterId : number, pageIndex : number) : void {
		if (indexOfBookmark(chapterId, pageIndex) >= 0) {
			return
		}
		bookmarks.value.push({ chapterId: chapterId, pageIndex: pageIndex } as Bookmark)
		saveBookmarksToStorage(bookmarks.value)
		emit('bookmarksChanged')
	}

	/** 移除当前页书签（宿主上推落定调用；无则忽略） */
	function removeBookmark(chapterId : number, pageIndex : number) : void {
		const i = indexOfBookmark(chapterId, pageIndex)
		if (i < 0) {
			return
		}
		bookmarks.value.splice(i, 1)
		saveBookmarksToStorage(bookmarks.value)
		emit('bookmarksChanged')
	}

	defineExpose({
		addBookmark,
		removeBookmark
	})

	/** ===== 目录抽屉（页签/排序为面板内 UI 状态，组件自管理） ===== */
	const drawerTab = ref('catalog')
	const orderDesc = ref(false)

	/** 目录正/倒序展示（Stitch: ⇅/↓↑ 切换；当前阅读章节蓝色高亮由 activeChapterId 驱动） */
	const displayChapters = computed<Chapter[]>(() : Chapter[] => {
		const marked = props.chapters.map((c : Chapter) : Chapter => {
			return { id: c.id, title: c.title, label: c.label, contentTitle: c.contentTitle, active: c.id == props.activeChapterId } as Chapter
		})
		if (!orderDesc.value) {
			return marked
		}
		return marked.slice().reverse()
	})

	/** 抽屉页签切换 */
	function switchDrawerTab(tab : string) : void {
		drawerTab.value = tab
	}

	/** 目录页签排序箭头：阻止冒泡（防触发父级页签切换）后切换正/倒序 */
	function onSortTap(e : UniPointerEvent) : void {
		e.stopPropagation()
		orderDesc.value = !orderDesc.value
		emit('toast', orderDesc.value ? '已切换至倒序排列' : '已切换至正序排列')
	}

	/** ===== 设置面板：字体列表（面板内 UI 状态，保存动作组件内持久化） ===== */
	const fontListOpen = ref(false)
	/** 字体列表中的待保存选择 */
	const pendingFontKey = ref('sourcehan')

	/** 展开/收起字体列表（展开时待保存选择重置为当前生效值） */
	function toggleFontList() : void {
		fontListOpen.value = !fontListOpen.value
		pendingFontKey.value = fontKey.value
	}

	function selectFont(key : string) : void {
		pendingFontKey.value = key
	}

	/** 保存字体选择（收起列表并应用/持久化） */
	function saveFont() : void {
		fontListOpen.value = false
		applyFont(pendingFontKey.value)
	}

	/** 取消字体选择：放弃待保存选择并收起列表 */
	function cancelFontSelect() : void {
		pendingFontKey.value = fontKey.value
		fontListOpen.value = false
	}

	/** ===== 交互事件上行（导航类耦合宿主正文，设置/夜间已在组件内处理） ===== */
	function onBack() : void {
		emit('back')
	}

	function onToggleDrawer() : void {
		emit('toggleDrawer')
	}

	function onToggleSettings() : void {
		emit('toggleSettings')
	}

	function onListen() : void {
		emit('listen')
	}

	function onSelectChapter(ch : Chapter) : void {
		emit('selectChapter', ch.id)
	}

	function onGoBookmark(bm : Bookmark) : void {
		emit('goBookmark', bm)
	}

	function onGoNote(r : NoteRecord) : void {
		emit('goNote', r)
	}
</script>

<style lang="scss">
	/* 组件根：零尺寸占位（不设 flex 参与宿主 flex 流挤压正文），子浮层（absolute）相对宿主页面相对定位容器定位 */
	.control-root {
		width: 0;
		height: 0;
	}

	/* 顶部导航菜单（Stitch: 毛玻璃背景、底边框、底部圆角 16px，呼出/隐藏滑移动效） */
	.menu-top {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		/* 内容行高与顶部内边距由内联绑定（状态栏起 40px 行，与胶囊垂直居中对齐） */
		padding-left: 38rpx;
		padding-right: 38rpx;
		padding-bottom: 27rpx;
		border-bottom-width: 1px;
		border-bottom-style: solid;

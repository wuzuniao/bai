		border-bottom-right-radius: $bai-rounded-lg;
		z-index: 40;
		transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.menu-top-hidden {
		transform: translateY(-110%);
		opacity: 0;
	}

	.menu-top-inner {
		flex-direction: row;
		align-items: center;
	}

	.menu-top-left {
		flex-direction: row;
		align-items: center;
		gap: 23rpx;
	}

	/* 返回按钮与其他子页统一：图标 80rpx */
	.round-btn {
		width: 80rpx;
		height: 80rpx;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.round-btn-icon {
		width: 80rpx;
		height: 80rpx;
	}

	.book-name {
		font-size: 29rpx;
		font-weight: 600;
	}

	/* 底部控制面板（令牌: 顶部圆角 xl 24px、毛玻璃、浮层提升阴影，呼出/隐藏滑移动效） */
	.menu-bottom {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		border-top-left-radius: $bai-rounded-xl;
		border-top-right-radius: $bai-rounded-xl;
		z-index: 30;
		/* 投影内联绑定（夜间切换白色微光） */
		transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.menu-bottom-hidden {
		transform: translateY(110%);
		opacity: 0;
	}

	/* 设置面板（Stitch: 顶部药丸指示器 + 字号/背景/翻页三行） */
	.settings-panel {

<template>
	<view class="sp-root">
		<!-- 划词手柄（选区两端水滴形大手柄：拖动调节选中范围，触摸热区大于视觉体便于拖动；锚点实测完成后才显示，避免位置跳变） -->
		<template v-if="bubbleVisible">
			<view
				id="sel-handle-start"
				class="sel-handle sel-handle-start"
				:style="'left:' + handleStartLeft + 'px;top:' + handleStartTop + 'px'"
				@touchstart="onStartHandleTouchStart"
				@touchmove="onStartHandleTouchMove"
				@touchend="onStartHandleTouchEnd"
				@touchcancel="onStartHandleTouchEnd"
			>
				<view class="sel-handle-drop"></view>
				<view class="sel-handle-tip sel-handle-tip-down"></view>
			</view>
			<view
				id="sel-handle-end"
				class="sel-handle sel-handle-end"
				:style="'left:' + handleEndLeft + 'px;top:' + handleEndTop + 'px'"
				@touchstart="onEndHandleTouchStart"
				@touchmove="onEndHandleTouchMove"
				@touchend="onEndHandleTouchEnd"
				@touchcancel="onEndHandleTouchEnd"
			>
				<view class="sel-handle-tip sel-handle-tip-up"></view>
				<view class="sel-handle-drop"></view>
			</view>
		</template>
		<!-- 划词气泡（Stitch: 黑底圆角 12px 内边距 12x8，操作项竖排图标+文字；位置由内联绑定——水平对准选区中心、垂直置于选区上/下侧，箭头随朝向指向选区） -->
		<view
			v-if="bubbleVisible"
			class="selection-popover"
			:style="'left:' + popoverLeft + 'px;top:' + popoverTop + 'px'"
			@click="emit('dismiss')"
		>
			<!-- 气泡在选区下方时三角贴体顶朝上 -->
			<view
				v-if="below"
				class="popover-arrow popover-arrow-above"
				:style="'margin-left:' + arrowLeft + 'px;background-color:' + bg"
			></view>
			<view class="popover-body" :class="twoLine ? 'popover-body-two' : ''" :style="'background-color:' + bg">
				<template v-if="twoLine">
					<view class="popover-row">
						<view class="popover-btn" @click="onAction($event, 'copy')">
							<image class="popover-icon" src="/static/icons/popover-copy.svg" />
							<text class="popover-text">复制</text>
						</view>
						<view class="popover-divider"></view>
						<view class="popover-btn" @click="onAction($event, 'idea')">
							<image class="popover-icon" src="/static/icons/popover-idea.svg" />
							<text class="popover-text">写想法</text>
						</view>
						<view class="popover-divider"></view>
						<view class="popover-btn" @click="onAction($event, 'underline')">
							<image class="popover-icon" src="/static/icons/popover-underline.svg" />
							<text class="popover-text">划线</text>
						</view>
					</view>
					<view class="popover-divider-h"></view>
					<view class="popover-row">
						<view class="popover-btn" @click="onAction($event, 'query')">
							<image class="popover-icon" src="/static/icons/popover-query.svg" />
							<text class="popover-text">查询</text>
						</view>
						<view class="popover-divider"></view>
						<view class="popover-btn" @click="onAction($event, 'share')">
							<image class="popover-icon" src="/static/icons/popover-share.svg" />
							<text class="popover-text">分享</text>
						</view>
					</view>
				</template>
				<template v-else>
					<view class="popover-btn" @click="onAction($event, 'copy')">
						<image class="popover-icon" src="/static/icons/popover-copy.svg" />
						<text class="popover-text">复制</text>
					</view>
					<view class="popover-divider"></view>
					<view class="popover-btn" @click="onAction($event, 'idea')">
						<image class="popover-icon" src="/static/icons/popover-idea.svg" />
						<text class="popover-text">写想法</text>
					</view>
					<view class="popover-divider"></view>
					<view class="popover-btn" @click="onAction($event, 'underline')">
						<image class="popover-icon" src="/static/icons/popover-underline.svg" />
						<text class="popover-text">划线</text>
					</view>
					<view class="popover-divider"></view>
					<view class="popover-btn" @click="onAction($event, 'query')">
						<image class="popover-icon" src="/static/icons/popover-query.svg" />
						<text class="popover-text">查询</text>
					</view>
					<view class="popover-divider"></view>
					<view class="popover-btn" @click="onAction($event, 'share')">
						<image class="popover-icon" src="/static/icons/popover-share.svg" />
						<text class="popover-text">分享</text>
					</view>
				</template>
			</view>
			<!-- 气泡在选区上方时三角贴体底朝下 -->
			<view
				v-if="!below"
				class="popover-arrow popover-arrow-below"
				:style="'margin-left:' + arrowLeft + 'px;background-color:' + bg"
			></view>
		</view>

		<!-- 想法查看（锚定划线下方/上方只读浮层：仅展示想法内容，超长内部滚动，点击任意处关闭；宿主经 ref 调 showThoughtView 打开） -->
		<view v-if="cardOpen" class="thought-view-mask" @click="closeCard">
			<view
				class="thought-view-panel"
				:style="'left:' + cardLeft + 'px;top:' + cardTop + 'px;width:' + cardW + 'px;background-color:' + panelBg + ';box-shadow:' + shadow"
				@click="closeCard"
			>
				<scroll-view scroll-y class="thought-view-scroll" :style="'max-height:' + cardMaxH + 'px'">
					<text class="thought-view-content" :style="'color:' + contentColor">{{ cardContent }}</text>
				</scroll-view>
			</view>
		</view>

		<!-- 想法编辑器（多行输入框浮层：上方双引号引用高亮文本，确认后保存想法到本地存储并同步划线；点击拦截已移除避免微信端 textarea 聚焦失效） -->
		<view v-if="editorOpen" class="thought-mask">
			<view class="thought-dialog">
				<text class="thought-title">写想法</text>
				<view class="thought-quote">
					<text class="thought-quote-text" :style="'color:' + quoteColor"><text class="thought-quote-mark">“</text>{{ editorQuote }}<text class="thought-quote-mark">”</text></text>
				</view>
				<textarea
					class="thought-input"
					v-model="editorInput"
					placeholder="写下你的想法…"
					:maxlength="10000"
					:focus="editorFocus"
					auto-height
					:style="'max-height:' + editorMaxH + 'px'"
				/>
				<view class="thought-actions">
					<view class="thought-btn-cancel" @click="cancelEditor">
						<text class="thought-btn-cancel-text">取消</text>
					</view>
					<view class="thought-btn-confirm" @click="confirmEditor">
						<text class="thought-btn-confirm-text">保存</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 分享卡片预览（头像半出卡片顶部正中/产品名/引文渐出/想法预览限高滚动；导出为全量长图；分享按钮仅微信端） -->
		<view v-if="shareOpen" class="share-mask" @click="closeShare">
			<view class="share-pop">
				<view class="share-card">
					<text class="share-card-app">无足鸟古诗词学习助手</text>
					<scroll-view scroll-y class="share-card-scroll" :style="'max-height:' + shareCardMaxH + 'px'">
						<text class="share-card-text"><text class="share-ctx-far">{{ shareData.farBefore }}</text><text class="share-ctx-near">{{ shareData.nearBefore }}</text><text class="share-quote-mark">“</text><text class="share-quote-main">{{ shareData.quote }}</text><text class="share-quote-mark">”</text><text class="share-ctx-near">{{ shareData.nearAfter }}</text><text class="share-ctx-far">{{ shareData.farAfter }}</text></text>
						<view v-if="shareData.thoughtText.length > 0" class="share-card-thought">
							<text class="share-card-thought-text">{{ shareData.thoughtText }}</text>
						</view>
					</scroll-view>
					<text class="share-card-source">《{{ shareData.bookTitle }}》 · {{ shareData.source }}</text>
				</view>
				<view class="share-card-logo-ring">
					<image class="share-card-logo" :src="logoSrc" />
				</view>
				<view class="share-actions">
					<view class="share-action" @click="saveShareImage">
						<text class="share-action-text">保存为图片</text>
					</view>
					<!-- #ifdef MP-WEIXIN -->
					<button class="share-action share-action-share" open-type="share">
						<text class="share-action-text share-action-text-primary">分享</text>
					</button>
					<!-- #endif -->
				</view>
			</view>
		</view>

		<!-- 分享卡片绘制画布（隐藏，仅用于导出图片） -->
		<canvas id="share-canvas" type="2d" class="share-canvas"></canvas>
	</view>
</template>

<script setup lang="uts">
	import { getCurrentInstance } from 'vue'
	import { SelSpan, SpanSeg, TextMetrics, ParaRect, Thought, ShareQuoteCtx, comparePos, normalizeSpan, applySpanUnderlineToStorage, saveThought, rowSpacing } from '@/utils/readerTypes.uts'

	/**
	 * SelectionPopover —— 阅读页划词气泡（可复用组件）
	 * --------------------------------------------------------------
	 * 职责：划词子系统 + 五项划词功能的完整实现。
	 * 划词：选区状态/手柄（渲染、拖动、触摸事件）/句间吸附/气泡显隐
	 *       全部内聚。宿主长按正文完成 rect 查询与字符换算后经 ref 调
	 *       beginSelection() 建立选区（正文锚点零宽字符与拖动段落矩形
	 *       在宿主模板内，跨组件查询不可行，由宿主查询后经
	 *       setAnchorRects/setDragRects 回传组件吸附换算）；选区变化
	 *       emit('spanChanged') 供宿主渲染高亮镜像。
	 * 复制：写入剪贴板（微信端系统提示，其他端页面内提示）。
	 * 划线：本地存储区间运算（切换式：完全覆盖取消、否则并入），存储 key
	 *       reader_underlines 为真源。
	 * 写想法：内置编辑器浮层，确认后想法写入 reader_thoughts、选区区间
	 *         确保划线（add=true 并入），随后一并持久化。
	 * 查询：占位提示。
	 * 分享：内置分享卡片预览浮层与隐藏 canvas，保存为相册长图（排版与
	 *       预览 CSS 换算一致），微信端经 button open-type=share 转发。
	 * 划线/想法写入后 emit('sync') 通知宿主重读本地存储刷新渲染（正文
	 * 划线与目录抽屉卡片）；选区清除经 emit('dismiss')，提示经 emit('toast')。
	 * 选区上下文（文本/段序列/分享快照）由宿主按选区计算下行。
	 */
	const props = defineProps<{
		/** 气泡底色（随主题，夜间提亮） */
		bg: string
		/** 正文区顶部起点（px，气泡上置下界） */
		navTop: number
		/** 页面宽高（px，钳制与双行判定） */
		pageW: number
		pageH: number
		/** 排版度量（每行字数/行高/字距，宿主随字号与屏宽下行，划词换算用） */
		metrics: TextMetrics
		/** 选区覆盖段序列（宿主按选区与各章段落展开；划线按项写入所在章） */
		segs: SpanSeg[]
		/** 选区文本（跨段拼接，宿主计算） */
		text: string
		/** 分享卡片内容快照（宿主按选区计算；null=无选区不可分享） */
		shareCtx: ShareQuoteCtx | null
		/** 分享卡片头像路径（宿主按登录态映射，未登录默认头像） */
		logoSrc: string
		/** 引用文本颜色（随主题，想法编辑器引用块） */
		quoteColor: string
		/** 想法查看卡片面板底色（随主题，夜间深色浮层） */
		panelBg: string
		/** 想法查看卡片内容文字色（随主题） */
		contentColor: string
		/** 浮层投影（随主题，想法查看卡片沿用底栏投影） */
		shadow: string
	}>()

	const emit = defineEmits(['sync', 'dismiss', 'toast', 'thoughtViewClosed', 'spanChanged', 'dragStarted', 'queryAnchors'])

	/** 气泡定位（px，视口坐标）：体中心跟随焦点（钳制屏幕内），垂直优先上方、空间不足转下方 */
	const popoverLeft = ref(0)
	const popoverTop = ref(0)
	/** 气泡是否位于选区下方（箭头朝上指向选区） */
	const below = ref(false)
	/** 箭头在气泡体内的水平位置（px，相对气泡体左缘，钳制不悬空） */
	const arrowLeft = ref(0)
	/** 气泡体尺寸缓存（内容固定，显示后查询一次校正；未就绪用估算值兜底） */
	let popoverW = 0
	let popoverH = 0
	let popoverMeasured = false
	const POPOVER_EST_W = 230
	const POPOVER_EST_H = 52
	/** 气泡双行布局：五项单行所需宽超过屏宽可用宽时切换，按屏宽判定一次 */
	const twoLine = ref(false)
	{
		const needW = uni.upx2px(449) + 24
		const availW = props.pageW - uni.upx2px(48)
		twoLine.value = needW > availW
	}

	/** ===== 划词子系统（选区状态/手柄/拖动/句间吸附内聚；正文锚点与段落矩形由宿主查询回传） ===== */
	/** 划词选区（跨段选区：从起点段/字符到终点段/字符的闭区间） */
	const selSpan = ref<SelSpan | null>(null)
	/** 起点段视口位置（px，长按时缓存；滚动/翻页/字号变化即清选区防止手柄错位） */
	const selRectLeft = ref(0)
	const selRectTop = ref(0)
	/** 手柄位置（px，视口坐标，随选区端点更新） */
	const handleStartLeft = ref(0)
	const handleStartTop = ref(0)
	const handleEndLeft = ref(0)
	const handleEndTop = ref(0)
	/** 选区几何（px，视口坐标，气泡定位用）：估算即时填充，锚点实测后覆盖为真实值 */
	const selTopPx = ref(0)
	const selBottomPx = ref(0)
	/** 手柄热区/视觉体尺寸（rpx）：热区大于视觉体便于拖动 */
	const HANDLE_HOT_RPX = 76
	const HANDLE_VISUAL_RPX = 50
	/** 手柄拖动状态（触摸目标在 touchstart 时锁定，move/end 持续派发至该手柄；响应式供气泡显隐联动） */
	const dragStartActive = ref(false)
	const dragEndActive = ref(false)
	/** 箭头指向的视口 x：长按触点位置，拖动手柄后为被拖端的新边界 */
	const selFocusX = ref(0)
	/** 最后操作的手柄端：0=未拖动（箭头指长按触点）/ -1=起点 / 1=终点 */
	let lastDragEnd = 0
	/** 选区已实测定位（锚点测量完成后手柄/气泡才出现，避免估算兜底位置跳变为实测位置） */
	const selectionLaidOut = ref(false)
	/** 宿主回传的锚点实测矩形（起点/终点，齐备后吸附） */
	let pendingAnchorStart : NodeInfo | null = null
	let pendingAnchorEnd : NodeInfo | null = null
	/** 宿主回传的拖动段落视口矩形（拖动开始时宿主查询回传） */
	let dragRects : ParaRect[] = []
	/** 建立选区时缓存的起点段文本长度（同段选区手柄估算用） */
	let beginParaLen = 0
	/** 气泡显示：有选区且已实测定位、不在拖动手柄中（拖动中隐藏，松手按新选区重定位显示） */
	const bubbleVisible = computed(() : boolean => {
		return selSpan.value != null && selectionLaidOut.value && !dragStartActive.value && !dragEndActive.value
	})

	/** 字符边界视口坐标（[x, y]）：isEnd=末字符右缘/其行底，否则首字符左缘/其行顶；字距按所在行取满行均分/末行自然值 */
	function charEdgePos(charIdx : number, isEnd : boolean, len : number) : number[] {
		const m = props.metrics
		const maxRow = Math.max(0, Math.floor((len - 1) / m.perLine))
		const row = Math.max(0, Math.min(Math.floor(charIdx / m.perLine), maxRow))
		const col = charIdx - row * m.perLine
		const spacing = rowSpacing(m, len, maxRow, row)
		const lineTop = selRectTop.value + row * m.lineH
		const x = selRectLeft.value + (isEnd ? (col + 1) * spacing : col * spacing)
		return [x, isEnd ? lineTop + m.lineH : lineTop]
	}

	/** 按选区端点估算刷新手柄与选区几何（即时显示兜底；跨段选区估算失效，由锚点实测定位） */
	function updateHandles() : void {
		const s = selSpan.value
		if (s == null) {
			return
		}
		if (s.fromOrigin != s.toOrigin || s.fromCid != s.toCid) {
			return
		}
		const hotH = uni.upx2px(HANDLE_HOT_RPX)
		const visH = uni.upx2px(HANDLE_VISUAL_RPX)
		// 选区同段内才能按排版估算；段长为建立选区时宿主提供的起点段文本长度
		const len = beginParaLen
		if (len <= 0) {
			return
		}
		const sp = charEdgePos(s.fromStart, false, len)
		handleStartLeft.value = sp[0] - hotH / 2
		handleStartTop.value = sp[1] - visH
		const ep = charEdgePos(s.toEnd, true, len)
		handleEndLeft.value = ep[0] - hotH / 2
		handleEndTop.value = ep[1] - hotH + visH
		selTopPx.value = sp[1]
		selBottomPx.value = ep[1]
	}

	/** 两个锚点实测矩形齐备后吸附：手柄贴真实字符边界，选区几何与气泡随之精化 */
	function applyAnchors() : void {
		const s = pendingAnchorStart
		const e = pendingAnchorEnd
		if (selSpan.value == null || s == null || e == null) {
			return
		}
		const hotH = uni.upx2px(HANDLE_HOT_RPX)
		const visH = uni.upx2px(HANDLE_VISUAL_RPX)
		handleStartLeft.value = s.left - hotH / 2
		handleStartTop.value = s.top - visH
		handleEndLeft.value = e.right - hotH / 2
		handleEndTop.value = e.bottom - hotH + visH
		selTopPx.value = s.top
		selBottomPx.value = e.bottom
		// 拖动过手柄后箭头指向被拖端的新边界，未拖动时保持指向长按触点
		if (lastDragEnd == -1) {
			selFocusX.value = s.left
		} else if (lastDragEnd == 1) {
			selFocusX.value = e.right
		}
		// 实测完成，手柄与气泡以精确位置首次显示
		selectionLaidOut.value = true
	}

	/** 手柄拖动（跨段）：触点映射到段落与字符并更新被拖端点；越过另一端时端点互换（原生选择交互）；拖动中手柄视觉跟随手指，松手后由锚点实测吸附真实边界 */
	function applyHandleDrag(e : UniTouchEvent, isEnd : boolean) : void {
		const span = selSpan.value
		if (e.touches.length == 0 || span == null || dragRects.length == 0) {
			return
		}
		const m = props.metrics
		const touch = e.touches[0]
		// 触点命中段落（纵向区间，未命中钳制首末段）
		let idx = -1
		for (let i = 0; i < dragRects.length; i++) {
			if (touch.clientY >= dragRects[i].top && touch.clientY <= dragRects[i].bottom) {
				idx = i
				break
			}
		}
		if (idx < 0) {
			idx = touch.clientY < dragRects[0].top ? 0 : dragRects.length - 1
		}
		const pr = dragRects[idx]
		// 拖动到的段落长度：以段序列口径不可用（跨章/跨段展开顺序≠rect 顺序），由宿主随矩形回传段长
		const len = pr.len
		if (len <= 0) {
			return
		}
		const maxRow = Math.max(0, Math.floor((len - 1) / m.perLine))
		let row = Math.floor((touch.clientY - pr.top) / m.lineH)
		row = Math.max(0, Math.min(row, maxRow))
		let col = Math.floor((touch.clientX - pr.left) / rowSpacing(m, len, maxRow, row))
		col = Math.max(0, Math.min(col, m.perLine - 1))
		const charIdx = Math.min(row * m.perLine + col, len - 1)
		if (isEnd) {
			// 终点柄：新位置在起点之前则互换端点，否则更新终点
			if (comparePos(pr.cid, pr.origin, charIdx, span.fromCid, span.fromOrigin, span.fromStart) >= 0) {
				span.toCid = pr.cid
				span.toOrigin = pr.origin
				span.toEnd = charIdx
			} else {
				span.toCid = span.fromCid
				span.toOrigin = span.fromOrigin
				span.toEnd = span.fromStart
				span.fromCid = pr.cid
				span.fromOrigin = pr.origin
				span.fromStart = charIdx
			}
		} else {
			// 起点柄：新位置在终点之后则互换端点，否则更新起点
			if (comparePos(pr.cid, pr.origin, charIdx, span.toCid, span.toOrigin, span.toEnd) <= 0) {
				span.fromCid = pr.cid
				span.fromOrigin = pr.origin
				span.fromStart = charIdx
			} else {
				span.fromCid = span.toCid
				span.fromOrigin = span.toOrigin
				span.fromStart = span.toEnd
				span.toCid = pr.cid
				span.toOrigin = pr.origin
				span.toEnd = charIdx
			}
		}
		const hotH = uni.upx2px(HANDLE_HOT_RPX)
		// 箭头焦点跟随触点（跨段拖动时气泡随手指移动，避免停留在旧位置无法点击）
		selFocusX.value = touch.clientX
		if (isEnd) {
			handleEndLeft.value = touch.clientX - hotH / 2
			handleEndTop.value = touch.clientY - hotH / 2
		} else {
			handleStartLeft.value = touch.clientX - hotH / 2
			handleStartTop.value = touch.clientY - hotH / 2
		}
		// 选区端点变化上行（宿主渲染高亮与派生上下文）
		emit('spanChanged', span)
	}

	function onStartHandleTouchStart() : void {
		dragStartActive.value = true
		lastDragEnd = -1
		emit('dragStarted')
	}

	function onStartHandleTouchMove(e : UniTouchEvent) : void {
		if (dragStartActive.value) {
			applyHandleDrag(e, false)
		}
	}

	function onStartHandleTouchEnd() : void {
		dragStartActive.value = false
		emit('queryAnchors')
	}

	function onEndHandleTouchStart() : void {
		dragEndActive.value = true
		lastDragEnd = 1
		emit('dragStarted')
	}

	function onEndHandleTouchMove(e : UniTouchEvent) : void {
		if (dragEndActive.value) {
			applyHandleDrag(e, true)
		}
	}

	function onEndHandleTouchEnd() : void {
		dragEndActive.value = false
		emit('queryAnchors')
	}

	/** 建立选区（宿主长按正文完成 rect 查询/字符换算/想法恢复/句界计算后调用）：状态建立、手柄估算、请求锚点实测 */
	function beginSelection(span : SelSpan, rectLeft : number, rectTop : number, focusX : number, paraLen : number) : void {
		selRectLeft.value = rectLeft
		selRectTop.value = rectTop
		beginParaLen = paraLen
		selSpan.value = normalizeSpan(span)
		emit('spanChanged', selSpan.value)
		// 箭头初始指向长按触点位置
		selFocusX.value = focusX
		lastDragEnd = 0
		// 复位定位标记：手柄与气泡等锚点实测完成后才出现（估算位置仅作兜底，避免先显示估算位置再跳到实测位置）
		selectionLaidOut.value = false
		pendingAnchorStart = null
		pendingAnchorEnd = null
		updateHandles()
		emit('queryAnchors')
		// 锚点测量异常兜底：仍以估算位置显示手柄与气泡，保证功能可用
		setTimeout(() => {
			if (selSpan.value != null && !selectionLaidOut.value) {
				selectionLaidOut.value = true
			}
		}, 250)
	}

	/** 宿主回传锚点实测矩形（which：0=起点锚点 / 1=终点锚点；齐备后吸附） */
	function setAnchorRects(which : number, r : NodeInfo | null) : void {
		if (which == 0) {
			pendingAnchorStart = r
		} else {
			pendingAnchorEnd = r
		}
		applyAnchors()
	}

	/** 宿主回传拖动段落视口矩形（拖动开始时宿主查询正文段落并回传） */
	function setDragRects(rects : ParaRect[]) : void {
		dragRects = rects
	}

	/** 清除选区（滚动/翻页/字号变化/跳转等场景宿主调用）：状态复位并联动收起想法查看卡片 */
	function hideSelection() : void {
		selSpan.value = null
		selectionLaidOut.value = false
		pendingAnchorStart = null
		pendingAnchorEnd = null
		dragRects = []
		hideThoughtView()
		emit('spanChanged', null)
	}

	/** 按选区几何重定位（估算兜底按布局模式区分，实测后以真实尺寸校正） */
	function relocate() : void {
		if (!bubbleVisible.value) {
			return
		}
		const selTop = selTopPx.value
		const selBottom = selBottomPx.value
		const w = popoverW > 0 ? popoverW : (twoLine.value ? uni.upx2px(290) : POPOVER_EST_W)
		const h = popoverH > 0 ? popoverH : (twoLine.value ? 100 : POPOVER_EST_H)
		// 上下间距避开手柄视觉体：起点柄悬于行顶上方、终点柄圆头垂于行底下方，另留 16rpx 呼吸空隙
		const hotH = uni.upx2px(76)
		const visH = uni.upx2px(50)
		const gapUp = visH + uni.upx2px(16)
		const gapDown = hotH - visH + uni.upx2px(16)
		const arrowH = uni.upx2px(13)
		// 水平：气泡体中心跟随焦点位置，两侧留边钳制不出屏
		const margin = uni.upx2px(24)
		popoverLeft.value = Math.max(margin, Math.min(selFocusX.value - w / 2, props.pageW - margin - w))
		// 垂直：上方放得下置上方；否则取上下空间宽裕侧（下方时箭头朝上）
		const topSpace = selTop - gapUp - arrowH - h
		const bottomSpace = props.pageH - selBottom - gapDown - arrowH - h
		if (topSpace >= props.navTop || topSpace >= bottomSpace) {
			below.value = false
			popoverTop.value = Math.max(props.navTop, selTop - gapUp - arrowH - h)
		} else {
			below.value = true
			popoverTop.value = Math.min(selBottom + gapDown + arrowH, props.pageH - h - uni.upx2px(60))
		}
		// 箭头（20rpx 方块）指向焦点：焦点在气泡体内时对准其位置、出体时钳到边缘，左缘再扣半宽
		const arrowMargin = uni.upx2px(30)
		const arrowCenter = Math.max(arrowMargin, Math.min(selFocusX.value - popoverLeft.value, w - arrowMargin))
		arrowLeft.value = arrowCenter - uni.upx2px(10)
	}

	watch(
		[bubbleVisible, () => selTopPx.value, () => selBottomPx.value, () => selFocusX.value],
		() => {
			relocate()
			if (bubbleVisible.value && !popoverMeasured) {
				setTimeout(() => {
					measure()
				}, 80)
			}
		}
	)

	/** 查询气泡体实际尺寸并校正定位（内容固定仅查一次，查询失败允许重试；组件内查询必须 .in 实例） */
	function measure() : void {
		uni.createSelectorQuery().in(getCurrentInstance()!.proxy!).select('.popover-body').boundingClientRect((rect : NodeInfo | null) : void => {
			if (rect != null && rect.width > 0 && rect.height > 0) {
				popoverW = rect.width
				popoverH = rect.height
				popoverMeasured = true
				relocate()
			}
		}).exec()
	}

	/** 延迟清选区（复制/查询操作后留出感知时间） */
	function delayDismiss() : void {
		setTimeout(() => {
			emit('dismiss')
		}, 500)
	}

	/** 气泡操作分发（阻止冒泡避免触发容器点击清选区） */
	function onAction(e : UniPointerEvent, action : string) : void {
		e.stopPropagation()
		if (action === 'copy') {
			doCopy()
		} else if (action === 'idea') {
			// 打开想法编辑器（多行输入框），确认后保存想法并同步划线；编辑期间保留选区
			openEditor()
		} else if (action === 'underline') {
			doUnderline()
		} else if (action === 'query') {
			emit('toast', '查询功能即将上线')
			delayDismiss()
		} else if (action === 'share') {
			openShare()
		}
	}

	/** 复制：选区文本写入剪贴板（微信端系统强制「内容已复制」提示，只保留系统提示） */
	function doCopy() : void {
		const content = props.text
		if (content.length == 0) {
			return
		}
		// #ifdef MP-WEIXIN
		uni.setClipboardData({
			data: content,
			fail: () => {
				emit('toast', '复制失败，请重试')
			}
		})
		// #endif
		// #ifndef MP-WEIXIN
		uni.setClipboardData({
			data: content,
			showToast: false,
			success: () => {
				emit('toast', '已复制到剪贴板')
			},
			fail: () => {
				emit('toast', '复制失败，请重试')
			}
		})
		// #endif
		delayDismiss()
	}

	/** 划线：选区段序列逐段做区间切换（已完全划线取消、否则并入）并持久化，随后通知宿主重读 */
	function doUnderline() : void {
		if (props.segs.length == 0) {
			return
		}
		applySpanUnderlineToStorage(props.segs, false)
		emit('sync')
		emit('dismiss')
	}

	/** ===== 想法查看（点击划线弹出的只读卡片：宿主命中想法经 ref 调 showThoughtView 打开，定位/实测/关闭内聚） ===== */
	const cardOpen = ref(false)
	const cardLeft = ref(0)
	const cardTop = ref(0)
	/** 面板宽度（px，视口坐标）：左右留边后的满宽 */
	const cardW = ref(0)
	/** 面板内容最大高度（px，屏高的 35%，超出内部滚动） */
	const cardMaxH = computed(() : number => props.pageH * 0.35)
	const cardContent = ref('')
	let cardH = 0
	const CARD_EST_H = 150
	/** 打开时锚定的划线段视口上下界（实测校正后重定位用） */
	let cardSelBottom = 0
	let cardSelTop = 0

	/** 按划线段视口几何定位：下方放得下置下方；否则取上下空间宽裕侧并钳制不出屏 */
	function positionCard(selBottom : number, selTop : number) : void {
		const margin = uni.upx2px(24)
		cardLeft.value = margin
		cardW.value = props.pageW - margin * 2
		const gap = uni.upx2px(16)
		const h = cardH > 0 ? cardH : CARD_EST_H
		const bottomSpace = props.pageH - selBottom - gap - h
		const topSpace = selTop - gap - h
		if (bottomSpace >= uni.upx2px(60) || bottomSpace >= topSpace) {
			cardTop.value = Math.min(selBottom + gap, props.pageH - h - uni.upx2px(40))
		} else {
			cardTop.value = Math.max(props.navTop, selTop - gap - h)
		}
	}

	/** 面板显示后实测高度并校正垂直定位（想法长度不同高度不同，每次打开都测；组件内查询须 .in 实例） */
	function measureCard() : void {
		uni.createSelectorQuery().in(getCurrentInstance()!.proxy!).select('.thought-view-panel').boundingClientRect((rect : NodeInfo | null) : void => {
			if (rect != null && rect.height > 0) {
				cardH = rect.height
				positionCard(cardSelBottom, cardSelTop)
			}
		}).exec()
	}

	/** 打开想法查看卡片（宿主页面点击划线段命中想法时调用） */
	function showThoughtView(quote : string, content : string, selBottom : number, selTop : number) : void {
		cardSelBottom = selBottom
		cardSelTop = selTop
		cardContent.value = content
		positionCard(selBottom, selTop)
		cardOpen.value = true
		setTimeout(() => {
			measureCard()
		}, 80)
	}

	/** 关闭想法查看卡片（供宿主在清选区/字号变化等场景联动收起） */
	function hideThoughtView() : void {
		cardOpen.value = false
	}

	/** 点击遮罩/面板任意处关闭：通知宿主复位点击协调标志 */
	function closeCard() : void {
		cardOpen.value = false
		emit('thoughtViewClosed')
	}

	/** 宿主页面调用入口：划词建立/清除与锚点、拖动矩形回传，想法查看卡片开关 */
	defineExpose({
		beginSelection,
		hideSelection,
		setAnchorRects,
		setDragRects,
		showThoughtView,
		hideThoughtView
	})

	/** ===== 写想法（编辑器浮层内聚） ===== */
	const editorOpen = ref(false)
	const editorInput = ref('')
	/** textarea 聚焦控制：微信端打开后延时置 true 拉起键盘（渲染期设置无效） */
	const editorFocus = ref(false)
	/** 打开时的划线文本快照（微信端冒泡清选区不影响） */
	const editorQuote = ref('')
	/** 想法输入框最大高度（px）：屏高的 40%，auto-height 随内容增长到此封顶（内部滚动） */
	const editorMaxH = computed(() : number => props.pageH * 0.4)

	function openEditor() : void {
		editorQuote.value = props.text
		editorInput.value = ''
		editorFocus.value = false
		editorOpen.value = true
		setTimeout(() => {
			editorFocus.value = true
		}, 150)
	}

	function confirmEditor() : void {
		const content = editorInput.value.trim()
		if (content.length == 0) {
			emit('toast', '请输入想法内容')
			return
		}
		const segs = props.segs
		if (segs.length == 0) {
			closeEditor()
			return
		}
		// 想法选区区间 = 段序列首末项（起点段起点字符 → 终点段终点字符）
		const first = segs[0]
		const last = segs[segs.length - 1]
		saveThought({
			fromCid: first.cid,
			fromOrigin: first.origin,
			fromStart: first.start,
			toCid: last.cid,
			toOrigin: last.origin,
			toEnd: last.end,
			quote: editorQuote.value,
			content: content
		} as Thought)
		// 同步将选中区域划线（已划线则保持）并持久化
		applySpanUnderlineToStorage(segs, true)
		closeEditor()
		emit('sync')
		emit('dismiss')
	}

	/** 取消写想法：关闭编辑器并清除选区 */
	function cancelEditor() : void {
		closeEditor()
		emit('dismiss')
	}

	function closeEditor() : void {
		editorOpen.value = false
		editorFocus.value = false
		editorInput.value = ''
	}

	/** ===== 分享（卡片预览浮层 + canvas 导出长图内聚） ===== */
	const shareOpen = ref(false)
	/** 打开分享时的内容快照（渲染与绘制共用非空数据） */
	const shareData = ref<ShareQuoteCtx>({
		farBefore: '',
		nearBefore: '',
		quote: '',
		nearAfter: '',
		farAfter: '',
		thoughtText: '',
		source: '',
		bookTitle: ''
	} as ShareQuoteCtx)
	/** 分享卡片预览滚动区最大高度（px）：屏高的 45% */
	const shareCardMaxH = computed(() : number => props.pageH * 0.45)

	function openShare() : void {
		const c = props.shareCtx
		if (c == null) {
			return
		}
		shareData.value = {
			farBefore: c.farBefore,
			nearBefore: c.nearBefore,
			quote: c.quote,
			nearAfter: c.nearAfter,
			farAfter: c.farAfter,
			thoughtText: c.thoughtText,
			source: c.source,
			bookTitle: c.bookTitle
		} as ShareQuoteCtx
		shareOpen.value = true
	}

	function closeShare() : void {
		shareOpen.value = false
	}

	/** 绘制排版常量（与预览 CSS 逐项换算：rpx 值减半为 px） */
	const SHARE_CARD_W = 295.0
	const SHARE_CARD_TOP = 29.0
	const SHARE_HEADER_H = 30.0
	const SHARE_PAD = 15.5
	const SHARE_TEXT_X = SHARE_PAD
	const SHARE_TEXT_W = SHARE_CARD_W - SHARE_PAD * 2
	const SHARE_LINE_H = 21.0
	const SHARE_BASE12 = 10.0
	const SHARE_BASE10 = 8.5
	const SHARE_RING_R = 23.0
	const SHARE_LOGO_R = 20.0
	const SHARE_INK = '#0e0f0c'

	/** 分享卡片绘制辅助：文本按宽度折行（\n 强制换行保留段落结构；返回行数组，供画布高度预算与逐行绘制） */
	function wrapCanvasLines(ctx : CanvasRenderingContext2D, text : string, maxW : number, font : string) : string[] {
		ctx.font = font
		const lines : string[] = []
		let line = ''
		for (let i = 0; i < text.length; i++) {
			const ch = text.charAt(i)
			if (ch == '\n') {
				lines.push(line)
				line = ''
				continue
			}
			if (ctx.measureText(line + ch).width > maxW && line.length > 0) {
				lines.push(line)
				line = ch
			} else {
				line = line + ch
			}
		}
		if (line.length > 0) {
			lines.push(line)
		}
		return lines
	}

	/** 分享卡片绘制辅助：逐行绘制（yTop 为首行行盒顶，与预览 text 行盒模型一致；baseline 为字号对应基线偏移），返回块底 yTop */
	function drawCanvasLines(ctx : CanvasRenderingContext2D, lines : string[], x : number, yTop : number, lineH : number, font : string, color : string, baseline : number) : number {
		ctx.font = font
		ctx.fillStyle = color
		let top = yTop
		for (const line of lines) {
			ctx.fillText(line, x, top + baseline)
			top += lineH
		}
		return top
	}

	/** 分享卡片富文本运行段（字号/加粗/颜色/内容） */
	type ShareRun = {
		text : string
		fs : number
		bold : boolean
		color : string
	}

	/** 富文本行（行内运行段顺序混排，基线对齐） */
	type RenderLine = {
		runs : ShareRun[]
	}

	function shareRunFont(r : ShareRun) : string {
		return (r.bold ? 'bold ' : '') + r.fs + 'px sans-serif'
	}

	/** 富文本流式折行排版（逐字符测量、\n 强制换行、行内同款运行段合并），返回行数组 */
	function layoutShareRuns(ctx : CanvasRenderingContext2D, runs : ShareRun[], maxW : number) : RenderLine[] {
		const out : RenderLine[] = []
		let curRuns : ShareRun[] = [] as ShareRun[]
		let curW = 0.0
		const pushLine = () : void => {
			if (curRuns.length > 0) {
				out.push({ runs: curRuns } as RenderLine)
				curRuns = [] as ShareRun[]
				curW = 0.0
			}
		}
		for (const run of runs) {
			ctx.font = shareRunFont(run)
			for (let i = 0; i < run.text.length; i++) {
				const ch = run.text.charAt(i)
				if (ch == '\n') {
					pushLine()
					continue
				}
				const w = ctx.measureText(ch).width
				if (curW + w > maxW && curW > 0) {
					pushLine()
				}
				const last = curRuns.length > 0 ? curRuns[curRuns.length - 1] : null
				if (last != null && last.fs == run.fs && last.bold == run.bold && last.color == run.color) {
					last.text = last.text + ch
				} else {
					curRuns.push({ text: ch, fs: run.fs, bold: run.bold, color: run.color } as ShareRun)
				}
				curW += w
			}
		}
		pushLine()
		return out
	}

	/** 富文本行绘制（行内基线按行内最大字号对齐），返回块底 yTop */
	function drawRenderLines(ctx : CanvasRenderingContext2D, lines : RenderLine[], x : number, yTop : number, lineH : number) : number {
		let top = yTop
		for (const line of lines) {
			let maxFs = 12.5
			for (const r of line.runs) {
				if (r.fs > maxFs) {
					maxFs = r.fs
				}
			}
			const bl = top + maxFs * 0.8
			let rx = x
			for (const r of line.runs) {
				ctx.font = shareRunFont(r)
				ctx.fillStyle = r.color
				ctx.fillText(r.text, rx, bl)
				rx += ctx.measureText(r.text).width
			}
			top += lineH
		}
		return top
	}

	/** 构建引文富文本运行段（上/下文渐出 + 大引号 + 选中文本） */
	function buildShareQuoteRuns() : ShareRun[] {
		const runs : ShareRun[] = [] as ShareRun[]
		const d = shareData.value
		if (d.farBefore.length > 0) {
			runs.push({ text: d.farBefore, fs: 12.5, bold: false, color: 'rgba(14, 15, 12, 0.18)' } as ShareRun)
		}
		if (d.nearBefore.length > 0) {
			runs.push({ text: d.nearBefore, fs: 12.5, bold: false, color: 'rgba(14, 15, 12, 0.4)' } as ShareRun)
		}
		runs.push({ text: '“', fs: 20, bold: true, color: 'rgba(14, 15, 12, 0.25)' } as ShareRun)
		runs.push({ text: d.quote, fs: 13.5, bold: true, color: SHARE_INK } as ShareRun)
		runs.push({ text: '”', fs: 20, bold: true, color: 'rgba(14, 15, 12, 0.25)' } as ShareRun)
		if (d.nearAfter.length > 0) {
			runs.push({ text: d.nearAfter, fs: 12.5, bold: false, color: 'rgba(14, 15, 12, 0.4)' } as ShareRun)
		}
		if (d.farAfter.length > 0) {
			runs.push({ text: d.farAfter, fs: 12.5, bold: false, color: 'rgba(14, 15, 12, 0.18)' } as ShareRun)
		}
		return runs
	}

	/** 分享卡片布局：各块行盒顶位置与卡片/画布高度（想法块按行数占位，间距与预览 CSS 换算一致） */
	type ShareCardLayout = {
		thoughtTop : number
		sourceTop : number
		cardH : number
		H : number
	}

	function layoutShareCard(quoteLines : RenderLine[], thL : string[]) : ShareCardLayout {
		const quoteTop = SHARE_CARD_TOP + SHARE_HEADER_H + SHARE_LINE_H + 11.5
		const quoteBlockH = quoteLines.length * SHARE_LINE_H
		let thoughtTop = quoteTop + quoteBlockH + 11.5
		if (thL.length > 0) {
			thoughtTop += 1 + 9.5
		}
		const sourceTop = thoughtTop + (thL.length > 0 ? thL.length * SHARE_LINE_H : 0) + 11.5
		const cardH = sourceTop + 15.0 - SHARE_CARD_TOP
		return { thoughtTop: thoughtTop, sourceTop: sourceTop, cardH: cardH, H: SHARE_CARD_TOP + cardH } as ShareCardLayout
	}

	/** 绘制卡片底（顶部头像带浅灰 + 卡片白底）与产品名 */
	function drawShareCardBase(ctx : CanvasRenderingContext2D, cardH : number) : void {
		ctx.fillStyle = '#efefec'
		ctx.fillRect(0, 0, SHARE_CARD_W, SHARE_CARD_TOP)
		ctx.fillStyle = '#ffffff'
		ctx.fillRect(0, SHARE_CARD_TOP, SHARE_CARD_W, cardH)
		ctx.fillStyle = 'rgba(14, 15, 12, 0.45)'
		ctx.font = '12.5px sans-serif'
		ctx.textAlign = 'center'
		ctx.fillText('无足鸟古诗词学习助手', SHARE_CARD_W / 2, SHARE_CARD_TOP + SHARE_HEADER_H + SHARE_BASE12)
		ctx.textAlign = 'left'
	}

	/** 绘制引文块（富文本流式：大引号 + 上/下文渐出 + 选中文本加粗） */
	function drawShareQuoteBlock(ctx : CanvasRenderingContext2D, quoteLines : RenderLine[]) : void {
		drawRenderLines(ctx, quoteLines, SHARE_TEXT_X, SHARE_CARD_TOP + SHARE_HEADER_H + SHARE_LINE_H + 11.5, SHARE_LINE_H)
	}

	/** 绘制想法块（蓝色） */
	function drawShareThoughtBlock(ctx : CanvasRenderingContext2D, thL : string[], top : number) : void {
		drawCanvasLines(ctx, thL, SHARE_TEXT_X, top, SHARE_LINE_H, '12.5px sans-serif', '#1e40af', SHARE_BASE12)
	}

	/** 绘制出处（左对齐，与预览一致） */
	function drawShareSource(ctx : CanvasRenderingContext2D, top : number) : void {
		ctx.fillStyle = 'rgba(14, 15, 12, 0.4)'
		ctx.font = '10.5px sans-serif'
		ctx.fillText('《' + shareData.value.bookTitle + '》 · ' + shareData.value.source, SHARE_TEXT_X, top + SHARE_BASE10)
	}

	/** 绘制头像（白环包裹跨卡片顶边；withLogo=false 时以浅色圆替代） */
	function drawShareLogo(ctx : CanvasRenderingContext2D, logo : CanvasImage, withLogo : boolean) : void {
		ctx.fillStyle = '#ffffff'
		ctx.beginPath()
		ctx.arc(SHARE_CARD_W / 2, SHARE_CARD_TOP, SHARE_RING_R, 0, Math.PI * 2)
		ctx.fill()
		if (withLogo) {
			ctx.save()
			ctx.beginPath()
			ctx.arc(SHARE_CARD_W / 2, SHARE_CARD_TOP, SHARE_LOGO_R, 0, Math.PI * 2)
			ctx.clip()
			ctx.drawImage(logo, SHARE_CARD_W / 2 - SHARE_LOGO_R, SHARE_CARD_TOP - SHARE_LOGO_R, SHARE_LOGO_R * 2, SHARE_LOGO_R * 2)
			ctx.restore()
		} else {
			ctx.fillStyle = '#d9d9d5'
			ctx.beginPath()
			ctx.arc(SHARE_CARD_W / 2, SHARE_CARD_TOP, SHARE_LOGO_R, 0, Math.PI * 2)
			ctx.fill()
		}
	}

	/** 导出画布为临时图并保存到相册（单次） */
	function exportShareCanvas(canvas : CanvasNode) : void {
		uni.canvasToTempFilePath({
			canvas: canvas,
			success: (res2) => {
				uni.saveImageToPhotosAlbum({
					filePath: res2.tempFilePath,
					success: () => {
						emit('toast', '已保存到相册')
					},
					fail: () => {
						emit('toast', '保存失败，请检查相册权限')
					}
				})
			},
			fail: () => {
				emit('toast', '保存失败，请重试')
			}
		})
	}

	/** 绘制分享卡片到隐藏 canvas 并保存为长图（排版与预览 CSS 换算一致；头像半出卡片顶部白环包裹；想法全量渲染不截断） */
	function saveShareImage() : void {
		uni.createSelectorQuery().in(getCurrentInstance()!.proxy!).select('#share-canvas').fields({ node: true, size: true }, (res : any) : void => {
			if (res == null || res.node == null) {
				emit('toast', '保存失败，请重试')
				return
			}
			const canvas = res.node as CanvasNode
			const dpr = uni.getWindowInfo().pixelRatio
			const ctx = canvas.getContext('2d')
			if (ctx == null) {
				emit('toast', '保存失败，请重试')
				return
			}
			// 排版：富文本折行 + 想法折行 + 各块位置（测量在画布尺寸设定前完成，赋值后重新 scale）
			const quoteLines = layoutShareRuns(ctx, buildShareQuoteRuns(), SHARE_TEXT_W)
			const thL = shareData.value.thoughtText.length > 0 ? wrapCanvasLines(ctx, shareData.value.thoughtText, SHARE_TEXT_W, '12.5px sans-serif') : ([] as string[])
			const L = layoutShareCard(quoteLines, thL)
			canvas.width = SHARE_CARD_W * dpr
			canvas.height = L.H * dpr
			ctx.scale(dpr, dpr)
			drawShareCardBase(ctx, L.cardH)
			drawShareQuoteBlock(ctx, quoteLines)
			if (thL.length > 0) {
				drawShareThoughtBlock(ctx, thL, L.thoughtTop)
			}
			drawShareSource(ctx, L.sourceTop)
			// 头像（异步加载，完成后导出；加载失败/超时以浅色圆替代）
			let headerDrawn = false
			let exported = false
			const drawLogo = (withLogo : boolean) : void => {
				if (headerDrawn) {
					return
				}
				headerDrawn = true
				drawShareLogo(ctx, logo, withLogo)
			}
			const exportCanvas = () : void => {
				if (exported) {
					return
				}
				exported = true
				exportShareCanvas(canvas)
			}
			const logo = canvas.createImage()
			logo.src = props.logoSrc
			logo.onload = () => {
				drawLogo(true)
				exportCanvas()
			}
			logo.onerror = () => {
				drawLogo(false)
				exportCanvas()
			}
			// 加载异常兜底：超时后按浅色圆导出
			setTimeout(() => {
				drawLogo(false)
				exportCanvas()
			}, 1500)
		}).exec()
	}
</script>

<style lang="scss">
	/* 组件根：零尺寸占位（不设 flex 参与宿主 flex 流挤压正文），fixed 子浮层相对页面视口定位 */
	.sp-root {
		width: 0;
		height: 0;
	}

	/* 划词手柄（选区两端水滴形大手柄：圆头+三角尖，色取正蓝与高亮呼应；热区 76rpx 大于视觉体 50rpx 便于拖动，起点柄贴行顶、终点柄贴行底） */
	.sel-handle {
		position: fixed;
		width: 76rpx;
		height: 76rpx;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		z-index: 61;
	}

	.sel-handle-drop {
		width: 34rpx;
		height: 34rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-positive;
	}

	.sel-handle-tip {
		width: 0;
		height: 0;
		border-left-width: 12rpx;
		border-left-style: solid;
		border-left-color: transparent;
		border-right-width: 12rpx;
		border-right-style: solid;
		border-right-color: transparent;
	}

	.sel-handle-tip-down {
		border-top-width: 16rpx;
		border-top-style: solid;
		border-top-color: $bai-positive;
		margin-top: -4rpx;
	}

	.sel-handle-tip-up {
		border-bottom-width: 16rpx;
		border-bottom-style: solid;
		border-bottom-color: $bai-positive;
		margin-bottom: -4rpx;
	}

	/* 划词气泡（Stitch: 黑底圆角 12px 内边距 12x8，操作项竖排图标+文字；位置由内联绑定——水平对准选区中心、垂直置于选区上/下侧，箭头随朝向指向选区） */
	.selection-popover {
		position: fixed;
		z-index: 60;
	}

	.popover-body {
		position: relative;
		flex-direction: row;
		align-items: center;
		gap: 6rpx;
		padding: 12rpx 15rpx;
		/* 背景内联绑定（夜间提亮一档与暗底区分，日间墨黑） */
		border-radius: $bai-rounded-md;
	}

	/* 双行布局（屏宽不足以单行展开时）：行靠左、各行与按钮宽度均自适应内容，行间水平细分隔线（stretch 横贯） */
	.popover-body-two {
		flex-direction: column;
		align-items: flex-start;
		gap: 0;
	}

	.popover-row {
		flex-direction: row;
		align-items: center;
		gap: 6rpx;
	}

	.popover-divider-h {
		align-self: stretch;
		height: 1px;
		margin: 10rpx 15rpx;
		background-color: rgba($bai-on-primary, 0.2);
	}

	.popover-btn {
		flex-direction: column;
		align-items: center;
		gap: 6rpx;
		padding: 6rpx 14rpx;
	}

	.popover-icon {
		width: 31rpx;
		height: 31rpx;
	}

	.popover-text {
		font-size: 21rpx;
		font-weight: 500;
		color: $bai-on-primary;
	}

	.popover-divider {
		width: 1px;
		height: 46rpx;
		background-color: rgba($bai-on-primary, 0.2);
	}

	/* 气泡箭头（体旁旋转 45° 实色小方块：一半与体重叠（同色无缝）、露出一半形成三角尖，规避 border 三角 hack 与体圆角裁剪；水平 margin-left 内联绑定指向按住位置，颜色内联绑定与体一致） */
	.popover-arrow {
		width: 20rpx;
		height: 20rpx;
		transform: rotate(45deg);
	}

	/* 气泡在选区上方：方块贴体底，上移半格与体重叠，露出下半菱形为朝下尖 */
	.popover-arrow-below {
		margin-top: -10rpx;
	}

	/* 气泡在选区下方：方块贴体顶，下移半格与体重叠，露出下半菱形为朝上尖 */
	.popover-arrow-above {
		margin-bottom: -10rpx;
	}

	/* 想法查看（锚定划线上/下方只读浮层：透明遮罩点击关闭，面板位置/宽度内联绑定，内容超长内部滚动） */
	.thought-view-mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		z-index: 92;
	}

	.thought-view-panel {
		position: fixed;
		border-radius: $bai-rounded-lg;
		padding: 31rpx 38rpx;
	}

	.thought-view-scroll {
		flex-direction: column;
	}

	.thought-view-content {
		font-size: 29rpx;
		line-height: 46rpx;
	}

	/* 想法编辑器（多行输入框浮层：遮罩居中卡片，textarea 多行输入，取消/保存） */
	.thought-mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba($bai-ink, 0.5);
		z-index: 95;
		justify-content: center;
		align-items: center;
	}

	.thought-dialog {
		width: 590rpx;
		border-radius: $bai-rounded-lg;
		background-color: $bai-canvas;
		padding: 31rpx 31rpx 23rpx 31rpx;
	}

	.thought-title {
		font-size: 40rpx;
		font-weight: 800;
		color: $bai-ink;
		margin-bottom: 19rpx;
		text-align: center;
	}

	/* 引用块：超大双引号行内混排装饰（引号随字体度量自动基线对齐），无背景 */
	.thought-quote {
		margin-bottom: 15rpx;
	}

	.thought-quote-text {
		font-size: 25rpx;
		line-height: 38rpx;
	}

	.thought-quote-mark {
		font-size: 56rpx;
		font-weight: 800;
		color: rgba($bai-ink, 0.18);
	}

	.thought-input {
		width: 528rpx;
		min-height: 160rpx;
		font-size: 27rpx;
		line-height: 42rpx;
		color: $bai-ink;
		padding: 19rpx;
		background-color: $bai-pale;
		border-radius: $bai-rounded-sm;
	}

	.thought-actions {
		flex-direction: row;
		justify-content: flex-end;
		gap: 15rpx;
		margin-top: 19rpx;
	}

	.thought-btn-cancel {
		padding: 12rpx 38rpx;
		border-radius: $bai-rounded-pill;
		border: 1px solid $bai-pale;
	}

	.thought-btn-cancel-text {
		font-size: 25rpx;
		color: $bai-mute;
	}

	.thought-btn-confirm {
		padding: 12rpx 38rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-ink;
	}

	.thought-btn-confirm-text {
		font-size: 25rpx;
		color: $bai-on-primary;
	}

	/* 分享卡片预览（居中白卡：头像/引文渐出/想法/出处，固定日间配色便于分享） */
	.share-mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba($bai-ink, 0.6);
		z-index: 96;
		justify-content: center;
		align-items: center;
		/* 头像环一半出弹窗容器，沿途容器不裁剪 */
		overflow: visible;
	}

	.share-pop {
		position: relative;
		flex-direction: column;
		align-items: center;
		overflow: visible;
	}

	.share-card {
		width: 590rpx;
		background-color: #ffffff;
		border-radius: $bai-rounded-lg;
		padding: 62rpx 31rpx 31rpx 31rpx;
	}

	/* 头像圆环包裹（环色与卡片一致）：绝对定位钉在卡片上边框正中，一半出卡，绘制于卡片上层 */
	.share-card-logo-ring {
		position: absolute;
		top: -46rpx;
		left: 50%;
		margin-left: -46rpx;
		width: 92rpx;
		height: 92rpx;
		border-radius: $bai-rounded-pill;
		background-color: #ffffff;
		padding: 6rpx;
		z-index: 2;
	}

	.share-card-logo {
		width: 80rpx;
		height: 80rpx;
		border-radius: $bai-rounded-pill;
	}

	.share-card-app {
		font-size: 25rpx;
		color: rgba(14, 15, 12, 0.45);
		text-align: center;
		margin-bottom: 23rpx;
	}

	.share-card-scroll {
		flex-direction: column;
	}

	.share-card-text {
		font-size: 25rpx;
		line-height: 42rpx;
	}

	.share-ctx-far {
		color: rgba(14, 15, 12, 0.18);
	}

	.share-ctx-near {
		color: rgba(14, 15, 12, 0.4);
	}

	.share-quote-mark {
		font-size: 40rpx;
		font-weight: 800;
		color: rgba(14, 15, 12, 0.25);
	}

	.share-quote-main {
		font-size: 27rpx;
		font-weight: 700;
		color: #0e0f0c;
	}

	.share-card-thought {
		margin-top: 23rpx;
	}

	.share-card-thought-text {
		font-size: 25rpx;
		line-height: 42rpx;
		color: $bai-positive;
	}

	.share-card-source {
		font-size: 21rpx;
		color: rgba(14, 15, 12, 0.4);
		margin-top: 23rpx;
	}

	.share-actions {
		flex-direction: row;
		gap: 15rpx;
		margin-top: 31rpx;
		width: 590rpx;
	}

	.share-action {
		flex: 1;
		height: 80rpx;
		border-radius: $bai-rounded-pill;
		background-color: #ffffff;
		border: 1px solid rgba(14, 15, 12, 0.15);
		align-items: center;
		justify-content: center;
	}

	.share-action-text {
		font-size: 27rpx;
		color: #0e0f0c;
	}

	.share-action-share {
		background-color: #0e0f0c;
		border-color: #0e0f0c;
	}

	.share-action-text-primary {
		color: #ffffff;
	}

	/* 分享卡片绘制画布（移出屏幕外，仅用于导出图片） */
	.share-canvas {
		position: fixed;
		left: -9999px;
		top: 0;
		width: 375px;
		height: 500px;
	}
</style>

<template>
	<view class="pwd-input">
		<text class="pwd-input__label">{{ label }}</text>
		<view class="pwd-input__row" :class="error.length > 0 ? 'pwd-input__row--error' : ''">
			<input
				class="pwd-input__field"
				:value="modelValue"
				:password="!visible"
				:key="'pwd-input-' + visible"
				:placeholder="placeholder"
				:placeholder-style="PLACEHOLDER_STYLE"
				:maxlength="maxlength"
				@input="onInput"
				@blur="onBlur"
			/>
			<view class="pwd-input__eye" @click="toggle">
				<PasswordEye :visible="visible" />
			</view>
		</view>
		<text v-if="error.length > 0" class="pwd-input__error">{{ error }}</text>
	</view>
</template>

<script setup lang="uts">
	/**
	 * PasswordInput —— 密码输入组件（标签 + 密码行 + 显隐切换 + 错误提示）
	 * --------------------------------------------------------------------------
	 * 密码行统一边框容器内含输入框与 PasswordEye 眼睛图标；显隐切换内聚，
	 * :key 强制重建 input 保证 password 属性切换后微信端正确刷新；blur 上行供宿主校验。
	 */
	import { PLACEHOLDER_STYLE } from '@/utils/theme.uts'
	import PasswordEye from '@/components/form/PasswordEye.uvue'

	const props = defineProps<{
		/** 输入值（v-model） */
		modelValue: string
		/** 字段标签 */
		label: string
		/** 占位文案 */
		placeholder: string
		/** 最大输入长度 */
		maxlength: number
		/** 错误提示（空串不渲染） */
		error: string
	}>()
	const emit = defineEmits(['update:modelValue', 'blur'])

	/** 是否明文显示（默认隐藏） */
	const visible = ref(false)

	function toggle() : void {
		visible.value = !visible.value
	}

	function onInput(e : UniInputEvent) : void {
		emit('update:modelValue', e.detail.value)
	}

	function onBlur() : void {
		emit('blur')
	}
</script>

<style lang="scss">
	.pwd-input {
		flex-direction: column;
	}

	.pwd-input__label {
		margin-bottom: 16rpx;
		color: $bai-ink;
		font-size: 28rpx;
		line-height: 40rpx;
		font-weight: 400;
	}

	/* 密码行：统一边框容器，内含输入框与眼睛图标 */
	.pwd-input__row {
		position: relative;
		flex-direction: row;
		align-items: stretch;
		border: 1px solid $bai-ink;
		border-radius: $bai-rounded-md;
		background-color: $bai-canvas;
	}

	.pwd-input__row--error {
		border-color: $bai-negative;
	}

	.pwd-input__field {
		flex: 1;
		height: 98rpx;
		padding: 28rpx 24rpx 24rpx;
		box-sizing: border-box;
		border: none;
		background-color: transparent;
		border-radius: $bai-rounded-md 0 0 $bai-rounded-md;
		padding-right: 24rpx;
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 42rpx;
	}

	.pwd-input__eye {
		flex-shrink: 0;
		position: relative;
		z-index: 2;
		padding: 0 24rpx;
		border-radius: 0 $bai-rounded-md $bai-rounded-md 0;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.pwd-input__error {
		margin-top: 16rpx;
		color: $bai-negative;
		font-size: 24rpx;
		line-height: 32rpx;
	}
</style>

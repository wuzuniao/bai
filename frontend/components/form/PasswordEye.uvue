<template>
	<!-- 密码显隐眼睛图标（纯 CSS 绘制，不依赖图片资源） -->
	<view class="pwd-eye">
		<!-- 睁眼：眼形轮廓 + 瞳孔（密码明文可见） -->
		<view v-if="visible" class="pwd-eye__open">
			<view class="pwd-eye__pupil"></view>
		</view>
		<!-- 闭眼：向下弯曲的闭合弧线（密码隐藏） -->
		<view v-else class="pwd-eye__closed"></view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * PasswordEye —— 密码显隐切换眼睛图标（纯展示组件）
	 * visible=false（默认）闭眼表示密码已隐藏；visible=true 睁眼表示明文可见。
	 * 点击切换由父组件的眼睛容器处理，本组件仅负责绘制。
	 */
	defineProps<{
		/** 是否睁眼（密码明文可见） */
		visible: boolean
	}>()
</script>

<style lang="scss">
	.pwd-eye {
		width: 48rpx;
		height: 32rpx;
		justify-content: center;
		align-items: center;
	}

	/* 睁眼：上平下圆的眼形轮廓 + 中心瞳孔（对齐 yao 画法；uvue 不支持斜杠椭圆角，以正椭圆近似） */
	.pwd-eye__open {
		width: 44rpx;
		height: 28rpx;
		border: 3rpx solid $bai-body;
		border-radius: 50%;
		box-sizing: border-box;
		justify-content: center;
		align-items: center;
	}

	.pwd-eye__pupil {
		width: 14rpx;
		height: 14rpx;
		border-radius: 50%;
		background-color: $bai-body;
	}

	/* 闭眼：向下弯曲的闭合弧线（仅左右下三边 + 平缓下圆角，对齐 yao） */
	.pwd-eye__closed {
		width: 44rpx;
		height: 22rpx;
		border-left: 3rpx solid $bai-body;
		border-right: 3rpx solid $bai-body;
		border-bottom: 3rpx solid $bai-body;
		border-radius: 0 0 50% 50%;
		box-sizing: border-box;
	}
</style>

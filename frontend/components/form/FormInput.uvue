<template>
	<view class="form-input">
		<text v-if="label.length > 0" class="form-input__label">{{ label }}</text>
		<input
			class="form-input__field"
			:class="error.length > 0 ? 'form-input__field--error' : ''"
			:value="modelValue"
			:placeholder="placeholder"
			:placeholder-style="PLACEHOLDER_STYLE"
			:maxlength="maxlength"
			@input="onInput"
			@blur="onBlur"
		/>
		<text v-if="error.length > 0" class="form-input__error">{{ error }}</text>
	</view>
</template>

<script setup lang="uts">
	/**
	 * FormInput —— 表单文本输入组件（label + 输入框 + 错误提示三段结构）
	 * --------------------------------------------------------------------------
	 * 登录/注册/找回密码/个人信息各表单字段共用；blur 事件上行供宿主做失焦校验。
	 */
	import { PLACEHOLDER_STYLE } from '@/utils/theme.uts'

	const props = defineProps<{
		/** 输入值（v-model） */
		modelValue: string
		/** 字段标签（空串不渲染） */
		label: string
		/** 占位文案 */
		placeholder: string
		/** 最大输入长度 */
		maxlength: number
		/** 错误提示（空串不渲染） */
		error: string
	}>()
	const emit = defineEmits(['update:modelValue', 'blur'])

	function onInput(e : UniInputEvent) : void {
		emit('update:modelValue', e.detail.value)
	}

	function onBlur() : void {
		emit('blur')
	}
</script>

<style lang="scss">
	.form-input {
		flex-direction: column;
	}

	.form-input__label {
		margin-bottom: 16rpx;
		color: $bai-ink;
		font-size: 28rpx;
		line-height: 40rpx;
		font-weight: 400;
	}

	.form-input__field {
		height: 98rpx;
		padding: 28rpx 24rpx 24rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-md;
		border: 1px solid $bai-ink;
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 42rpx;
	}

	.form-input__field--error {
		border-color: $bai-negative;
	}

	.form-input__error {
		margin-top: 16rpx;
		color: $bai-negative;
		font-size: 24rpx;
		line-height: 32rpx;
	}
</style>

<template>
	<view class="share-root">
		<!-- 分享卡片预览（头像半出卡片顶部正中/产品名/引文分段排版与正文同参/想法预览限高滚动；导出为全量长图；分享按钮仅微信端） -->
		<view v-if="shareOpen" class="share-mask" @click="closeShare">
			<view class="share-pop">
				<view class="share-card">
					<text class="share-card-app">{{ t('sel.appName') }}</text>
					<scroll-view direction="vertical" class="share-card-scroll" :style="'max-height:' + shareCardMaxH + 'px'">
						<!-- 引文分段渲染：\n 拆段（段边界即原文段落边界）+ 段首两全角空格缩进 + 段间距，与正文段落排版同参；
						     “ 恰在段首时（无上/下文渐出）悬挂于首段缩进区内（不占文字流宽度），各段文字左缘对齐 -->
						<view
							v-for="(para, pi) in shareParas"
							:key="pi"
							class="share-para"
							:class="pi > 0 ? 'share-para-gap' : ''"
						>
							<text v-if="pi == 0 && quoteStartsAtParaStart()" class="share-quote-mark share-quote-mark-hung">“</text>
							<text class="share-card-text"><text v-for="(r, ri) in para" :key="ri" :class="r.cls">{{ r.text }}</text></text>
						</view>
						<view v-if="shareData.thoughtText.length > 0" class="share-card-thought">
							<text class="share-card-thought-text">{{ shareData.thoughtText }}</text>
						</view>
					</scroll-view>
					<text class="share-card-source">《{{ shareData.bookTitle }}》 · {{ shareData.source }}</text>
				</view>
				<view class="share-card-logo-ring">
					<image class="share-card-logo" :src="logoSrc" />
				</view>
				<!-- #ifdef MP-WEIXIN -->
				<!-- 转发封面状态行：缩略图即预生成的临时文件本身（真机可渲染=文件有效），
				     失败时状态文案携带平台 errMsg（真机预览无 console，诊断信息须上屏） -->
				<view class="share-cover-row">
					<image v-if="coverPath.length > 0" class="share-cover-thumb" :src="coverPath" mode="aspectFill" />
					<text class="share-cover-status" :class="coverStatus == 'fail' ? 'share-cover-status-fail' : ''">{{ coverStatusText() }}</text>
				</view>
				<!-- #endif -->
				<view class="share-actions">
					<view class="share-action" @click="saveShareImage">
						<text class="share-action-text">{{ t('sel.saveImage') }}</text>
					</view>
					<!-- #ifdef MP-WEIXIN -->
					<button class="share-action share-action-share" open-type="share">
						<text class="share-action-text share-action-text-primary">{{ t('sel.share') }}</text>
					</button>
					<!-- #endif -->
				</view>
			</view>
		</view>

		<!-- 分享卡片绘制画布（隐藏，仅用于导出图片） -->
		<canvas id="share-canvas" type="2d" class="share-canvas"></canvas>
	</view>
</template>

<script setup lang="uts">
	import { getCurrentInstance } from 'vue'
	import { ShareQuoteCtx } from '@/utils/readerTypes.uts'
	import { t } from '@/utils/i18n.uts'
	import { getAccessToken } from '@/utils/request.uts'
	import { API_BASE_URL } from '@/utils/config.uts'
	// 词典注册（划词子系统文案）
	import '@/utils/locales/selectioncomp.uts'
	import '@/utils/locales/common.uts'

	/**
	 * ShareCard —— 分享卡片子组件（预览浮层 + canvas 导出长图内聚）
	 * --------------------------------------------------------------------------
	 * 打开时按宿主下行的分享快照（shareCtx）渲染预览；保存为图片时查询组件内
	 * 隐藏 canvas（.in 自身实例）按排版常量绘制全量长图（与预览 CSS 逐项换算）并
	 * 存相册；微信端经 button open-type=share 转发（触发宿主页面 onShareAppMessage）。
	 * 打开经 ref 调 open()（无选区快照时忽略），提示经 emit('toast') 上行；
	 * 微信端打开预览时即预生成 5:4 转发封面并上传后端换取服务端 URL（微信真机
	 * 不接受本地临时文件路径作转发封面），经 emit('shareImage') 上行供宿主页面
	 * onShareAppMessage 作为转发封面（关闭预览时上行空串清除；上传失败回落本地
	 * 路径——开发者工具可用、真机由静态兜底图收口）；
	 * 宿主另经 ref coverImagePath() 直读当前封面路径（emit 事件链在真机
	 * 不可靠，ref 链与 beginSelection 同机制、真机已验证）。
	 */
	/** 组件实例（setup 同步期捕获：getCurrentInstance 仅 setup 同步期可用，异步回调中调用返回 null） */
	const self = getCurrentInstance()
	const props = defineProps<{
		/** 分享卡片内容快照（宿主按选区计算；null=无选区不可分享） */
		shareCtx: ShareQuoteCtx | null
		/** 分享卡片头像路径（宿主按登录态映射，未登录默认头像） */
		logoSrc: string
		/** 页面高度（px，预览滚动区最大高度换算） */
		pageH: number
	}>()
	const emit = defineEmits(['toast', 'shareImage'])

	/** 分享预览展开态 */
	const shareOpen = ref(false)
	/** 转发封面导出已重试标志（真机 canvasToTempFilePath 偶发失败时整链重试一次；每次打开预览复位） */
	let coverExportRetried = false
	/** ===== 转发封面生成状态（仅微信端；真机预览无 console，状态与失败原因直接上屏供诊断） ===== */
	/** 生成状态：making 生成中 / ready 就绪 / fail 失败 */
	const coverStatus = ref('making')
	/** 失败原因（平台 errMsg 摘要或超时标记） */
	const coverErrText = ref('')
	/** 已生成的封面临时文件路径（缩略图直读该文件，真机可渲染=文件有效） */
	const coverPath = ref('')
	/** 最终分享用封面路径（服务端 URL 优先，上传失败回落本地临时路径；''=未定） */
	const coverUrl = ref('')
	/** 看门狗定时器句柄（预生成回调在真机可能整个丢失：1.7s 无结果重跑一次，再 1.7s 仍无结果标超时失败） */
	let coverWatchdog = 0
	/** 看门狗已重跑预生成标志（每次打开预览复位） */
	let coverRegenDone = false

	/** 封面状态行文案（失败时拼接真实原因） */
	function coverStatusText() : string {
		if (coverStatus.value == 'ready') {
			return t('sel.coverReady')
		}
		if (coverStatus.value == 'fail') {
			return t('sel.coverFailPrefix') + coverErrText.value
		}
		return t('sel.coverMaking')
	}

	/** 重置并启动封面看门狗（打开预览时调用；关闭预览时经 stopCoverWatchdog 清理） */
	function startCoverWatchdog() : void {
		stopCoverWatchdog()
		coverWatchdog = setTimeout(() : void => {
			// 导出已有结果（本地路径就绪或已失败）即止——后续上传由其自身超时收口
			if (coverStatus.value != 'making' || coverPath.value.length > 0) {
				return
			}
			if (!coverRegenDone) {
				coverRegenDone = true
				console.warn('转发封面预生成无结果，看门狗重跑')
				preGenerateShareImage()
				coverWatchdog = setTimeout(() : void => {
					if (coverStatus.value == 'making' && coverPath.value.length == 0) {
						coverStatus.value = 'fail'
						coverErrText.value = t('sel.coverTimeout')
					}
				}, 1700)
				return
			}
			coverStatus.value = 'fail'
			coverErrText.value = t('sel.coverTimeout')
		}, 1700)
	}

	/** 停止封面看门狗 */
	function stopCoverWatchdog() : void {
		if (coverWatchdog > 0) {
			clearTimeout(coverWatchdog)
			coverWatchdog = 0
		}
	}
	/** 打开分享时的内容快照（渲染与绘制共用非空数据） */
	const shareData = ref<ShareQuoteCtx>({
		farBefore: '',
		nearBefore: '',
		quote: '',
		nearAfter: '',
		farAfter: '',
		thoughtText: '',
		source: '',
		bookTitle: ''
	} as ShareQuoteCtx)
	/** 分享卡片预览滚动区最大高度（px）：屏高的 45% */
	const shareCardMaxH = computed(() : number => props.pageH * 0.45)

	/** 分享预览富文本运行段（文本 + 样式类；与画布绘制段 ShareRun 同源异构） */
	type ShareViewRun = {
		text : string
		cls : string
	}

	/** 选区起于段首判定：前文上下文为空 ⇔ 选区起点即所在段段首（宿主前文取同段 slice(0, fromStart)，非段首必非空）；决定首段是否缩进 */
	function quoteStartsAtParaStart() : boolean {
		const d = shareData.value
		return d.farBefore.length == 0 && d.nearBefore.length == 0
	}

	/** 引文段落视图（预览）：按 \n 拆段（段边界即原文段落边界），段首插入两全角空格缩进（与正文段首渲染同参，首段仅选区起于段首时缩进），段间距由 share-para-gap 承担；与画布 layoutShareParas 同规则 */
	const shareParas = computed(() : Array<Array<ShareViewRun>> => {
		const d = shareData.value
		const runs : ShareViewRun[] = [] as ShareViewRun[]
		if (d.farBefore.length > 0) {
			runs.push({ text: d.farBefore, cls: 'share-ctx-far' } as ShareViewRun)
		}
		if (d.nearBefore.length > 0) {
			runs.push({ text: d.nearBefore, cls: 'share-ctx-near' } as ShareViewRun)
		}
		// 开引号仅在上/下文渐出场景渲染（“ 位于文字流中不影响对齐）；“ 恰在段首时（无上/下文，
		// 选区起点即段首）渲染会推歪首段文字、与后续段左缘参差，故不渲染——各段统一「段首两全角
		// 缩进」文字左缘对齐，闭引号贴尾不受影响（与画布 buildShareQuoteRuns 同规则）
		if (!quoteStartsAtParaStart()) {
			runs.push({ text: '“', cls: 'share-quote-mark' } as ShareViewRun)
		}
		runs.push({ text: d.quote, cls: 'share-quote-main' } as ShareViewRun)
		runs.push({ text: '”', cls: 'share-quote-mark' } as ShareViewRun)
		if (d.nearAfter.length > 0) {
			runs.push({ text: d.nearAfter, cls: 'share-ctx-near' } as ShareViewRun)
		}
		if (d.farAfter.length > 0) {
			runs.push({ text: d.farAfter, cls: 'share-ctx-far' } as ShareViewRun)
		}
		const paras : Array<Array<ShareViewRun>> = [] as Array<Array<ShareViewRun>>
		let cur : ShareViewRun[] = [] as ShareViewRun[]
		const flushPara = () : void => {
			if (cur.length == 0) {
				return
			}
			if (paras.length > 0 || quoteStartsAtParaStart()) {
				cur.unshift({ text: '　　', cls: '' } as ShareViewRun)
			}
			paras.push(cur)
			cur = [] as ShareViewRun[]
		}
		for (const run of runs) {
			const parts = run.text.split('\n')
			for (let i = 0; i < parts.length; i++) {
				if (i > 0) {
					flushPara()
				}
				if (parts[i].length > 0) {
					cur.push({ text: parts[i], cls: run.cls } as ShareViewRun)
				}
			}
		}
		flushPara()
		return paras
	})

	/** 打开分享预览（宿主气泡分享按钮调用；无选区快照时忽略） */
	function open() : void {
		const c = props.shareCtx
		if (c == null) {
			return
		}
		shareData.value = {
			farBefore: c.farBefore,
			nearBefore: c.nearBefore,
			quote: c.quote,
			nearAfter: c.nearAfter,
			farAfter: c.farAfter,
			thoughtText: c.thoughtText,
			source: c.source,
			bookTitle: c.bookTitle
		} as ShareQuoteCtx
		shareOpen.value = true
		// #ifdef MP-WEIXIN
		// 打开预览即后台预生成分享封面图（用户点击分享按钮时已就绪；先生清空旧图防上一次选区残留）
		emit('shareImage', '')
		coverExportRetried = false
		coverRegenDone = false
		coverStatus.value = 'making'
		coverErrText.value = ''
		coverPath.value = ''
		coverUrl.value = ''
		preGenerateShareImage()
		startCoverWatchdog()
		// #endif
	}

	function closeShare() : void {
		shareOpen.value = false
		// #ifdef MP-WEIXIN
		stopCoverWatchdog()
		coverPath.value = ''
		coverUrl.value = ''
		// #endif
		// 关闭预览即清除待用封面（避免后续右上角菜单转发误用本次引文图）
		emit('shareImage', '')
	}

	/** 当前分享用封面路径（''=未定；服务端 URL 优先。供宿主 ref 直读——emit 事件链
	 *  在真机不可靠，ref 链与 beginSelection 同机制、真机已验证） */
	function coverImagePath() : string {
		return coverUrl.value
	}

	/** 绘制排版常量（与预览 CSS 逐项换算：rpx 值减半为 px） */
	const SHARE_CARD_W = 295.0
	const SHARE_CARD_TOP = 29.0
	const SHARE_HEADER_H = 30.0
	const SHARE_PAD = 15.5
	const SHARE_TEXT_X = SHARE_PAD
	const SHARE_TEXT_W = SHARE_CARD_W - SHARE_PAD * 2
	const SHARE_LINE_H = 21.0
	const SHARE_BASE12 = 10.0
	const SHARE_BASE10 = 8.5
	const SHARE_RING_R = 23.0
	const SHARE_LOGO_R = 20.0
	const SHARE_INK = '#0e0f0c'
	/** 画布用墨色透明梯度与底色（与 SCSS 侧 rgba($bai-ink, x)/令牌同值：远端引文/近端引文/引号/元信息/卡片白底） */
	const SHARE_FAR = 'rgba($bai-ink, 0.18)'
	const SHARE_NEAR = 'rgba($bai-ink, 0.4)'
	const SHARE_QUOTE = 'rgba($bai-ink, 0.25)'
	const SHARE_META = 'rgba($bai-ink, 0.45)'
	const SHARE_CANVAS_BG = '#ffffff'
	/** 段落间距（px，正文段间距 40rpx 换算） */
	const SHARE_PARA_GAP = 20.0
	/** 小间距（px，23rpx 间距换算，390 基准 ÷2）：引文块/想法块/出处行之间距 */
	const SHARE_GAP_SM = 11.5

	/** 分享卡片绘制辅助：文本按宽度折行（\n 强制换行保留段落结构；返回行数组，供画布高度预算与逐行绘制） */
	function wrapCanvasLines(ctx : CanvasRenderingContext2D, text : string, maxW : number, font : string) : string[] {
		ctx.font = font
		const lines : string[] = []
		let line = ''
		for (let i = 0; i < text.length; i++) {
			const ch = text.charAt(i)
			if (ch == '\n') {
				lines.push(line)
				line = ''
				continue
			}
			if (ctx.measureText(line + ch).width > maxW && line.length > 0) {
				lines.push(line)
				line = ch
			} else {
				line = line + ch
			}
		}
		if (line.length > 0) {
			lines.push(line)
		}
		return lines
	}

	/** 分享卡片绘制辅助：逐行绘制（yTop 为首行行盒顶，与预览 text 行盒模型一致；baseline 为字号对应基线偏移），返回块底 yTop */
	function drawCanvasLines(ctx : CanvasRenderingContext2D, lines : string[], x : number, yTop : number, lineH : number, font : string, color : string, baseline : number) : number {
		ctx.font = font
		ctx.fillStyle = color
		let top = yTop
		for (const line of lines) {
			ctx.fillText(line, x, top + baseline)
			top += lineH
		}
		return top
	}

	/** 分享卡片富文本运行段（字号/加粗/颜色/内容） */
	type ShareRun = {
		text : string
		fs : number
		bold : boolean
		color : string
	}

	/** 富文本行（行内运行段顺序混排，基线对齐） */
	type RenderLine = {
		runs : ShareRun[]
	}

	function shareRunFont(r : ShareRun) : string {
		return (r.bold ? 'bold ' : '') + r.fs + 'px sans-serif'
	}

	/** 富文本流式折行排版（逐字符测量、\n 强制换行、行内同款运行段合并），返回行数组 */
	function layoutShareRuns(ctx : CanvasRenderingContext2D, runs : ShareRun[], maxW : number) : RenderLine[] {
		const out : RenderLine[] = []
		let curRuns : ShareRun[] = [] as ShareRun[]
		let curW = 0.0
		const pushLine = () : void => {
			if (curRuns.length > 0) {
				out.push({ runs: curRuns } as RenderLine)
				curRuns = [] as ShareRun[]
				curW = 0.0
			}
		}
		for (const run of runs) {
			ctx.font = shareRunFont(run)
			for (let i = 0; i < run.text.length; i++) {
				const ch = run.text.charAt(i)
				if (ch == '\n') {
					pushLine()
					continue
				}
				const w = ctx.measureText(ch).width
				if (curW + w > maxW && curW > 0) {
					pushLine()
				}
				const last = curRuns.length > 0 ? curRuns[curRuns.length - 1] : null
				if (last != null && last.fs == run.fs && last.bold == run.bold && last.color == run.color) {
					last.text = last.text + ch
				} else {
					curRuns.push({ text: ch, fs: run.fs, bold: run.bold, color: run.color } as ShareRun)
				}
				curW += w
			}
		}
		pushLine()
		return out
	}

	/** 富文本行绘制（行内基线按行内最大字号对齐），返回块底 yTop */
	function drawRenderLines(ctx : CanvasRenderingContext2D, lines : RenderLine[], x : number, yTop : number, lineH : number) : number {
		let top = yTop
		for (const line of lines) {
			let maxFs = 12.5
			for (const r of line.runs) {
				if (r.fs > maxFs) {
					maxFs = r.fs
				}
			}
			const bl = top + maxFs * 0.8
			let rx = x
			for (const r of line.runs) {
				ctx.font = shareRunFont(r)
				ctx.fillStyle = r.color
				ctx.fillText(r.text, rx, bl)
				rx += ctx.measureText(r.text).width
			}
			top += lineH
		}
		return top
	}

	/** 引文段落（\n 拆段后的一段折行结果；段间以 SHARE_PARA_GAP 堆叠） */
	type QuotePara = {
		lines : RenderLine[]
	}

	/** 分段折行排版：按 \n 拆段（段边界即原文段落边界，与预览 shareParas 同规则）→ 段首插入两全角空格缩进（随上下文基础字号 12.5px 计宽，与正文段首渲染同参；首段仅选区起于段首时缩进）→ 逐段折行 */
	function layoutShareParas(ctx : CanvasRenderingContext2D, runs : ShareRun[], maxW : number, indentFirst : boolean) : QuotePara[] {
		const out : QuotePara[] = []
		let paraRuns : ShareRun[] = [] as ShareRun[]
		const flushPara = () : void => {
			if (paraRuns.length == 0) {
				return
			}
			if (out.length > 0 || indentFirst) {
				paraRuns.unshift({ text: '　　', fs: 12.5, bold: false, color: SHARE_INK } as ShareRun)
			}
			out.push({ lines: layoutShareRuns(ctx, paraRuns, maxW) } as QuotePara)
			paraRuns = [] as ShareRun[]
		}
		for (const run of runs) {
			const parts = run.text.split('\n')
			for (let i = 0; i < parts.length; i++) {
				if (i > 0) {
					flushPara()
				}
				if (parts[i].length > 0) {
					paraRuns.push({ text: parts[i], fs: run.fs, bold: run.bold, color: run.color } as ShareRun)
				}
			}
		}
		flushPara()
		return out
	}

	/** 构建引文富文本运行段（上/下文渐出 + 大引号 + 选中文本） */
	function buildShareQuoteRuns() : ShareRun[] {
		const runs : ShareRun[] = [] as ShareRun[]
		const d = shareData.value
		if (d.farBefore.length > 0) {
			runs.push({ text: d.farBefore, fs: 12.5, bold: false, color: SHARE_FAR } as ShareRun)
		}
		if (d.nearBefore.length > 0) {
			runs.push({ text: d.nearBefore, fs: 12.5, bold: false, color: SHARE_NEAR } as ShareRun)
		}
		// 开引号仅在上/下文渐出场景渲染（与预览 shareParas 同规则：段首场景不渲染保证左缘对齐）
		if (!quoteStartsAtParaStart()) {
			runs.push({ text: '“', fs: 20, bold: true, color: SHARE_QUOTE } as ShareRun)
		}
		runs.push({ text: d.quote, fs: 13.5, bold: true, color: SHARE_INK } as ShareRun)
		runs.push({ text: '”', fs: 20, bold: true, color: SHARE_QUOTE } as ShareRun)
		if (d.nearAfter.length > 0) {
			runs.push({ text: d.nearAfter, fs: 12.5, bold: false, color: SHARE_NEAR } as ShareRun)
		}
		if (d.farAfter.length > 0) {
			runs.push({ text: d.farAfter, fs: 12.5, bold: false, color: SHARE_FAR } as ShareRun)
		}
		return runs
	}

	/** 分享卡片布局：各块行盒顶位置与卡片/画布高度（引文块按段落行数+段间距占位，想法块按行数占位，间距与预览 CSS 换算一致） */
	type ShareCardLayout = {
		thoughtTop : number
		sourceTop : number
		cardH : number
		H : number
	}

	function layoutShareCard(quoteParas : QuotePara[], thL : string[]) : ShareCardLayout {
		let quoteBlockH = 0.0
		for (let i = 0; i < quoteParas.length; i++) {
			if (i > 0) {
				quoteBlockH += SHARE_PARA_GAP
			}
			quoteBlockH += quoteParas[i].lines.length * SHARE_LINE_H
		}
		const quoteTop = SHARE_CARD_TOP + SHARE_HEADER_H + SHARE_LINE_H + SHARE_GAP_SM
		let thoughtTop = quoteTop + quoteBlockH + SHARE_GAP_SM
		if (thL.length > 0) {
			// 存在想法时的 +10.5 为实测对齐校准值（与预览 CSS 间距无直接对应），调整需导出长图核对
			thoughtTop += 1 + 9.5
		}
		const sourceTop = thoughtTop + (thL.length > 0 ? thL.length * SHARE_LINE_H : 0) + SHARE_GAP_SM
		const cardH = sourceTop + 15.0 - SHARE_CARD_TOP
		return { thoughtTop: thoughtTop, sourceTop: sourceTop, cardH: cardH, H: SHARE_CARD_TOP + cardH } as ShareCardLayout
	}

	/** 绘制卡片底（顶部头像带浅灰 + 卡片白底）与产品名 */
	function drawShareCardBase(ctx : CanvasRenderingContext2D, cardH : number) : void {
		ctx.fillStyle = '#efefec'
		ctx.fillRect(0, 0, SHARE_CARD_W, SHARE_CARD_TOP)
		ctx.fillStyle = SHARE_CANVAS_BG
		ctx.fillRect(0, SHARE_CARD_TOP, SHARE_CARD_W, cardH)
		ctx.fillStyle = SHARE_META
		ctx.font = '12.5px sans-serif'
		ctx.textAlign = 'center'
		ctx.fillText(t('sel.appName'), SHARE_CARD_W / 2, SHARE_CARD_TOP + SHARE_HEADER_H + SHARE_BASE12)
		ctx.textAlign = 'left'
	}

	/** 绘制引文块（富文本流式：上/下文渐出 + 选中文本加粗；段间以 SHARE_PARA_GAP 堆叠；
	 *  hungMark 为真时开引号悬挂绘制在首段缩进区内（不在文字流内，与预览悬挂同源）——
	 *  首行行内最大字号恒为选中文本 13.5px，基线公式与 drawRenderLines 一致） */
	function drawShareQuoteBlock(ctx : CanvasRenderingContext2D, quoteParas : QuotePara[], hungMark : boolean) : void {
		let top = SHARE_CARD_TOP + SHARE_HEADER_H + SHARE_LINE_H + 11.5
		for (let i = 0; i < quoteParas.length; i++) {
			if (i > 0) {
				top += SHARE_PARA_GAP
			}
			if (i == 0 && hungMark) {
				ctx.fillStyle = SHARE_QUOTE
				ctx.font = 'bold 20px sans-serif'
				ctx.fillText('“', SHARE_TEXT_X, top + 13.5 * 0.8)
			}
			top = drawRenderLines(ctx, quoteParas[i].lines, SHARE_TEXT_X, top, SHARE_LINE_H)
		}
	}

	/** 绘制想法块（蓝色） */
	function drawShareThoughtBlock(ctx : CanvasRenderingContext2D, thL : string[], top : number) : void {
		drawCanvasLines(ctx, thL, SHARE_TEXT_X, top, SHARE_LINE_H, '12.5px sans-serif', '#1e40af', SHARE_BASE12)
	}

	/** 绘制出处（左对齐，与预览一致） */
	function drawShareSource(ctx : CanvasRenderingContext2D, top : number) : void {
		ctx.fillStyle = SHARE_NEAR
		ctx.font = '10.5px sans-serif'
		ctx.fillText('《' + shareData.value.bookTitle + '》 · ' + shareData.value.source, SHARE_TEXT_X, top + SHARE_BASE10)
	}

	/** 绘制头像（白环包裹，圆心/半径由调用方传入；withLogo=false 时以浅色圆替代）——分享卡与转发封面共用 */
	function drawAvatar(ctx : CanvasRenderingContext2D, cx : number, cy : number, ringR : number, logoR : number, logo : CanvasImage, withLogo : boolean) : void {
		ctx.fillStyle = SHARE_CANVAS_BG
		ctx.beginPath()
		ctx.arc(cx, cy, ringR, 0, Math.PI * 2)
		ctx.fill()
		if (withLogo) {
			ctx.save()
			ctx.beginPath()
			ctx.arc(cx, cy, logoR, 0, Math.PI * 2)
			ctx.clip()
			ctx.drawImage(logo, cx - logoR, cy - logoR, logoR * 2, logoR * 2)
			ctx.restore()
		} else {
			ctx.fillStyle = '#d9d9d5'
			ctx.beginPath()
			ctx.arc(cx, cy, logoR, 0, Math.PI * 2)
			ctx.fill()
		}
	}

	/** 导出画布（单次；Web 端为 toDataURL 触发浏览器下载）。forShare=false 保存到相册；
	 *  forShare=true 仅导出临时图并经 emit('shareImage') 上行（供页面转发封面，Web 端无此场景） */
	function exportShareCanvas(canvas : any, forShare : boolean) : void {
		// #ifdef WEB
		// Web 端无相册能力：画布导出 PNG 数据，经临时 <a download> 触发浏览器下载；文件名=应用名_日期_时间到秒
		try {
			const url = (canvas as any).toDataURL('image/png')
			const now = new Date()
			const pad2 = (n : number) : string => (n < 10 ? '0' + n.toString() : n.toString())
			const dateStr = now.getFullYear().toString() + pad2(now.getMonth() + 1) + pad2(now.getDate()) +
				'_' + pad2(now.getHours()) + pad2(now.getMinutes()) + pad2(now.getSeconds())
			const a = document.createElement('a') as HTMLAnchorElement
			a.href = url
			a.download = t('sel.appName') + '_' + dateStr + '.png'
			document.body.appendChild(a)
			a.click()
			a.remove()
			emit('toast', t('sel.savedDownloads'))
		} catch (e) {
			emit('toast', t('sel.saveFail'))
		}
		return
		// #endif
		// #ifndef WEB
		uni.canvasToTempFilePath({
			canvas: canvas,
			success: (res2) => {
				if (forShare) {
					console.log('转发封面已生成', res2.tempFilePath)
					coverPath.value = res2.tempFilePath
					uploadCover(res2.tempFilePath)
					return
				}
				uni.saveImageToPhotosAlbum({
					filePath: res2.tempFilePath,
					success: () => {
						emit('toast', t('sel.savedAlbum'))
					},
					fail: () => {
						emit('toast', t('sel.saveFailPerm'))
					}
				})
			},
			// err 为平台边界对象（errMsg 形态随端而定），显式 any 取真实失败原因
			fail: (err : any) => {
				if (forShare) {
					// 真机导出偶发失败自动整链重试一次（重绘+重导出）；再失败才提示并回落默认封面
					if (!coverExportRetried) {
						coverExportRetried = true
						console.warn('转发封面导出失败，自动重试', err != null ? err.errMsg : '')
						setTimeout(() : void => {
							drawAndExport(canvas, true)
						}, 400)
						return
					}
					console.warn('转发封面导出重试仍失败', err != null ? err.errMsg : '')
					coverStatus.value = 'fail'
					coverErrText.value = err != null && err.errMsg != null ? ('' + err.errMsg) : ''
					emit('toast', t('sel.coverFailExport'))
					emit('shareImage', '')
					return
				}
				emit('toast', t('sel.saveFail'))
			}
		})
		// #endif
	}

	/** 绘制分享卡片到隐藏 canvas 并保存为长图（排版与预览 CSS 换算一致；头像半出卡片顶部白环包裹；想法全量渲染不截断） */
	function saveShareImage() : void {
		// #ifdef WEB
		// Web 端跳过选择器查询（fields node 语义不可靠）：直接取 uni-canvas 内的原生画布绘制
		let canvas : any = document.querySelector('#share-canvas canvas')
		if (canvas == null) {
			canvas = document.querySelector('#share-canvas')
		}
		if (canvas == null) {
			emit('toast', t('sel.saveFail'))
			return
		}
		drawAndExport(canvas, false)
		return
		// #endif
		// #ifndef WEB
		const proxy = self == null ? null : self.proxy
		if (proxy == null) {
			emit('toast', t('sel.saveFail'))
			return
		}
		uni.createSelectorQuery().in(proxy).select('#share-canvas').fields({ node: true, size: true }, (res : any) : void => {
			if (res == null || res.node == null) {
				emit('toast', t('sel.saveFail'))
				return
			}
			drawAndExport(res.node, false)
		}).exec()
		// #endif
	}

	/** 预生成分享封面图（仅微信端，打开预览时调用）：画布绘制后导出临时图经
	 *  emit('shareImage') 上行，供宿主页面 onShareAppMessage 作为转发封面；
	 *  失败时上行空串，宿主回落默认封面 */
	/** 封面最终路径定格（服务端 URL 优先，上传失败回落本地）：就绪上行 + 状态更新 */
	function settleCover(p : string) : void {
		coverUrl.value = p
		coverStatus.value = 'ready'
		emit('shareImage', p)
	}

	/**
	 * 上传封面到后端换取服务端 URL（微信真机不接受本地临时文件路径作转发封面，
	 * 网络图片路径两端通用）；成功→URL 定格，未登录/失败→回落本地路径定格
	 * （开发者工具可用本地路径，真机回落静态兜底图）
	 */
	function uploadCover(localPath : string) : void {
		const token = getAccessToken()
		if (token.length == 0) {
			settleCover(localPath)
			return
		}
		const header = {} as UTSJSONObject
		header['Authorization'] = 'Bearer ' + token
		uni.uploadFile({
			url: API_BASE_URL + '/api/v1/share-covers',
			filePath: localPath,
			name: 'file',
			header: header,
			timeout: 8000,
			success: (res) => {
				if (res.statusCode >= 200 && res.statusCode < 300) {
					try {
						const obj = JSON.parse<UTSJSONObject>(res.data)
						if (obj != null && (obj.getNumber('code') ?? 1) == 0) {
							// uts2js（小程序 JS 运行时）UTSJSONObject 无 getObject 方法，嵌套取值用索引访问
							const data = obj['data']
							const dataObj = data == null ? null : data as UTSJSONObject
							const p = dataObj == null ? '' : (dataObj.getString('path') ?? '')
							if (p.length > 0) {
								settleCover(API_BASE_URL + p)
								return
							}
						}
					} catch (e) {
						console.warn('转发封面上传响应解析失败', e)
					}
				} else {
					console.warn('转发封面上传失败', res.statusCode, res.data)
				}
				settleCover(localPath)
			},
			fail: (err) => {
				console.warn('转发封面上传请求失败', err.errMsg)
				settleCover(localPath)
			}
		})
	}

	// #ifdef MP-WEIXIN
	function preGenerateShareImage() : void {
		const proxy = self == null ? null : self.proxy
		if (proxy == null) {
			console.warn('转发封面预生成失败：组件实例不可用')
			coverStatus.value = 'fail'
			coverErrText.value = t('sel.coverNoCanvas')
			emit('toast', t('sel.coverFailCanvas'))
			return
		}
		uni.createSelectorQuery().in(proxy).select('#share-canvas').fields({ node: true, size: true }, (res : any) : void => {
			if (res == null || res.node == null) {
				console.warn('转发封面预生成失败：画布节点查询为空', JSON.stringify(res))
				coverStatus.value = 'fail'
				coverErrText.value = t('sel.coverNoCanvas')
				emit('toast', t('sel.coverFailCanvas'))
				return
			}
			drawAndExport(res.node, true)
		}).exec()
	}
	// #endif

	/** 转发封面构图常量（官方要求转发封面显示长宽比 5:4）：专用构图替代全量长图——
	 *  长图作封面会被微信按 5:4 裁剪，展示区域不可控 */
	const COVER_W = 500.0
	const COVER_H = 400.0
	const COVER_PAD = 30.0
	const COVER_BAND_H = 70.0
	const COVER_RING_R = 30.0
	const COVER_LOGO_R = 26.0
	const COVER_NAME_Y = 122.0
	const COVER_QUOTE_TOP = 170.0
	const COVER_QUOTE_MAX_BOTTOM = 336.0
	const COVER_LINE_H = 26.0

	/** 绘制转发封面主体（背景/顶带/产品名/引文主体折行截断/出处；头像由 drawCoverLogo 补画） */
	function drawCoverComposition(ctx : CanvasRenderingContext2D) : void {
		ctx.fillStyle = SHARE_CANVAS_BG
		ctx.fillRect(0, 0, COVER_W, COVER_H)
		ctx.fillStyle = '#efefec'
		ctx.fillRect(0, 0, COVER_W, COVER_BAND_H)
		ctx.fillStyle = SHARE_META
		ctx.font = '11px sans-serif'
		ctx.textAlign = 'center'
		ctx.fillText(t('sel.appName'), COVER_W / 2, COVER_NAME_Y)
		ctx.textAlign = 'left'
		// 引文主体（仅选中文本含引号；折行后按可用高度截断，截断行以省略号收尾）
		const lines = wrapCanvasLines(ctx, '“' + shareData.value.quote + '”', COVER_W - COVER_PAD * 2, 'bold 16px sans-serif')
		const maxLines = Math.floor((COVER_QUOTE_MAX_BOTTOM - COVER_QUOTE_TOP) / COVER_LINE_H)
		const truncated = lines.length > maxLines
		const shown = truncated ? lines.slice(0, maxLines) : lines
		ctx.fillStyle = SHARE_INK
		ctx.font = 'bold 16px sans-serif'
		let top = COVER_QUOTE_TOP
		for (let i = 0; i < shown.length; i++) {
			ctx.fillText(shown[i] + (truncated && i == shown.length - 1 ? '…' : ''), COVER_PAD, top)
			top += COVER_LINE_H
		}
		ctx.fillStyle = SHARE_NEAR
		ctx.font = '11px sans-serif'
		ctx.fillText('《' + shareData.value.bookTitle + '》 · ' + shareData.value.source, COVER_PAD, COVER_H - 24.0)
	}

	/** 绘制转发封面头像（白环包裹跨顶带底边；withLogo=false 时以浅色圆替代） */
	function drawCoverLogo(ctx : CanvasRenderingContext2D, logo : CanvasImage, withLogo : boolean) : void {
		drawAvatar(ctx, COVER_W / 2, COVER_BAND_H, COVER_RING_R, COVER_LOGO_R, logo, withLogo)
	}

	/** 绘制并导出（canvas 为画布节点：小程序/App 为 node 模式画布，Web 为原生 HTMLCanvasElement） */
	function drawAndExport(canvas : any, forShare : boolean) : void {
		const dpr = uni.getWindowInfo().pixelRatio
		const ctx = canvas.getContext('2d')
		if (ctx == null) {
			emit('toast', t('sel.saveFail'))
			return
		}
		// 转发封面（仅微信端）：5:4 专用构图 + 头像按加载结果补画（失败/超时以浅色圆替代）
		if (forShare) {
			canvas.width = COVER_W * dpr
			canvas.height = COVER_H * dpr
			ctx.scale(dpr, dpr)
			drawCoverComposition(ctx)
			let logoDrawn = false
			let coverExported = false
			let coverLogo : any = null
			const finishLogo = (withLogo : boolean) : void => {
				if (logoDrawn) {
					return
				}
				logoDrawn = true
				drawCoverLogo(ctx, coverLogo, withLogo)
			}
			const doExport = () : void => {
				if (coverExported) {
					return
				}
				coverExported = true
				exportShareCanvas(canvas, true)
			}
			coverLogo = canvas.createImage()
			coverLogo.src = props.logoSrc
			coverLogo.onload = () => {
				finishLogo(true)
				doExport()
			}
			coverLogo.onerror = () => {
				finishLogo(false)
				doExport()
			}
			setTimeout(() => {
				finishLogo(false)
				doExport()
			}, 1500)
			return
		}
		// 排版：引文分段折行（\n 拆段、段首缩进、段间距与预览一致）+ 想法折行 + 各块位置（测量在画布尺寸设定前完成，赋值后重新 scale）
		const quoteParas = layoutShareParas(ctx, buildShareQuoteRuns(), SHARE_TEXT_W, quoteStartsAtParaStart())
		const thL = shareData.value.thoughtText.length > 0 ? wrapCanvasLines(ctx, shareData.value.thoughtText, SHARE_TEXT_W, '12.5px sans-serif') : ([] as string[])
		const L = layoutShareCard(quoteParas, thL)
		canvas.width = SHARE_CARD_W * dpr
		canvas.height = L.H * dpr
		ctx.scale(dpr, dpr)
		drawShareCardBase(ctx, L.cardH)
		drawShareQuoteBlock(ctx, quoteParas, quoteStartsAtParaStart())
		if (thL.length > 0) {
			drawShareThoughtBlock(ctx, thL, L.thoughtTop)
		}
		drawShareSource(ctx, L.sourceTop)
		// 头像（异步加载，完成后导出；加载失败/超时以浅色圆替代）
		let headerDrawn = false
		let exported = false
		const drawLogo = (withLogo : boolean) : void => {
			if (headerDrawn) {
				return
			}
			headerDrawn = true
			drawAvatar(ctx, SHARE_CARD_W / 2, SHARE_CARD_TOP, SHARE_RING_R, SHARE_LOGO_R, logo, withLogo)
		}
		const exportCanvas = () : void => {
			if (exported) {
				return
			}
			exported = true
			exportShareCanvas(canvas, forShare)
		}
		// 头像图像对象：Web 为 DOM Image，小程序/App 为画布 node 的 createImage（同函数内条件赋值，避免解析期重名）
		let logo : any = null
		// #ifdef WEB
		logo = new Image()
		// #endif
		// #ifndef WEB
		logo = canvas.createImage()
		// #endif
		logo.src = props.logoSrc
		logo.onload = () => {
			drawLogo(true)
			exportCanvas()
		}
		logo.onerror = () => {
			drawLogo(false)
			exportCanvas()
		}
		// 加载异常兜底：超时后按浅色圆导出
		setTimeout(() => {
			drawLogo(false)
			exportCanvas()
		}, 1500)
	}

	defineExpose({
		open,
		coverImagePath
	})
</script>

<style lang="scss">
	/* 组件根：零尺寸占位（fixed 子浮层相对页面视口定位） */
	.share-root {
		width: 0;
		height: 0;
	}

	/* 分享卡片预览（居中白卡：头像/引文渐出/想法/出处，固定日间配色便于分享） */
	.share-mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba($bai-ink, 0.6);
		z-index: 96;
		justify-content: center;
		align-items: center;
		/* 头像环一半出弹窗容器，沿途容器不裁剪 */
		overflow: visible;
	}

	.share-pop {
		position: relative;
		flex-direction: column;
		align-items: center;
		overflow: visible;
	}

	.share-card {
		width: 590rpx;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-lg;
		padding: 62rpx 31rpx 31rpx 31rpx;
	}

	/* 头像圆环包裹（环色与卡片一致）：绝对定位钉在卡片上边框正中，一半出卡，绘制于卡片上层 */
	.share-card-logo-ring {
		position: absolute;
		top: -46rpx;
		left: 50%;
		margin-left: -46rpx;
		width: 92rpx;
		height: 92rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-canvas;
		padding: 6rpx;
		z-index: 2;
	}

	.share-card-logo {
		width: 80rpx;
		height: 80rpx;
		border-radius: $bai-rounded-pill;
	}

	/* 转发封面状态行（仅微信端）：缩略图 5:4 直读预生成临时文件 */
	.share-cover-row {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 15rpx;
		margin-top: 23rpx;
		width: 590rpx;
	}

	.share-cover-thumb {
		width: 100rpx;
		height: 80rpx;
		border-radius: $bai-rounded-sm;
		border: 1px solid rgba($bai-ink, 0.15);
	}

	.share-cover-status {
		font-size: 21rpx;
		color: rgba($bai-ink, 0.4);
		flex: 1;
	}

	.share-cover-status-fail {
		color: rgba($bai-ink, 0.6);
	}

	.share-card-app {
		font-size: 25rpx;
		color: rgba($bai-ink, 0.45);
		text-align: center;
		margin-bottom: 23rpx;
	}

	.share-card-scroll {
		flex-direction: column;
	}

	/* 引文段（relative 作为悬挂开引号的定位基准） */
	.share-para {
		position: relative;
	}

	.share-card-text {
		font-size: 25rpx;
		line-height: 42rpx;
	}

	/* 悬挂开引号（“ 恰在段首场景）：absolute 叠于段首两全角缩进区（50rpx 可容纳 40rpx 字形），
	 * 不占文字流宽度使各段文字左缘对齐；top 与首行文字基线近似对齐，跨端差异待真机微调 */
	.share-quote-mark-hung {
		position: absolute;
		left: 0;
		top: 0;
	}

	/* 引文段落间距（与正文段落间距一致：正文 .novel-body gap 40rpx） */
	.share-para-gap {
		margin-top: 40rpx;
	}

	.share-ctx-far {
		color: rgba($bai-ink, 0.18);
	}

	.share-ctx-near {
		color: rgba($bai-ink, 0.4);
	}

	.share-quote-mark {
		font-size: 40rpx;
		font-weight: 800;
		color: rgba($bai-ink, 0.25);
	}

	.share-quote-main {
		font-size: 27rpx;
		font-weight: 700;
		color: $bai-ink;
	}

	.share-card-thought {
		margin-top: 23rpx;
	}

	.share-card-thought-text {
		font-size: 25rpx;
		line-height: 42rpx;
		color: $bai-positive;
	}

	.share-card-source {
		font-size: 21rpx;
		color: rgba($bai-ink, 0.4);
		margin-top: 23rpx;
	}

	.share-actions {
		flex-direction: row;
		gap: 15rpx;
		margin-top: 31rpx;
		width: 590rpx;
	}

	.share-action {
		flex: 1;
		height: 80rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-canvas;
		border: 1px solid rgba($bai-ink, 0.15);
		align-items: center;
		justify-content: center;
	}

	.share-action-text {
		font-size: 27rpx;
		color: $bai-ink;
	}

	.share-action-share {
		background-color: $bai-ink;
		border-color: $bai-ink;
	}

	.share-action-text-primary {
		color: $bai-on-primary;
	}

	/* 分享卡片绘制画布（移出屏幕外，仅用于导出图片） */
	.share-canvas {
		position: fixed;
		left: -9999px;
		top: 0;
		width: 375px;
		height: 500px;
	}

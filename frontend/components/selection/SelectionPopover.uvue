<template>
	<view class="sp-root">
		<!-- 划词手柄（选区两端水滴形大手柄：拖动调节选中范围，触摸热区大于视觉体便于拖动；圆头+三角+边界竖线同色叠压连为一体——竖线贯穿整行文字、贴文字边界为手柄延伸，三角尖端指向竖线、不卡入文字行。锚点实测完成后才显示，避免位置跳变。
		     拖动中必须保持挂载跟随手指——若随气泡一起隐藏，被拖手柄在触摸中途被卸载，微信端触摸序列随之中断，拖动即失效） -->
		<template v-if="handlesVisible">
			<view
				id="sel-handle-start"
				class="sel-handle sel-handle-start"
				:style="'left:' + handleStartLeft + 'px;top:' + handleStartTop + 'px;height:' + handleZoneH + 'px'"
				@touchstart="onStartHandleTouchStart"
				@touchmove="onStartHandleTouchMove"
				@touchend="onStartHandleTouchEnd"
				@touchcancel="onStartHandleTouchEnd"
			>
				<view class="sel-handle-drop"></view>
				<view class="sel-handle-tip sel-handle-tip-down"></view>
				<view class="sel-handle-line sel-handle-line-start" :style="'height:' + handleLineH + 'px'"></view>
			</view>
			<view
				id="sel-handle-end"
				class="sel-handle sel-handle-end"
				:style="'left:' + handleEndLeft + 'px;top:' + handleEndTop + 'px;height:' + handleZoneH + 'px'"
				@touchstart="onEndHandleTouchStart"
				@touchmove="onEndHandleTouchMove"
				@touchend="onEndHandleTouchEnd"
				@touchcancel="onEndHandleTouchEnd"
			>
				<view class="sel-handle-line" :style="'height:' + handleLineH + 'px'"></view>
				<view class="sel-handle-tip sel-handle-tip-up"></view>
				<view class="sel-handle-drop"></view>
			</view>
		</template>
		<!-- 划词气泡（Stitch: 黑底圆角 12px 内边距 12x8，操作项竖排图标+文字；位置由内联绑定——水平对准选区中心、垂直置于选区上/下侧，箭头随朝向指向选区） -->
		<view
			v-if="bubbleVisible"
			class="selection-popover"
			:style="'left:' + popoverLeft + 'px;top:' + popoverTop + 'px'"
			@click="emit('dismiss')"
		>
			<!-- 气泡在选区下方时三角贴体顶朝上 -->
			<view
				v-if="below"
				class="popover-arrow popover-arrow-above"
				:style="'margin-left:' + arrowLeft + 'px;background-color:' + bg"
			></view>
			<view class="popover-body" :class="twoLine ? 'popover-body-two' : ''" :style="'background-color:' + bg">
				<template v-if="twoLine">
					<view class="popover-row">
						<view class="popover-btn" @click="onAction($event, 'copy')">
							<image class="popover-icon" src="/static/icons/popover-copy.svg" />
							<text class="popover-text">{{ t('sel.copy') }}</text>
						</view>
						<view class="popover-divider"></view>
						<view class="popover-btn" @click="onAction($event, 'idea')">
							<image class="popover-icon" src="/static/icons/popover-idea.svg" />
							<text class="popover-text">{{ t('sel.thought') }}</text>
						</view>
						<view class="popover-divider"></view>
						<view class="popover-btn" @click="onAction($event, 'underline')">
							<image class="popover-icon" src="/static/icons/popover-underline.svg" />
							<text class="popover-text">{{ t('sel.underline') }}</text>
						</view>
					</view>
					<view class="popover-divider-h"></view>
					<view class="popover-row">
						<view class="popover-btn" @click="onAction($event, 'query')">
							<image class="popover-icon" src="/static/icons/popover-query.svg" />
							<text class="popover-text">{{ t('sel.query') }}</text>
						</view>
						<view class="popover-divider"></view>
						<view class="popover-btn" @click="onAction($event, 'share')">
							<image class="popover-icon" src="/static/icons/popover-share.svg" />
							<text class="popover-text">{{ t('sel.share') }}</text>
						</view>
					</view>
				</template>
				<template v-else>
					<view class="popover-btn" @click="onAction($event, 'copy')">
						<image class="popover-icon" src="/static/icons/popover-copy.svg" />
						<text class="popover-text">{{ t('sel.copy') }}</text>
					</view>
					<view class="popover-divider"></view>
					<view class="popover-btn" @click="onAction($event, 'idea')">
						<image class="popover-icon" src="/static/icons/popover-idea.svg" />
						<text class="popover-text">{{ t('sel.thought') }}</text>
					</view>
					<view class="popover-divider"></view>
					<view class="popover-btn" @click="onAction($event, 'underline')">
						<image class="popover-icon" src="/static/icons/popover-underline.svg" />
						<text class="popover-text">{{ t('sel.underline') }}</text>
					</view>
					<view class="popover-divider"></view>
					<view class="popover-btn" @click="onAction($event, 'query')">
						<image class="popover-icon" src="/static/icons/popover-query.svg" />
						<text class="popover-text">{{ t('sel.query') }}</text>
					</view>
					<view class="popover-divider"></view>
					<view class="popover-btn" @click="onAction($event, 'share')">
						<image class="popover-icon" src="/static/icons/popover-share.svg" />
						<text class="popover-text">{{ t('sel.share') }}</text>
					</view>
				</template>
			</view>
			<!-- 气泡在选区上方时三角贴体底朝下 -->
			<view
				v-if="!below"
				class="popover-arrow popover-arrow-below"
				:style="'margin-left:' + arrowLeft + 'px;background-color:' + bg"
			></view>
		</view>

		<!-- 想法子组件（查看卡片 + 写想法编辑器内聚：开关/定位/实测/保存经 ref 与事件接线） -->
		<ThoughtPanel
			ref="thoughtPanelRef"
			:segs="segs"
			:quote-color="quoteColor"
			:panel-bg="panelBg"
			:content-color="contentColor"
			:page-w="pageW"
			:page-h="pageH"
			:nav-top="navTop"
			:quote-align="quoteAlign"
			:card-max-w="thoughtCardMaxW"
			@sync="emit('sync')"
			@dismiss="emit('dismiss')"
			@toast="emit('toast', $event)"
			@thought-view-closed="emit('thoughtViewClosed')"
		/>

		<!-- 分享卡片子组件（预览浮层 + canvas 导出内聚：打开快照/绘制/存相册经 ref 与事件接线） -->
		<ShareCard
			ref="shareCardRef"
			:share-ctx="shareCtx"
			:logo-src="logoSrc"
			:page-h="pageH"
			@toast="emit('toast', $event)"
			@share-image="emit('shareImage', $event)"
		/>
	</view>
</template>

<script setup lang="uts">
	import { getCurrentInstance } from 'vue'
	import type { SelSpan, SpanSeg, TextMetrics, ParaRect, ShareQuoteCtx } from '@/utils/readerTypesDefs.ts'
	import { comparePos, normalizeSpan, applySpanUnderlineToStorage } from '@/utils/readerTypes.uts'
	import ThoughtPanel from '@/components/selection/ThoughtPanel.uvue'
	import ShareCard from '@/components/selection/ShareCard.uvue'
	import { t } from '@/utils/i18n.uts'
	import { rpxToPx } from '@/utils/layout.uts'
	// 词典注册（划词子系统文案）
	import '@/utils/locales/selectioncomp.uts'
	import '@/utils/locales/common.uts'

	/**
	 * SelectionPopover —— 阅读页划词气泡（可复用组件，框架层）
	 * --------------------------------------------------------------
	 * 职责：划词子系统（选区状态/手柄逐字拖动/气泡定位显隐）+
	 * 气泡五项操作分发；想法（查看卡片/编辑器）与分享（预览/canvas 导出）
	 * 已拆分为 ThoughtPanel/ShareCard 子组件，本组件经 ref 与事件接线。
	 * 划词：宿主长按正文选中触点所在字符，完成 rect 查询与字符换算后经 ref 调
	 *       beginSelection() 建立选区（正文锚点零宽字符与拖动段落矩形
	 *       在宿主模板内，跨组件查询不可行，由宿主查询后经
	 *       setAnchors/setDragRects 回传组件差分定位）；选区变化
	 *       emit('spanChanged') 供宿主渲染高亮镜像。
	 * 复制：写入剪贴板（微信端系统提示，其他端页面内提示）。
	 * 划线：本地缓存区间运算（切换式：完全覆盖取消、否则并入），存储 key
	 *       reader_underlines（云端真源的本地镜像，写入后云端静默跟随）。
	 * 查询：占位提示。
	 * 写想法/查看卡片/分享：经 thoughtPanelRef/shareCardRef 调子组件
	 *       （openEditor/open/showThoughtView/hideThoughtView）。
	 * 划线/想法写入后子组件 emit('sync') 通知宿主重读本地存储刷新渲染；
	 * 选区清除经 emit('dismiss')，提示经 emit('toast')。
	 * 选区上下文（文本/段序列/分享快照）由宿主按选区计算下行。
	 */
	/** 组件实例（setup 同步期捕获：getCurrentInstance 仅 setup 同步期可用，异步回调中调用返回 null） */
	const self = getCurrentInstance()
	const props = defineProps<{
		/** 气泡底色（随主题，夜间提亮） */
		bg: string
		/** 正文区顶部起点（px，气泡上置下界） */
		navTop: number
		/** 引用排版模式（下行想法编辑器：true=悬挂对齐式短行诗句，false=正文流式长文段落） */
		quoteAlign: boolean
		/** 想法查看卡片最大宽度（px；0=页面满宽，透传 ThoughtPanel，宿主正文限宽时下行） */
		thoughtCardMaxW: number
		/** 页面宽高（px，钳制与双行判定） */
		pageW: number
		pageH: number
		/** 排版度量（每行字数/行高/字距，宿主随字号与屏宽下行，划词换算用） */
		metrics: TextMetrics
		/** 宿主锚点是否为 view 级元素（首页诗字符单元）：true 时 App 原生端也可信并取其实测 x；
		 *  正文嵌套 text 的锚点在 App 端 X 含首行缩进平移，须置 false 走段落矩形+真实行边界 */
		anchorsFromView: boolean
		/** 选区覆盖段序列（宿主按选区与各章段落展开；划线按项写入所在章） */
		segs: SpanSeg[]
		/** 选区文本（跨段拼接，宿主计算） */
		text: string
		/** 分享卡片内容快照（宿主按选区计算；null=无选区不可分享） */
		shareCtx: ShareQuoteCtx | null
		/** 分享卡片头像路径（宿主按登录态映射，未登录默认头像） */
		logoSrc: string
		/** 引用文本颜色（随主题，想法编辑器引用块） */
		quoteColor: string
		/** 想法查看卡片面板底色（随主题，夜间深色浮层） */
		panelBg: string
		/** 想法查看卡片内容文字色（随主题） */
		contentColor: string
	}>()

	const emit = defineEmits(['sync', 'dismiss', 'toast', 'thoughtViewClosed', 'spanChanged', 'dragStarted', 'queryAnchors', 'shareImage'])

	/** ===== 想法/分享子组件引用（浮层功能内聚子组件，本组件经 ref 接线转发）。
	 *  vdom 模式下自定义 Expose 类型 ref 会在运行时 cast 失败（项目规范 3.4），
	 *  统一用内置 ComponentPublicInstance + $callMethod（方法名为字符串，子组件改名须同步调用点） ===== */
	const thoughtPanelRef = ref<ComponentPublicInstance | null>(null)
	const shareCardRef = ref<ComponentPublicInstance | null>(null)

	/** 气泡定位（px，视口坐标）：体中心跟随焦点（钳制屏幕内），垂直优先上方、空间不足转下方 */
	const popoverLeft = ref(0)
	const popoverTop = ref(0)
	/** 气泡是否位于选区下方（箭头朝上指向选区） */
	const below = ref(false)
	/** 箭头在气泡体内的水平位置（px，相对气泡体左缘，钳制不悬空） */
	const arrowLeft = ref(0)
	/** 气泡体尺寸缓存（内容固定，显示后查询一次校正；未就绪用估算值兜底） */
	let popoverW = 0
	let popoverH = 0
	let popoverMeasured = false
	const POPOVER_EST_W = 230
	const POPOVER_EST_H = 52
	/** 气泡双行布局：五项单行所需宽超过屏宽可用宽时切换，按屏宽判定一次 */
	const twoLine = ref(false)
	// 气泡单/双行判定（UTS script setup 顶层不支持裸块语句，块内变量提升并改名）
	const twoLineNeedW = rpxToPx(449) + 24
	const twoLineAvailW = props.pageW - rpxToPx(48)
	twoLine.value = twoLineNeedW > twoLineAvailW

	/** ===== 划词子系统（选区状态/手柄/逐字拖动吸附内聚；正文锚点与段落矩形由宿主查询回传） ===== */
	/** 划词选区（跨段选区：从起点段/字符到终点段/字符的闭区间） */
	const selSpan = ref<SelSpan | null>(null)
	/** 起点段视口位置（px，长按时缓存；滚动/翻页/字号变化即清选区防止手柄错位） */
	const selRectLeft = ref(0)
	const selRectTop = ref(0)
	/** 手柄位置（px，视口坐标，随选区端点更新） */
	const handleStartLeft = ref(0)
	const handleStartTop = ref(0)
	const handleEndLeft = ref(0)
	const handleEndTop = ref(0)
	/** 选区几何（px，视口坐标，气泡定位用）：估算即时填充，锚点实测后覆盖为真实值 */
	const selTopPx = ref(0)
	const selBottomPx = ref(0)
	/** 手柄热区尺寸（rpx）：HOT 仅作热区宽度（水平居中用）；VISUAL 为圆头+三角视觉体高度（= 热区顶/底到文字边界的距离）。
	 *  热区高度动态 = VISUAL + 行高（边界竖线贯穿整行文字），内联绑定 handleZoneH */
	const HANDLE_HOT_RPX = 76
	const HANDLE_VISUAL_RPX = 50
	/** 手柄热区高度（px，动态）：圆头+三角 50rpx + 贯穿整行的边界竖线（行高）；宽度仍 76rpx */
	const handleZoneH = computed(() : number => rpxToPx(HANDLE_VISUAL_RPX) + props.metrics.lineH)
	/** 边界竖线高度（px）：整行行高 + 4rpx 搭接量（超出行高的部分藏进三角尖端，衔接无缝） */
	const handleLineH = computed(() : number => props.metrics.lineH + rpxToPx(4))
	/** 手柄拖动状态（触摸目标在 touchstart 时锁定，move/end 持续派发至该手柄；响应式供气泡显隐联动） */
	const dragStartActive = ref(false)
	const dragEndActive = ref(false)
	/** 箭头指向的视口 x：长按触点位置，拖动手柄后为被拖端的新边界 */
	const selFocusX = ref(0)
	/** 最后操作的手柄端：0=未拖动（箭头指长按触点）/ -1=起点 / 1=终点 */
	let lastDragEnd = 0
	/** 选区已实测定位（锚点测量完成后手柄/气泡才出现，避免估算兜底位置跳变为实测位置） */
	const selectionLaidOut = ref(false)
	/** 宿主回传的拖动段落视口矩形（拖动开始时宿主查询回传） */
	let dragRects : ParaRect[] = []
	/** 建立选区时缓存的起点段文本长度（同段选区手柄估算用） */
	let beginParaLen = 0
	/** 建立选区时缓存的起点段切片在整段中的起始偏移（连续流恒为 0，保留兼容） */
	let beginSliceFrom = 0
	/** 手柄显示：有选区且已实测定位（拖动中保持显示并跟随手指，触摸目标不可卸载） */
	const handlesVisible = computed(() : boolean => {
		return selSpan.value != null && selectionLaidOut.value
	})
	/** 气泡显示：手柄显示且不在拖动手柄中（拖动中隐藏，松手按新选区重定位显示） */
	const bubbleVisible = computed(() : boolean => {
		return handlesVisible.value && !dragStartActive.value && !dragEndActive.value
	})

	/** 整段字符索引 → 行列（首行缩进占 2 字：首行容量 = perLine-2，续行 = perLine） */
	function rowColOf(charIdx : number, perLine : number) : number[] {
		const firstCap = Math.max(1, perLine - 2)
		if (charIdx < firstCap) {
			return [0, charIdx]
		}
		const row = 1 + Math.floor((charIdx - firstCap) / perLine)
		const col = charIdx - firstCap - (row - 1) * perLine
		return [row, col]
	}

	/** 行字距：App 原生端正文左对齐（text-align: justify 被平台裁剪），字格步进恒为自然字距；
	 *  非 App 端满行两端对齐拉伸，末列按行宽均分（末字符右缘再由真实行右界吸附校正） */
	function spacingOfRow(col : number, perLine : number) : number {
		const m = props.metrics
		// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
		return m.charW
		// #endif
		// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
		return (col + 1 >= perLine) ? m.fullCharW : m.charW
		// #endif
	}

	/** 字符边界视口坐标（[x, y]）：isEnd=末字符右缘/其行底，否则首字符左缘/其行顶。
	 *  charIdx 为整段坐标；段首切片（beginSliceFrom==0）按首行容量 perLine-2+缩进换算，
	 *  续切片（beginSliceFrom>0，段落跨页）行满容量 perLine 且无缩进，行列先平移到切片内坐标
	 *  （rect 为本页切片元素，整段行号直接套用会错位整行）；字距按行取值（与宿主行列换算同口径） */
	function charEdgePos(charIdx : number, isEnd : boolean, len : number) : number[] {
		const m = props.metrics
		let row : number
		let col : number
		if (beginSliceFrom > 0) {
			const rel = Math.max(0, Math.min(charIdx - beginSliceFrom, len - 1))
			row = Math.floor(rel / m.perLine)
			col = rel - row * m.perLine
		} else {
			const rc = rowColOf(Math.max(0, Math.min(charIdx, len - 1)), m.perLine)
			row = rc[0]
			col = rc[1]
		}
		const indent = (beginSliceFrom == 0 && row == 0) ? m.indentPx : 0
		const spacing = spacingOfRow(col, m.perLine)
		const lineTop = selRectTop.value + row * m.lineH
		const x = selRectLeft.value + indent + (isEnd ? (col + 1) * spacing : col * spacing)
		return [x, isEnd ? lineTop + m.lineH : lineTop]
	}

	/** 按选区端点估算刷新手柄与选区几何（即时显示兜底；跨段选区估算失效，由锚点实测定位） */
	function updateHandles() : void {
		const s = selSpan.value
		if (s == null) {
			return
		}
		if (s.fromOrigin != s.toOrigin || s.fromCid != s.toCid) {
			return
		}
		const hotH = rpxToPx(HANDLE_HOT_RPX)
		const visH = rpxToPx(HANDLE_VISUAL_RPX)
		const m = props.metrics
		// 选区同段内才能按排版估算；段长为建立选区时宿主提供的起点段文本长度
		const len = beginParaLen
		if (len <= 0) {
			return
		}
		const sp = charEdgePos(s.fromStart, false, len)
		handleStartLeft.value = sp[0] - hotH / 2
		handleStartTop.value = sp[1] - visH
		const ep = charEdgePos(s.toEnd, true, len)
		handleEndLeft.value = ep[0] - hotH / 2
		handleEndTop.value = ep[1] - m.lineH
		selTopPx.value = sp[1]
		selBottomPx.value = ep[1]
	}

	/** 锚点矩形可用性校验：与段落矩形同一查询批次（坐标系一致），做相对包含性校验与粒度校验；
	 *  App 原生端嵌套 text 的实测矩形可能是整行文本盒（宽度远大于一个字符）或 0 宽，
	 *  取错右缘会把手柄甩到行尾/字头——宽度不在单字量级即判不可用，退回真实行边界估算。
	 *  NodeInfo 字段在类型上可空，Kotlin 侧禁止可空值参与算术，统一 ?? 0 兜底 */
	function anchorUsable(a : NodeInfo, para : NodeInfo, m : TextMetrics) : boolean {
		const aTop = a.top ?? 0
		const aHeight = a.height ?? 0
		const aLeft = a.left ?? 0
		const aWidth = (a.right ?? 0) - aLeft
		const pTop = para.top ?? 0
		const pLeft = para.left ?? 0
		const pRight = para.right ?? 0
		const pBottom = para.bottom ?? 0
		// 下限取 0.28 字：首页诗行尾标点单元仅 27rpx（约 0.4 字宽）需通过；0 宽异常矩形仍被拒
		if (aWidth > m.charW * 2 || aWidth < m.charW * 0.28) {
			return false
		}
		const cy = aTop + aHeight / 2
		if (cy < pTop - m.lineH || cy > pBottom + m.lineH) {
			return false
		}
		if (aLeft < pLeft - m.charW || aLeft > pRight + m.charW) {
			return false
		}
		return true
	}

	/** 段落实际行数（元素高度/行高反推）的最大行序号，用于钳制异常行号 */
	function maxRowOf(para : NodeInfo, lineH : number) : number {
		const rows = Math.round((para.height ?? 0) / lineH)
		return Math.max(0, rows - 1)
	}

	/** 选区端点行列估算（切片口径）：续切片（sliceFrom>0，段落跨页）行满容量 perLine 且无缩进，
	 *  行列先平移到切片内坐标（rect 为本页切片元素，整段行号直接套用会错位整行）；段首切片按首行 -2 容量 */
	function rowColSliced(charIdx : number, sliceFrom : number, perLine : number) : number[] {
		if (sliceFrom > 0) {
			const rel = Math.max(0, charIdx - sliceFrom)
			const row = Math.floor(rel / perLine)
			return [row, rel - row * perLine]
		}
		return rowColOf(charIdx, perLine)
	}

	/** 切片起始字符所在段落的绝对行号（真实行断点口径；续切片无缩进，行号需整体平移） */
	function absLineOf(sliceFrom : number, ends : number[]) : number {
		let line = 0
		if (sliceFrom > 0) {
			while (line < ends.length - 1 && sliceFrom > ends[line]) {
				line++
			}
		}
		return line
	}

	/** 触点 → 字符（charX 精确口径）：pxPara 为触点相对段落文本原点的 x，在 paraLine 行的
	 *  可见字符区间 [visFrom, visTo]（切片口径）内找所属字格。端点边界语义与均匀口径一致：
	 *  起点柄边界归右字（floor）、终点柄边界归左字（ceil-1）。返回 [字符段落下标, 手柄 x]；
	 *  数据不可用返回 [-1, 0]（调用方退回均匀字格口径）。
	 *  rights 为该段逐行真实右缘：行末字符的右边界 cx[行末+1] 是下一行首字左缘（x=0，charX 按行
	 *  重启），必须改用本行右缘，否则终点柄拖到行末会吸附到 x=0 */
	function charCellAt(pxPara : number, cx : number[] | null, ends : number[] | null, rights : number[] | null, paraLine : number, visFrom : number, visTo : number, isEnd : boolean) : number[] {
		if (cx == null || ends == null) {
			return [-1, 0]
		}
		if (paraLine < 0 || paraLine >= ends.length) {
			return [-1, 0]
		}
		const rowStart = paraLine == 0 ? 0 : ends[paraLine - 1] + 1
		const rowEnd = ends[paraLine]
		const kStart = Math.max(rowStart, visFrom)
		const kEnd = Math.min(rowEnd, visTo)
		if (kEnd < kStart) {
			return [-1, 0]
		}
		if (isEnd) {
			let k = kEnd
			while (k > kStart && pxPara <= cx[k]) {
				k--
			}
			let x = cx[k + 1]
			if (k == rowEnd && rights != null && paraLine < rights.length) {
				x = rights[paraLine] ?? 0
			}
			return [k, x]
		}
		let k = kStart
		while (k < kEnd && pxPara >= cx[k + 1]) {
			k++
		}
		return [k, cx[k]]
	}

	/** 选区端点行列换算（真实行边界）：exactEnds 为整段真实逐行末字符下标，行号按本页切片起始偏移平移 */
	function rowColOfExact(charIdx : number, ends : number[], sliceFrom : number) : number[] {
		let line = 0
		while (line < ends.length - 1 && charIdx > ends[line]) {
			line++
		}
		let sliceLine = 0
		if (sliceFrom > 0) {
			while (sliceLine < ends.length - 1 && sliceFrom > ends[sliceLine]) {
				sliceLine++
			}
		}
		if (line < sliceLine) {
			line = sliceLine
		}
		const lineStart = line == 0 ? 0 : ends[line - 1] + 1
		const col = Math.max(0, charIdx - lineStart)
		return [line - sliceLine, col]
	}

	/** 宿主批量回传同一查询批次的矩形（锚点起/终 + 选区起/终段落）与两端各自的真实行边界，执行差分定位：
	 *  锚点矩形可实测时直接取真实字符边界；Android 零宽/单字锚点矩形可能为 0×0，
	 *  此时按所在端的真实行边界换算行/列（跨段选区两端行断点不同，必须分别传入） */
	function setAnchors(span : SelSpan, anchorStart : NodeInfo | null, anchorEnd : NodeInfo | null, fromPara : NodeInfo | null, toPara : NodeInfo | null, fromSliceFrom : number, toSliceFrom : number, fromLineEnds : number[] | null, toLineEnds : number[] | null, toLineRights : number[] | null, fromCharX : number[] | null, toCharX : number[] | null) : void {
		const m = props.metrics
		const hotH = rpxToPx(HANDLE_HOT_RPX)
		const visH = rpxToPx(HANDLE_VISUAL_RPX)
		const sameChapter = span.fromCid == span.toCid
		// UTS 无跨语句空值智能转换（Kotlin 侧不生效），可空入参先经 ! 归一为非空局部值，
		// NodeInfo 字段读取统一 ?? 0（可空值参与算术/赋给非空字段均编译失败）
		if (fromPara != null && ((sameChapter && span.fromOrigin == span.toOrigin) || toPara != null)) {
			const fp = fromPara!
			// 终点段矩形：同段即起点段；跨段/跨章取 toPara（上方守卫已保证非空）。
			// 不用「cond ? a : b!」三元——UTS codegen 对「三元+非空断言」的成员访问解析有缺陷
			let ep = fp
			if (!sameChapter || span.fromOrigin != span.toOrigin) {
				ep = toPara!
			}
			// 估算兜底：真实行边界优先（起点用起点段、终点用终点段——跨段时两段行断点不同，
			// 拿起点段的断点算终点会整行错位），无实测断点时退回段内行列×排版常量
			const sc = fromLineEnds != null ? rowColOfExact(span.fromStart, fromLineEnds, fromSliceFrom) : rowColSliced(span.fromStart, fromSliceFrom, m.perLine)
			// 终点按末字符自身行列换算（+1 会落到下一行行首，单字选区拖到行尾时手柄跑到下一行左侧）
			const ec = toLineEnds != null ? rowColOfExact(span.toEnd, toLineEnds, toSliceFrom) : rowColSliced(span.toEnd, toSliceFrom, m.perLine)
			let startRow = sc[0]
			let endRow = ec[0]
			// 段落绝对行号：toLineEnds/toLineRights 是整段逐行数组，切片口径行号须加回切片起始行
			const absEndRow = toLineEnds != null ? ec[0] + absLineOf(toSliceFrom, toLineEnds) : -1
			let startX = (fp.left ?? 0) + (fromSliceFrom == 0 && startRow == 0 ? m.indentPx : 0) + sc[1] * spacingOfRow(sc[1], m.perLine)
			let endX = (ep.left ?? 0) + (toSliceFrom == 0 && endRow == 0 ? m.indentPx : 0) + (ec[1] + 1) * spacingOfRow(ec[1], m.perLine)
			// 选区终点恰在原生行尾时直接吸附真实行右缘，消除按均分列宽估算的末端误差
			if (toLineRights != null && toLineEnds != null && absEndRow >= 0 && absEndRow < toLineRights.length && absEndRow < toLineEnds.length && span.toEnd == toLineEnds[absEndRow]) {
				endX = (ep.left ?? 0) + (toLineRights[absEndRow] ?? 0)
			}
			// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
			// 末字符右缘统一从真实行右界倒推：行宽含「”」「，」等窄字形的实际推进宽，
			// 前进口径按 charW 均分会把窄字形多算约半字（尾柄超出高亮条/标点）。
			// 后缀字符按自然字距折算（正文左对齐，App 端无两端对齐拉伸）
			if (toLineEnds != null && toLineRights != null && absEndRow >= 0 && absEndRow < toLineEnds.length && absEndRow < toLineRights.length) {
				const remain = toLineEnds[absEndRow] - span.toEnd
				if (remain >= 0) {
					endX = (ep.left ?? 0) + (toLineRights[absEndRow] ?? 0) - remain * m.charW
				}
			}
			// 逐字推进宽（StaticLayout.getPrimaryHorizontal 缓存，段落坐标含缩进）：字符边界精确到字形，
			// 窄引号/标点的推进宽 ≠ charW，均分/行右倒推口径的残差在此归零
			if (fromCharX != null && span.fromStart >= 0 && span.fromStart < fromCharX.length) {
				startX = (fp.left ?? 0) + fromCharX[span.fromStart]
			}
			const endBound = span.toEnd + 1
			if (toCharX != null && endBound >= 0 && endBound < toCharX.length) {
				endX = (ep.left ?? 0) + toCharX[endBound]
			}
			// #endif
			// 行号钳制进段落实际行数（矩形高度反推），异常值不至飞出段落
			startRow = Math.max(0, Math.min(startRow, maxRowOf(fp, m.lineH)))
			endRow = Math.max(0, Math.min(endRow, maxRowOf(ep, m.lineH)))
			let startTop = (fp.top ?? 0) + startRow * m.lineH
			let endBottom = (ep.top ?? 0) + (endRow + 1) * m.lineH
			// 锚点实测优先：X/Y 均直接使用真实字符边界，不再把实测结果折算回估算行高。
			// App 原生端嵌套 text 的锚点矩形 X 含首行缩进平移、Y 为行盒口径，不可作正文划词真源；
			// 首页诗的字符单元是 view，实测矩形精确（anchorsFromView=true）——该端只取其 x，y 仍用行估算
			let useAnchor = false
			// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
			useAnchor = true
			// #endif
			// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
			useAnchor = props.anchorsFromView
			// #endif
			if (useAnchor && anchorStart != null && anchorUsable(anchorStart, fp, m)) {
				const asN = anchorStart!
				startX = asN.left ?? 0
				if (!props.anchorsFromView) {
					startTop = asN.top ?? 0
				}
			}
			if (useAnchor && anchorEnd != null && anchorUsable(anchorEnd, ep, m)) {
				const aeN = anchorEnd!
				endX = aeN.right ?? 0
				if (!props.anchorsFromView) {
					endBottom = aeN.bottom ?? 0
				}
			}
			// view 锚点宿主（首页诗）经 toRights 下发终点字符的「视觉右界」（字符=步进边界含单元右距、
			// 行尾标点=内容右缘，与高亮条/拖动吸附同公式）：锚点 right=单元盒右缘，比视觉右界少 15rpx 右距，
			// 直接采用会让松手落定比拖动预览/高亮右缘缩进半个字距——此处覆盖为视觉右界
			if (props.anchorsFromView && useAnchor && toLineRights != null && toLineRights.length > 0) {
				endX = (ep.left ?? 0) + (toLineRights[0] ?? 0)
			}
			// 兜底：末字符右缘不得越出段落矩形右界（首页诗行尾标点单元窄于字格步进，
			// 按列宽前推会把手柄推到标点右侧之外；正文段落右界恒 ≥ 文本右缘，无副作用）
			const epRight = ep.right ?? 0
			if (epRight > (ep.left ?? 0) && endX > epRight) {
				endX = epRight
			}
			handleStartLeft.value = startX - hotH / 2
			handleStartTop.value = startTop - visH
			handleEndLeft.value = endX - hotH / 2
			handleEndTop.value = endBottom - m.lineH
			selTopPx.value = startTop
			selBottomPx.value = endBottom
		} else if (anchorStart != null && anchorEnd != null) {
			const asN = anchorStart!
			const aeN = anchorEnd!
			// 跨章/段落矩形缺失：退回锚点绝对坐标
			handleStartLeft.value = (asN.left ?? 0) - hotH / 2
			handleStartTop.value = (asN.top ?? 0) - visH
			handleEndLeft.value = (aeN.right ?? 0) - hotH / 2
			handleEndTop.value = (aeN.bottom ?? 0) - m.lineH
			selTopPx.value = asN.top ?? 0
			selBottomPx.value = aeN.bottom ?? 0
		} else {
			return
		}
		// 拖动过手柄后箭头指向被拖端的新边界，未拖动时保持指向长按触点
		if (lastDragEnd == -1) {
			selFocusX.value = handleStartLeft.value + hotH / 2
		} else if (lastDragEnd == 1) {
			selFocusX.value = handleEndLeft.value + hotH / 2
		}
		// 实测完成，手柄与气泡以精确位置首次显示
		selectionLaidOut.value = true
	}

	/** 拖动手柄的抓握偏移（触点 - 被拖端字符边界锚点）：手柄视觉体悬于行外（起点柄在行顶上方、
	 *  终点柄圆头垂于行底下方），直接把触点当字符落点会让人抓在圆头时首帧跳到相邻行；
	 *  拖动全程沿用该偏移还原逻辑落点，视觉位置由逐字吸附决定 */
	let dragGrabDX = 0
	let dragGrabDY = 0

	/** 手柄拖动核心（触摸与 Web 鼠标桥接共用；x/y 为触点视口坐标）：
	 *  触点按抓握偏移还原逻辑落点 → 映射段落行列 → 更新被拖端点 → 手柄逐字吸附到字符边界
	 *  （起点柄贴字符左缘/行顶，终点柄贴字符右缘/行底；每次跨过一个字格才移动一格） */
	function applyHandleDragAt(x : number, y : number, isEnd : boolean) : void {
		const span = selSpan.value
		if (span == null || dragRects.length == 0) {
			return
		}
		const m = props.metrics
		const px = x - dragGrabDX
		const py = y - dragGrabDY
		// 触点命中段落（纵向区间，未命中钳制首末段）
		let idx = -1
		for (let i = 0; i < dragRects.length; i++) {
			if (py >= dragRects[i].top && py <= dragRects[i].bottom) {
				idx = i
				break
			}
		}
		if (idx < 0) {
			// 段落间距空隙：归入纵向最近的段落（落到首/末段会让端点跨段跳变）
			idx = 0
			let best = 0
			if (py < dragRects[0].top) {
				best = dragRects[0].top - py
			} else if (py > dragRects[0].bottom) {
				best = py - dragRects[0].bottom
			}
			for (let i = 1; i < dragRects.length; i++) {
				let d = 0
				if (py < dragRects[i].top) {
					d = dragRects[i].top - py
				} else if (py > dragRects[i].bottom) {
					d = py - dragRects[i].bottom
				}
				if (d < best) {
					best = d
					idx = i
				}
			}
		}
		const pr = dragRects[idx]
		// 拖动到的段落长度：以段序列口径不可用（跨章/跨段展开顺序≠rect 顺序），由宿主随矩形回传段长
		const len = pr.len
		if (len <= 0) {
			return
		}
		// 首行容量：段首切片（pr.from==0）被两个全角缩进占去 2 字，续切片（段落跨页）首行即满容量
		const firstCap = pr.from == 0 ? Math.max(1, m.perLine - 2) : m.perLine
		let maxRow : number
		if (pr.from == 0) {
			const rest = len - firstCap
			maxRow = rest <= 0 ? 0 : Math.ceil(rest / m.perLine)
		} else {
			maxRow = Math.max(0, Math.ceil(len / m.perLine) - 1)
		}
		// 行映射按端点边界取整：起点柄锚在行顶（触点所在行）、终点柄锚在行底（触点上一行），
		// 触点恰在边界上时归入手柄当前所在行，拖动首帧不会跳到相邻行
		let row : number
		if (isEnd) {
			row = Math.ceil((py - pr.top) / m.lineH) - 1
		} else {
			row = Math.floor((py - pr.top) / m.lineH)
		}
		row = Math.max(0, Math.min(row, maxRow))

		let effOrigin = pr.origin
		let effCharIdx = 0
		let snapX = 0
		let lineTop = 0
		let preciseDone = false
		// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
		// 精确路径：charX（逐字左缘，段落坐标含缩进）+ lineEnds（行断点）由宿主从 StaticLayout 缓存下发。
		// 触点 px 相对段落文本原点，在触点所在行的可见字符区间内找所属字格——窄引号/标点的
		// 真实推进宽在此生效，拖动预览与松手落定完全一致（无松手跳变）
		const cxN = pr.charX
		const endsN = pr.lineEnds
		if (cxN != null && endsN != null) {
			const paraLine = Math.max(0, Math.min(absLineOf(pr.from, endsN) + row, endsN.length - 1))
			const cell = charCellAt(px - pr.left, cxN, endsN, pr.lineRights, paraLine, pr.from, pr.from + len - 1, isEnd)
			if (cell[0] >= 0) {
				effCharIdx = cell[0]
				snapX = pr.left + cell[1]
				lineTop = pr.top + row * m.lineH
				preciseDone = true
			}
		}
		// #endif
		if (!preciseDone) {
			// 均匀字格口径（首页诗/无逐字缓存的端）：首行触点先扣除缩进宽（两个全角空格）；
			// 字距：App 原生端左对齐恒为自然字距，非 App 端首行/末行自然字距、中间满行两端对齐拉伸
			const indent = (pr.from == 0 && row == 0) ? m.indentPx : 0
			// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
			const spacing = m.charW
			// #endif
			// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
			const spacing = row == 0 ? m.charW : (row < maxRow ? m.fullCharW : m.charW)
			// #endif
			const rowCap = row == 0 ? firstCap : m.perLine
			// 列映射同口径：起点柄取触点所在字格（floor），终点柄锚在字符右缘（ceil-1），边界处不跳字
			let col : number
			if (isEnd) {
				col = Math.ceil((px - pr.left - indent) / spacing) - 1
			} else {
				col = Math.floor((px - pr.left - indent) / spacing)
			}
			col = Math.max(0, Math.min(col, rowCap - 1))
			// 切片内字符索引（首行容量 firstCap）加切片偏移 = 整段坐标（流式分页段落跨页时 pr.from 非 0）
			const sliceIdx = row == 0 ? col : firstCap + (row - 1) * m.perLine + col
			// 钳制到切片末字符后回推列号：触点落在行尾空白/标点区时吸附末字符，不越出文本
			const sliceCharIdx = Math.max(0, Math.min(sliceIdx, len - 1))
			const snapCol = row == 0 ? sliceCharIdx : Math.max(0, sliceCharIdx - firstCap - (row - 1) * m.perLine)
			const charIdx = sliceCharIdx + pr.from
			effCharIdx = charIdx
			// 合并行（首页诗宽屏"每行一句"：一个渲染行并置两个笔记段）——超过前段长度的字符索引
			// 归入后段（secondOrigin），段内列 = 字符索引 - 前段长度；无合并（-1）按单段原样
			if (pr.secondOrigin > 0 && charIdx >= pr.firstLen) {
				effOrigin = pr.secondOrigin
				effCharIdx = charIdx - pr.firstLen
			}
			snapX = pr.left + indent + (isEnd ? (snapCol + 1) * spacing : snapCol * spacing)
			if (isEnd && snapCol == len - 1 && pr.right > pr.left) {
				// 末字符右缘按段落右界收敛（首页诗行尾标点区窄于字格步进，避免手柄悬出文本）
				snapX = Math.min(snapX, pr.right)
			}
			lineTop = pr.top + row * m.lineH
		}
		if (isEnd) {
			// 终点柄：新位置在起点之前则互换端点，否则更新终点
			if (comparePos(pr.cid, effOrigin, effCharIdx, span.fromCid, span.fromOrigin, span.fromStart) >= 0) {
				span.toCid = pr.cid
				span.toOrigin = effOrigin
				span.toEnd = effCharIdx
			} else {
				span.toCid = span.fromCid
				span.toOrigin = span.fromOrigin
				span.toEnd = span.fromStart
				span.fromCid = pr.cid
				span.fromOrigin = effOrigin
				span.fromStart = effCharIdx
			}
		} else {
			// 起点柄：新位置在终点之后则互换端点，否则更新起点
			if (comparePos(pr.cid, effOrigin, effCharIdx, span.toCid, span.toOrigin, span.toEnd) <= 0) {
				span.fromCid = pr.cid
				span.fromOrigin = effOrigin
				span.fromStart = effCharIdx
			} else {
				span.fromCid = span.toCid
				span.fromOrigin = span.toOrigin
				span.fromStart = span.toEnd
				span.toCid = pr.cid
				span.toOrigin = effOrigin
				span.toEnd = effCharIdx
			}
		}
		// 逐字吸附：被拖端落在新字符的左/右缘与行顶/行底，箭头焦点同步吸附点
		const hotH = rpxToPx(HANDLE_HOT_RPX)
		const visH = rpxToPx(HANDLE_VISUAL_RPX)
		selFocusX.value = snapX
		if (isEnd) {
			handleEndLeft.value = snapX - hotH / 2
			// 终点柄热区顶=行顶（竖线自行顶贯穿至行底）：行底-行高=行顶，圆头三角垂于行底下方
			handleEndTop.value = lineTop
		} else {
			handleStartLeft.value = snapX - hotH / 2
			handleStartTop.value = lineTop - visH
		}
		// 选区端点变化上行（宿主渲染高亮与派生上下文）
		emit('spanChanged', span)
	}

	/** 手柄拖动（跨段）：触点映射到段落与字符并更新被拖端点；越过另一端时端点互换（原生选择交互）；拖动中手柄逐字吸附，松手后由锚点实测校正真实边界 */
	function applyHandleDrag(e : UniTouchEvent, isEnd : boolean) : void {
		if (e.touches.length == 0) {
			return
		}
		applyHandleDragAt(e.touches[0].clientX, e.touches[0].clientY, isEnd)
	}

	/** 开始拖动手柄（触摸与 Web 鼠标共用）：锁定被拖端、记录抓握偏移并通知宿主刷新拖动段落矩形 */
	function beginHandleDrag(isEnd : boolean, touchX : number, touchY : number) : void {
		const hotH = rpxToPx(HANDLE_HOT_RPX)
		const visH = rpxToPx(HANDLE_VISUAL_RPX)
		const m = props.metrics
		if (isEnd) {
			dragGrabDX = touchX - (handleEndLeft.value + hotH / 2)
			// 抓握锚点=文字边界（热区顶+行高）：终点柄热区顶=行底-行高
			dragGrabDY = touchY - (handleEndTop.value + m.lineH)
			dragEndActive.value = true
			lastDragEnd = 1
		} else {
			dragGrabDX = touchX - (handleStartLeft.value + hotH / 2)
			dragGrabDY = touchY - (handleStartTop.value + visH)
			dragStartActive.value = true
			lastDragEnd = -1
		}
		emit('dragStarted')
	}

	function onStartHandleTouchStart(e : UniTouchEvent) : void {
		if (e.touches.length == 0) {
			return
		}
		beginHandleDrag(false, e.touches[0].clientX, e.touches[0].clientY)
	}

	function onStartHandleTouchMove(e : UniTouchEvent) : void {
		if (dragStartActive.value) {
			applyHandleDrag(e, false)
		}
	}

	function onStartHandleTouchEnd() : void {
		dragStartActive.value = false
		emit('queryAnchors')
	}

	function onEndHandleTouchStart(e : UniTouchEvent) : void {
		if (e.touches.length == 0) {
			return
		}
		beginHandleDrag(true, e.touches[0].clientX, e.touches[0].clientY)
	}

	function onEndHandleTouchMove(e : UniTouchEvent) : void {
		if (dragEndActive.value) {
			applyHandleDrag(e, true)
		}
	}

	function onEndHandleTouchEnd() : void {
		dragEndActive.value = false
		emit('queryAnchors')
	}

	// #ifdef WEB
	/** 桌面端无 touch 事件：鼠标桥接手柄拖动（mousedown 命中手柄 → move 逐字吸附映射选区 → up 落定实测），
	 *  与触摸共用 beginHandleDrag / applyHandleDragAt / onStart·EndHandleTouchEnd；组件常挂载，监听挂 document/window 一次 */
	let webHandleDragging = -1

	function onWebHandleMouseDown(e : MouseEvent) : void {
		if (e.button != 0) {
			return
		}
		const target = e.target as Element
		if (target.closest == null) {
			return
		}
		if (target.closest('#sel-handle-end') != null) {
			e.preventDefault()
			webHandleDragging = 1
			beginHandleDrag(true, e.clientX, e.clientY)
		} else if (target.closest('#sel-handle-start') != null) {
			e.preventDefault()
			webHandleDragging = 0
			beginHandleDrag(false, e.clientX, e.clientY)
		}
	}

	function onWebHandleMouseMove(e : MouseEvent) : void {
		if (webHandleDragging < 0) {
			return
		}
		applyHandleDragAt(e.clientX, e.clientY, webHandleDragging == 1)
	}

	function onWebHandleMouseUp(_e : MouseEvent) : void {
		if (webHandleDragging < 0) {
			return
		}
		webHandleDragging = -1
		if (dragStartActive.value) {
			onStartHandleTouchEnd()
		} else if (dragEndActive.value) {
			onEndHandleTouchEnd()
		}
	}

	onMounted(() => {
		document.addEventListener('mousedown', onWebHandleMouseDown)
		window.addEventListener('mousemove', onWebHandleMouseMove)
		window.addEventListener('mouseup', onWebHandleMouseUp)
	})

	onUnmounted(() => {
		document.removeEventListener('mousedown', onWebHandleMouseDown)
		window.removeEventListener('mousemove', onWebHandleMouseMove)
		window.removeEventListener('mouseup', onWebHandleMouseUp)
	})
	// #endif

	/** 建立选区（宿主长按正文选中触点所在字符，完成 rect 查询/字符换算/想法恢复后调用）：状态建立、手柄估算、请求锚点实测；
	 *  sliceFrom 为长按切片在整段中的起始偏移（流式分页段落跨页时非 0），手柄估算的行列换算需按切片口径 */
	function beginSelection(span : SelSpan, rectLeft : number, rectTop : number, focusX : number, paraLen : number, sliceFrom : number) : void {
		selRectLeft.value = rectLeft
		selRectTop.value = rectTop
		beginParaLen = paraLen
		beginSliceFrom = sliceFrom
		selSpan.value = normalizeSpan(span)
		emit('spanChanged', selSpan.value)
		// 箭头初始指向长按触点位置
		selFocusX.value = focusX
		lastDragEnd = 0
		// 复位定位标记：手柄与气泡等锚点实测完成后才出现（估算位置仅作兜底，避免先显示估算位置再跳到实测位置）
		selectionLaidOut.value = false
		updateHandles()
		emit('queryAnchors')
		// 锚点测量异常兜底：仍以估算位置显示手柄与气泡，保证功能可用
		setTimeout(() => {
			if (selSpan.value != null && !selectionLaidOut.value) {
				selectionLaidOut.value = true
			}
		}, 250)
	}

	/** 宿主回传拖动段落视口矩形（拖动开始时宿主查询正文段落并回传） */
	function setDragRects(rects : ParaRect[]) : void {
		dragRects = rects
	}

	/** 清除选区（滚动/翻页/字号变化/跳转等场景宿主调用）：状态复位并联动收起想法查看卡片（子组件） */
	function hideSelection() : void {
		selSpan.value = null
		selectionLaidOut.value = false
		dragRects = []
		thoughtPanelRef.value?.$callMethod('hideThoughtView')
		emit('spanChanged', null)
	}

	/** 按选区几何重定位（估算兜底按布局模式区分，实测后以真实尺寸校正） */
	function relocate() : void {
		if (!bubbleVisible.value) {
			return
		}
		const selTop = selTopPx.value
		const selBottom = selBottomPx.value
		const w = popoverW > 0 ? popoverW : (twoLine.value ? rpxToPx(290) : POPOVER_EST_W)
		const h = popoverH > 0 ? popoverH : (twoLine.value ? 100 : POPOVER_EST_H)
		// 上下间距避开手柄视觉体：起点柄悬于行顶上方、终点柄圆头三角垂于行底下方（延伸后各 50rpx），另留 16rpx 呼吸空隙
		const visH = rpxToPx(HANDLE_VISUAL_RPX)
		const gapUp = visH + rpxToPx(16)
		const gapDown = visH + rpxToPx(16)
		const arrowH = rpxToPx(13)
		// 水平：气泡体中心跟随焦点位置，两侧留边钳制不出屏
		const margin = rpxToPx(24)
		popoverLeft.value = Math.max(margin, Math.min(selFocusX.value - w / 2, props.pageW - margin - w))
		// 垂直：上方放得下置上方；否则取上下空间宽裕侧（下方时箭头朝上）
		const topSpace = selTop - gapUp - arrowH - h
		const bottomSpace = props.pageH - selBottom - gapDown - arrowH - h
		if (topSpace >= props.navTop || topSpace >= bottomSpace) {
			below.value = false
			popoverTop.value = Math.max(props.navTop, selTop - gapUp - arrowH - h)
		} else {
			below.value = true
			popoverTop.value = Math.min(selBottom + gapDown + arrowH, props.pageH - h - rpxToPx(60))
		}
		// 箭头（20rpx 方块）指向焦点：焦点在气泡体内时对准其位置、出体时钳到边缘，左缘再扣半宽
		const arrowMargin = rpxToPx(30)
		const arrowCenter = Math.max(arrowMargin, Math.min(selFocusX.value - popoverLeft.value, w - arrowMargin))
		arrowLeft.value = arrowCenter - rpxToPx(10)
	}

	/** 查询气泡体实际尺寸并校正定位（内容固定仅查一次，查询失败允许重试；组件内查询必须 .in 实例） */
	function measure() : void {
		const proxy = self == null ? null : self.proxy
		if (proxy == null) {
			return
		}
		// .in(proxy) 变体的回调入参为 any（与不带 in 的重载签名不同），内部再 as NodeInfo 收窄；
		// NodeInfo 字段可空，Kotlin 侧禁可空比较/赋值给非空变量，统一 ?? 0 兜底
		uni.createSelectorQuery().in(proxy).select('.popover-body').boundingClientRect((res : any) : void => {
			const rect = res as NodeInfo
			if (rect != null && (rect.width ?? 0) > 0 && (rect.height ?? 0) > 0) {
				popoverW = rect.width ?? 0
				popoverH = rect.height ?? 0
				popoverMeasured = true
				relocate()
			}
		}).exec()
	}

	/** 气泡重定位回调（任一几何源变化均触发；气泡可见且未实测时延迟实测校正） */
	function onRelocateSourceChange() : void {
		relocate()
		if (bubbleVisible.value && !popoverMeasured) {
			setTimeout(() => {
				measure()
			}, 80)
		}
	}

	// 单 getter 源逐个 watch（UTS 强类型下混合类型数组源推断不稳，与项目其余 watch 写法对齐；
	// getter 需显式标注返回类型，推断缺失会在 Kotlin 侧报 Return type mismatch）
	watch(() : boolean => bubbleVisible.value, onRelocateSourceChange)
	watch(() : number => selTopPx.value, onRelocateSourceChange)
	watch(() : number => selBottomPx.value, onRelocateSourceChange)
	watch(() : number => selFocusX.value, onRelocateSourceChange)


	/** 延迟清选区（复制/查询操作后留出感知时间） */
	function delayDismiss() : void {
		setTimeout(() => {
			emit('dismiss')
		}, 500)
	}

	/** 复制：选区文本写入剪贴板（微信端系统强制「内容已复制」提示，只保留系统提示） */
	function doCopy() : void {
		const content = props.text
		if (content.length == 0) {
			return
		}
		// #ifdef MP-WEIXIN
		uni.setClipboardData({
			data: content,
			fail: () => {
				emit('toast', t('sel.copyFail'))
			}
		})
		// #endif
		// #ifndef MP-WEIXIN
		uni.setClipboardData({
			data: content,
			showToast: false,
			success: () => {
				emit('toast', t('sel.copied'))
			},
			fail: () => {
				emit('toast', t('sel.copyFail'))
			}
		})
		// #endif
		delayDismiss()
	}

	/** 划线：选区段序列逐段做区间切换（已完全划线取消、否则并入）并持久化，随后通知宿主重读 */
	function doUnderline() : void {
		if (props.segs.length == 0) {
			return
		}
		applySpanUnderlineToStorage(props.segs, false)
		emit('sync')
		emit('dismiss')
	}

	/** 气泡操作分发（阻止冒泡避免触发容器点击清选区）。vdom 模式模板 $event 为 Any
	 *  （引擎差异见 项目规范 3.4），入参收 any、内部断言为指针事件 */
	function onAction(e : any, action : string) : void {
		const pe = e as UniPointerEvent
		pe.stopPropagation()
		if (action === 'copy') {
			doCopy()
		} else if (action === 'idea') {
			// 打开想法编辑器（子组件内聚：输入/保存/同步划线），编辑期间保留选区
			thoughtPanelRef.value?.$callMethod('openEditor', props.text)
		} else if (action === 'underline') {
			doUnderline()
		} else if (action === 'query') {
			emit('toast', t('sel.queryTodo'))
			delayDismiss()
		} else if (action === 'share') {
			shareCardRef.value?.$callMethod('open')
		}
	}

	/** ===== 宿主调用入口（划词协议 + 想法查看卡片开关转发子组件） ===== */
	function showThoughtView(quote : string, content : string, selBottom : number, selTop : number) : void {
		thoughtPanelRef.value?.$callMethod('showThoughtView', quote, content, selBottom, selTop)
	}

	function hideThoughtView() : void {
		thoughtPanelRef.value?.$callMethod('hideThoughtView')
	}

	/** 转发封面路径直读转发（宿主 onShareAppMessage 经 ref 消费；emit 链真机不可靠） */
	function coverImagePath() : string {
		return (shareCardRef.value?.$callMethod('coverImagePath') as string | null) ?? ''
	}

	defineExpose({
		beginSelection,
		hideSelection,
		setAnchors,
		setDragRects,
		showThoughtView,
		hideThoughtView,
		coverImagePath
	})
</script>

<style lang="scss">
	/* 组件根：零尺寸占位（不设 flex 参与宿主 flex 流挤压正文），fixed 子浮层相对页面视口定位 */
	.sp-root {
		width: 0;
		height: 0;
	}

	/* 划词手柄（选区两端水滴形大手柄：圆头+三角+边界竖线同色叠压连为一体；宽度 76rpx 大于视觉体便于拖动，
	 * 高度动态内联绑定 handleZoneH（圆头三角 50rpx + 贯穿整行文字的竖线），起点柄贴行顶、终点柄贴行底） */
	.sel-handle {
		position: fixed;
		width: 76rpx;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		z-index: 61;
	}

	.sel-handle-drop {
		width: 34rpx;
		height: 34rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-mute;
	}

	.sel-handle-tip {
		width: 0;
		height: 0;
		border-left-width: 15rpx;
		border-left-style: solid;
		border-left-color: transparent;
		border-right-width: 15rpx;
		border-right-style: solid;
		border-right-color: transparent;
	}

	/* 边界竖线（手柄延伸）：贯穿整行文字（高度内联绑定 handleLineH = 行高 + 4rpx 搭接量），宽 2rpx 尽量少遮文字 */
	.sel-handle-line {
		width: 2rpx;
		background-color: $bai-mute;
	}

	/* 起点柄竖线（三角在上、线在下）：上缘以 -4rpx 搭入三角尖端；终点柄线在上、三角在下，由 .sel-handle-tip-up 的 margin-top -4rpx 反向搭接 */
	.sel-handle-line-start {
		margin-top: -4rpx;
	}

	/* 三角底边 30rpx、高 25rpx：底边两角恰落在圆头轮廓上（圆底上方 9rpx 处弦宽恰 30rpx），侧边与圆面相切，
	 * 衔接无豁口无尖角——底边窄于该处弦宽或搭接过浅都会让两角戳出圆外形成左右豁口；
	 * tip-down 以 -9rpx 搭圆头；tip-up 以 -9rpx 搭圆头、-4rpx 搭竖线；
	 * 圆头+三角有效高度 34+(25-9)=50rpx = HANDLE_VISUAL_RPX，加竖线（行高+4rpx 搭接）恰填满动态热区，
	 * 三角尖端与文字边界精确重合；改 HANDLE_VISUAL_RPX 或本组尺寸须同步 script 侧 handleZoneH/handleLineH */
	.sel-handle-tip-down {
		border-top-width: 25rpx;
		border-top-style: solid;
		border-top-color: $bai-mute;
		margin-top: -9rpx;
	}

	.sel-handle-tip-up {
		border-bottom-width: 25rpx;
		border-bottom-style: solid;
		border-bottom-color: $bai-mute;
		margin-top: -4rpx;
		margin-bottom: -9rpx;
	}

	/* 划词气泡（Stitch: 黑底圆角 12px 内边距 12x8，操作项竖排图标+文字；位置由内联绑定——水平对准选区中心、垂直置于选区上/下侧，箭头随朝向指向选区） */
	.selection-popover {
		position: fixed;
		z-index: 60;
	}

	.popover-body {
		position: relative;
		flex-direction: row;
		align-items: center;
		padding: 12rpx 15rpx;
		/* 背景内联绑定（夜间提亮一档与暗底区分，日间墨黑） */
		border-radius: $bai-rounded-md;
	}

	/* 双行布局（屏宽不足以单行展开时）：行靠左、各行与按钮宽度均自适应内容，行间水平细分隔线（stretch 横贯） */
	.popover-body-two {
		flex-direction: column;
		align-items: flex-start;
	}

	.popover-row {
		flex-direction: row;
		align-items: center;
	}

	.popover-divider-h {
		align-self: stretch;
		height: 1px;
		margin: 10rpx 15rpx;
		background-color: rgba($bai-on-primary, 0.2);
	}

	.popover-btn {
		flex-direction: column;
		align-items: center;
		padding: 6rpx 14rpx;
	}

	.popover-icon {
		width: 31rpx;
		height: 31rpx;
	}

	.popover-text {
		/* App 原生端 gap 不生效（规范 3.4）：图标与文字间距改 margin */
		margin-top: 6rpx;
		font-size: 21rpx;
		font-weight: 500;
		color: $bai-on-primary;
	}

	.popover-divider {
		/* App 原生端 gap 不生效（规范 3.4）：按钮与竖分隔线间距改两侧 margin */
		margin-left: 6rpx;
		margin-right: 6rpx;
		width: 1px;
		height: 46rpx;
		background-color: rgba($bai-on-primary, 0.2);
	}

	/* 气泡箭头（体旁旋转 45° 实色小方块：一半与体重叠（同色无缝）、露出一半形成三角尖，规避 border 三角 hack 与体圆角裁剪；水平 margin-left 内联绑定指向按住位置，颜色内联绑定与体一致） */
	.popover-arrow {
		width: 20rpx;
		height: 20rpx;
		transform: rotate(45deg);
	}

	/* 气泡在选区上方：方块贴体底，上移半格与体重叠，露出下半菱形为朝下尖 */
	.popover-arrow-below {
		margin-top: -10rpx;
	}

	/* 气泡在选区下方：方块贴体顶，下移半格与体重叠，露出下半菱形为朝上尖 */
	.popover-arrow-above {
		margin-bottom: -10rpx;
	}

</style>

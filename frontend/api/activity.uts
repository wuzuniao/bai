/**
 * 活动奖励接口（直连本项目后端，与阅读业务同服务）
 * --------------------------------------------------------------------------
 * - 活动页聚合数据 / 每日签到 / 阅读档位奖励领取，全部需登录态
 * - 全部标记 silent：未登录/令牌过期 401 不跳转登录页（调用点经
 *   hasAccessToken 源头跳过请求，未登录走本地默认展示）
 * - 返回 ApiResponse（code=0 成功，data 为内层业务数据）
 */
import { request, ApiResponse, apiOpts } from '@/utils/request.uts'


/** 活动页聚合数据（余额 / 今日已获 / 阅读统计 / 本周签到 / 今日档位状态） */
export function fetchActivitySummary() : Promise<ApiResponse> {
	return request(apiOpts('/api/v1/activity/summary', 'GET', null))
}

/** 今日签到（按星期定档发放铜币；重复签到后端 400） */
export function postCheckin() : Promise<ApiResponse> {
	return request(apiOpts('/api/v1/activity/checkin', 'POST', {} as UTSJSONObject))
}

/** 会员补签（date=被补日期 YYYY-MM-DD；黑铁及以上每月 3 次，后端实时复核会员与限额） */
export function postCheckinMakeup(date: string) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['date'] = date
	return request(apiOpts('/api/v1/activity/makeup', 'POST', data))
}

/** 领取阅读档位奖励（tierMinutes=档位阈值分钟数；未达标/已领取后端 400） */
export function claimReadingReward(tierMinutes: number) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['tier_minutes'] = tierMinutes
	return request(apiOpts('/api/v1/activity/reading-claim', 'POST', data))
}

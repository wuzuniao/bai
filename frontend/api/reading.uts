/**
 * 阅读业务接口（直连本项目后端，与 auth 接口分服务）
 * --------------------------------------------------------------------------
 * - 书籍元数据 / 划线想法 / 书签 / 阅读时长 / 偏好，全部需登录态
 * - baseUrl 统一 API_BASE_URL（区别于 pages/user/api/user.uts 直连 auth）
 * - 全部标记 silent：未登录/令牌过期 401 不跳转登录页（未登录属常态，
 *   页面走本地缓存与默认样式；调用点经 hasAccessToken 源头跳过请求）
 * - 返回 ApiResponse（code=0 成功，data 为内层业务数据）
 */
import { request, ApiResponse, apiOpts } from '@/utils/request.uts'
import { t } from '@/utils/i18n.uts'
// 词典注册（复用请求层文案段）
import '@/utils/locales/request.uts'


/** 空请求体（DELETE 等无体请求） */
function emptyBody() : UTSJSONObject {
	return {} as UTSJSONObject
}

// ==================== 书籍元数据 ====================

/** 书架列表（云端为准；返回 data.list 为书籍对象数组） */
export function fetchBooks() : Promise<ApiResponse> {
	return request(apiOpts('/api/v1/books', 'GET', null))
}

/** 导入登记（同用户同名书后端复用同一行并回填元数据；返回 data 含 id 与 created） */
export function registerBook(title: string, format: string, size: number, chapterCount: number, hasPreface: boolean) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['title'] = title
	data['format'] = format
	data['size'] = size
	data['chapter_count'] = chapterCount
	data['has_preface'] = hasPreface
	return request(apiOpts('/api/v1/books', 'POST', data))
}

/** 阅读进度回写（fields 仅放本次要更新的进度键，如 last_chapter/last_page_index/last_scroll_top/last_percent/pdf_ratio；后端按「有进度字段」判定刷新最近阅读时刻） */
export function updateBookProgress(bookId: number, fields: UTSJSONObject) : Promise<ApiResponse> {
	return request(apiOpts('/api/v1/books/' + bookId, 'PUT', fields))
}

/** 书架手动排序批量更新（items: [{id, sort_order}]） */
export function updateBookOrder(items: UTSJSONObject[]) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['items'] = items
	return request(apiOpts('/api/v1/books/order', 'PUT', data))
}

/** 删除书籍（后端级联清理划线/想法/书签） */
export function deleteBook(bookId: number) : Promise<ApiResponse> {
	return request(apiOpts('/api/v1/books/' + bookId, 'DELETE', emptyBody()))
}

// ==================== 划线与想法 ====================

/** 书籍的划线与想法列表（data: {underlines, thoughts}） */
export function fetchBookNotes(bookId: number) : Promise<ApiResponse> {
	return request(apiOpts('/api/v1/books/' + bookId + '/notes', 'GET', null))
}

/** 划线按「章+段」upsert（ranges 扁平数组 [s1,e1,s2,e2,...]，空数组=整段取消） */
export function upsertUnderline(bookId: number, cid: number, origin: number, ranges: number[]) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['cid'] = cid
	data['origin'] = origin
	data['ranges'] = ranges
	return request(apiOpts('/api/v1/books/' + bookId + '/notes/underline', 'PUT', data))
}

/** 写想法（跨章选区定位 + 划线文本快照 + 正文；返回 data.id） */
export function createThought(bookId: number, fromCid: number, fromOrigin: number, fromStart: number, toCid: number, toOrigin: number, toEnd: number, quote: string, content: string) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['from_cid'] = fromCid
	data['from_origin'] = fromOrigin
	data['from_start'] = fromStart
	data['to_cid'] = toCid
	data['to_origin'] = toOrigin
	data['to_end'] = toEnd
	data['quote'] = quote
	data['content'] = content
	return request(apiOpts('/api/v1/books/' + bookId + '/notes/thought', 'POST', data))
}

// ==================== 书签 ====================

/** 书签列表（data.list: [{chapter_id, page_index}]） */
export function fetchBookBookmarks(bookId: number) : Promise<ApiResponse> {
	return request(apiOpts('/api/v1/books/' + bookId + '/bookmarks', 'GET', null))
}

/** 书签整表替换（前端本地列表即真源快照） */
export function replaceBookmarks(bookId: number, items: UTSJSONObject[]) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['items'] = items
	return request(apiOpts('/api/v1/books/' + bookId + '/bookmarks', 'PUT', data))
}

// ==================== 阅读时长 ====================

/** 单次阅读结算上报（分钟数累加至今日；返回 data 今日与累计分钟数） */
export function reportMinutes(mins: number) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['minutes'] = mins
	return request(apiOpts('/api/v1/reading/minutes', 'POST', data))
}

/** 今日与累计阅读分钟数（data: {today_minutes, total_minutes}） */
export function fetchReadingStats() : Promise<ApiResponse> {
	return request(apiOpts('/api/v1/reading/stats', 'GET', null))
}

/** 阅读统计报告（data: 周期指标/trend 趋势/peak 最久点位/books 书籍榜/hours 时段分布/peak_tag 偏好标签；anchor 为周期内锚点日期 YYYY-MM-DD） */
export function fetchReadingReport(period: string, anchor: string) : Promise<ApiResponse> {
	let url = '/api/v1/reading/report?period=' + period
	if (anchor.length > 0) {
		url += '&anchor=' + anchor
	}
	return request(apiOpts(url, 'GET', null))
}

/** 阅读时长排行（data: {total, has_more, list:[{user_id, username, total_minutes}]}，仅含有阅读记录的已存在用户，按总时长降序分页；has_more 为是否还有下一页；anchor 为周期内锚点日期 YYYY-MM-DD） */
export function fetchReadingRanking(period: string, anchor: string, page: number, pageSize: number) : Promise<ApiResponse> {
	let url = '/api/v1/reading/ranking?period=' + period + '&page=' + page + '&page_size=' + pageSize
	if (anchor.length > 0) {
		url += '&anchor=' + anchor
	}
	return request(apiOpts(url, 'GET', null))
}

/**
 * 阅读会话流水批量上报（按书/时段明细账，在线直传与离线补传共用）
 * items 元素字段：book_id/source(txt|pdf)/started_at/ended_at(YYYY-MM-DD HH:mm:ss)/minutes
 * 书籍无效的条目由后端跳过，返回 data.accepted 实际落库条数
 */
export function reportReadingSessions(items: UTSJSONObject[]) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['sessions'] = items
	return request(apiOpts('/api/v1/reading/sessions', 'POST', data))
}

// ==================== 偏好 ====================

/** 读取偏好配置（data.prefs 未保存过为 null） */
export function fetchPreferences() : Promise<ApiResponse> {
	return request(apiOpts('/api/v1/preferences', 'GET', null))
}

/** 偏好整包写入（阅读设置 + 书架样式） */
export function savePreferences(prefs: UTSJSONObject) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['prefs'] = prefs
	return request(apiOpts('/api/v1/preferences', 'PUT', data))
}

/**
 * 静默同步：本地写入后的云端跟随（fire-and-forget）
 * 云端失败仅告警不打断交互（本地缓存为准，下次进入页面以云端覆盖回正）
 */
export function syncQuiet(p: Promise<ApiResponse>) : void {
	p.then((_res: ApiResponse) => {
		// 成功静默
	}, (e: Error | null) => {
		// 未登录属常态（本地缓存为准），不告警（文案与 request.uts 同源，跨语言一致）
		if (e != null && e.message == t('request.notLoggedIn')) {
			return
		}
		console.warn('云端同步失败', e)
	})
}

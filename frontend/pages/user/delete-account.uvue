<script setup lang="uts">
	import PageShell from '@/components/common/PageShell.uvue'
	import { t } from '@/utils/i18n.uts'
	// 词典注册（contact/help/delete 页文案）
	import '@/utils/locales/userinfo-pages.uts'
	import '@/utils/locales/common.uts'

	/** 跳转登录页（登录后在个人信息页删除账号） */
	function goLogin() : void {
		uni.navigateTo({ url: '/pages/user/login' })
	}

	// 微信小程序分享：转发好友与朋友圈（封面统一 /static/share-cover.png，复制自 yao 项目）
	// #ifdef MP-WEIXIN
	onShareAppMessage(() => {
		return { title: t('delete.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	onShareTimeline(() => {
		return { title: t('delete.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	// #endif
</script>


<template>
	<PageShell title="" desc="" :center="true">
				<!-- 找回密码卡片 -->
				<view class="forgot-page__card">
					<view class="forgot-page__header">
						<text class="forgot-page__title">{{ t('forgot.title') }}</text>
					</view>

					<!-- 步骤1：邮箱 + 验证码 -->
					<view v-if="step === 1" class="forgot-page__form">
						<view class="forgot-page__field">
							<FormInput v-model="emailValue" :label="t('forgot.emailLabel')" :placeholder="t('forgot.emailPh')" :maxlength="254" :error="emailError" @blur="onEmailBlur" />
						</view>

						<view class="forgot-page__field">
							<CodeInput ref="codeRef" v-model="codeValue" :label="t('forgot.codeLabel')" :error="codeError" :sending="isSending" @request-send="handleGetCode" />
						</view>

						<view class="forgot-page__submit" @click="handleStep1Submit">
							<text class="forgot-page__submit-text">{{ t('forgot.next') }}</text>
						</view>
					</view>

					<!-- 步骤2：新密码 + 确认密码 -->
					<view v-else class="forgot-page__form">
						<view class="forgot-page__field">
							<PasswordInput v-model="newPasswordValue" :label="t('forgot.newPasswordLabel')" :placeholder="t('forgot.newPasswordPh')" :maxlength="20" :error="newPasswordError" @blur="onNewPasswordBlur" />
						</view>

						<view class="forgot-page__field">
							<PasswordInput v-model="confirmPasswordValue" :label="t('forgot.confirmLabel')" :placeholder="t('forgot.confirmPh')" :maxlength="20" :error="confirmPasswordError" @blur="onConfirmPasswordBlur" />
						</view>

						<view class="forgot-page__submit" @click="handleStep2Submit">
							<text class="forgot-page__submit-text">{{ t('forgot.submit') }}</text>
						</view>
					</view>
				</view>

				<!-- 底部登录链接 -->
				<view class="forgot-page__footer" @click="goLogin">
					<text class="forgot-page__footer-text">{{ t('forgot.backLogin') }}</text>
				</view>
	</PageShell>
</template>

<script setup lang="uts">
	import PageShell from '@/components/common/PageShell.uvue'
	import FormInput from '@/components/form/FormInput.uvue'
	import PasswordInput from '@/components/form/PasswordInput.uvue'
	import CodeInput from '@/components/form/CodeInput.uvue'
	import { sendResetCode, resetPassword } from './api/user.uts'
	import { validateEmail, validateCode, validatePassword, validateConfirmPassword } from './utils/validators.uts'
	import { toastGo } from './utils/flow.uts'
	import { t } from '@/utils/i18n.uts'
	// 词典注册（forgot 页文案 + 公共段）
	import '@/pages/user/locales/forgot.uts'
	import '@/utils/locales/common.uts'

	const step = ref(1)
	const emailValue = ref('')
	const codeValue = ref('')
	const newPasswordValue = ref('')
	const confirmPasswordValue = ref('')
	const emailError = ref('')
	const codeError = ref('')
	const newPasswordError = ref('')
	const confirmPasswordError = ref('')
	const isSending = ref(false)
	const submitting = ref(false)

	/** 验证码组件引用（倒计时与按钮复位内聚于组件）。类型用结构化暴露面而非组件名——
	 *  vdom 模式（规范 3.4）下组件实例需以 ComponentPublicInstance + $callMethod 调用（页面自定义 Expose 类型运行时 cast 失败）；方法名为字符串，组件内方法改名需同步 */
	const codeRef = ref<ComponentPublicInstance | null>(null)

	// ===== 前端输入校验（规则统一收口 utils/validators.uts，与 auth 服务后端保持一致） =====

	function onEmailBlur() : void {
		emailError.value = emailValue.value.length == 0 ? '' : validateEmail(emailValue.value)
	}

	function onNewPasswordBlur() : void {
		newPasswordError.value = newPasswordValue.value.length == 0 ? '' : validatePassword(newPasswordValue.value)
	}

	function onConfirmPasswordBlur() : void {
		confirmPasswordError.value = confirmPasswordValue.value.length == 0 ? '' : validateConfirmPassword(confirmPasswordValue.value, newPasswordValue.value)
	}

	// ===== 获取验证码（倒计时与复位内聚 CodeInput 组件） =====
	function handleGetCode() : void {
		if (isSending.value) {
			return
		}
		const emailErr = validateEmail(emailValue.value)
		if (emailErr.length > 0) {
			emailError.value = emailErr
			uni.showToast({ title: emailErr, icon: 'none' })
			return
		}
		isSending.value = true
		sendResetCode(emailValue.value).then((_res) => {
			uni.showToast({ title: t('forgot.codeSent'), icon: 'none' })
			codeRef.value?.$callMethod('startCountdown')
		}).catch((e) => {
			const err = e as Error
			codeRef.value?.$callMethod('reset')
			uni.showToast({ title: err.message, icon: 'none' })
		}).finally(() => {
			isSending.value = false
		})
	}

	// ===== 步骤1提交：校验邮箱和验证码格式后进入下一步 =====
	function handleStep1Submit() : void {
		if (submitting.value) {
			return
		}
		emailError.value = validateEmail(emailValue.value)
		codeError.value = validateCode(codeValue.value)
		if (emailError.value.length > 0) {
			uni.showToast({ title: emailError.value, icon: 'none' })
			return
		}
		if (codeError.value.length > 0) {
			uni.showToast({ title: codeError.value, icon: 'none' })
			return
		}
		step.value = 2
	}

	// ===== 步骤2提交：校验新密码并重置（成功响应含新令牌，直接写入登录态） =====
	function handleStep2Submit() : void {
		if (submitting.value) {
			return
		}
		newPasswordError.value = validatePassword(newPasswordValue.value)
		confirmPasswordError.value = validateConfirmPassword(confirmPasswordValue.value, newPasswordValue.value)
		if (newPasswordError.value.length > 0) {
			uni.showToast({ title: newPasswordError.value, icon: 'none' })
			return
		}
		if (confirmPasswordError.value.length > 0) {
			uni.showToast({ title: confirmPasswordError.value, icon: 'none' })
			return
		}
		submitting.value = true
		resetPassword(emailValue.value, codeValue.value, newPasswordValue.value).then((_res) => {
			toastGo(t('forgot.success'), '/pages/user/login?mode=normal')
		}).catch((e) => {
			const err = e as Error
			const msg = err.message.includes('验证码') ? t('forgot.codeWrong') : err.message
			uni.showToast({ title: msg, icon: 'none' })
		}).finally(() => {
			submitting.value = false
		})
	}

	function goLogin() : void {
		uni.navigateTo({ url: '/pages/user/login' })
	}

	// 微信小程序分享：转发好友与朋友圈（封面统一 /static/share-cover.png，复制自 yao 项目）
	// #ifdef MP-WEIXIN
	onShareAppMessage(() => {
		return { title: t('forgot.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	onShareTimeline(() => {
		return { title: t('forgot.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	// #endif
</script>

<style lang="scss">
	/* ===== 找回密码卡片（页面壳样式随 PageShell 组件） ===== */
	.forgot-page__card {
		width: 684rpx;
		margin-top: 64rpx;
		padding: 48rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: 48rpx;
		flex-direction: column;
	}

	.forgot-page__header {
		flex-direction: column;
		align-items: center;
	}

	.forgot-page__title {
		color: $bai-ink;
		font-size: 64rpx;
		line-height: 72rpx;
		font-weight: 600;
		text-align: center;
	}

	/* ===== 表单 ===== */
	.forgot-page__form {
		margin-top: 48rpx;
		flex-direction: column;
	}

	.forgot-page__field {
		margin-bottom: 32rpx;
		flex-direction: column;
	}

	/* ===== 找回按钮 ===== */
	.forgot-page__submit {
		height: 96rpx;
		padding: 24rpx 0;
		box-sizing: border-box;
		background-color: $bai-ink;
		border-radius: 48rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.forgot-page__submit-text {
		color: $bai-on-primary;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 500;
	}

	/* ===== 底部登录链接 ===== */
	.forgot-page__footer {
		margin-top: 48rpx;
		flex-direction: row;
		justify-content: center;
	}

	.forgot-page__footer-text {
		color: $bai-body;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}
</style>

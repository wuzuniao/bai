<template>
	<view class="forgot-page">
		<!-- 顶部返回按钮（次级页面统一返回组件） -->
		<BackButton />

		<scroll-view class="forgot-page__scroll" direction="vertical" :show-scrollbar="false">
			<view class="forgot-page__canvas" :style="'padding-top:' + mainTop + 'px'">
				<!-- 找回密码卡片 -->
				<view class="forgot-page__card">
					<view class="forgot-page__header">
						<text class="forgot-page__title">找回密码</text>
					</view>

					<!-- 步骤1：邮箱 + 验证码 -->
					<view v-if="step === 1" class="forgot-page__form">
						<view class="forgot-page__field">
							<text class="forgot-page__label">电子邮箱</text>
							<input
								class="forgot-page__input"
								:class="emailError.length > 0 ? 'forgot-page__input--error' : ''"
								v-model="emailValue"
								placeholder="请输入邮箱地址"
								:placeholder-style="PLACEHOLDER_STYLE"
								:maxlength="254"
								@blur="onEmailBlur"
							/>
							<text v-if="emailError.length > 0" class="forgot-page__error-text">{{ emailError }}</text>
						</view>

						<view class="forgot-page__field">
							<text class="forgot-page__label">验证码</text>
							<view class="forgot-page__code-row">
								<input
									class="forgot-page__code-input"
									:class="codeError.length > 0 ? 'forgot-page__code-input--error' : ''"
									v-model="codeValue"
									placeholder="请输入验证码"
									:placeholder-style="PLACEHOLDER_STYLE"
									:maxlength="6"
								/>
								<view
									class="forgot-page__code-btn"
									:class="counting || isSending ? 'forgot-page__code-btn--disabled' : ''"
									@click="handleGetCode"
								>
									<text class="forgot-page__code-btn-text">{{ codeText }}</text>
								</view>
							</view>
							<text v-if="codeError.length > 0" class="forgot-page__error-text">{{ codeError }}</text>
						</view>

						<view class="forgot-page__submit" @click="handleStep1Submit">
							<text class="forgot-page__submit-text">下一步</text>
						</view>
					</view>

					<!-- 步骤2：新密码 + 确认密码 -->
					<view v-else class="forgot-page__form">
						<view class="forgot-page__field">
							<text class="forgot-page__label">新密码</text>
							<view
								class="forgot-page__password-row"
								:class="newPasswordError.length > 0 ? 'forgot-page__password-row--error' : ''"
							>
								<input
									class="forgot-page__input forgot-page__input--password"
									v-model="newPasswordValue"
									:password="!showNewPassword"
									:key="'fp-new-' + showNewPassword"
									placeholder="请设置强密码"
									:placeholder-style="PLACEHOLDER_STYLE"
									:maxlength="20"
									@blur="onNewPasswordBlur"
								/>
								<view class="forgot-page__eye" @click="toggleNewPassword">
									<PasswordEye :visible="showNewPassword" />
								</view>
							</view>
							<text v-if="newPasswordError.length > 0" class="forgot-page__error-text">{{ newPasswordError }}</text>
						</view>

						<view class="forgot-page__field">
							<text class="forgot-page__label">确认密码</text>
							<view
								class="forgot-page__password-row"
								:class="confirmPasswordError.length > 0 ? 'forgot-page__password-row--error' : ''"
							>
								<input
									class="forgot-page__input forgot-page__input--password"
									v-model="confirmPasswordValue"
									:password="!showConfirmPassword"
									:key="'fp-cpwd-' + showConfirmPassword"
									placeholder="请再次输入密码"
									:placeholder-style="PLACEHOLDER_STYLE"
									:maxlength="20"
									@blur="onConfirmPasswordBlur"
								/>
								<view class="forgot-page__eye" @click="toggleConfirmPassword">
									<PasswordEye :visible="showConfirmPassword" />
								</view>
							</view>
							<text v-if="confirmPasswordError.length > 0" class="forgot-page__error-text">{{ confirmPasswordError }}</text>
						</view>

						<view class="forgot-page__submit" @click="handleStep2Submit">
							<text class="forgot-page__submit-text">找回</text>
						</view>
					</view>
				</view>

				<!-- 底部登录链接 -->
				<view class="forgot-page__footer" @click="goLogin">
					<text class="forgot-page__footer-text">返回登录</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import BackButton from '@/components/BackButton/BackButton.uvue'
	import PasswordEye from '@/components/PasswordEye/PasswordEye.uvue'
	import { PLACEHOLDER_STYLE } from '@/utils/theme.uts'
	import { sendResetCode, resetPassword } from '@/api/user.uts'

	/** 顶部留白：返回按钮（状态栏高度 + 40px）之下再留 12px */
	const mainTop = ref(96)
	const win = uni.getWindowInfo()
	if (win.statusBarHeight > 0) {
		mainTop.value = win.statusBarHeight + 52
	}

	const step = ref(1)
	const emailValue = ref('')
	const codeValue = ref('')
	const newPasswordValue = ref('')
	const confirmPasswordValue = ref('')
	const emailError = ref('')
	const codeError = ref('')
	const newPasswordError = ref('')
	const confirmPasswordError = ref('')
	const showNewPassword = ref(false)
	const showConfirmPassword = ref(false)
	const codeText = ref('获取验证码')
	const counting = ref(false)
	const isSending = ref(false)
	const submitting = ref(false)
	let codeTimer = 0

	function toggleNewPassword() : void {
		showNewPassword.value = !showNewPassword.value
	}

	function toggleConfirmPassword() : void {
		showConfirmPassword.value = !showConfirmPassword.value
	}

	// ===== 前端输入校验 =====
	function validateEmail(v: string) : string {
		if (v.length == 0) {
			return '请输入邮箱地址'
		}
		if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
			return '邮箱格式不正确'
		}
		return ''
	}

	function validateCode(v: string) : string {
		if (v.length == 0) {
			return '请输入验证码'
		}
		if (!/^\d{6}$/.test(v)) {
			return '验证码为 6 位数字'
		}
		return ''
	}

	function validatePassword(v: string) : string {
		if (v.length == 0) {
			return '请输入密码'
		}
		if (v.length < 8 || v.length > 20) {
			return '密码长度需为 8-20 位'
		}
		let categories = 0
		if (/[a-z]/.test(v)) {
			categories++
		}
		if (/[A-Z]/.test(v)) {
			categories++
		}
		if (/[0-9]/.test(v)) {
			categories++
		}
		if (/[^a-zA-Z0-9]/.test(v)) {
			categories++
		}
		if (categories < 3) {
			return '密码需包含大小写字母、数字、特殊符号中的至少三种'
		}
		return ''
	}

	function validateConfirmPassword(v: string) : string {
		if (v.length == 0) {
			return '请再次输入密码'
		}
		if (v !== newPasswordValue.value) {
			return '两次密码不一致'
		}
		return ''
	}

	function onEmailBlur() : void {
		emailError.value = emailValue.value.length == 0 ? '' : validateEmail(emailValue.value)
	}

	function onNewPasswordBlur() : void {
		newPasswordError.value = newPasswordValue.value.length == 0 ? '' : validatePassword(newPasswordValue.value)
	}

	function onConfirmPasswordBlur() : void {
		confirmPasswordError.value = confirmPasswordValue.value.length == 0 ? '' : validateConfirmPassword(confirmPasswordValue.value)
	}

	// ===== 获取验证码 =====
	function handleGetCode() : void {
		if (counting.value || isSending.value) {
			return
		}
		const emailErr = validateEmail(emailValue.value)
		if (emailErr.length > 0) {
			emailError.value = emailErr
			uni.showToast({ title: emailErr, icon: 'none' })
			return
		}
		isSending.value = true
		codeText.value = '发送中...'
		sendResetCode(emailValue.value).then((_res) => {
			uni.showToast({ title: '验证码已发送', icon: 'none' })
			startCountdown()
		}).catch((e) => {
			const err = e as Error
			codeText.value = '获取验证码'
			uni.showToast({ title: err.message, icon: 'none' })
		}).finally(() => {
			isSending.value = false
		})
	}

	function startCountdown() : void {
		let sec = 60
		counting.value = true
		codeText.value = `${sec}s`
		codeTimer = setInterval(() => {
			sec--
			if (sec <= 0) {
				clearInterval(codeTimer)
				counting.value = false
				codeText.value = '获取验证码'
			} else {
				codeText.value = `${sec}s`
			}
		}, 1000)
	}

	// ===== 步骤1提交：校验邮箱和验证码格式后进入下一步 =====
	function handleStep1Submit() : void {
		if (submitting.value) {
			return
		}
		emailError.value = validateEmail(emailValue.value)
		codeError.value = validateCode(codeValue.value)
		if (emailError.value.length > 0) {
			uni.showToast({ title: emailError.value, icon: 'none' })
			return
		}
		if (codeError.value.length > 0) {
			uni.showToast({ title: codeError.value, icon: 'none' })
			return
		}
		step.value = 2
	}

	// ===== 步骤2提交：校验新密码并重置（成功响应含新令牌，直接写入登录态） =====
	function handleStep2Submit() : void {
		if (submitting.value) {
			return
		}
		newPasswordError.value = validatePassword(newPasswordValue.value)
		confirmPasswordError.value = validateConfirmPassword(confirmPasswordValue.value)
		if (newPasswordError.value.length > 0) {
			uni.showToast({ title: newPasswordError.value, icon: 'none' })
			return
		}
		if (confirmPasswordError.value.length > 0) {
			uni.showToast({ title: confirmPasswordError.value, icon: 'none' })
			return
		}
		submitting.value = true
		resetPassword(emailValue.value, codeValue.value, newPasswordValue.value).then((_res) => {
			uni.showToast({ title: '密码重置成功', icon: 'success' })
			setTimeout(() => {
				uni.redirectTo({ url: '/pages/user/login?mode=normal' })
			}, 1500)
		}).catch((e) => {
			const err = e as Error
			const msg = err.message.includes('验证码') ? '请输入正确验证码' : err.message
			uni.showToast({ title: msg, icon: 'none' })
		}).finally(() => {
			submitting.value = false
		})
	}

	function goLogin() : void {
		uni.navigateTo({ url: '/pages/user/login' })
	}
</script>

<style lang="scss">
	.forgot-page {
		flex: 1;
		position: relative;
		background-color: $bai-canvas-soft;
	}

	.forgot-page__scroll {
		flex: 1;
	}

	.forgot-page__canvas {
		padding-left: 48rpx;
		padding-right: 48rpx;
		padding-bottom: 72rpx;
		box-sizing: border-box;
		flex-direction: column;
	}

	/* ===== 找回密码卡片 ===== */
	.forgot-page__card {
		width: 100%;
		margin-top: 64rpx;
		padding: 48rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: 48rpx;
		flex-direction: column;
	}

	.forgot-page__header {
		flex-direction: column;
		align-items: center;
	}

	.forgot-page__title {
		color: $bai-ink;
		font-size: 64rpx;
		line-height: 72rpx;
		font-weight: 600;
		text-align: center;
	}

	/* ===== 表单 ===== */
	.forgot-page__form {
		margin-top: 48rpx;
		flex-direction: column;
	}

	.forgot-page__field {
		margin-bottom: 32rpx;
		flex-direction: column;
	}

	.forgot-page__label {
		margin-bottom: 16rpx;
		color: $bai-ink;
		font-size: 28rpx;
		line-height: 40rpx;
		font-weight: 400;
	}

	.forgot-page__input {
		height: 98rpx;
		padding: 28rpx 24rpx 24rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-md;
		border: 1px solid $bai-ink;
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 42rpx;
	}

	.forgot-page__input--error {
		border-color: $bai-negative;
	}

	/* 密码行：统一边框容器，内含输入框与眼睛图标 */
	.forgot-page__password-row {
		position: relative;
		flex-direction: row;
		align-items: stretch;
		border: 1px solid $bai-ink;
		border-radius: $bai-rounded-md;
		background-color: $bai-canvas;
	}

	.forgot-page__password-row--error {
		border-color: $bai-negative;
	}

	.forgot-page__input--password {
		flex: 1;
		border: none;
		background-color: transparent;
		border-radius: $bai-rounded-md 0 0 $bai-rounded-md;
		padding-right: 24rpx;
	}

	.forgot-page__eye {
		flex-shrink: 0;
		position: relative;
		z-index: 2;
		padding: 0 24rpx;
		border-radius: 0 $bai-rounded-md $bai-rounded-md 0;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.forgot-page__error-text {
		margin-top: 8rpx;
		color: $bai-negative;
		font-size: 24rpx;
		line-height: 32rpx;
	}

	/* ===== 验证码行 ===== */
	.forgot-page__code-row {
		flex-direction: row;
	}

	.forgot-page__code-input {
		flex: 1;
		height: 98rpx;
		padding: 28rpx 24rpx 24rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-md;
		border: 1px solid $bai-ink;
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 42rpx;
	}

	.forgot-page__code-input--error {
		border-color: $bai-negative;
	}

	.forgot-page__code-btn {
		margin-left: 16rpx;
		width: 192rpx;
		height: 98rpx;
		box-sizing: border-box;
		border-radius: $bai-rounded-md;
		border: 1px solid $bai-ink;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		flex-shrink: 0;
	}

	.forgot-page__code-btn--disabled {
		opacity: 0.6;
	}

	.forgot-page__code-btn-text {
		color: $bai-ink;
		font-size: 28rpx;
		line-height: 40rpx;
		font-weight: 400;
	}

	/* ===== 找回按钮 ===== */
	.forgot-page__submit {
		margin-top: 16rpx;
		height: 96rpx;
		padding: 24rpx 0;
		box-sizing: border-box;
		background-color: $bai-ink;
		border-radius: $bai-rounded-xl;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.forgot-page__submit-text {
		color: $bai-on-primary;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 500;
	}

	/* ===== 底部登录链接 ===== */
	.forgot-page__footer {
		margin-top: 48rpx;
		flex-direction: row;
		justify-content: center;
	}

	.forgot-page__footer-text {
		color: $bai-body;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}
</style>

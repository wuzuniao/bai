<template>
	<PageShell :title="t('profile.title')" :desc="t('profile.desc')" :center="false">

				<!-- 分组 1：资料修改（账号待删除状态整体置灰并禁用交互） -->
				<ListGroup :disabled="isDeletionScheduled">
					<!-- 修改用户名 -->
					<ListCell :label="t('profile.editUsername')" tone="default" :bordered="true" :arrow="true" @select="toggleUsername" />
					<view v-if="expandUsername" class="profile-page__form-section">
						<view class="profile-page__form-field">
							<FormInput v-model="usernameValue" :label="t('profile.newUsername')" :placeholder="t('profile.newUsernamePh')" :maxlength="15" :error="usernameError" @blur="onUsernameBlur" />
						</view>
						<view class="profile-page__form-actions">
							<view class="profile-page__btn profile-page__btn--cancel" @click="toggleUsername">
								<text class="profile-page__btn-text">{{ t('common.cancel') }}</text>
							</view>
							<view class="profile-page__btn profile-page__btn--submit" @click="handleUpdateUsername">
								<text class="profile-page__btn-text profile-page__btn-text--primary">{{ t('common.submit') }}</text>
							</view>
						</view>
					</view>

					<!-- 修改头像 -->
					<ListCell :label="t('profile.editAvatar')" tone="default" :bordered="true" :arrow="true" @select="toggleAvatar" />
					<view v-if="expandAvatar" class="profile-page__form-section">
						<view class="profile-page__avatar-list">
							<view
								v-for="item in avatarOptions"
								:key="item.key"
								class="profile-page__avatar-option"
								:class="selectedAvatar === item.key ? 'profile-page__avatar-option--selected' : ''"
								@click="onSelectAvatar(item.key)"
							>
								<image class="profile-page__avatar-image" :src="item.src" mode="aspectFit" />
							</view>
						</view>
						<view class="profile-page__form-actions">
							<view class="profile-page__btn profile-page__btn--cancel" @click="toggleAvatar">
								<text class="profile-page__btn-text">{{ t('common.cancel') }}</text>
							</view>
							<view class="profile-page__btn profile-page__btn--submit" @click="handleUpdateAvatar">
								<text class="profile-page__btn-text profile-page__btn-text--primary">{{ t('common.submit') }}</text>
							</view>
						</view>
					</view>

					<!-- 修改签名 -->
					<ListCell :label="t('profile.editSignature')" tone="default" :bordered="true" :arrow="true" @select="toggleSignature" />
					<view v-if="expandSignature" class="profile-page__form-section">
						<FormInput v-model="signatureValue" label="" :placeholder="t('profile.signaturePh')" :maxlength="70" :error="signatureError" />
						<view class="profile-page__form-actions">
							<view class="profile-page__btn profile-page__btn--cancel" @click="toggleSignature">
								<text class="profile-page__btn-text">{{ t('common.cancel') }}</text>
							</view>
							<view class="profile-page__btn profile-page__btn--submit" @click="handleUpdateSignature">
								<text class="profile-page__btn-text profile-page__btn-text--primary">{{ t('common.submit') }}</text>
							</view>
						</view>
					</view>

					<!-- 修改密码 / 设置密码（无密码用户显示「设置密码」） -->
					<ListCell :label="hasPassword ? t('profile.changePassword') : t('profile.setPassword')" tone="default" :bordered="true" :arrow="true" @select="togglePassword" />
					<view v-if="expandPassword" class="profile-page__form-section">
						<view v-if="hasPassword" class="profile-page__form-field">
							<PasswordInput v-model="oldPasswordValue" :label="t('profile.oldPassword')" :placeholder="t('profile.oldPasswordPh')" :maxlength="20" :error="oldPasswordError" @blur="onOldPasswordBlur" />
						</view>
						<view class="profile-page__form-field">
							<PasswordInput v-model="newPasswordValue" :label="t('profile.newPassword')" :placeholder="t('profile.newPasswordPh')" :maxlength="20" :error="newPasswordError" @blur="onNewPasswordBlur" />
						</view>
						<view class="profile-page__form-field">
							<PasswordInput v-model="confirmPasswordValue" :label="t('profile.confirmPassword')" :placeholder="t('profile.confirmPasswordPh')" :maxlength="20" :error="confirmPasswordError" @blur="onConfirmPasswordBlur" />
						</view>
						<view class="profile-page__form-actions">
							<view class="profile-page__btn profile-page__btn--cancel" @click="togglePassword">
								<text class="profile-page__btn-text">{{ t('common.cancel') }}</text>
							</view>
							<view class="profile-page__btn profile-page__btn--submit" @click="handleChangePassword">
								<text class="profile-page__btn-text profile-page__btn-text--primary">{{ t('common.submit') }}</text>
							</view>
						</view>
					</view>

					<!-- 修改邮箱 / 绑定邮箱（无邮箱用户显示「绑定邮箱」），分组最后一项无下边框 -->
					<ListCell :label="hasEmail ? t('profile.changeEmail') : t('profile.bindEmail')" tone="default" :bordered="false" :arrow="true" @select="toggleEmail" />
					<view v-if="expandEmail" class="profile-page__form-section">
						<!-- 步骤1：旧邮箱验证（仅已有邮箱的用户需要） -->
						<view v-if="hasEmail && emailStep === 1">
							<view class="profile-page__form-field">
								<CodeInput ref="oldCodeRef" v-model="oldCodeValue" :label="t('profile.oldCode')" :error="oldCodeError" :sending="oldCodeSending" @request-send="handleGetOldEmailCode" />
							</view>
							<view class="profile-page__form-actions">
								<view class="profile-page__btn profile-page__btn--cancel" @click="toggleEmail">
									<text class="profile-page__btn-text">{{ t('common.cancel') }}</text>
								</view>
								<view class="profile-page__btn profile-page__btn--submit" @click="handleVerifyOldEmail">
									<text class="profile-page__btn-text profile-page__btn-text--primary">{{ t('common.verify') }}</text>
								</view>
							</view>
						</view>
						<!-- 步骤2：新邮箱验证 / 绑定邮箱（无邮箱用户直接显示此步骤） -->
						<view v-else>
							<view class="profile-page__form-field">
								<FormInput v-model="newEmailValue" :label="t('profile.newEmail')" :placeholder="t('profile.newEmailPh')" :maxlength="254" :error="newEmailError" @blur="onNewEmailBlur" />
							</view>
							<view class="profile-page__form-field">
								<CodeInput ref="newCodeRef" v-model="newCodeValue" :label="t('profile.newCode')" :error="newCodeError" :sending="newCodeSending" @request-send="handleGetNewEmailCode" />
							</view>
							<view class="profile-page__form-actions">
								<view class="profile-page__btn profile-page__btn--cancel" @click="onEmailStepBack">
									<text class="profile-page__btn-text">{{ hasEmail ? t('common.back') : t('common.cancel') }}</text>
								</view>
								<view class="profile-page__btn profile-page__btn--submit" @click="handleChangeEmail">
									<text class="profile-page__btn-text profile-page__btn-text--primary">{{ hasEmail ? t('common.modify') : t('common.bind') }}</text>
								</view>
							</view>
						</view>
					</view>
				</ListGroup>

				<!-- 分组 1.5：偏好设置（语言 / 指纹登录，独立成区） -->
				<ListGroup :disabled="false">
					<ListCell :label="t('profile.language')" tone="default" :bordered="false" :arrow="false">
						<view :class="isEn ? 'profile-page__lang-switch profile-page__lang-switch--en' : 'profile-page__lang-switch'" @click="toggleLanguage">
							<view :class="isEn ? 'profile-page__lang-knob profile-page__lang-knob--en' : 'profile-page__lang-knob'"></view>
							<text :class="isEn ? 'profile-page__lang-text profile-page__lang-text--en' : 'profile-page__lang-text'">{{ langText }}</text>
						</view>
					</ListCell>

					<!-- 指纹登录开关（仅 App 端：设备支持指纹且已登录时显示） -->
					<!-- #ifdef APP -->
					<ListCell v-if="showBiometric" :label="t('profile.biometric')" tone="default" :bordered="true" :arrow="false">
						<!-- 纯 CSS 手写开关（uvue 不支持后代选择器，开态经动态组合类控制旋钮位移） -->
						<view
							:class="biometricEnabled ? 'profile-page__biometric-switch profile-page__biometric-switch--on' : 'profile-page__biometric-switch'"
							@click="toggleBiometric"
						>
							<view :class="biometricEnabled ? 'profile-page__biometric-knob profile-page__biometric-knob--on' : 'profile-page__biometric-knob'"></view>
						</view>
					</ListCell>
					<!-- #endif -->
				</ListGroup>

				<!-- 分组 2：退出登录 + 删除账号（危险操作红色提示） -->
				<ListGroup :disabled="false">
					<ListCell :label="t('profile.logout')" tone="danger" :bordered="true" :arrow="true" @select="handleLogout" />
					<ListCell :label="isDeletionScheduled ? t('profile.cancelDeletion') : t('profile.deleteAccount')" tone="danger" :bordered="false" :arrow="true" @select="handleDeletion" />
					<ListCell :label="t('profile.deletionHelp')" tone="hint" :bordered="false" :arrow="true" @select="goDeleteAccountHelp" />
				</ListGroup>
	</PageShell>
</template>

<script setup lang="uts">
	import PageShell from '@/components/common/PageShell.uvue'
	import FormInput from '@/components/form/FormInput.uvue'
	import PasswordInput from '@/components/form/PasswordInput.uvue'
	import CodeInput from '@/components/form/CodeInput.uvue'
	import ListGroup from '@/components/list/ListGroup.uvue'
	import ListCell from '@/components/list/ListCell.uvue'
	import { useUserStore, avatarPathOf, avatarKeyOf, AVATAR_OPTION_KEYS } from '@/stores/user.uts'
	import { validateConfirmPassword } from './utils/validators.uts'
	import type { ApiResponse } from '@/utils/requestDefs.ts'
	import { t, currentLocale, setLocale } from '@/utils/i18n.uts'
	// 词典注册（profile 页文案 + 公共段）
	import '@/pages/user/locales/profile.uts'
	import '@/utils/locales/common.uts'
	// #ifdef APP
	import { isBiometricAvailable, isBiometricEnabled, setBiometricEnabled, getBiometricToken } from '@/utils/biometric.uts'
	// #endif
	import {
		updateSignature,
		changePassword,
		sendChangeEmailOldCode,
		sendChangeEmailNewCode,
		changeEmail,
		updateAvatar,
		scheduleDeletion,
		cancelDeletion,
		updateUsername,
		setPassword,
		bindEmail,
		getUserInfo,
		logout
	} from './api/user.uts'
	import { validateUsername, validatePassword, validateEmail, validateCode } from './utils/validators.uts'

	const userStore = useUserStore()

	// 账号是否处于待删除状态（status=0：24 小时冷静期）
	const isDeletionScheduled = computed((): boolean => {
		const info = userStore.userInfo
		return info != null && info.status === 0
	})

	// 当前用户是否已设置密码（微信登录用户可能无密码）
	const hasPassword = computed((): boolean => {
		const info = userStore.userInfo
		return info != null && info.has_password
	})

	// 当前用户是否已绑定邮箱
	const hasEmail = computed((): boolean => {
		const info = userStore.userInfo
		return info != null && info.email.length > 0
	})

	// ===== 分区展开状态 =====
	const expandUsername = ref(false)
	const expandAvatar = ref(false)
	const expandSignature = ref(false)
	const expandPassword = ref(false)
	const expandEmail = ref(false)

	function collapseAll() : void {
		expandUsername.value = false
		expandAvatar.value = false
		expandSignature.value = false
		expandPassword.value = false
		expandEmail.value = false
		resetUsernameForm()
		resetSignatureForm()
		resetPasswordForm()
		resetEmailForm()
	}

	function toggleUsername() : void {
		if (isDeletionScheduled.value) {
			return
		}
		const next = !expandUsername.value
		collapseAll()
		expandUsername.value = next
	}

	function toggleAvatar() : void {
		if (isDeletionScheduled.value) {
			return
		}
		const next = !expandAvatar.value
		collapseAll()
		if (next) {
			selectedAvatar.value = currentAvatarKey()
		}
		expandAvatar.value = next
	}

	function toggleSignature() : void {
		if (isDeletionScheduled.value) {
			return
		}
		const next = !expandSignature.value
		collapseAll()
		expandSignature.value = next
	}

	function togglePassword() : void {
		if (isDeletionScheduled.value) {
			return
		}
		const next = !expandPassword.value
		collapseAll()
		expandPassword.value = next
	}

	function toggleEmail() : void {
		if (isDeletionScheduled.value) {
			return
		}
		const next = !expandEmail.value
		collapseAll()
		expandEmail.value = next
	}

	// ===== 修改用户名 =====
	const usernameValue = ref('')
	const usernameError = ref('')

	function resetUsernameForm() : void {
		usernameValue.value = ''
		usernameError.value = ''
	}

	// 用户名校验规则见 utils/validators.uts

	function onUsernameBlur() : void {
		usernameError.value = usernameValue.value.length == 0 ? '' : validateUsername(usernameValue.value)
	}

	function handleUpdateUsername() : void {
		const v = usernameValue.value.trim()
		const err = validateUsername(v)
		if (err.length > 0) {
			usernameError.value = err
			uni.showToast({ title: err, icon: 'none' })
			return
		}
		updateUsername(v).then((_res: ApiResponse) => {
			userStore.patchUser('username', v)
			uni.showToast({ title: t('profile.usernameOk'), icon: 'success' })
			collapseAll()
		}).catch((e) => {
			const err = e as Error
			uni.showToast({ title: err.message, icon: 'none' })
		})
	}

	// ===== 修改头像 =====
	type AvatarOption = {
		key: string
		src: string
	}

	/** 可选头像网格（key 顺序与路径映射真源在 stores/user.uts） */
	const avatarOptions = ref<AvatarOption[]>(AVATAR_OPTION_KEYS.map((k : string) : AvatarOption => {
		return { key: k, src: avatarPathOf(k) } as AvatarOption
	}))

	const selectedAvatar = ref('hong')

	/** 数据库存值反查头像 key（默认 hong） */
	function currentAvatarKey() : string {
		const info = userStore.userInfo
		if (info == null) {
			return 'hong'
		}
		return avatarKeyOf(info.avatar_url)
	}

	function onSelectAvatar(key: string) : void {
		selectedAvatar.value = key
	}

	function handleUpdateAvatar() : void {
		updateAvatar(selectedAvatar.value).then((_res: ApiResponse) => {
			userStore.patchUser('avatar_url', selectedAvatar.value)
			uni.showToast({ title: t('profile.avatarOk'), icon: 'success' })
			collapseAll()
		}).catch((e) => {
			const err = e as Error
			uni.showToast({ title: err.message, icon: 'none' })
		})
	}

	// ===== 修改签名 =====
	const signatureValue = ref('')
	const signatureError = ref('')

	function resetSignatureForm() : void {
		signatureValue.value = ''
		signatureError.value = ''
	}

	function handleUpdateSignature() : void {
		const v = signatureValue.value.trim()
		if (v.length == 0) {
			signatureError.value = t('profile.signatureEmpty')
			return
		}
		updateSignature(v).then((_res: ApiResponse) => {
			userStore.patchUser('signature', v)
			uni.showToast({ title: t('profile.signatureOk'), icon: 'success' })
			collapseAll()
		}).catch((e) => {
			const err = e as Error
			uni.showToast({ title: err.message, icon: 'none' })
		})
	}

	// ===== 修改 / 设置密码 =====
	const oldPasswordValue = ref('')
	const newPasswordValue = ref('')
	const confirmPasswordValue = ref('')
	const oldPasswordError = ref('')
	const newPasswordError = ref('')
	const confirmPasswordError = ref('')

	function resetPasswordForm() : void {
		oldPasswordValue.value = ''
		newPasswordValue.value = ''
		confirmPasswordValue.value = ''
		oldPasswordError.value = ''
		newPasswordError.value = ''
		confirmPasswordError.value = ''
	}

	// 密码校验规则见 utils/validators.uts

	function onOldPasswordBlur() : void {
		oldPasswordError.value = oldPasswordValue.value.length == 0 ? t('profile.oldPasswordPh') : ''
	}

	function onNewPasswordBlur() : void {
		newPasswordError.value = newPasswordValue.value.length == 0 ? '' : validatePassword(newPasswordValue.value)
	}

	function onConfirmPasswordBlur() : void {
		if (confirmPasswordValue.value.length == 0) {
			confirmPasswordError.value = ''
			return
		}
		confirmPasswordError.value = validateConfirmPassword(confirmPasswordValue.value, newPasswordValue.value)
	}

	function handleChangePassword() : void {
		newPasswordError.value = validatePassword(newPasswordValue.value)
		if (newPasswordValue.value.length > 0 && confirmPasswordValue.value.length > 0) {
			confirmPasswordError.value = validateConfirmPassword(confirmPasswordValue.value, newPasswordValue.value)
		} else if (confirmPasswordValue.value.length == 0) {
			confirmPasswordError.value = t('profile.confirmPasswordPh')
		} else {
			confirmPasswordError.value = ''
		}
		if (hasPassword.value) {
			oldPasswordError.value = oldPasswordValue.value.length == 0 ? t('profile.oldPasswordPh') : ''
		} else {
			oldPasswordError.value = ''
		}
		if (oldPasswordError.value.length > 0) {
			uni.showToast({ title: oldPasswordError.value, icon: 'none' })
			return
		}
		if (newPasswordError.value.length > 0) {
			uni.showToast({ title: newPasswordError.value, icon: 'none' })
			return
		}
		if (confirmPasswordError.value.length > 0) {
			uni.showToast({ title: confirmPasswordError.value, icon: 'none' })
			return
		}
		if (hasPassword.value) {
			// 修改密码：验证旧密码后更新
			changePassword(oldPasswordValue.value, newPasswordValue.value).then((_res: ApiResponse) => {
				uni.showToast({ title: t('profile.pwdChangeOk'), icon: 'success' })
				collapseAll()
			}).catch((e) => {
				const err = e as Error
				uni.showToast({ title: err.message, icon: 'none' })
			})
		} else {
			// 设置密码：无密码用户首次设置
			setPassword(newPasswordValue.value).then((_res: ApiResponse) => {
				userStore.patchUser('has_password', true)
				uni.showToast({ title: t('profile.pwdSetOk'), icon: 'success' })
				collapseAll()
			}).catch((e) => {
				const err = e as Error
				uni.showToast({ title: err.message, icon: 'none' })
			})
		}
	}

	// ===== 修改 / 绑定邮箱 =====
	const emailStep = ref(1)
	const oldCodeValue = ref('')
	const newEmailValue = ref('')
	const newCodeValue = ref('')
	const oldCodeError = ref('')
	const newEmailError = ref('')
	const newCodeError = ref('')
	const oldCodeSending = ref(false)
	const newCodeSending = ref(false)

	/** 验证码组件引用（倒计时与按钮复位内聚于组件） */
	const oldCodeRef = ref<CodeInput | null>(null)
	const newCodeRef = ref<CodeInput | null>(null)

	function resetEmailForm() : void {
		emailStep.value = 1
		oldCodeValue.value = ''
		newEmailValue.value = ''
		newCodeValue.value = ''
		oldCodeError.value = ''
		newEmailError.value = ''
		newCodeError.value = ''
		oldCodeRef.value?.reset()
		newCodeRef.value?.reset()
	}

	// 邮箱与验证码校验规则见 utils/validators.uts

	function onNewEmailBlur() : void {
		newEmailError.value = newEmailValue.value.length == 0 ? '' : validateEmail(newEmailValue.value)
	}

	function handleGetOldEmailCode() : void {
		if (oldCodeSending.value) {
			return
		}
		oldCodeSending.value = true
		sendChangeEmailOldCode().then((_res: ApiResponse) => {
			uni.showToast({ title: t('profile.codeSent'), icon: 'none' })
			oldCodeRef.value?.startCountdown()
		}).catch((e) => {
			const err = e as Error
			oldCodeRef.value?.reset()
			uni.showToast({ title: err.message, icon: 'none' })
		}).finally(() => {
			oldCodeSending.value = false
		})
	}

	function handleVerifyOldEmail() : void {
		oldCodeError.value = validateCode(oldCodeValue.value)
		if (oldCodeError.value.length > 0) {
			uni.showToast({ title: oldCodeError.value, icon: 'none' })
			return
		}
		emailStep.value = 2
	}

	function onEmailStepBack() : void {
		if (hasEmail.value) {
			// 修改邮箱：返回上一步重新验证旧邮箱
			emailStep.value = 1
			newEmailValue.value = ''
			newCodeValue.value = ''
			newEmailError.value = ''
			newCodeError.value = ''
			newCodeRef.value?.reset()
		} else {
			collapseAll()
		}
	}

	function handleGetNewEmailCode() : void {
		if (newCodeSending.value) {
			return
		}
		const emailErr = validateEmail(newEmailValue.value)
		if (emailErr.length > 0) {
			newEmailError.value = emailErr
			uni.showToast({ title: emailErr, icon: 'none' })
			return
		}
		newCodeSending.value = true
		// 绑定邮箱场景（无邮箱用户）允许邮箱已存在以触发账号合并提示；修改邮箱场景禁止已存在
		sendChangeEmailNewCode(newEmailValue.value, !hasEmail.value).then((_res: ApiResponse) => {
			uni.showToast({ title: t('profile.codeSent'), icon: 'none' })
			newCodeRef.value?.startCountdown()
		}).catch((e) => {
			const err = e as Error
			newCodeRef.value?.reset()
			uni.showToast({ title: err.message, icon: 'none' })
		}).finally(() => {
			newCodeSending.value = false
		})
	}

	function handleChangeEmail() : void {
		newEmailError.value = validateEmail(newEmailValue.value)
		newCodeError.value = validateCode(newCodeValue.value)
		if (newEmailError.value.length > 0) {
			uni.showToast({ title: newEmailError.value, icon: 'none' })
			return
		}
		if (newCodeError.value.length > 0) {
			uni.showToast({ title: newCodeError.value, icon: 'none' })
			return
		}
		if (hasEmail.value) {
			// 修改邮箱：需旧邮箱验证码 + 新邮箱验证码
			changeEmail(oldCodeValue.value, newEmailValue.value, newCodeValue.value).then((_res: ApiResponse) => {
				userStore.patchUser('email', newEmailValue.value)
				uni.showToast({ title: t('profile.emailChangeOk'), icon: 'success' })
				collapseAll()
			}).catch((e) => {
				const err = e as Error
				const msg = err.message.includes('验证码') ? t('profile.codeWrong') : err.message
				uni.showToast({ title: msg, icon: 'none' })
			})
		} else {
			// 绑定邮箱：无邮箱用户首次绑定（邮箱已存在时 auth 内部自动合并，响应返回合并后资料与全新令牌组）
			bindEmail(newEmailValue.value, newCodeValue.value).then((res: ApiResponse) => {
				if (res.data != null) {
					// 全量更新登录态（id/资料/令牌三件套），并同步父域 SSO Cookie
					userStore.setUser(res.data as UTSJSONObject)
				}
				uni.showToast({ title: t('profile.emailBindOk'), icon: 'success' })
				collapseAll()
			}).catch((e) => {
				const err = e as Error
				const msg = err.message.includes('验证码') ? t('profile.codeWrong') : err.message
				uni.showToast({ title: msg, icon: 'none' })
			})
		}
	}

	// ===== 语言切换（中/英：i18n 模块级响应式语言，切换即刻全端生效并持久化） =====
	const isEn = computed((): boolean => currentLocale() == 'en')
	const langText = computed((): string => currentLocale() == 'en' ? 'English' : t('profile.langZh'))

	function toggleLanguage() : void {
		setLocale(isEn.value ? 'zh' : 'en')
	}

	// ===== App 端指纹登录开关（仅 App 端，与 yao 同构） =====
	// #ifdef APP
	const biometricSupported = ref(false)
	const biometricEnabled = ref(false)
	// 开关显示条件：设备支持指纹且当前已登录
	const showBiometric = computed((): boolean => {
		const info = userStore.userInfo
		return biometricSupported.value && info != null && info.id > 0
	})

	/** 切换指纹登录：开启前提为本地已有登录时下发的凭证，否则提示先账号密码登录一次 */
	function toggleBiometric() : void {
		if (isDeletionScheduled.value) {
			return
		}
		const next = !biometricEnabled.value
		if (next) {
			if (getBiometricToken().length == 0) {
				biometricEnabled.value = false
				uni.showToast({ title: t('profile.biometricNeedLogin'), icon: 'none' })
				return
			}
			setBiometricEnabled(true)
			biometricEnabled.value = true
		} else {
			// 关闭：仅切换开关标记，不清理本地凭证（重新开启无需重新登录）
			setBiometricEnabled(false)
			biometricEnabled.value = false
		}
	}
	// #endif

	// 微信小程序分享：转发好友与朋友圈（封面统一 /static/share-cover.png，复制自 yao 项目）
	// #ifdef MP-WEIXIN
	onShareAppMessage(() => {
		return { title: t('profile.title'), imageUrl: '/static/share-cover.png' }
	})
	onShareTimeline(() => {
		return { title: t('profile.title'), imageUrl: '/static/share-cover.png' }
	})
	// #endif

	// ===== 页面加载：刷新最新用户信息（含 status/role） =====
	onLoad(() => {
		// App 端：检测指纹能力并读取本地开关状态
		// #ifdef APP
		isBiometricAvailable().then((ok: boolean) => {
			biometricSupported.value = ok
			if (ok) {
				biometricEnabled.value = isBiometricEnabled()
			}
		})
		// #endif
		const info = userStore.userInfo
		if (info != null && info.id > 0) {
			getUserInfo().then((res: ApiResponse) => {
				const d = res.data
				if (res.code == 0 && d != null) {
					const un = d.getString('username')
					if (un != null) {
						userStore.patchUser('username', un)
					}
					const sg = d.getString('signature')
					if (sg != null) {
						userStore.patchUser('signature', sg)
					}
					const av = d.getString('avatar_url')
					if (av != null && av.length > 0) {
						userStore.patchUser('avatar_url', av)
					}
					const em = d.getString('email')
					if (em != null) {
						userStore.patchUser('email', em)
					}
					const hp = d.getBoolean('has_password')
					if (hp != null) {
						userStore.patchUser('has_password', hp)
					}
					const st = d.getNumber('status')
					if (st != null) {
						userStore.patchUser('status', st)
					}
					const rs = d.getArray('roles')
					if (rs != null) {
						userStore.patchUser('roles', rs.map((x): string => x as string))
					}
				}
			}).catch((_e) => {
				// 刷新失败静默，使用本地缓存信息
			})
		}
	})

	// ===== 删除账号 / 取消删除 =====
	function handleDeletion() : void {
		if (isDeletionScheduled.value) {
			// 处于冷静期，执行取消删除
			uni.showModal({
				title: t('common.tip'),
				content: t('profile.confirmCancelDeletion'),
				success: (res) => {
					if (res.confirm) {
						cancelDeletion().then((_res: ApiResponse) => {
							userStore.patchUser('status', 1)
							uni.showToast({ title: t('profile.deletionCancelled'), icon: 'success' })
						}).catch((e) => {
							const err = e as Error
							uni.showToast({ title: err.message, icon: 'none' })
						})
					}
				}
			})
		} else {
			// 未处于冷静期，执行删除
			uni.showModal({
				title: t('profile.deleteAccountTitle'),
				content: t('profile.deleteAccountContent'),
				confirmText: t('profile.confirmDelete'),
				cancelText: t('common.cancel'),
				success: (res) => {
					if (res.confirm) {
						scheduleDeletion().then((result: ApiResponse) => {
							const d = result.data
							const status = d != null ? (d.getNumber('status') ?? 0) : 0
							userStore.patchUser('status', status)
							uni.showToast({ title: t('profile.deletionScheduled'), icon: 'none' })
						}).catch((e) => {
							const err = e as Error
							uni.showToast({ title: err.message, icon: 'none' })
						})
					}
				}
			})
		}
	}

	// ===== 跳转免登录账号删除说明页 =====
	function goDeleteAccountHelp() : void {
		uni.navigateTo({ url: '/pages/user/delete-account' })
	}

	// ===== 退出登录 =====
	function handleLogout() : void {
		uni.showModal({
			title: t('common.tip'),
			content: t('profile.confirmLogout'),
			success: (res) => {
				if (res.confirm) {
					// 先通知 auth 撤销全部令牌；失败不阻断本地退出
					logout().catch((_e) => {
						// 服务端退出失败已忽略，本地态照常清理
					}).finally(() => {
						userStore.clearUser()
						uni.showToast({ title: t('profile.loggedOut'), icon: 'none' })
						setTimeout(() => {
							uni.redirectTo({ url: '/pages/user/settings' })
						}, 1500)
					})
				}
			}
		})
	}
</script>

<style lang="scss">
	/* ===== 分组卡片（分组与行项样式随 ListGroup/ListCell 组件） ===== */

	/* 指纹登录开关：纯 CSS 手写开关（uvue 不支持后代选择器，开态经动态组合类控制） */
	.profile-page__biometric-switch {
		position: relative;
		width: 88rpx;
		height: 48rpx;
		border-radius: 9999px;
		background-color: $bai-pale;
		flex-shrink: 0;
	}

	.profile-page__biometric-switch--on {
		background-color: $bai-ink;
	}

	.profile-page__biometric-knob {
		position: absolute;
		top: 4rpx;
		left: 4rpx;
		width: 40rpx;
		height: 40rpx;
		border-radius: 50%;
		background-color: $bai-canvas;
	}

	.profile-page__biometric-knob--on {
		transform: translateX(40rpx);
		background-color: $bai-on-primary;
	}

	/* 语言切换开关：纯 CSS 手写开关（中文=旋钮靠左文案右对齐 / English=旋钮靠右文案左对齐） */
	.profile-page__lang-switch {
		position: relative;
		width: 176rpx;
		height: 56rpx;
		border-radius: 9999px;
		background-color: $bai-ink;
		flex-shrink: 0;
		overflow: hidden;
	}

	.profile-page__lang-knob {
		position: absolute;
		top: 4rpx;
		left: 4rpx;
		width: 48rpx;
		height: 48rpx;
		border-radius: 50%;
		background-color: $bai-on-primary;
	}

	.profile-page__lang-knob--en {
		transform: translateX(120rpx);
	}

	.profile-page__lang-text {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		text-align: right;
		padding-right: 16rpx;
		line-height: 56rpx;
		font-size: 24rpx;
		font-weight: 500;
		color: $bai-on-primary;
	}

	.profile-page__lang-text--en {
		text-align: left;
		padding-right: 0;
		padding-left: 16rpx;
	}

	/* ===== 动态表单区域 ===== */
	.profile-page__form-section {
		padding: 24rpx 32rpx;
		box-sizing: border-box;
		background-color: $bai-surface-form;
	}

	.profile-page__form-field {
		margin-bottom: 24rpx;
		flex-direction: column;
	}

	/* ===== 表单操作按钮 ===== */
	.profile-page__form-actions {
		margin-top: 32rpx;
		flex-direction: row;
		justify-content: flex-end;
	}

	.profile-page__btn {
		margin-left: 24rpx;
		height: 72rpx;
		padding: 0 40rpx;
		box-sizing: border-box;
		border-radius: $bai-rounded-pill;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.profile-page__btn--cancel {
		background-color: $bai-canvas;
	}

	.profile-page__btn--submit {
		background-color: $bai-ink;
	}

	.profile-page__btn-text {
		font-size: 28rpx;
		line-height: 40rpx;
		font-weight: 400;
		color: $bai-ink;
	}

	.profile-page__btn-text--primary {
		color: $bai-on-primary;
	}

	/* ===== 头像选择列表 ===== */
	.profile-page__avatar-list {
		padding: 16rpx 0;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.profile-page__avatar-option {
		margin-right: 32rpx;
		margin-bottom: 16rpx;
		width: 144rpx;
		height: 144rpx;
		border-radius: 24rpx;
		border: 2px solid transparent;
		box-sizing: border-box;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		background-color: $bai-canvas;
	}

	.profile-page__avatar-option--selected {
		border-color: $bai-ink;
		background-color: $bai-canvas-soft;
	}

	.profile-page__avatar-image {
		width: 112rpx;
		height: 112rpx;
	}
</style>

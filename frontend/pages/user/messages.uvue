<template>
	<view class="messages-page">
		<!-- 顶部返回按钮（次级页面统一返回组件） -->
		<BackButton />

		<scroll-view class="messages-page__scroll" direction="vertical" :show-scrollbar="false">
			<view class="messages-page__canvas" :style="'padding-top:' + mainTop + 'px'">
				<PageHeader title="站内信" desc="查看您的提醒消息，点击未读消息可标记为已读。" />

				<!-- 消息卡片列表（消息能力依赖本项目后端，暂未交付，当前展示空态） -->

<template>
	<PageShell title="" desc="" :center="true">
				<!-- 白色卡片容器 -->
				<view class="register-page__card">
					<!-- 标题区 -->
					<view class="register-page__header">
						<text class="register-page__title">{{ t('register.title') }}</text>
						<text class="register-page__subtitle">{{ t('register.subtitle') }}</text>
					</view>

					<!-- 注册表单 -->
					<view class="register-page__form">
						<!-- 用户名 -->
						<view class="register-page__field">
							<FormInput v-model="usernameValue" :label="t('register.usernameLabel')" :placeholder="t('register.usernamePh')" :maxlength="15" :error="usernameError" @blur="onUsernameBlur" />
						</view>

						<!-- 密码 -->
						<view class="register-page__field">
							<PasswordInput v-model="passwordValue" :label="t('register.passwordLabel')" :placeholder="t('register.passwordPh')" :maxlength="20" :error="passwordError" @blur="onPasswordBlur" />
						</view>

						<!-- 确认密码 -->
						<view class="register-page__field">
							<PasswordInput v-model="confirmPasswordValue" :label="t('register.confirmLabel')" :placeholder="t('register.confirmPh')" :maxlength="20" :error="confirmPasswordError" @blur="onConfirmPasswordBlur" />
						</view>

						<!-- 电子邮箱 -->
						<view class="register-page__field">
							<FormInput v-model="emailValue" :label="t('register.emailLabel')" :placeholder="t('register.emailPh')" :maxlength="254" :error="emailError" @blur="onEmailBlur" />
						</view>

						<!-- 验证码 -->
						<view class="register-page__field">
							<CodeInput ref="codeRef" v-model="codeValue" :label="t('register.codeLabel')" :error="codeError" :sending="isSending" @request-send="handleGetCode" />
						</view>

						<!-- 协议勾选（注册仅提示隐私政策） -->
						<view class="register-page__agree">
							<AgreementCheckbox v-model="agreed" />
						</view>

						<!-- 注册按钮 -->
						<view class="register-page__submit" @click="handleRegister">
							<text class="register-page__submit-text">{{ t('register.submit') }}</text>
						</view>
					</view>
				</view>

				<!-- 底部登录链接 -->
				<view class="register-page__footer">
					<text class="register-page__footer-text">{{ t('register.hasAccount') }}</text>
					<text class="register-page__footer-link" @click="goLogin">{{ t('register.goLogin') }}</text>
			</view>
	</PageShell>
</template>

<script setup lang="uts">
	import PageShell from '@/components/common/PageShell.uvue'
	import FormInput from '@/components/form/FormInput.uvue'
	import PasswordInput from '@/components/form/PasswordInput.uvue'
	import CodeInput from '@/components/form/CodeInput.uvue'
	import AgreementCheckbox from '@/components/form/AgreementCheckbox.uvue'
	import { sendRegisterCode, registerUser } from './api/user.uts'
	import { validateUsername, validatePassword, validateConfirmPassword, validateEmail } from './utils/validators.uts'
	import { t } from '@/utils/i18n.uts'
	// 词典注册（register 页文案 + 公共段）
	import '@/pages/user/locales/register.uts'
	import '@/utils/locales/common.uts'

	const usernameValue = ref('')
	const passwordValue = ref('')
	const confirmPasswordValue = ref('')
	const emailValue = ref('')
	const codeValue = ref('')
	const usernameError = ref('')
	const passwordError = ref('')
	const confirmPasswordError = ref('')
	const emailError = ref('')
	const codeError = ref('')
	const agreed = ref(false)
	const isSending = ref(false)
	const submitting = ref(false)

	/** 验证码组件引用（倒计时与按钮复位内聚于组件） */
	const codeRef = ref<CodeInput | null>(null)

	// ===== 前端输入校验（规则统一收口 utils/validators.uts，与 auth 服务后端保持一致） =====

	function onUsernameBlur() : void {
		usernameError.value = usernameValue.value.length == 0 ? '' : validateUsername(usernameValue.value)
	}

	function onPasswordBlur() : void {
		passwordError.value = passwordValue.value.length == 0 ? '' : validatePassword(passwordValue.value)
		// 密码修改后需联动重新校验确认密码
		if (confirmPasswordValue.value.length > 0) {
			confirmPasswordError.value = validateConfirmPassword(confirmPasswordValue.value, passwordValue.value)
		}
	}

	function onConfirmPasswordBlur() : void {
		confirmPasswordError.value = confirmPasswordValue.value.length == 0 ? '' : validateConfirmPassword(confirmPasswordValue.value, passwordValue.value)
	}

	function onEmailBlur() : void {
		emailError.value = emailValue.value.length == 0 ? '' : validateEmail(emailValue.value)
	}

	// ===== 获取验证码：前端校验邮箱 → 调用 auth 服务发送邮件 → 组件内倒计时 =====
	function handleGetCode() : void {
		if (isSending.value) {
			return
		}
		const emailErr = validateEmail(emailValue.value)
		if (emailErr.length > 0) {
			emailError.value = emailErr
			uni.showToast({ title: emailErr, icon: 'none' })
			return
		}
		isSending.value = true
		sendRegisterCode(emailValue.value).then((_res) => {
			uni.showToast({ title: t('register.codeSent'), icon: 'none' })
			codeRef.value?.startCountdown()
		}).catch((e) => {
			const err = e as Error
			// 发送失败恢复按钮，允许用户立即重试
			codeRef.value?.reset()
			uni.showToast({ title: err.message, icon: 'none' })
		}).finally(() => {
			isSending.value = false
		})
	}

	// ===== 注册提交：前端校验 → 隐私政策确认 → 调用 auth 服务 =====
	function handleRegister() : void {
		if (submitting.value) {
			return
		}
		usernameError.value = validateUsername(usernameValue.value)
		passwordError.value = validatePassword(passwordValue.value)
		confirmPasswordError.value = validateConfirmPassword(confirmPasswordValue.value, passwordValue.value)
		emailError.value = validateEmail(emailValue.value)
		codeError.value = codeValue.value.length == 0 ? t('register.codeEmpty') : ''
		if (usernameError.value.length > 0) {
			uni.showToast({ title: usernameError.value, icon: 'none' })
			return
		}
		if (passwordError.value.length > 0) {
			uni.showToast({ title: passwordError.value, icon: 'none' })
			return
		}
		if (confirmPasswordError.value.length > 0) {
			uni.showToast({ title: confirmPasswordError.value, icon: 'none' })
			return
		}
		if (emailError.value.length > 0) {
			uni.showToast({ title: emailError.value, icon: 'none' })
			return
		}
		if (codeError.value.length > 0) {
			uni.showToast({ title: codeError.value, icon: 'none' })
			return
		}
		if (!agreed.value) {
			uni.showModal({
				title: t('common.tip'),
				content: t('register.agreeContent'),
				confirmText: t('common.ok'),
				cancelText: t('common.cancel'),
				success: (res) => {
					if (res.confirm) {
						agreed.value = true
						submitForm()
					}
				}
			})
			return
		}
		submitForm()
	}

	function submitForm() : void {
		submitting.value = true
		registerUser(usernameValue.value, passwordValue.value, emailValue.value, codeValue.value).then((_res) => {
			uni.showToast({ title: t('register.success'), icon: 'success' })
			// 注册成功后跳转登录页（带 mode=normal 直接展示账号密码登录卡片）
			setTimeout(() => {
				uni.redirectTo({ url: '/pages/user/login?mode=normal' })
			}, 1500)
		}).catch((e) => {
			const err = e as Error
			const msg = err.message.includes('验证码') ? t('register.codeWrong') : err.message
			uni.showToast({ title: msg, icon: 'none' })
		}).finally(() => {
			submitting.value = false
		})
	}

	function goLogin() : void {
		uni.navigateTo({ url: '/pages/user/login?mode=normal' })
	}

	// 微信小程序分享：转发好友与朋友圈（封面统一 /static/share-cover.png，复制自 yao 项目）
	// #ifdef MP-WEIXIN
	onShareAppMessage(() => {
		return { title: t('register.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	onShareTimeline(() => {
		return { title: t('register.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	// #endif
</script>

<style lang="scss">
	/* ===== 白色卡片容器（页面壳样式随 PageShell 组件） ===== */
	.register-page__card {
		width: 684rpx;
		margin-top: 64rpx;
		padding: 48rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: 48rpx;
		flex-direction: column;
	}

	/* ===== 标题区 ===== */
	.register-page__header {
		flex-direction: column;
		align-items: center;
	}

	.register-page__title {
		color: $bai-ink;
		font-size: 64rpx;
		line-height: 72rpx;
		font-weight: 600;
		text-align: center;
	}

	.register-page__subtitle {
		margin-top: 16rpx;
		color: $bai-body;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
		text-align: center;
	}

	/* ===== 注册表单 ===== */
	.register-page__form {
		margin-top: 48rpx;
		flex-direction: column;
	}

	.register-page__field {
		margin-bottom: 32rpx;
		flex-direction: column;
	}

	/* ===== 协议勾选（勾选行样式随 AgreementCheckbox 组件） ===== */
	.register-page__agree {
		padding-bottom: 16rpx;
		flex-direction: row;
		align-items: center;
	}

	/* ===== 注册按钮 ===== */
	.register-page__submit {
		margin-top: 16rpx;
		height: 96rpx;
		padding: 24rpx 0;
		box-sizing: border-box;
		background-color: $bai-ink;
		border-radius: 48rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.register-page__submit-text {
		color: $bai-on-primary;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 500;
	}

	/* ===== 底部登录链接 ===== */
	.register-page__footer {
		margin-top: 48rpx;
		flex-direction: row;
		justify-content: center;
	}

	.register-page__footer-text {
		color: $bai-body;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}

	.register-page__footer-link {
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 500;
	}
</style>

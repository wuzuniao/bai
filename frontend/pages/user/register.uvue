<template>
	<view class="register-page">
		<!-- 顶部返回按钮（次级页面统一返回组件） -->
		<BackButton />

		<scroll-view class="register-page__scroll" direction="vertical" :show-scrollbar="false">
			<view class="register-page__canvas" :style="'padding-top:' + mainTop + 'px'">
				<!-- 白色卡片容器 -->
				<view class="register-page__card">
					<!-- 标题区 -->
					<view class="register-page__header">
						<text class="register-page__title">注册账号</text>
						<text class="register-page__subtitle">创建账号，开启您的阅读之旅。</text>
					</view>

					<!-- 注册表单 -->
					<view class="register-page__form">
						<!-- 用户名 -->
						<view class="register-page__field">
							<text class="register-page__label">用户名</text>
							<input
								class="register-page__input"
								:class="usernameError.length > 0 ? 'register-page__input--error' : ''"
								v-model="usernameValue"
								placeholder="请输入用户名（2-15 个字符，仅限中文、英文及数字）"
								:placeholder-style="PLACEHOLDER_STYLE"
								:maxlength="15"
								@blur="onUsernameBlur"
							/>
							<text v-if="usernameError.length > 0" class="register-page__error-text">{{ usernameError }}</text>
						</view>

						<!-- 密码 -->
						<view class="register-page__field">
							<text class="register-page__label">密码</text>
							<view
								class="register-page__password-row"
								:class="passwordError.length > 0 ? 'register-page__password-row--error' : ''"
							>
								<input
									class="register-page__input register-page__input--password"
									v-model="passwordValue"
									:password="!showPassword"
									:key="'reg-pwd-' + showPassword"
									placeholder="请输入密码"
									:placeholder-style="PLACEHOLDER_STYLE"
									:maxlength="20"
									@blur="onPasswordBlur"
								/>
								<view class="register-page__eye" @click="togglePassword">
									<PasswordEye :visible="showPassword" />
								</view>
							</view>
							<text v-if="passwordError.length > 0" class="register-page__error-text">{{ passwordError }}</text>
						</view>

						<!-- 确认密码 -->
						<view class="register-page__field">
							<text class="register-page__label">确认密码</text>
							<view
								class="register-page__password-row"
								:class="confirmPasswordError.length > 0 ? 'register-page__password-row--error' : ''"
							>
								<input
									class="register-page__input register-page__input--password"
									v-model="confirmPasswordValue"
									:password="!showConfirmPassword"
									:key="'reg-cpwd-' + showConfirmPassword"
									placeholder="请再次输入密码"
									:placeholder-style="PLACEHOLDER_STYLE"
									:maxlength="20"
									@blur="onConfirmPasswordBlur"
								/>
								<view class="register-page__eye" @click="toggleConfirmPassword">
									<PasswordEye :visible="showConfirmPassword" />
								</view>
							</view>
							<text v-if="confirmPasswordError.length > 0" class="register-page__error-text">{{ confirmPasswordError }}</text>
						</view>

						<!-- 电子邮箱 -->
						<view class="register-page__field">
							<text class="register-page__label">电子邮箱</text>
							<input
								class="register-page__input"
								:class="emailError.length > 0 ? 'register-page__input--error' : ''"
								v-model="emailValue"
								placeholder="请输入邮箱地址"
								:placeholder-style="PLACEHOLDER_STYLE"
								:maxlength="254"
								@blur="onEmailBlur"
							/>
							<text v-if="emailError.length > 0" class="register-page__error-text">{{ emailError }}</text>
						</view>

						<!-- 验证码 -->
						<view class="register-page__field">
							<text class="register-page__label">验证码</text>
							<view class="register-page__code-row">
								<input
									class="register-page__code-input"
									:class="codeError.length > 0 ? 'register-page__code-input--error' : ''"
									v-model="codeValue"
									placeholder="请输入验证码"
									:placeholder-style="PLACEHOLDER_STYLE"
									:maxlength="6"
								/>
								<view
									class="register-page__code-btn"
									:class="counting || isSending ? 'register-page__code-btn--disabled' : ''"
									@click="handleGetCode"
								>
									<text class="register-page__code-btn-text">{{ codeText }}</text>
								</view>
							</view>
							<text v-if="codeError.length > 0" class="register-page__error-text">{{ codeError }}</text>
						</view>

						<!-- 协议勾选（注册仅提示隐私政策） -->
						<view class="register-page__agree" @click="toggleAgree">
							<view :class="agreed ? 'register-page__checkbox register-page__checkbox--checked' : 'register-page__checkbox'">
								<view v-if="agreed" class="register-page__checkmark"></view>
							</view>
							<text class="register-page__agree-text">查看并同意</text>
							<text class="register-page__agree-text" @click.stop="goAgreement">《服务协议》</text>
							<text class="register-page__agree-text">和</text>
							<text class="register-page__agree-text" @click.stop="goPrivacy">《隐私政策》</text>
						</view>

						<!-- 注册按钮 -->
						<view class="register-page__submit" @click="handleRegister">
							<text class="register-page__submit-text">注册</text>
						</view>
					</view>
				</view>

				<!-- 底部登录链接 -->
				<view class="register-page__footer">
					<text class="register-page__footer-text">已有账号？</text>
					<text class="register-page__footer-link" @click="goLogin">去登录</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import BackButton from '@/components/BackButton/BackButton.uvue'
	import PasswordEye from '@/components/PasswordEye/PasswordEye.uvue'
	import { PLACEHOLDER_STYLE } from '@/utils/theme.uts'
	import { AGREEMENT_URL, PRIVACY_URL } from '@/utils/config.uts'
	import { openExternalLink } from '@/utils/link.uts'
	import { sendRegisterCode, registerUser } from '@/api/user.uts'

	/** 顶部留白：返回按钮（状态栏高度 + 40px）之下再留 12px */
	const mainTop = ref(96)
	const win = uni.getWindowInfo()
	if (win.statusBarHeight > 0) {
		mainTop.value = win.statusBarHeight + 52
	}

	const usernameValue = ref('')
	const passwordValue = ref('')
	const confirmPasswordValue = ref('')
	const emailValue = ref('')
	const codeValue = ref('')
	const usernameError = ref('')
	const passwordError = ref('')
	const confirmPasswordError = ref('')
	const emailError = ref('')
	const codeError = ref('')
	const agreed = ref(false)
	const showPassword = ref(false)
	const showConfirmPassword = ref(false)
	const codeText = ref('获取验证码')
	const counting = ref(false)
	const isSending = ref(false)
	const submitting = ref(false)
	let codeTimer = 0

	function togglePassword() : void {
		showPassword.value = !showPassword.value
	}

	function toggleConfirmPassword() : void {
		showConfirmPassword.value = !showConfirmPassword.value
	}

	function toggleAgree() : void {
		agreed.value = !agreed.value
	}

	// ===== 前端输入校验（与 auth 服务后端规则保持一致） =====
	function validateUsername(v: string) : string {
		if (v.length == 0) {
			return '请输入用户名'
		}
		if (v.length < 2 || v.length > 15) {
			return '用户名长度需为 2-15 个字符'
		}
		if (!/^[\u4e00-\u9fa5a-zA-Z0-9]+$/.test(v)) {
			return '用户名仅允许中文、英文及数字字符'
		}
		return ''
	}

	function validatePasswordValue(v: string) : string {
		if (v.length == 0) {
			return '请输入密码'
		}
		if (v.length < 8 || v.length > 20) {
			return '密码长度需为 8-20 位'
		}
		let categories = 0
		if (/[a-z]/.test(v)) {
			categories++
		}
		if (/[A-Z]/.test(v)) {
			categories++
		}
		if (/[0-9]/.test(v)) {
			categories++
		}
		if (/[^a-zA-Z0-9]/.test(v)) {
			categories++
		}
		if (categories < 3) {
			return '密码需包含大小写字母、数字、特殊符号中的至少三种'
		}
		return ''
	}

	function validateConfirmPassword(v: string) : string {
		if (v.length == 0) {
			return '请再次输入密码'
		}
		if (v !== passwordValue.value) {
			return '两次密码不一致'
		}
		return ''
	}

	function validateEmail(v: string) : string {
		if (v.length == 0) {
			return '请输入邮箱地址'
		}
		if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
			return '邮箱格式不正确'
		}
		return ''
	}

	function onUsernameBlur() : void {
		usernameError.value = usernameValue.value.length == 0 ? '' : validateUsername(usernameValue.value)
	}

	function onPasswordBlur() : void {
		passwordError.value = passwordValue.value.length == 0 ? '' : validatePasswordValue(passwordValue.value)
		// 密码修改后需联动重新校验确认密码
		if (confirmPasswordValue.value.length > 0) {
			confirmPasswordError.value = validateConfirmPassword(confirmPasswordValue.value)
		}
	}

	function onConfirmPasswordBlur() : void {
		confirmPasswordError.value = confirmPasswordValue.value.length == 0 ? '' : validateConfirmPassword(confirmPasswordValue.value)
	}

	function onEmailBlur() : void {
		emailError.value = emailValue.value.length == 0 ? '' : validateEmail(emailValue.value)
	}

	// ===== 获取验证码：前端校验邮箱 → 调用 auth 服务发送邮件 → 倒计时 =====
	function handleGetCode() : void {
		if (counting.value || isSending.value) {
			return
		}
		const emailErr = validateEmail(emailValue.value)
		if (emailErr.length > 0) {
			emailError.value = emailErr
			uni.showToast({ title: emailErr, icon: 'none' })
			return
		}
		isSending.value = true
		codeText.value = '发送中...'
		sendRegisterCode(emailValue.value).then((_res) => {
			uni.showToast({ title: '验证码已发送', icon: 'none' })
			startCountdown()
		}).catch((e) => {
			const err = e as Error
			// 发送失败恢复按钮，允许用户立即重试
			codeText.value = '获取验证码'
			uni.showToast({ title: err.message, icon: 'none' })
		}).finally(() => {
			isSending.value = false
		})
	}

	function startCountdown() : void {
		let sec = 60
		counting.value = true
		codeText.value = `${sec}s`
		codeTimer = setInterval(() => {
			sec--
			if (sec <= 0) {
				clearInterval(codeTimer)
				counting.value = false
				codeText.value = '获取验证码'
			} else {
				codeText.value = `${sec}s`
			}
		}, 1000)
	}

	// ===== 注册提交：前端校验 → 隐私政策确认 → 调用 auth 服务 =====
	function handleRegister() : void {
		if (submitting.value) {
			return
		}
		usernameError.value = validateUsername(usernameValue.value)
		passwordError.value = validatePasswordValue(passwordValue.value)
		confirmPasswordError.value = validateConfirmPassword(confirmPasswordValue.value)
		emailError.value = validateEmail(emailValue.value)
		codeError.value = codeValue.value.length == 0 ? '请输入验证码' : ''
		if (usernameError.value.length > 0) {
			uni.showToast({ title: usernameError.value, icon: 'none' })
			return
		}
		if (passwordError.value.length > 0) {
			uni.showToast({ title: passwordError.value, icon: 'none' })
			return
		}
		if (confirmPasswordError.value.length > 0) {
			uni.showToast({ title: confirmPasswordError.value, icon: 'none' })
			return
		}
		if (emailError.value.length > 0) {
			uni.showToast({ title: emailError.value, icon: 'none' })
			return
		}
		if (codeError.value.length > 0) {
			uni.showToast({ title: codeError.value, icon: 'none' })
			return
		}
		if (!agreed.value) {
			uni.showModal({
				title: '提示',
				content: '查看并同意《服务协议》和《隐私政策》',
				confirmText: '确定',
				cancelText: '取消',
				success: (res) => {
					if (res.confirm) {
						agreed.value = true
						submitForm()
					}
				}
			})
			return
		}
		submitForm()
	}

	function submitForm() : void {
		submitting.value = true
		registerUser(usernameValue.value, passwordValue.value, emailValue.value, codeValue.value).then((_res) => {
			uni.showToast({ title: '注册成功', icon: 'success' })
			// 注册成功后跳转登录页（带 mode=normal 直接展示账号密码登录卡片）
			setTimeout(() => {
				uni.redirectTo({ url: '/pages/user/login?mode=normal' })
			}, 1500)
		}).catch((e) => {
			const err = e as Error
			const msg = err.message.includes('验证码') ? '请输入正确验证码' : err.message
			uni.showToast({ title: msg, icon: 'none' })
		}).finally(() => {
			submitting.value = false
		})
	}

	function goLogin() : void {
		uni.navigateTo({ url: '/pages/user/login?mode=normal' })
	}

	/** 服务协议 / 隐私政策：外部链接，复制后浏览器打开 */
	function goAgreement() : void {
		openExternalLink(AGREEMENT_URL)
	}

	function goPrivacy() : void {
		openExternalLink(PRIVACY_URL)
	}
</script>

<style lang="scss">
	.register-page {
		flex: 1;
		position: relative;
		background-color: $bai-canvas-soft;
	}

	.register-page__scroll {
		flex: 1;
	}

	.register-page__canvas {
		padding-left: 48rpx;
		padding-right: 48rpx;
		padding-bottom: 72rpx;
		box-sizing: border-box;
		flex-direction: column;
	}

	/* ===== 白色卡片容器 ===== */
	.register-page__card {
		width: 100%;
		margin-top: 64rpx;
		padding: 48rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: 48rpx;
		flex-direction: column;
	}

	/* ===== 标题区 ===== */
	.register-page__header {
		flex-direction: column;
		align-items: center;
	}

	.register-page__title {
		color: $bai-ink;
		font-size: 64rpx;
		line-height: 72rpx;
		font-weight: 600;
		text-align: center;
	}

	.register-page__subtitle {
		margin-top: 16rpx;
		color: $bai-body;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
		text-align: center;
	}

	/* ===== 注册表单 ===== */
	.register-page__form {
		margin-top: 48rpx;
		flex-direction: column;
	}

	.register-page__field {
		margin-bottom: 32rpx;
		flex-direction: column;
	}

	.register-page__label {
		margin-bottom: 16rpx;
		color: $bai-ink;
		font-size: 28rpx;
		line-height: 40rpx;
		font-weight: 400;
	}

	.register-page__input {
		height: 98rpx;
		padding: 28rpx 24rpx 24rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-md;
		border: 1px solid $bai-ink;
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 42rpx;
	}

	/* 密码行：统一边框容器，内含输入框与眼睛图标 */
	.register-page__password-row {
		position: relative;
		flex-direction: row;
		align-items: stretch;
		border: 1px solid $bai-ink;
		border-radius: $bai-rounded-md;
		background-color: $bai-canvas;
	}

	.register-page__password-row--error {
		border-color: $bai-negative;
	}

	.register-page__input--password {
		flex: 1;
		border: none;
		background-color: transparent;
		border-radius: $bai-rounded-md 0 0 $bai-rounded-md;
		padding-right: 24rpx;
	}

	.register-page__eye {
		flex-shrink: 0;
		position: relative;
		z-index: 2;
		padding: 0 24rpx;
		border-radius: 0 $bai-rounded-md $bai-rounded-md 0;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.register-page__input--error {
		border-color: $bai-negative;
	}

	.register-page__error-text {
		margin-top: 8rpx;
		color: $bai-negative;
		font-size: 24rpx;
		line-height: 32rpx;
	}

	/* ===== 验证码行 ===== */
	.register-page__code-row {
		flex-direction: row;
	}

	.register-page__code-input {
		flex: 1;
		height: 98rpx;
		padding: 28rpx 24rpx 24rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-md;
		border: 1px solid $bai-ink;
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 42rpx;
	}

	.register-page__code-input--error {
		border-color: $bai-negative;
	}

	.register-page__code-btn {
		margin-left: 16rpx;
		width: 192rpx;
		height: 98rpx;
		box-sizing: border-box;
		border-radius: $bai-rounded-md;
		border: 1px solid $bai-ink;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		flex-shrink: 0;
	}

	.register-page__code-btn--disabled {
		opacity: 0.6;
	}

	.register-page__code-btn-text {
		color: $bai-ink;
		font-size: 28rpx;
		line-height: 40rpx;
		font-weight: 400;
	}

	/* ===== 协议勾选 ===== */
	.register-page__agree {
		margin-top: 16rpx;
		padding-bottom: 16rpx;
		flex-direction: row;
		align-items: center;
	}

	.register-page__checkbox {
		width: 32rpx;
		height: 32rpx;
		border-radius: $bai-rounded-sm;
		background-color: $bai-canvas;
		border: 1px solid $bai-neutral;
		box-sizing: border-box;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		flex-shrink: 0;
	}

	.register-page__checkbox--checked {
		background-color: $bai-ink;
		border-color: $bai-ink;
	}

	/* 选中态对勾（CSS 绘制） */
	.register-page__checkmark {
		width: 10rpx;
		height: 16rpx;
		border-right: 1.5px solid $bai-on-primary;
		border-bottom: 1.5px solid $bai-on-primary;
		transform: rotate(45deg) translate(-1px, -1px);
	}

	.register-page__agree-text {
		margin-left: 16rpx;
		color: $bai-body;
		font-size: 24rpx;
		line-height: 32rpx;
		font-weight: 400;
	}

	/* ===== 注册按钮 ===== */
	.register-page__submit {
		margin-top: 16rpx;
		height: 96rpx;
		padding: 24rpx 0;
		box-sizing: border-box;
		background-color: $bai-ink;
		border-radius: $bai-rounded-xl;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.register-page__submit-text {
		color: $bai-on-primary;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 500;
	}

	/* ===== 底部登录链接 ===== */
	.register-page__footer {
		margin-top: 48rpx;
		flex-direction: row;
		justify-content: center;
	}

	.register-page__footer-text {
		color: $bai-body;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}

	.register-page__footer-link {
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 600;
	}
</style>

<template>
	<PageShell title="" desc="" :center="true">
				<!-- 微信一键登录卡片（仅微信小程序端展示） -->
				<!-- #ifdef MP-WEIXIN -->
				<view v-if="loginMode === 'wechat'" class="login-page__card">
					<text class="login-page__title">一键登录</text>
					<view class="login-page__wechat-btn" @click="handleWechatLogin">
						<image class="login-page__wechat-icon" src="/static/icons/wechat-login.png" mode="aspectFit" />
					</view>
					<!-- 微信登录隐私勾选（独立于账号密码登录的隐私勾选） -->
					<view class="login-page__remember login-page__remember--center">
						<AgreementCheckbox v-model="wechatAgree" />
					</view>
					<!-- 切换到账号密码登录引导 -->
					<view class="login-page__switch" @click="switchMode('normal')">
						<text class="login-page__switch-text">账号密码登录</text>
					</view>
				</view>
				<!-- #endif -->

				<!-- App 端指纹一键登录卡片（仅 App 端：设备支持指纹 + 本地存在凭证 + 已开启开关时展示） -->
				<!-- #ifdef APP -->
				<view v-if="loginMode === 'fingerprint' && biometricVisible" class="login-page__card">
					<text class="login-page__title">一键登录</text>
					<view class="login-page__wechat-btn" @click="handleFingerprintLogin">
						<image class="login-page__wechat-icon" src="/static/icons/dl_fingerprint.png" mode="aspectFit" />
					</view>
					<!-- 指纹登录隐私勾选（与微信端对称，独立于账号密码登录的隐私勾选） -->
					<view class="login-page__remember login-page__remember--center">
						<AgreementCheckbox v-model="fingerprintAgree" />
					</view>
					<!-- 切换到账号密码登录引导 -->
					<view class="login-page__switch" @click="switchMode('normal')">
						<text class="login-page__switch-text">账号密码登录</text>
					</view>
				</view>
				<!-- #endif -->

				<!-- 主登录卡片（账号密码登录；微信端切换或注册页跳转时展示） -->
				<view v-if="loginMode === 'normal'" class="login-page__card">
					<text class="login-page__title">欢迎回来</text>

					<view class="login-page__form">
						<!-- 用户名或邮箱 -->
						<view class="login-page__field">
							<FormInput v-model="usernameValue" label="用户名或邮箱" placeholder="请输入用户名或邮箱" :maxlength="254" :error="usernameError" @blur="onUsernameBlur" />
						</view>

						<!-- 密码 -->
						<view class="login-page__field login-page__field--password">
							<PasswordInput v-model="passwordValue" label="密码" placeholder="请输入密码" :maxlength="20" :error="passwordError" @blur="onPasswordBlur" />
							<view class="login-page__forgot-row">
								<text class="login-page__forgot" @click="handleForgot">忘记密码？</text>
							</view>
						</view>

						<!-- 操作区 -->
						<view class="login-page__actions">
							<view class="login-page__remember">
								<AgreementCheckbox v-model="remember" />
							</view>
							<view class="login-page__submit" @click="handleLogin">
								<text class="login-page__submit-text">登录</text>
							</view>
						</view>
					</view>

					<!-- 切换到微信一键登录引导（仅微信小程序端展示） -->
					<!-- #ifdef MP-WEIXIN -->
					<view class="login-page__switch" @click="switchMode('wechat')">
						<text class="login-page__switch-text">一键登录</text>
					</view>
					<!-- #endif -->
				</view>

				<!-- 底部注册链接 -->
				<view v-if="loginMode === 'normal'" class="login-page__footer">
					<text class="login-page__footer-text">还没有账号？</text>
					<text class="login-page__footer-link" @click="goRegister">立即注册</text>
				</view>
</template>

<script setup lang="uts">
	import PageShell from '@/components/common/PageShell.uvue'
	import FormInput from '@/components/form/FormInput.uvue'
	import PasswordInput from '@/components/form/PasswordInput.uvue'
	import AgreementCheckbox from '@/components/form/AgreementCheckbox.uvue'
	import { useUserStore } from '@/stores/user.uts'
	import { ApiResponse } from '@/utils/request.uts'
	import { loginUser } from '@/api/user.uts'

	// #ifdef MP-WEIXIN
	import { wechatLogin } from '@/api/user.uts'
	// #endif

	// #ifdef APP
	import { getDeviceId, storeBiometricToken, getBiometricToken, isBiometricAvailable, isBiometricEnabled, authenticate } from '@/utils/biometric.uts'
	import { biometricLogin } from '@/api/user.uts'
	// #endif

	const userStore = useUserStore()

	// 登录方式：微信小程序端默认微信一键登录，其他端默认账号密码登录；
	// 注册页跳转时 URL 带 ?mode=normal，则初始展示账号密码卡片
	let defaultLoginMode = 'normal'
	// #ifdef MP-WEIXIN
	defaultLoginMode = 'wechat'
	// #endif
	const loginMode = ref(defaultLoginMode)

	onLoad((options) => {
		if (options != null && options['mode'] == 'normal') {
			loginMode.value = 'normal'
		}
	})

	// App 端：页面显示时检测指纹能力，决定是否默认展示指纹一键登录卡片
	// 三者同时满足才默认指纹卡片：设备支持指纹 + 本地存在凭证 + 已开启指纹开关，否则账号密码登录
	const biometricVisible = ref(false)
	onShow(() => {
		// #ifdef APP
		isBiometricAvailable().then((ok: boolean) => {
			biometricVisible.value = ok && getBiometricToken().length > 0 && isBiometricEnabled()
			loginMode.value = biometricVisible.value ? 'fingerprint' : 'normal'
		})
		// #endif
	})

	/** 切换登录方式（互斥显示对应卡片） */
	function switchMode(mode: string) : void {
		loginMode.value = mode
	}

	const usernameValue = ref('')
	const passwordValue = ref('')
	const usernameError = ref('')
	const passwordError = ref('')
	const remember = ref(false)
	const submitting = ref(false)
	// #ifdef MP-WEIXIN
	const wechatAgree = ref(false)
	// #endif
	// #ifdef APP
	const fingerprintAgree = ref(false)
	// #endif

	function validateUsername(v: string) : string {
		if (v.length == 0) {
			return '请输入用户名'
		}
		return ''
	}

	function validatePasswordValue(v: string) : string {
		if (v.length == 0) {
			return '请输入密码'
		}
		return ''
	}

	function onUsernameBlur() : void {
		usernameError.value = validateUsername(usernameValue.value)
	}

	function onPasswordBlur() : void {
		passwordError.value = passwordValue.value.length == 0 ? '请输入密码' : ''
	}

	/** 登录提交：前端校验 → 隐私协议确认 → 调用 auth 服务 → 写入状态 → 跳转 */
	function handleLogin() : void {
		if (submitting.value) {
			return
		}
		usernameError.value = validateUsername(usernameValue.value)
		passwordError.value = validatePasswordValue(passwordValue.value)
		if (usernameError.value.length > 0) {
			uni.showToast({ title: usernameError.value, icon: 'none' })
			return
		}
		if (passwordError.value.length > 0) {
			uni.showToast({ title: passwordError.value, icon: 'none' })
			return
		}
		// 隐私协议勾选校验：未勾选时显示确认弹窗
		if (!remember.value) {
			uni.showModal({
				title: '提示',
				content: '查看并同意《服务协议》和《隐私政策》',
				confirmText: '确定',
				cancelText: '取消',
				success: (res) => {
					if (res.confirm) {
						remember.value = true
						handleLogin()
					}
				}
			})
			return
		}
		submitting.value = true
		// App 端携带设备标识，auth 登录成功时一并下发指纹登录凭证（biometric_token）
		let deviceId = ''
		// #ifdef APP
		deviceId = getDeviceId()
		// #endif
		loginUser(usernameValue.value, passwordValue.value, deviceId).then((res: ApiResponse) => {
			const d = res.data
			if (d != null) {
				userStore.setUser(d)
				// #ifdef APP
				const biometricToken = d.getString('biometric_token')
				if (biometricToken != null && biometricToken.length > 0) {
					storeBiometricToken(biometricToken)
				}
				// #endif
			}
			uni.showToast({ title: '登录成功', icon: 'success' })
			setTimeout(() => {
				uni.redirectTo({ url: '/pages/user/settings' })
			}, 1500)
		}).catch((e) => {
			const err = e as Error
			uni.showToast({ title: err.message, icon: 'none' })
		}).finally(() => {
			submitting.value = false
		})
	}

	function handleForgot() : void {
		uni.navigateTo({
			url: '/pages/user/forgot-password',
			fail: () => {
				uni.showToast({ title: '页面跳转失败', icon: 'none' })
			}
		})
	}

	// #ifdef APP
	/** 指纹一键登录（仅 App 端）：隐私勾选确认 → 系统指纹验证 → 本地凭证调 auth 指纹登录 → 跳转 */
	async function handleFingerprintLogin() : Promise<void> {
		if (submitting.value) {
			return
		}
		// 隐私协议勾选校验：未勾选时弹出确认对话框，确认后自动勾选并重入
		if (!fingerprintAgree.value) {
			uni.showModal({
				title: '提示',
				content: '查看并同意《服务协议》和《隐私政策》',
				confirmText: '确定',
				cancelText: '取消',
				success: (res) => {
					if (res.confirm) {
						fingerprintAgree.value = true
						handleFingerprintLogin()
					}
				}
			})
			return
		}
		const token = getBiometricToken()
		if (token.length == 0) {
			// 本地凭证缺失（如清缓存），回退账号密码登录
			loginMode.value = 'normal'
			return
		}
		submitting.value = true
		uni.showLoading({ title: '指纹验证中...', mask: true })
		try {
			// 1. 系统级指纹验证（未通过不会返回成功）
			await authenticate()
			// 2. 本地凭证 + 设备标识调用 auth 指纹登录
			const res = await biometricLogin(token, getDeviceId())
			uni.hideLoading()
			const d = res.data
			if (d != null) {
				userStore.setUser(d)
			}
			uni.showToast({ title: '登录成功', icon: 'success' })
			setTimeout(() => {
				uni.redirectTo({ url: '/pages/user/settings' })
			}, 1500)
		} catch (e) {
			uni.hideLoading()
			// 用户取消指纹验证不提示错误，其余提示
			setTimeout(() => {
				const err = e as UniError
				const msg = err.errMsg != null ? err.errMsg : ''
				if (!msg.includes('cancel') && !msg.includes('authenticate fail')) {
					uni.showToast({ title: '指纹登录失败，请使用账号密码登录', icon: 'none' })
				}
			}, 200)
		} finally {
			submitting.value = false
		}
	}
	// #endif

	// #ifdef MP-WEIXIN
	/** 微信一键登录：uni.login 获取 code → auth 服务换取令牌 → 写入状态 → 跳转 */
	function handleWechatLogin() : void {
		if (submitting.value) {
			return
		}
		if (!wechatAgree.value) {
			uni.showModal({
				title: '提示',
				content: '查看并同意《服务协议》和《隐私政策》',
				confirmText: '确定',
				cancelText: '取消',
				success: (res) => {
					if (res.confirm) {
						wechatAgree.value = true
						handleWechatLogin()
					}
				}
			})
			return
		}
		submitting.value = true
		uni.showLoading({ title: '微信登录中...', mask: true })
		// 超时安全网：覆盖 uni.login + 后端请求整个流程
		const timeoutId = setTimeout(() => {
			submitting.value = false
			uni.hideLoading()
			setTimeout(() => {
				uni.showToast({ title: '登录超时，请检查网络或认证服务', icon: 'none' })
			}, 200)
		}, 15000)
		uni.login({
			provider: 'weixin',
			success: (loginRes) => {
				const code = loginRes.code
				if (code.length == 0) {
					clearTimeout(timeoutId)
					uni.hideLoading()
					submitting.value = false
					setTimeout(() => {
						uni.showToast({ title: '获取微信登录凭证失败', icon: 'none' })
					}, 200)
					return
				}
				wechatLogin(code).then((res: ApiResponse) => {
					clearTimeout(timeoutId)
					uni.hideLoading()
					const d = res.data
					if (d != null) {
						userStore.setUser(d)
					}
					uni.showToast({ title: '登录成功', icon: 'success' })
					setTimeout(() => {
						uni.redirectTo({ url: '/pages/user/settings' })
					}, 1500)
				}).catch((e) => {
					clearTimeout(timeoutId)
					uni.hideLoading()
					const err = e as Error
					setTimeout(() => {
						uni.showToast({ title: err.message.length > 0 ? err.message : '微信登录失败', icon: 'none' })
					}, 200)
				}).finally(() => {
					submitting.value = false
				})
			},
			fail: (err) => {
				clearTimeout(timeoutId)
				uni.hideLoading()
				setTimeout(() => {
					const msg = err.errMsg
					if (msg.includes('cancel') || msg.includes('auth deny')) {
						uni.showToast({ title: '已取消微信登录', icon: 'none' })
					} else {
						uni.showToast({ title: '微信登录失败', icon: 'none' })
					}
				}, 200)
				submitting.value = false
			}
		})
	}
	// #endif

	function goRegister() : void {
		uni.navigateTo({
			url: '/pages/user/register',
			fail: () => {
				uni.showToast({ title: '页面跳转失败', icon: 'none' })
			}
		})
	}
</script>

<style lang="scss">
	/* ===== 登录卡片（页面壳样式随 PageShell 组件） ===== */
	.login-page__card {
		position: relative;
		z-index: 1;
		width: 684rpx;
		margin-top: 64rpx;
		padding: 48rpx;
		box-sizing: border-box;
		background-color: $bai-canvas;
		border-radius: 48rpx;
		flex-direction: column;
	}

	.login-page__title {
		color: $bai-ink;
		font-size: 64rpx;
		line-height: 72rpx;
		font-weight: 600;
		text-align: center;
	}

	/* ===== 表单 ===== */
	.login-page__form {
		margin-top: 48rpx;
		flex-direction: column;
	}

	.login-page__field {
		flex-direction: column;
	}

	.login-page__field--password {
		margin-top: 32rpx;
	}

	/* 忘记密码链接行 */
	.login-page__forgot-row {
		margin-top: 8rpx;
		flex-direction: row;
		justify-content: flex-end;
	}

	.login-page__forgot {
		color: $bai-body;
		font-size: 24rpx;
		line-height: 32rpx;
	}

	/* ===== 操作区 ===== */
	.login-page__actions {
		margin-top: 32rpx;
		flex-direction: column;
	}

	/* 协议勾选行样式随 AgreementCheckbox 组件 */
	.login-page__remember {
		height: 32rpx;
		flex-direction: row;
		align-items: center;
	}

	.login-page__remember--center {
		justify-content: center;
		margin-top: 32rpx;
	}

	.login-page__submit {
		margin-top: 24rpx;
		height: 96rpx;
		padding: 24rpx 0;
		box-sizing: border-box;
		background-color: $bai-ink;
		border-radius: 48rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.login-page__submit-text {
		color: $bai-on-primary;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 500;
	}

	/* ===== 底部注册链接 ===== */
	.login-page__footer {
		margin-top: 48rpx;
		flex-direction: row;
		justify-content: center;
	}

	.login-page__footer-text {
		color: $bai-body;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}

	.login-page__footer-link {
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 500;
	}

	/* ===== 登录方式切换引导 ===== */
	.login-page__switch {
		margin-top: 48rpx;
		flex-direction: row;
		justify-content: center;
	}

	.login-page__switch-text {
		color: $bai-ink;
		font-size: 36rpx;
		line-height: 52rpx;
		font-weight: 600;
	}

	/* ===== 微信一键登录区 ===== */
	.login-page__wechat-btn {
		width: 96rpx;
		height: 96rpx;
		margin-top: 48rpx;
		border-radius: 9999px;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		align-self: center;
	}

	.login-page__wechat-icon {
		width: 96rpx;
		height: 96rpx;
	}
</style>

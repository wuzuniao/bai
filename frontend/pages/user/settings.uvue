<template>
	<view class="settings-page">
		<!-- 站内信通知按钮（组件化：内部查询 auth 公告未读数驱动两态图标） -->
		<NoticeButton ref="noticeRef" />

		<scroll-view class="settings-page__scroll" direction="vertical" :show-scrollbar="false">
			<view class="settings-page__main">
				<!-- 用户资料卡片（普通版式：未登录或普通会员） -->
				<view v-if="!isMemberProfile" class="settings-page__profile-card" @click="goProfileOrLogin">
					<!-- 左缘品牌色装饰竖条 -->
					<view class="settings-page__profile-accent"></view>
					<view class="settings-page__profile-info">
						<text class="settings-page__profile-name">{{ displayName }}</text>
						<text class="settings-page__profile-slogan">{{ displaySlogan }}</text>
					</view>
					<view class="settings-page__profile-avatar-wrap">
						<image v-if="avatarUrl.length > 0" class="settings-page__profile-avatar" :src="avatarUrl" mode="aspectFit" />
					</view>
					<!-- 右上角 45° 斜切角（页面背景色三角覆盖形成） -->
					<view class="settings-page__profile-notch"></view>
				</view>

				<!-- 用户资料卡片（会员版式：黑铁及以上或管理员；
				     白色横幅（会员名徽标）+ 墨色信息板错位叠放，对应 bai 双表层设计语言） -->
				<view v-else class="settings-page__kinetic-card" @click="goProfileOrLogin">
					<view class="settings-page__kinetic-hero">
						<view class="settings-page__kinetic-pro-wrap">
							<text class="settings-page__kinetic-pro">{{ memberTierName }}</text>
						</view>
						<image v-if="avatarUrl.length > 0" class="settings-page__kinetic-avatar" :src="avatarUrl" mode="widthFix" />
					</view>
					<view class="settings-page__kinetic-panel">
						<text class="settings-page__kinetic-name">{{ displayName }}</text>
						<view v-if="displaySlogan.length > 0" class="settings-page__kinetic-slogan-box">
							<text class="settings-page__kinetic-slogan">{{ displaySlogan }}</text>
						</view>
					</view>
				</view>

				<!-- 会员卡片（仅 App 商店分发渠道且登录的普通用户 role=0 可见；
				     深色权益卡，样式与内容为纯前端静态展示，支付相关保留原配色） -->
				<view v-if="showMemberCard" class="settings-page__member-card">
					<view class="settings-page__member-glow"></view>
					<view class="settings-page__member-info">
						<view class="settings-page__member-badge">
							<image class="settings-page__member-badge-icon" src="/static/icons/huiyuan.png" mode="aspectFit" />
							<text class="settings-page__member-badge-text">会员专享权益</text>
						</view>
						<text class="settings-page__member-title">解锁离线畅读与纯净阅读体验</text>
					</view>
					<view class="settings-page__member-price-row">
						<text class="settings-page__member-price">¥6</text>
						<view class="settings-page__member-price-meta">
							<text class="settings-page__member-price-original">原价 ¥36</text>
							<text class="settings-page__member-price-unit">/ 每月</text>
						</view>
					</view>
					<view class="settings-page__member-btn" hover-class="settings-page__member-btn--hover" :hover-stay-time="70" @click="goMemberPay">
						<text class="settings-page__member-btn-text">立即抢购</text>
					</view>
				</view>

				<!-- 公告管理已随「公告管理迁移 auth」（2026-10-02）下线：管理员经 auth 前端管理公告 -->

				<!-- 帮助入口分组：帮助中心 + 联系我们 -->
				<view class="settings-page__group2">
					<view class="settings-page__group2-item settings-page__group2-item--bordered" @click="goHelp">
						<text class="settings-page__group2-text">帮助中心</text>
						<view class="u-arrow-right"></view>
					</view>
					<view class="settings-page__group2-item" @click="goContact">
						<text class="settings-page__group2-text">联系我们</text>
						<view class="u-arrow-right"></view>
					</view>
				</view>
			</view>
		</scroll-view>

		<BottomNavBar active="mine" />
	</view>
</template>

<script setup lang="uts">
	import NoticeButton from '@/components/NoticeButton/NoticeButton.uvue'
	import BottomNavBar from '@/components/BottomNavBar/BottomNavBar.uvue'
	import { useUserStore, avatarPathOf } from '@/stores/user.uts'

	const userStore = useUserStore()

	// 通知按钮组件引用：页面显示时刷新未读状态（响应站内信页标记已读后的返回）
	const noticeRef = ref<NoticeButton | null>(null)

	/** 顶部留白：内容区避让状态栏（小程序端胶囊在右侧，不冲突） */
	// 页面显示：刷新登录态与通知未读状态
	onShow(() => {
		noticeRef.value?.refresh()
	})

	// 会员卡片渠道可见性：仅 App 商店分发渠道可见（小程序/H5 无此入口）。
	// 渠道包细分（google 等）待后续上架时再接入。
	let memberChannelVisible = false
	// #ifdef APP-ANDROID || APP-HARMONY
	memberChannelVisible = true
	// #endif

	// 是否为管理员（roles 含 admin）
	const isAdmin = computed((): boolean => {
		const info = userStore.userInfo
		return info != null && info.roles.includes('admin')
	})

	// 会员档位：档位数值采用 auth 角色表 id（member=1 普通会员、iron=2 黑铁、
	// bronze=3 青铜、silver=4 白银、gold=5 黄金，取已授最高档）；
	// admin（id=0）不参与档位序，作为最高特殊档直通会员卡与会员版式
	const memberLevel = computed((): number => {
		const info = userStore.userInfo
		if (info == null) {
			return 1
		}
		let level = 1
		if (info.roles.includes('gold')) {
			level = 5
		} else if (info.roles.includes('silver')) {
			level = 4
		} else if (info.roles.includes('bronze')) {
			level = 3
		} else if (info.roles.includes('iron')) {
			level = 2
		}
		return level
	})

	// 是否使用会员版式资料卡：黑铁及以上（memberLevel ≥ 2）或管理员
	const isMemberProfile = computed((): boolean => {
		return isAdmin.value || memberLevel.value >= 2
	})

	// 是否显示会员卡片：允许的分发渠道 + 已登录 + 黑铁及以上会员或管理员
	const showMemberCard = computed((): boolean => {
		return memberChannelVisible && userStore.userInfo != null && (isAdmin.value || memberLevel.value >= 2)
	})

	// 会员档位名（资料卡横幅徽标文案）：管理员显示「管理员」，其余按档位取名（不含「会员」后缀）
	const memberTierName = computed((): string => {
		if (isAdmin.value) {
			return '管理员'
		}
		if (memberLevel.value >= 5) {
			return '黄金'
		}
		if (memberLevel.value >= 4) {
			return '白银'
		}
		if (memberLevel.value >= 3) {
			return '青铜'
		}
		if (memberLevel.value >= 2) {
			return '黑铁'
		}
		return '普通'
	})

	// 用户名显示：已登录显示 username（可能为空），未登录显示「请登录」
	const displayName = computed((): string => {
		const info = userStore.userInfo
		if (info == null) {
			return '请登录'
		}
		return info.username
	})

	// 个性签名显示：未登录显示默认文案，已登录显示 signature（可能为空）
	const displaySlogan = computed((): string => {
		const info = userStore.userInfo
		if (info == null) {
			return '“保持热爱，奔赴山海，每一天都要好好生活。”'
		}
		return info.signature
	})

	// 头像：未登录使用默认头像 hong；已登录从用户信息取，字段为空则不显示
	const avatarUrl = computed((): string => {
		const info = userStore.userInfo
		if (info == null) {
			return '/static/touxiang/hong.png'
		}
		if (info.avatar_url.length == 0) {
			return ''
		}
		return avatarPathOf(info.avatar_url)
	})

	/** 资料卡点击：已登录跳个人信息页，未登录跳登录页 */
	function goProfileOrLogin() : void {
		const url = userStore.userInfo != null ? '/pages/user/profile' : '/pages/user/login'
		uni.navigateTo({
			url,
			fail: () => {
				uni.showToast({ title: '页面跳转失败', icon: 'none' })
			}
		})
	}

	function goMemberPay() : void {
		uni.navigateTo({ url: '/pages/user/member-pay' })
	}

	function goHelp() : void {
		uni.navigateTo({ url: '/pages/user/help' })
	}

	function goContact() : void {
		uni.navigateTo({ url: '/pages/user/contact' })
	}
</script>

<style lang="scss">
	/* 响应式单位：沿用原设置页 375 设计稿基准，1px = 2rpx；
	 * 颜色一律取 uni.scss 的 $bai-* 令牌（真源 DESIGN_bai.md），
	 * 会员卡为支付相关区块，按约定保留原绿色配色。 */
	.settings-page {
		flex: 1;
		position: relative;
		background-color: $bai-canvas-soft;
	}

	.settings-page__scroll {
		flex: 1;
	}

	.settings-page__main {
		/* padding-top 210rpx：通知按钮 top约50px + 高40px = 底部约90px，留间隙避免与内容重叠（与 yao 布局一致） */
		padding-top: 210rpx;
		padding-left: 48rpx;
		padding-right: 48rpx;
		padding-bottom: 240rpx;
		flex-direction: column;
	}

	/* ===== 站内信入口 ===== */
	/* 通知按钮已组件化（components/NoticeButton/NoticeButton.uvue），样式随组件 */

	/* ===== 用户资料卡片（普通版式） ===== */
	.settings-page__profile-card {
		position: relative;
		width: 100%;
		height: 286rpx;
		padding: 48rpx;
		box-sizing: border-box;
		/* 左侧上下与右下同弧度大圆角（overflow 裁齐左侧竖条圆弧），右上由斜切角覆盖保持直角 */
		border-radius: 48rpx 0 48rpx 48rpx;
		background-color: $bai-canvas;
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		overflow: hidden;
	}

	/* 左缘品牌色装饰竖条 */
	.settings-page__profile-accent {
		position: absolute;
		left: 0;
		top: 0;
		width: 12rpx;
		height: 100%;
		background-color: $bai-ink;
	}

	/* 右上角 45° 斜切角：页面背景色三角覆盖卡片角形成 */
	.settings-page__profile-notch {
		position: absolute;
		top: 0;
		right: 0;
		width: 0;
		height: 0;
		border-top: 80rpx solid $bai-canvas-soft;
		border-left: 80rpx solid transparent;
	}

	.settings-page__profile-info {
		position: relative;
		z-index: 1;
		flex: 1;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
	}

	.settings-page__profile-name {
		color: $bai-ink;
		font-size: 56rpx;
		line-height: 70rpx;
		font-weight: 700;
		padding-bottom: 16rpx;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.settings-page__profile-slogan {
		color: $bai-body;
		font-size: 32rpx;
		line-height: 52rpx;
		font-weight: 400;
		lines: 3;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.settings-page__profile-avatar-wrap {
		position: relative;
		z-index: 1;
		width: 176rpx;
		height: 176rpx;
		flex-shrink: 0;
	}

	.settings-page__profile-avatar {
		width: 176rpx;
		height: 176rpx;
	}

	/* ===== 用户资料卡片（管理员版式：白横幅 + 墨色信息板错位叠放） ===== */
	.settings-page__kinetic-card {
		position: relative;
		width: 100%;
		box-sizing: border-box;
		border-radius: 96rpx 0 96rpx 0;
		background-color: $bai-canvas-soft;
		flex-direction: column;
		overflow: hidden;
	}

	.settings-page__kinetic-hero {
		position: relative;
		z-index: 1;
		flex-direction: row;
		align-items: center;
		padding: 48rpx;
		border-radius: 0 0 96rpx 0;
		background-color: $bai-canvas;
	}

	.settings-page__kinetic-pro-wrap {
		flex: 1;
		min-width: 0;
		flex-direction: row;
		justify-content: center;
	}

	.settings-page__kinetic-pro {
		flex-shrink: 0;
		color: $bai-ink;
		font-size: 112rpx;
		line-height: 112rpx;
		font-weight: 700;
		font-style: italic;
		lines: 1;
		text-overflow: clip;
		/* 斜体右倾出血余量：防止末字右缘被文本框边界裁剪（对称不破坏居中） */
		padding: 0 16rpx;
	}

	/* 头像固定像素（原图 88x88），固定于横幅右缘 */
	.settings-page__kinetic-avatar {
		width: 88px;
		flex-shrink: 0;
	}

	/* 墨色信息板：上叠于白横幅之后（负 margin 错位叠放） */
	.settings-page__kinetic-panel {
		box-sizing: border-box;
		margin-top: -48rpx;
		padding: 96rpx 48rpx 48rpx;
		border-radius: 96rpx 0 0 0;
		background-color: $bai-ink;
		flex-direction: column;
	}

	.settings-page__kinetic-name {
		color: $bai-canvas;
		font-size: 64rpx;
		line-height: 64rpx;
		font-weight: 400;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	/* 签名框：仅左侧竖线装饰 */
	.settings-page__kinetic-slogan-box {
		margin-top: 24rpx;
		border-left: 4px solid $bai-canvas;
		padding: 8rpx 0 8rpx 32rpx;
	}

	.settings-page__kinetic-slogan {
		color: rgba(255, 255, 255, 0.75);
		font-size: 32rpx;
		line-height: 52rpx;
		font-weight: 400;
		font-style: italic;
		lines: 2;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	/* ===== 会员卡片（支付相关区块：保留原绿色配色，不随主题令牌更换） ===== */
	.settings-page__member-card {
		position: relative;
		width: 100%;
		min-height: 556rpx;
		margin-top: 32rpx;
		padding: 48rpx;
		box-sizing: border-box;
		border-radius: 24rpx;
		background-color: $bai-ink;
		flex-direction: column;
		overflow: hidden;
	}

	/* 右上角装饰微光圆（radial 渐隐以低透明纯色近似，溢出部分裁剪） */
	.settings-page__member-glow {
		position: absolute;
		top: -32rpx;
		right: -32rpx;
		width: 192rpx;
		height: 192rpx;
		border-radius: 9999px;
		background-color: rgba(159, 232, 112, 0.12);
	}

	.settings-page__member-info {
		position: relative;
		z-index: 1;
		flex-direction: column;
	}

	.settings-page__member-badge {
		flex-direction: row;
		align-items: center;
	}

	.settings-page__member-badge-icon {
		width: 32rpx;
		height: 42rpx;
		flex-shrink: 0;
	}

	.settings-page__member-badge-text {
		margin-left: 8rpx;
		color: #9fe870;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}

	.settings-page__member-title {
		margin-top: 16rpx;
		color: $bai-canvas;
		font-size: 48rpx;
		line-height: 64rpx;
		font-weight: 400;
	}

	/* 价格行：左侧大价格顶对齐，右侧说明组贴底 */
	.settings-page__member-price-row {
		position: relative;
		z-index: 1;
		margin-top: 48rpx;
		min-height: 140rpx;
		flex-direction: row;
	}

	.settings-page__member-price {
		color: #9fe870;
		font-size: 96rpx;
		line-height: 96rpx;
		font-weight: 700;
	}

	.settings-page__member-price-meta {
		margin-left: 20rpx;
		align-self: flex-end;
		flex-direction: column;
	}

	.settings-page__member-price-original {
		color: $bai-canvas;
		font-size: 24rpx;
		line-height: 32rpx;
		font-weight: 400;
		text-decoration: line-through;
	}

	.settings-page__member-price-unit {
		color: #9fe870;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}

	/* 抢购按钮：品牌浅绿胶囊 */
	.settings-page__member-btn {
		position: relative;
		z-index: 1;
		margin-top: 48rpx;
		height: 96rpx;
		border-radius: 9999px;
		background-color: #9fe870;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	/* 按压态：对应设计稿 hover opacity 0.8 / click scale 0.95 */
	.settings-page__member-btn--hover {
		opacity: 0.8;
		transform: scale(0.95);
	}

	.settings-page__member-btn-text {
		color: #2e6900;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}

	/* ===== 帮助入口分组 ===== */
	.settings-page__group2 {
		margin-top: 64rpx;
		border-radius: 48rpx;
		background-color: $bai-canvas;
		overflow: hidden;
	}

	.settings-page__group2-item {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 24rpx 32rpx;
		box-sizing: border-box;
		height: 98rpx;
	}

	.settings-page__group2-item--bordered {
		border-bottom: 1px solid $bai-pale;
	}

	.settings-page__group2-text {
		color: $bai-ink;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 500;
	}
</style>

		padding-right: 48rpx;
		padding-bottom: 48rpx;
		flex-direction: column;
		justify-content: center;
	}

	/* 标题区 */
	.pay-page__heading {
		flex-direction: column;
		align-items: center;
		padding-bottom: 96rpx;
	}

	.pay-page__title {
		color: #e8ebe6;
		font-size: 96rpx;
		line-height: 104rpx;
		font-weight: 700;
		text-align: center;
	}

	.pay-page__subtitle {
		margin-top: 24rpx;

<template>
	<view class="pay-page">
		<!-- 返回按钮：固定近黑背景使用 arrow-back-light（夜间白色变体），定位规则与 BackButton 一致；
		     零高定位层限宽与主内容同口径，宽屏时按钮对齐内容列而非视口缘；
		     Web 端不渲染（浏览器自带返回，与 BackButton 同口径） -->
		<view class="pay-page__back-cap">
			<!-- #ifndef WEB -->
			<view class="pay-page__back" :style="'top:' + backTop + 'px'" @click="goBack">
				<image class="pay-page__back-icon" src="/static/icons/arrow-back-light.svg" mode="aspectFit" />
			</view>
			<!-- #endif -->
		</view>

		<!-- 主内容：标题区 / 权益卡 / 价格区（单屏布局，无滚动） -->
		<view class="pay-page__main" :style="'padding-top:' + mainTop + 'px'">
			<view class="pay-page__heading">
				<text class="pay-page__title">{{ t('memberpay.planName') }}</text>
				<text class="pay-page__subtitle">{{ t('memberpay.subtitle') }}</text>
			</view>

			<view class="pay-page__perks">
				<view class="pay-page__perk">
					<text class="pay-page__perk-title">{{ t('memberpay.perk1Title') }}</text>
					<text class="pay-page__perk-text">{{ t('memberpay.perk1Text') }}</text>
				</view>
				<view class="pay-page__perk pay-page__perk--second">
					<text class="pay-page__perk-title">{{ t('memberpay.perk2Title') }}</text>
					<text class="pay-page__perk-text">{{ t('memberpay.perk2Text') }}</text>
				</view>
			</view>

			<view class="pay-page__pricing">
				<view class="pay-page__price-row">
					<!-- #ifdef APP -->
					<text class="pay-page__price">¥6</text>
					<!-- #endif -->
					<!-- #ifdef MP-WEIXIN -->
					<text class="pay-page__price">1 {{ t('memberpay.coin') }}</text>
					<!-- #endif -->
					<text class="pay-page__price-unit">{{ t('memberpay.priceUnit') }}</text>
				</view>
				<view class="pay-page__price-meta">
					<!-- #ifdef APP -->
					<text class="pay-page__price-origin">{{ t('memberpay.priceOriginApp') }}</text>
					<!-- #endif -->
					<!-- #ifdef MP-WEIXIN -->
					<text class="pay-page__price-origin">{{ t('memberpay.priceOriginMp') }}</text>
					<!-- #endif -->
					<view class="pay-page__pill">
						<text class="pay-page__pill-text">{{ t('memberpay.save') }}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 底部操作区：APP 端纯展示（应用商店内购待接入）；微信小程序端点击弹出支付确认卡 -->
		<view class="pay-page__action">
			<!-- #ifdef APP -->
			<view class="pay-page__btn" hover-class="pay-page__btn--hover" :hover-stay-time="70">
				<text class="pay-page__btn-text">{{ t('memberpay.subscribe') }}</text>
			</view>
			<!-- #endif -->
			<!-- #ifdef MP-WEIXIN -->
			<view class="pay-page__btn" hover-class="pay-page__btn--hover" :hover-stay-time="70" @click="openPaySheet">
				<text class="pay-page__btn-text">{{ t('memberpay.subscribe') }}</text>
			</view>
			<!-- #endif -->
			<!-- #ifdef APP -->
			<text class="pay-page__safe-tip">{{ t('memberpay.safeApp') }}</text>
			<!-- #endif -->
			<!-- #ifdef MP-WEIXIN -->
			<text class="pay-page__safe-tip">{{ t('memberpay.safeMp') }}</text>
			<!-- #endif -->
		</view>

		<!-- #ifdef MP-WEIXIN -->
		<!-- 支付确认卡片（底部滑出半屏，标准支付布局）：商品信息 / 支付金额 / 支付方式 / 确认按钮 -->
		<view v-if="paySheetOpen" class="pay-sheet__mask" @click="closePaySheet">
			<view class="pay-sheet" @click.stop>
				<view class="pay-sheet__header">
					<text class="pay-sheet__title">{{ t('memberpay.sheetTitle') }}</text>
					<text class="pay-sheet__close" @click="closePaySheet">×</text>
				</view>
				<view class="pay-sheet__goods">
					<text class="pay-sheet__goods-name">{{ t('memberpay.goodsName') }}</text>
					<text class="pay-sheet__goods-desc">{{ t('memberpay.goodsDesc') }}</text>
				</view>
				<view class="pay-sheet__row">
					<text class="pay-sheet__label">{{ t('memberpay.durationLabel') }}</text>
					<view class="pay-sheet__stepper">
						<view class="pay-sheet__step-btn" :class="months <= 1 ? 'pay-sheet__step-btn--disabled' : ''" @click="changeMonths(-1)">
							<text class="pay-sheet__step-text">−</text>
						</view>
						<text class="pay-sheet__months">{{ tf('memberpay.monthsN', [months.toString()]) }}</text>
						<view class="pay-sheet__step-btn" :class="months >= 12 ? 'pay-sheet__step-btn--disabled' : ''" @click="changeMonths(1)">
							<text class="pay-sheet__step-text">+</text>
						</view>
					</view>
				</view>
				<view class="pay-sheet__row">
					<text class="pay-sheet__label">{{ t('memberpay.amountLabel') }}</text>
					<view class="pay-sheet__amount">
						<image class="pay-sheet__coin-icon" src="/static/icons/coin-gold.svg" mode="aspectFit" />
						<text class="pay-sheet__amount-num">{{ tf('memberpay.coinsN', [months.toString()]) }}</text>
					</view>
				</view>
				<view class="pay-sheet__row">
					<text class="pay-sheet__label">{{ t('memberpay.methodLabel') }}</text>
					<text class="pay-sheet__value">{{ tf('memberpay.balanceN', [balanceGold.toString()]) }}</text>
				</view>
				<view class="pay-sheet__btn" hover-class="pay-sheet__btn--hover" :hover-stay-time="70" @click="confirmPay">
					<text class="pay-sheet__btn-text">{{ payBtnText }}</text>
				</view>
				<text class="pay-sheet__tip">{{ tf('memberpay.sheetTip', [months.toString()]) }}</text>
			</view>
		</view>

		<!-- 全屏支付成功卡片：订单明细 + 确认返回活动页 -->
		<view v-if="successOpen" class="pay-success">
			<view class="pay-success__body">
				<view class="pay-success__icon">
					<text class="pay-success__icon-check">✓</text>
				</view>
				<text class="pay-success__title">{{ t('memberpay.successTitle') }}</text>
				<view class="pay-success__info">
					<view class="pay-success__row">
						<text class="pay-success__label">{{ t('memberpay.successItemLabel') }}</text>
						<text class="pay-success__value">{{ tf('memberpay.successPlanN', [successMonths.toString()]) }}</text>
					</view>
					<view class="pay-success__row">
						<text class="pay-success__label">{{ t('memberpay.successAmountLabel') }}</text>
						<text class="pay-success__value pay-success__value-accent">{{ tf('memberpay.successCoinsN', [successGold.toString()]) }}</text>
					</view>
					<view class="pay-success__row">
						<text class="pay-success__label">{{ t('memberpay.successUntilLabel') }}</text>
						<text class="pay-success__value">{{ successExpires }}</text>
					</view>
				</view>
			</view>
			<view class="pay-success__btn" hover-class="pay-success__btn--hover" :hover-stay-time="70" @click="confirmSuccess">
				<text class="pay-success__btn-text">{{ t('common.confirm') }}</text>
			</view>
		</view>
		<!-- #endif -->
	</view>
</template>

<script setup lang="uts">
	/**
	 * 会员支付页（member-pay.uvue）
	 * --------------------------------------------------------------------------
	 * - APP 端：纯静态展示（权益卡/价格/订阅按钮），应用商店内购待接入
	 * - 微信小程序端：金币支付通道——「立即订阅」弹出支付确认卡，确认后调
	 *   POST /api/v1/membership/purchase（计价 1 金币/月、单月按 31 天计为服务端真源，
	 *   后端扣金币并调 auth 授 iron 角色续费顺延）
	 * - 入口：APP 端「我的」页会员卡「立即抢购」；微信小程序端活动页补签
	 *   提示条「查看」（补签权益引导购买月卡）
	 * - 固定深色皮肤：支付相关区块（含支付确认卡）按约定保留原支付配色
	 *   （#0e0f0c 页底 / #2f3131 卡底 + #e2e2e2 描边 / #acf67c 亮绿强调，不随 bai 主题令牌更换）
	 */
	import { fetchActivitySummary } from '@/api/activity.uts'
	import { purchaseMembership } from './api/membership.uts'
	import { ApiResponse, forceRefreshToken } from '@/utils/request.uts'
	import { t, tf } from '@/utils/i18n.uts'
	// 词典注册（memberpay 页文案 + 公共段）
	import '@/pages/user/locales/memberpay.uts'
	import '@/utils/locales/common.uts'

	// 原生导航栏标题随语言切换（本页未启用自定义导航样式）
	onShow(() => {
		uni.setNavigationBarTitle({ title: t('memberpay.title') })
	})

	/** 顶部定位：返回按钮取状态栏高度，内容再避让 */
	const backTop = ref(44)
	const mainTop = ref(90)
	const win = uni.getWindowInfo()
	if (win.statusBarHeight > 0) {
		backTop.value = win.statusBarHeight - 5 + win.windowHeight * 0.006
		mainTop.value = win.statusBarHeight + 90
	}

	/** 返回上一页：页面栈为空（如分享直达）时回退首页 */
	function goBack() : void {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({ delta: 1 })
		} else {
			uni.reLaunch({ url: '/pages/index/index' })
		}
	}

	// #ifdef MP-WEIXIN
	/** 支付确认卡显隐 / 支付进行中锁 / 金币余额（确认卡打开时拉取，支付后以返回值刷新） */
	const paySheetOpen = ref(false)
	const paying = ref(false)
	const balanceGold = ref(0)
	/** 购买月数（默认 1，步进范围 1~12，与后端 schema 上限一致） */
	const months = ref(1)
	/** 全屏支付成功卡片显隐与订单明细（支付成功后展示，确认后返回活动页） */
	const successOpen = ref(false)
	const successMonths = ref(1)
	const successGold = ref(1)
	const successExpires = ref('')

	/** 支付按钮文案：支付中 / 金币不足 / 可支付 */
	const payBtnText = computed((): string => {
		if (paying.value) {
			return t('memberpay.paying')
		}
		return balanceGold.value >= months.value ? t('memberpay.confirmPay') : t('memberpay.insufficient')
	})

	/** 调整购买月数（步进钳位 1~12；支付中不可调） */
	function changeMonths(delta: number) : void {
		if (paying.value) {
			return
		}
		const next = months.value + delta
		if (next < 1 || next > 12) {
			return
		}
		months.value = next
	}

	/**
	 * 从活动 summary 响应中提取金币余额并刷新
	 * uts2js（小程序/H5）的 UTSJSONObject 无 getJSONObject 方法，
	 * 嵌套取值一律索引访问 + 判空 + as 转换（与 request.uts 同构）
	 */
	function applyGoldBalance(res: ApiResponse) : void {
		if (res.code == 0 && res.data != null) {
			const data = res.data!
			const balanceRaw = data['balance']
			if (balanceRaw != null) {
				const b = balanceRaw as UTSJSONObject
				const gold = b['gold']
				balanceGold.value = gold == null ? 0 : gold as number
			}
		}
	}

	/** 打开支付确认卡（月数重置为 1，同步拉取金币余额展示） */
	function openPaySheet() : void {
		months.value = 1
		paySheetOpen.value = true
		paying.value = false
		fetchActivitySummary().then((res: ApiResponse) => {
			applyGoldBalance(res)
		}, (_e: Error) => {
			// 余额拉取失败保持当前值；确认支付时服务端仍强校验余额
		})
	}

	/** 关闭支付确认卡（支付中禁止关闭防重复扣币） */
	function closePaySheet() : void {
		if (paying.value) {
			return
		}
		paySheetOpen.value = false
	}

	/** 确认支付：金币购买黑铁会员（月数×单价，价格/时长服务端真源） */
	function confirmPay() : void {
		if (paying.value) {
			return
		}
		if (balanceGold.value < months.value) {
			uni.showToast({ title: t('memberpay.insufficientToast'), icon: 'none' })
			return
		}
		paying.value = true
		purchaseMembership(months.value).then((res: ApiResponse) => {
			paying.value = false
			if (res.code == 0 && res.data != null) {
				const data = res.data!
				const balanceRaw = data['balance']
				if (balanceRaw != null) {
					const b = balanceRaw as UTSJSONObject
					const gold = b['gold']
					balanceGold.value = gold == null ? 0 : gold as number
				}
				// 到期时间为 ISO 字符串（无时区后缀），展示日期部分
				const expiresAtRaw = data['expires_at']
				const expiresAt = expiresAtRaw == null ? '' : expiresAtRaw as string
				successMonths.value = data.getNumber('months') ?? months.value
				successGold.value = data.getNumber('amount_gold') ?? months.value
				successExpires.value = expiresAt.length >= 10 ? expiresAt.substring(0, 10) : ''
				paySheetOpen.value = false
				successOpen.value = true
			}
		}, (e: Error) => {
			paying.value = false
			uni.showToast({ title: e.message, icon: 'none' })
			// 授权失败金币已自动退款，重新拉取余额回正
			fetchActivitySummary().then((res: ApiResponse) => {
				applyGoldBalance(res)
			}, (_e: Error) => {
			})
		})
	}

	/**
	 * 成功卡片确认：先主动刷新令牌（购买已触发 auth 撤销扇出，旧令牌会被判失效，
	 * 刷新后新令牌携带会员角色），再返回活动页；刷新失败不阻塞返回
	 * （既有 401 静默刷新链路仍兜底）
	 */
	function confirmSuccess() : void {
		successOpen.value = false
		forceRefreshToken().then((_ok: boolean) => {
			const pages = getCurrentPages()
			if (pages.length > 1) {
				uni.navigateBack({ delta: 1 })
			} else {
				uni.reLaunch({ url: '/pages/reading/reward' })
			}
		})
	}
	// #endif

	// 微信小程序分享：转发好友与朋友圈（封面统一 /static/share-cover.png，复制自 yao 项目）
	// #ifdef MP-WEIXIN
	onShareAppMessage(() => {
		return { title: t('memberpay.title'), imageUrl: '/static/share-cover.png' }
	})
	onShareTimeline(() => {
		return { title: t('memberpay.title'), imageUrl: '/static/share-cover.png' }
	})
	// #endif
</script>

<style lang="scss">
	/* 支付相关区块：保留原支付固定配色（近黑底 + 亮绿强调），不使用 $bai 主题令牌 */
	.pay-page {
		flex: 1;
		box-sizing: border-box;
		background-color: #0e0f0c;
		flex-direction: column;
	}

	/* ===== 返回按钮（零高定位层：限宽与主内容同口径，Web 480 / 其余 750） ===== */
	.pay-page__back-cap {
		width: 100%;
		/* #ifdef WEB */
		max-width: 480px;
		/* #endif */
		/* #ifndef WEB */
		max-width: 750px;
		/* #endif */
		margin-left: auto;
		margin-right: auto;
		position: relative;
		/* 零高层显式放开裁剪（uni-h5 view 基础样式默认 hidden），否则 absolute 按钮不可见 */
		overflow: visible;
	}

	.pay-page__back {
		position: absolute;
		left: 48rpx;
		z-index: 10;
		width: 80rpx;
		height: 80rpx;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.pay-page__back-icon {
		width: 80rpx;
		height: 80rpx;
	}

	/* ===== 主内容（宽屏限宽居中，与 PageShell 画布同口径：Web 480 / 其余 750） ===== */
	.pay-page__main {
		flex: 1;
		width: 100%;
		/* #ifdef WEB */
		max-width: 480px;
		/* #endif */
		/* #ifndef WEB */
		max-width: 750px;
		/* #endif */
		margin-left: auto;
		margin-right: auto;
		box-sizing: border-box;
		padding-left: 48rpx;
		padding-right: 48rpx;
		padding-bottom: 48rpx;
		flex-direction: column;
		justify-content: center;
	}

	/* 标题区 */
	.pay-page__heading {
		flex-direction: column;
		align-items: center;
		padding-bottom: 96rpx;
	}

	.pay-page__title {
		color: #e8ebe6;
		font-size: 96rpx;
		line-height: 104rpx;
		font-weight: 700;
		text-align: center;
	}

	.pay-page__subtitle {
		margin-top: 24rpx;
		color: #c4c7c3;
		font-size: 40rpx;
		line-height: 60rpx;
		font-weight: 400;
		text-align: center;
	}

	/* ===== 权益卡 ===== */
	.pay-page__perks {
		flex-direction: column;
	}

	.pay-page__perk {
		box-sizing: border-box;
		padding: 32rpx;
		border-radius: 24rpx;
		background-color: #2f3131;
		border: 1px solid #e2e2e2;
		flex-direction: column;
	}

	.pay-page__perk--second {
		margin-top: 24rpx;
	}

	.pay-page__perk-title {
		color: #acf67c;
		font-size: 40rpx;
		line-height: 64rpx;
		font-weight: 600;
		padding-bottom: 8rpx;
	}

	.pay-page__perk-text {
		color: #c4c7c3;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}

	/* ===== 价格区 ===== */
	.pay-page__pricing {
		margin-top: 48rpx;
		padding: 32rpx 0;
		flex-direction: column;
	}

	.pay-page__price-row {
		flex-direction: row;
		justify-content: center;
		align-items: flex-end;
	}

	.pay-page__price {
		color: #acf67c;
		font-size: 128rpx;
		line-height: 128rpx;
		font-weight: 700;
	}

	.pay-page__price-unit {
		margin-left: 16rpx;
		color: #c4c7c3;
		font-size: 48rpx;
		line-height: 64rpx;
		font-weight: 400;
		padding-bottom: 4rpx;
	}

	/* 价格下行：原价（删除线）+ 限时胶囊 */
	.pay-page__price-meta {
		margin-top: 16rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.pay-page__price-origin {
		color: #868685;
		font-size: 28rpx;
		line-height: 28rpx;
		font-weight: 400;
		text-decoration: line-through;
	}

	.pay-page__pill {
		margin-left: 16rpx;
		height: 56rpx;
		box-sizing: border-box;
		padding: 0 24rpx;
		border-radius: 9999px;
		background-color: #2d3d23;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.pay-page__pill-text {
		color: #acf67c;
		font-size: 26rpx;
		line-height: 32rpx;
		font-weight: 400;
	}

	/* ===== 底部操作区 ===== */
	.pay-page__action {
		padding: 24rpx 48rpx;
		padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
		box-sizing: border-box;
		flex-direction: column;
	}

	.pay-page__btn {
		height: 128rpx;
		border-radius: 24rpx;
		background-color: #acf67c;
		box-shadow: 0 0 40px -10px rgba(172, 246, 124, 0.4);
		flex-direction: row;
		align-items: center;
		justify-content: center;
		transition: opacity 0.2s, transform 0.1s;
	}

	/* 按压态：对应设计稿 hover opacity 0.8 / click scale 0.95 */
	.pay-page__btn--hover {
		opacity: 0.8;
		transform: scale(0.95);
	}

	.pay-page__btn-text {
		color: #092100;
		font-size: 48rpx;
		line-height: 64rpx;
		font-weight: 400;
	}

	.pay-page__safe-tip {
		margin-top: 32rpx;
		color: #868685;
		font-size: 24rpx;
		line-height: 32rpx;
		font-weight: 400;
		text-align: center;
	}

	/* ===== 支付确认卡片（MP-WEIXIN：底部滑出半屏；配色随页面深色支付皮肤统一：
	          #2f3131 卡底 + #e2e2e2 描边 + #acf67c 亮绿强调 + 灰阶文字，不用 $bai 主题令牌） ===== */
	.pay-sheet__mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.55);
		z-index: 60;
		flex-direction: column;
		justify-content: flex-end;
	}

	.pay-sheet {
		box-sizing: border-box;

		line-height: 60rpx;
		font-weight: 400;
		text-align: center;
	}

	/* ===== 权益卡 ===== */
	.pay-page__perks {
		flex-direction: column;
	}

	.pay-page__perk {
		box-sizing: border-box;
		padding: 32rpx;
		border-radius: 24rpx;
		background-color: #2f3131;
		border: 1px solid #e2e2e2;
		flex-direction: column;
	}

	.pay-page__perk--second {
		margin-top: 24rpx;
	}

	.pay-page__perk-title {
		color: #acf67c;
		font-size: 40rpx;
		line-height: 64rpx;
		font-weight: 600;
		padding-bottom: 8rpx;
	}

	.pay-page__perk-text {
		color: #c4c7c3;
		font-size: 32rpx;
		line-height: 48rpx;
		font-weight: 400;
	}

	/* ===== 价格区 ===== */
	.pay-page__pricing {
		margin-top: 48rpx;
		padding: 32rpx 0;
		flex-direction: column;
	}

	.pay-page__price-row {
		flex-direction: row;
		justify-content: center;
		align-items: flex-end;
	}

	.pay-page__price {
		color: #acf67c;
		font-size: 128rpx;
		line-height: 128rpx;
		font-weight: 700;
	}

	.pay-page__price-unit {
		margin-left: 16rpx;
		color: #c4c7c3;
		font-size: 48rpx;
		line-height: 64rpx;
		font-weight: 400;
		padding-bottom: 4rpx;
	}

	/* 价格下行：原价（删除线）+ 限时胶囊 */
	.pay-page__price-meta {
		margin-top: 16rpx;
		flex-direction: row;
		justify-content: center;
		align-items: center;
	}

	.pay-page__price-origin {
		color: #868685;
		font-size: 28rpx;
		line-height: 28rpx;
		font-weight: 400;
		text-decoration: line-through;
	}

	.pay-page__pill {
		margin-left: 16rpx;
		height: 56rpx;
		box-sizing: border-box;
		padding: 0 24rpx;
		border-radius: 9999px;
		background-color: #2d3d23;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.pay-page__pill-text {
		color: #acf67c;
		font-size: 26rpx;
		line-height: 32rpx;
		font-weight: 400;
	}

	/* ===== 底部操作区 ===== */
	.pay-page__action {
		padding: 24rpx 48rpx;
		padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
		box-sizing: border-box;
		flex-direction: column;
	}

	.pay-page__btn {
		height: 128rpx;
		border-radius: 24rpx;
		background-color: #acf67c;
		box-shadow: 0 0 40px -10px rgba(172, 246, 124, 0.4);
		flex-direction: row;
		align-items: center;
		justify-content: center;
		transition: opacity 0.2s, transform 0.1s;
	}

	/* 按压态：对应设计稿 hover opacity 0.8 / click scale 0.95 */
	.pay-page__btn--hover {
		opacity: 0.8;
		transform: scale(0.95);
	}

	.pay-page__btn-text {
		color: #092100;
		font-size: 48rpx;
		line-height: 64rpx;
		font-weight: 400;
	}

	.pay-page__safe-tip {
		margin-top: 32rpx;
		color: #868685;
		font-size: 24rpx;
		line-height: 32rpx;
		font-weight: 400;
		text-align: center;
	}

	/* ===== 支付确认卡片（MP-WEIXIN：底部滑出半屏；配色随页面深色支付皮肤统一：
	          #2f3131 卡底 + #e2e2e2 描边 + #acf67c 亮绿强调 + 灰阶文字，不用 $bai 主题令牌） ===== */
	.pay-sheet__mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.55);
		z-index: 60;
		flex-direction: column;
		justify-content: flex-end;
	}

	.pay-sheet {
		box-sizing: border-box;
		padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
		background-color: #2f3131;
		border: 1px solid #e2e2e2;
		border-top-left-radius: 24rpx;
		border-top-right-radius: 24rpx;
		flex-direction: column;
	}

	.pay-sheet__header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.pay-sheet__title {
		font-size: 31rpx;
		line-height: 44rpx;
		font-weight: 900;
		color: #e8ebe6;
	}

	.pay-sheet__close {
		font-size: 40rpx;
		line-height: 44rpx;
		color: #868685;
		padding: 0 8rpx;
	}

	/* 商品信息块（页面底色沉一层，与卡底形成层级） */
	.pay-sheet__goods {
		margin-top: 32rpx;
		padding: 24rpx;
		border-radius: 16rpx;
		background-color: #0e0f0c;
		flex-direction: column;
	}

	.pay-sheet__goods-name {
		font-size: 27rpx;
		line-height: 38rpx;
		font-weight: 600;
		color: #e8ebe6;
	}

	.pay-sheet__goods-desc {
		margin-top: 6rpx;
		font-size: 23rpx;
		line-height: 33rpx;
		color: #868685;
	}

	/* 标签行：左标签右值（支付金额 / 支付方式） */
	.pay-sheet__row {
		margin-top: 24rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.pay-sheet__label {
		font-size: 25rpx;
		line-height: 36rpx;
		color: #c4c7c3;
	}

	.pay-sheet__value {
		font-size: 25rpx;
		line-height: 36rpx;
		font-weight: 600;
		color: #e8ebe6;
	}

	.pay-sheet__amount {
		flex-direction: row;
		align-items: center;
	}

	.pay-sheet__coin-icon {

/**
 * 会员购买接口（直连本项目后端）
 * --------------------------------------------------------------------------
 * - 金币购买黑铁会员月卡（微信小程序金币支付通道），需登录态
 * - 计价与时长由服务端真源下发（1 金币 / 30 天），前端不可传价格
 * - silent：未登录/令牌过期 401 不跳转登录页（动作前调用点已有登录校验）
 */
import { request, ApiResponse, RequestOptions } from '@/utils/request.uts'
import { API_BASE_URL } from '@/utils/config.uts'

/** 金币购买黑铁会员（months=购买月数 1~12；余额不足/授权失败后端 400，授权失败金币自动退回） */
export function purchaseMembership(months: number) : Promise<ApiResponse> {
	const data = {} as UTSJSONObject
	data['months'] = months
	return request({
		url: '/api/v1/membership/purchase',
		method: 'POST',
		data: data,
		auth: true,
		timeout: 15000,
		baseUrl: API_BASE_URL,
		silent: true
	} as RequestOptions)
}

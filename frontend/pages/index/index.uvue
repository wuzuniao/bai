<template>
	<view class="page">
		<scroll-view class="scroll" direction="vertical" :show-scrollbar="false" @scroll="onScrollClear">
			<view class="main" :style="'padding-top:' + topInset + 'px'">
				<!-- 诗文卡片（令牌 poem-card: 白底 圆角 xl 24px 内边距 24x16） -->
				<view class="poem-card" :style="cardStyle">
					<!-- 诗文主体：渲染行模型（窄屏 16 行每行 7 字；宽屏 8 行每行一句=并置两个笔记行 16 单元），
					     单元 id 恒按笔记行号编码（poem-unit-<origin>-<col>），划词协议跨模式一致 -->
					<view class="poem-body">
						<view
							v-for="(rl, ri) in renderLines"
							:key="ri"
							class="poem-line"
							:class="rl.gapClass"
							:id="'poem-line-' + ri"
							@longpress="onLineLongPress(ri, $event)"
							@click="onPoemTap(ri, $event)"
						>
							<view
								v-for="(sb, si) in rl.selStyles"
								:key="'s' + si"
								class="poem-sel-band"
								:style="sb"
							></view>
							<view
								v-for="(ub, ui) in rl.underlineStyles"
								:key="'u' + ui"
								class="poem-line-band poem-line-band-underline"
								:style="ub"
							></view>
							<view
								v-for="(tb, ti) in rl.thoughtStyles"
								:key="'t' + ti"
								class="poem-line-band poem-line-band-thought"
								:style="tb"
							></view>
							<view
								v-for="(u, ci) in rl.units"
								:key="ci"
								class="poem-unit"
								:class="u.isPunct ? 'poem-unit--punct' : ''"
								:style="u.unitStyle"
								:id="'poem-unit-' + u.origin + '-' + u.col"
							>
								<text class="poem-pinyin" :style="u.pinyinStyle">{{ u.isPunct ? '' : u.pinyin }}</text>
								<text v-if="u.isPunct" class="poem-punct" :style="u.textStyle">{{ u.punct }}</text>
								<text v-else class="poem-char" :style="u.textStyle">{{ u.char }}</text>
							</view>
						</view>
					</view>
					<!-- 底部铭文（令牌: 元信息用思源黑体 11px 灰色，宋体仅限诗句正文） -->
						<text class="inscription">《无题》无足鸟著 2017年2月</text>
				</view>
			</view>
		</scroll-view>
		<BottomNavBar active="home" />
		<!-- 划词气泡（复用阅读页 SelectionPopover：选区/手柄拖动与五项动作内聚；划线/想法写首页诗虚拟书 0，
		     锚点实测与拖动行矩形由本页查询回传，选区变化经 spanChanged 镜像驱动行内高亮） -->
		<SelectionPopover
			ref="popoverRef"
			:bg="popoverBg"
			:nav-top="topInset"
			:page-w="pageW"
			:quote-align="true"
			:thought-card-max-w="thoughtCardMaxW"
			:page-h="pageH"
			:metrics="poemMetrics"
			:segs="selSegs"
			:text="selText"
			:share-ctx="shareCtx"
			:logo-src="shareLogoSrc"
			:quote-color="quoteColor"
			:panel-bg="panelBg"
			:content-color="contentColor"
			:shadow="panelShadow"
			@sync="onPopoverSync"
			@dismiss="clearSelection"
			@toast="showToast"
			@span-changed="onSpanChanged"
			@drag-started="onDragStarted"
			@query-anchors="measureAnchors"
		/>
		<!-- 全局信息提示（复制/查询等动作反馈，固定日间样式） -->
		<ReaderToast ref="toastRef" :night="false" />
	</view>
</template>

<script setup lang="uts">
	import BottomNavBar from '@/components/common/BottomNavBar.uvue'
	import SelectionPopover from '@/components/selection/SelectionPopover.uvue'
	import ReaderToast from '@/components/reader/ReaderToast.uvue'
	import { READER_THEME_LIGHT } from '@/utils/theme.uts'
	import { useUserStore, avatarSrcOf } from '@/stores/user.uts'
	import { SelSpan, SpanSeg, TextMetrics, ParaRect, ShareQuoteCtx, Thought, UnderlineEntry, Paragraph, normalizeSpan, setActiveBookId, loadUnderlines, loadThoughts, fetchNotesToCache, VIRTUAL_BOOK_ID, SENTENCE_END_CHARS, thoughtAt, spanOfThought, thoughtTextOfSpan, buildSpanSegs } from '@/utils/readerTypes.uts'
	import { POEM_LINES, PoemLine } from '@/utils/poem.uts'
	import { scheduleResizeReload } from '@/utils/layout.uts'
	import { t } from '@/utils/i18n.uts'
	// 词典注册（首页文案；诗词内容不翻译）
	import '@/utils/locales/index.uts'
	import '@/utils/locales/common.uts'

	/** 诗文内容（8 联 16 行，逐字拼音取自设计稿，数据真源 utils/poem.uts） */
	const poemLines = ref<PoemLine[]>(POEM_LINES)

	/** 顶部留白：设计稿 48px 含状态栏，优先取系统状态栏高度（Web 端回退 48px） */
	const topInset = ref(48)
	/** 页面尺寸（px，气泡钳制与子组件布局） */
	const pageW = ref(0)
	const pageH = ref(0)
	// 窗口信息 setup 顶层同步初始化：划词气泡组件 setup 求值早于页面 onLoad，
	// 气泡单/双行判定与定位钳制依赖 pageW/pageH 就绪（与阅读页同模式）
	{
		const win = uni.getWindowInfo()
		let top = 48
		if (win.statusBarHeight > 0) {
			top = win.statusBarHeight + 1
		}
		// #ifdef MP-WEIXIN
		// 小程序端避开右上角胶囊按钮（胶囊规格：高 32px、top = 状态栏 + 4~8px，
		// 取状态栏 + 48 保证卡片顶部与胶囊底留 8~12px 间距）
		if (win.statusBarHeight > 0) {
			top = win.statusBarHeight + 48
		}
		// #endif
		topInset.value = top
		pageW.value = win.windowWidth
		pageH.value = win.windowHeight
	}

	/** 折叠屏展开/折叠、旋转、桌面拖宽：窗口尺寸变化后更新页面尺寸并重建排版度量（rpx 换算系数随窗口宽变化），
	 *  清除进行中的选区。App 端暂无 onResize 事件，由 onShow 比对窗口尺寸兜底（回前台时尺寸已变则重标定） */
	function syncViewport() : void {
		const win = uni.getWindowInfo()
		if (win.windowWidth == pageW.value && win.windowHeight == pageH.value) {
			return
		}
		pageW.value = win.windowWidth
		pageH.value = win.windowHeight
		poemMetrics.value = buildPoemMetrics()
		clearSelection()
		// 微信端折叠切换自愈（其他端空实现）：布局残留错乱按新窗口重载
		scheduleResizeReload(pageW.value, '/pages/index/index')
	}
	// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
	onResize(() : void => {
		syncViewport()
	})
	// #endif

	// 微信小程序分享：转发好友与朋友圈（封面统一 /static/share-cover.png，复制自 yao 项目）
	// #ifdef MP-WEIXIN
	onShareAppMessage(() => {
		return { title: t('index.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	onShareTimeline(() => {
		return { title: t('index.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	// #endif

	onShow(() => {
		syncViewport()
		loadHomeNotes()
	})

	/** ===== 首页诗划词气泡（复用阅读页 SelectionPopover：选区/手柄/拖动与五项动作内聚组件） ===== */
	/** 诗行字符容量：7 字 + 行尾标点（选区/划线/想法统一坐标口径，标点占每行末位 idx=7） */
	const LINE_CHAR_COUNT = 8
	/** 诗行内容宽（rpx，行尾标点区右缘，窄屏选区/划线换算特判用） */
	const LINE_TEXT_W_RPX = 510

	/** 划词气泡与提示组件引用 */
	const popoverRef = ref<SelectionPopover | null>(null)
	const toastRef = ref<ReaderToast | null>(null)

	/** 气泡浮层配色（首页固定日间，取自阅读日间主题真源；panelBg 与阅读页想法面板同字段） */
	const popoverBg = READER_THEME_LIGHT.popoverBg
	const quoteColor = READER_THEME_LIGHT.mutedColor
	const panelBg = READER_THEME_LIGHT.thoughtPanelBg
	const contentColor = READER_THEME_LIGHT.titleColor
	const panelShadow = READER_THEME_LIGHT.panelShadow

	/** ===== 宽屏行合并（每行放一句）：窗口宽 ≥640px 时 16 行并置为 8 行（一行 = 一句 = 两个笔记行）。
	 *  判定基于窗口宽（诗卡突破内容列限宽自适应扩展）；微信小程序窗口宽不受页面控制，
	 *  窗口不变（约 390-470px）则恒窄屏。 */
	const WIDE_MIN_W = 640
	const WIDE_CARD_MAX_W = 720
	const WIDE_CARD_PAD = 24
	const isWide = computed(() : boolean => pageW.value >= WIDE_MIN_W)
	const wideCardW = computed(() : number => Math.min(pageW.value - 40, WIDE_CARD_MAX_W))
	const wideUnitW = computed(() : number => Math.floor((wideCardW.value - WIDE_CARD_PAD * 2) / (LINE_CHAR_COUNT * 2)))
	const cardStyle = computed(() : string => isWide.value ? 'width:' + wideCardW.value + 'px;padding:' + WIDE_CARD_PAD + 'px' : '')

	/** rpx→px 换算因子（按端派生，与 uni.upx2px 的冻结基准换算同式；
	 *  微信端原生 rpx=窗口宽/750；App 端 rpx 冻结上限 750；Web 端 rpx 冻结上限 480，因子须与
	 *  pages.json globalStyle 的冻结基准一致，否则划词换算与 CSS 渲染错位） */
	const rpxF = computed(() : number => {
		let base = pageW.value
		// #ifdef WEB
		base = Math.min(base, 480)
		// #endif
		// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
		base = Math.min(base, 750)
		// #endif
		return base / 750
	})

	/** 排版度量构建（划词换算，窄屏）：诗行单行无缩进，行盒高 = 拼音区 27rpx + 汉字行高 50rpx = 77rpx；
	 *  字步进 69rpx（单元 54 + 右距 15）均匀映射前 7 列，行尾标点区 27rpx 收敛于末列；
	 *  perLine 借用阅读页「首行容量 = perLine - 2」公式：首页无缩进容量恒满行，取行字符数 + 2，
	 *  使拖动映射的行数钳制恒为 0（否则行底触点会被误判到第二行、字符恒收敛到行尾标点，手柄不跟字） */
	function buildPoemMetrics() : TextMetrics {
		const f = rpxF.value
		return {
			perLine: LINE_CHAR_COUNT + 2,
			lineH: 77 * f,
			charW: 69 * f,
			fullCharW: 69 * f,
			indentPx: 0
		} as TextMetrics
	}
	/** 排版度量（computed：窗口尺寸变化后随 isWide/单元宽重建，rpx 换算系数随窗口宽变化） */
	const poemMetrics = computed<TextMetrics>(() : TextMetrics => {
		if (!isWide.value) {
			return buildPoemMetrics()
		}
		// 宽屏合并行：行盒高 = 拼音区 + 汉字行高，单元等宽无右距
		return {
			perLine: LINE_CHAR_COUNT * 2 + 2,
			lineH: widePinyinLH.value + wideCharLH.value,
			charW: wideUnitW.value,
			fullCharW: wideUnitW.value,
			indentPx: 0
		} as TextMetrics
	})

	/** 想法查看卡片宽度上限（px）：诗行正文宽——窄屏行宽 510rpx（7 字步进 69rpx + 标点 27rpx，
	 *  与划线条带换算同口径）、宽屏合并行 16 单元宽；正文在页面内居中，卡片居中即与正文对齐 */
	const thoughtCardMaxW = computed(() : number => {
		if (!isWide.value) {
			return LINE_TEXT_W_RPX * rpxF.value
		}
		return wideUnitW.value * (LINE_CHAR_COUNT * 2)
	})

	/** ===== 渲染行模型（窄屏与宽屏同一套模板/协议） ===== */
	type PoemRenderUnit = {
		/** 笔记行号（origin 空间 0-15，单元 id 与划线/想法数据按此编码） */
		origin : number
		/** origin 内字符列（0-6 字 / 7 标点） */
		col : number
		char : string
		pinyin : string
		punct : string
		isPunct : boolean
		unitStyle : string
		pinyinStyle : string
		textStyle : string
	}
	type PoemRenderLine = {
		units : PoemRenderUnit[]
		gapClass : string
		/** 条带样式串（renderLines 内预计算：选区高亮/划线/想法，宽屏合并行内两 origin 各一段） */
		selStyles : string[]
		underlineStyles : string[]
		thoughtStyles : string[]
	}

	/** 宽屏单元内联样式（覆盖窄屏 rpx CSS：等宽单元无右距，字号/行高随单元宽派生——
	 *  触发阈值到卡片上限之间窗口跨度大，固定 px 会在窄内容列溢出单元）。
	 *  标点排版：标点单元贴单元底（flex-end），底部与汉字底对齐（无下坠区） */
	const wideCharFs = computed(() : number => Math.round(wideUnitW.value * 0.8))
	const widePinyinFs = computed(() : number => Math.max(10, Math.round(wideUnitW.value * 0.32)))
	const wideCharLH = computed(() : number => Math.round(wideUnitW.value * 1.24))
	const widePinyinLH = computed(() : number => Math.max(12, Math.round(wideUnitW.value * 0.48)))
	const wideUnitStyle = computed(() : string => 'width:' + wideUnitW.value + 'px;margin-right:0px')
	const widePinyinStyle = computed(() : string => 'width:100%;text-align:center;font-size:' + widePinyinFs.value + 'px;line-height:' + widePinyinLH.value + 'px;padding-top:0px;padding-bottom:0px')
	const wideCharStyle = computed(() : string => 'font-size:' + wideCharFs.value + 'px;line-height:' + wideCharLH.value + 'px')
	const widePunctStyle = computed(() : string => 'font-size:' + wideCharFs.value + 'px;line-height:' + wideCharLH.value + 'px')
	/** 宽屏标点单元：贴单元底（与汉字底对齐），显式高度覆盖窄屏修饰类的 38rpx 定高（防大字号被裁剪成小点） */
	const widePunctUnitStyle = computed(() : string => 'width:' + wideUnitW.value + 'px;margin-right:0px;justify-content:flex-end;height:' + (widePinyinLH.value + wideCharLH.value) + 'px;padding-bottom:0px')

	/** 渲染行条带样式预计算（vapor 模板对「函数调用作 v-for 源」的循环变量遮蔽不可靠，
	 *  条带样式在 computed 内算好，模板仅遍历数据属性） */
	type PoemLineBands = {
		sel : string[]
		underline : string[]
		thought : string[]
	}

	function bandStylesForUnits(units : PoemRenderUnit[]) : PoemLineBands {
		const origins : number[] = [] as number[]
		for (const u of units) {
			if (origins.indexOf(u.origin) < 0) {
				origins.push(u.origin)
			}
		}
		const sel : string[] = [] as string[]
		const underline : string[] = [] as string[]
		const thought : string[] = [] as string[]
		for (const origin of origins) {
			let s = -1
			let e = -1
			for (let i = 0; i < units.length; i++) {
				if (units[i].origin == origin) {
					if (s < 0) {
						s = i
					}
					e = i
				}
			}
			const r = lineSelRange(origin)
			if (r != null) {
				sel.push(selBandStyleOf(s + r[0], s + r[1]))
			}
			for (const b of lineUnderlineBands(origin)) {
				underline.push(decoBandStyleOf(s + b[0], s + b[1]))
			}
			for (const b of lineThoughtBands(origin)) {
				thought.push(decoBandStyleOf(s + b[0], s + b[1]))
			}
		}
		return { sel: sel, underline: underline, thought: thought } as PoemLineBands
	}

	/** 渲染行序列：窄屏 = 16 行（每行 7 字 + 标点单元）；宽屏 = 8 行（每行一句 = 两笔记行并置 16 单元） */
	const renderLines = computed<PoemRenderLine[]>(() : PoemRenderLine[] => {
		const lines : PoemRenderLine[] = []
		const src = poemLines.value
		if (!isWide.value) {
			for (let li = 0; li < src.length; li++) {
				const line = src[li]
				const units : PoemRenderUnit[] = []
				for (let ci = 0; ci < line.chars.length; ci++) {
					units.push({ origin: li, col: ci, char: line.chars[ci].char, pinyin: line.chars[ci].pinyin, punct: '', isPunct: false, unitStyle: '', pinyinStyle: '', textStyle: '' } as PoemRenderUnit)
				}
				units.push({ origin: li, col: LINE_CHAR_COUNT - 1, char: '', pinyin: '', punct: line.punct, isPunct: true, unitStyle: '', pinyinStyle: '', textStyle: '' } as PoemRenderUnit)
				const bands = bandStylesForUnits(units)
				lines.push({ units: units, gapClass: li == 0 ? '' : (li % 2 == 1 ? 'poem-line-gap-inner' : 'poem-line-gap-outer'), selStyles: bands.sel, underlineStyles: bands.underline, thoughtStyles: bands.thought } as PoemRenderLine)
			}
			return lines
		}
		for (let k = 0; k * 2 + 1 < src.length; k++) {
			const a = src[k * 2]
			const b = src[k * 2 + 1]
			const units : PoemRenderUnit[] = []
			for (let ci = 0; ci < a.chars.length; ci++) {
				units.push({ origin: k * 2, col: ci, char: a.chars[ci].char, pinyin: a.chars[ci].pinyin, punct: '', isPunct: false, unitStyle: wideUnitStyle.value, pinyinStyle: widePinyinStyle.value, textStyle: wideCharStyle.value } as PoemRenderUnit)
			}
			units.push({ origin: k * 2, col: LINE_CHAR_COUNT - 1, char: '', pinyin: '', punct: a.punct, isPunct: true, unitStyle: widePunctUnitStyle.value, pinyinStyle: widePinyinStyle.value, textStyle: widePunctStyle.value } as PoemRenderUnit)
			for (let ci = 0; ci < b.chars.length; ci++) {
				units.push({ origin: k * 2 + 1, col: ci, char: b.chars[ci].char, pinyin: b.chars[ci].pinyin, punct: '', isPunct: false, unitStyle: wideUnitStyle.value, pinyinStyle: widePinyinStyle.value, textStyle: wideCharStyle.value } as PoemRenderUnit)
			}
			units.push({ origin: k * 2 + 1, col: LINE_CHAR_COUNT - 1, char: '', pinyin: '', punct: b.punct, isPunct: true, unitStyle: widePunctUnitStyle.value, pinyinStyle: widePinyinStyle.value, textStyle: widePunctStyle.value } as PoemRenderUnit)
			const bands = bandStylesForUnits(units)
			lines.push({ units: units, gapClass: k % 2 == 0 ? 'poem-line-gap-outer' : 'poem-line-gap-inner', selStyles: bands.sel, underlineStyles: bands.underline, thoughtStyles: bands.thought } as PoemRenderLine)
		}
		return lines
	})

	/** 划词选区镜像（选区真源在气泡组件，spanChanged 同步驱动行内高亮） */
	const selSpan = ref<SelSpan | null>(null)

	/** 划线/想法镜像（首页诗笔记：本地缓存即真源渲染 + 云端 book_id=0 静默跟随） */
	const underlines = ref<UnderlineEntry[]>([])
	const thoughts = ref<Thought[]>([])

	/** 诗行 → 段落提供者（行文本 = 7 字 + 行尾标点，长度恒 8；选区段序列与选区文本经共享 buildSpanSegs 消费） */
	function poemParasOf(cid : number) : Paragraph[] {
		const paras : Paragraph[] = []
		for (let li = 0; li < poemLines.value.length; li++) {
			paras.push({ text: lineText(li) } as Paragraph)
		}
		return paras
	}

	/** 行完整文本（7 字 + 行尾标点） */
	function lineText(li : number) : string {
		const line = poemLines.value[li]
		if (line == null) {
			return ''
		}
		let out = ''
		for (const c of line.chars) {
			out += c.char
		}
		return out + line.punct
	}

	/** 选区文本（跨行拼接，行间换行，与阅读页跨段口径一致） */
	function selectionText() : string {
		const s = selSpan.value
		if (s == null) {
			return ''
		}
		let out = ''
		for (const seg of buildSpanSegs(s, poemParasOf)) {
			if (seg.end < seg.start) {
				continue
			}
			if (out.length > 0) {
				out += '\n'
			}
			out += poemParasOf(seg.cid)[seg.origin].text.slice(seg.start, seg.end + 1)
		}
		return out
	}

	/** 选区派生数据（下行气泡组件：划线写入按段序列、复制/写想法按文本） */
	const selSegs = computed<SpanSeg[]>(() : SpanSeg[] => {
		const s = selSpan.value
		if (s == null) {
			return [] as SpanSeg[]
		}
		return buildSpanSegs(s, poemParasOf)
	})

	const selText = computed(() : string => selectionText())

	/** 分享卡片内容快照（首页诗无上下文渐出，出处固定为铭文） */
	const shareCtx = computed<ShareQuoteCtx | null>(() : ShareQuoteCtx | null => {
		const s = selSpan.value
		if (s == null) {
			return null
		}
		return {
			farBefore: '',
			nearBefore: '',
			quote: selectionText(),
			nearAfter: '',
			farAfter: '',
			thoughtText: thoughtTextOfSpan(s, thoughts.value),
			source: '无足鸟著 2017年2月',
			bookTitle: '无题'
		} as ShareQuoteCtx
	})

	/** ===== 用户信息（分享卡片头像，与阅读页同口径） ===== */
	const userStore = useUserStore()
	const shareLogoSrc = computed(() : string => avatarSrcOf(userStore.userInfo))

	/** ===== 渲染函数（选区高亮与划线/想法装饰；条带样式经 renderLines 预计算，模板直读属性） ===== */

	/** 笔记行号 → 渲染行索引（宽屏合并行：两 origin 同属一个渲染行） */
	function lineIndexOfOrigin(origin : number) : number {
		return isWide.value ? Math.floor(origin / 2) : origin
	}

	/** 选区高亮条内联样式（渲染单元索引空间；纵向盖汉字行盒——拼音区不着色，top/height 显式绑定；
	 *  窄屏行尾标点区右缘=行内容宽 510rpx 特判） */
	function selBandStyleOf(ciStart : number, ciEnd : number) : string {
		const step = poemMetrics.value.charW
		if (isWide.value) {
			return 'left:' + ciStart * step + 'px;top:' + widePinyinLH.value + 'px;width:' + (ciEnd - ciStart + 1) * step + 'px;height:' + wideCharLH.value + 'px'
		}
		const f = rpxF.value
		const right = ciEnd >= LINE_CHAR_COUNT - 1 ? LINE_TEXT_W_RPX * f : (ciEnd + 1) * step
		return 'left:' + ciStart * step + 'px;top:' + 27 * f + 'px;width:' + (right - ciStart * step) + 'px;height:' + 50 * f + 'px'
	}

	/** 划线/想法下划线内联样式（只含 left/width——纵向「贴行底细线」由 .poem-line-band 类固定；
	 *  宽屏合并行单元等宽纯线性——窄屏「行尾标点区右缘=行内容宽 510rpx」特判仅适用于窄屏
	 *  行索引空间，合并行索引≥7 不代表行尾） */
	function decoBandStyleOf(ciStart : number, ciEnd : number) : string {
		const step = poemMetrics.value.charW
		if (isWide.value) {
			return 'left:' + ciStart * step + 'px;width:' + (ciEnd - ciStart + 1) * step + 'px'
		}
		const f = rpxF.value
		const right = ciEnd >= LINE_CHAR_COUNT - 1 ? LINE_TEXT_W_RPX * f : (ciEnd + 1) * step
		return 'left:' + ciStart * step + 'px;width:' + (right - ciStart * step) + 'px'
	}

	/** 行选区覆盖区间（origin 空间：该行被覆盖的字符闭区间 [start, end]；无覆盖返回 null） */
	function lineSelRange(origin : number) : number[] | null {
		const s = selSpan.value
		if (s == null) {
			return null
		}
		const n = normalizeSpan(s)
		if (origin < n.fromOrigin || origin > n.toOrigin) {
			return null
		}
		return [origin == n.fromOrigin ? n.fromStart : 0, origin == n.toOrigin ? n.toEnd : LINE_CHAR_COUNT - 1]
	}

	/** 行内划线条带区间（origin 空间：划线记录的字符区间对剔除想法覆盖段——想法优先，
	 *  被想法覆盖的区域只显示正蓝想法线、不残留灰色划线） */
	function lineUnderlineBands(origin : number) : number[][] {
		let ranges : number[][] = [] as number[][]
		for (const e of underlines.value) {
			if (e.cid == 0 && e.origin == origin) {
				ranges = e.ranges
				break
			}
		}
		for (const b of lineThoughtBands(origin)) {
			const next : number[][] = [] as number[][]
			for (const r of ranges) {
				if (r[1] < b[0] || r[0] > b[1]) {
					next.push(r)
					continue
				}
				if (r[0] < b[0]) {
					next.push([r[0], b[0] - 1])
				}
				if (r[1] > b[1]) {
					next.push([b[1] + 1, r[1]])
				}
			}
			ranges = next
		}
		return ranges
	}

	/** 行内想法条带区间（origin 空间：跨行想法在该行的投影，单段闭区间） */
	function lineThoughtBands(origin : number) : number[][] {
		const bands : number[][] = []
		for (const t of thoughts.value) {
			if (t.fromOrigin <= origin && origin <= t.toOrigin) {
				bands.push([t.fromOrigin == origin ? t.fromStart : 0, t.toOrigin == origin ? t.toEnd : LINE_CHAR_COUNT - 1])
			}
		}
		return bands
	}

	/** ===== 划词协议（选区状态在气泡组件，锚点实测与拖动行矩形由本页查询回传） ===== */

	/** 行尾标点是否句末（句号/叹号/问号结句，逗号不结句；句末集合与阅读页句间扫描同口径） */
	function isSentenceEnd(li : number) : boolean {
		const line = poemLines.value[li]
		return line != null && SENTENCE_END_CHARS.indexOf(line.punct) >= 0
	}

	/** 长按行的句覆盖范围 [句首行, 句末行]：向前找句首（前行结句即到句首）、向后找句末（结句行停，末行钳制） */
	function sentenceRangeOf(li : number) : number[] {
		let start = li
		while (start > 0 && !isSentenceEnd(start - 1)) {
			start--
		}
		let end = li
		while (!isSentenceEnd(end) && end < poemLines.value.length - 1) {
			end++
		}
		return [start, end]
	}

	/** 行矩形 → 拖动映射缓存项（行间 margin 空隙以上一行下界补齐消除死区）。
	 *  宽屏合并行：一个渲染行并置两个笔记段——len=16、firstLen=8、secondOrigin=后段行号，
	 *  气泡组件触点字符索引超前段长度时切分到后段（无合并时字段缺省行为不变） */
	function buildDragRects(rects : NodeInfo[]) : ParaRect[] {
		const dragRects : ParaRect[] = []
		const lines = renderLines.value
		for (let ri = 0; ri < rects.length && ri < lines.length; ri++) {
			const units = lines[ri].units
			if (isWide.value && units.length > LINE_CHAR_COUNT) {
				dragRects.push({
					cid: 0,
					origin: units[0].origin,
					left: rects[ri].left,
					top: rects[ri].top,
					bottom: rects[ri].bottom,
					len: units.length,
					from: 0,
					firstLen: LINE_CHAR_COUNT,
					secondOrigin: units[units.length - 1].origin
				} as ParaRect)
			} else {
				dragRects.push({
					cid: 0,
					origin: ri,
					left: rects[ri].left,
					top: rects[ri].top,
					bottom: rects[ri].bottom,
					len: LINE_CHAR_COUNT,
					from: 0
				} as ParaRect)
			}
		}
		for (let i = 1; i < dragRects.length; i++) {
			if (dragRects[i].top > dragRects[i - 1].bottom) {
				dragRects[i].top = dragRects[i - 1].bottom
			}
		}
		return dragRects
	}

	/** 长按诗行：整行选中（窄屏诗行即句、宽屏合并行即一句，对齐阅读页句间吸附语义），选区在气泡组件内建立；
	 *  同批次预查全部行矩形回传拖动映射缓存——拖动开始事件里的异步查询回来前 touchmove
	 *  会因映射为空被丢弃（表现为主柄拖不动），长按时预查使拖动首帧即跟手 */
	function onLineLongPress(ri : number, e : UniTouchEvent) : void {
		if (e.touches.length == 0) {
			return
		}
		onLineLongPressAt(ri, e.touches[0].clientX)
	}

	/** 长按核心（触摸与 Web 鼠标桥接共用；pressX 为按点视口横坐标，列命中按渲染单元查表换算 origin/列） */
	function onLineLongPressAt(ri : number, pressX : number) : void {
		const clientX = pressX
		uni.createSelectorQuery().selectAll('.poem-line').boundingClientRect((rects : NodeInfo[]) : void => {
			if (rects == null || ri >= rects.length) {
				return
			}
			popoverRef.value?.setDragRects(buildDragRects(rects))
			// 长按字符单元命中想法区间时恢复该想法的完整选区（含划线区域，默认高亮想法选区，
			// 与阅读页「句间吸附前判定想法」同语义）；否则按句选取——句号结尾的才是一句，
			// 逗号行与句号行构成一联一起选中（与阅读页句间吸附同语义）
			const units = renderLines.value[ri].units
			const ci = Math.max(0, Math.min(Math.floor((clientX - rects[ri].left) / poemMetrics.value.charW), units.length - 1))
			const unit = units[ci]
			const range = sentenceRangeOf(unit.origin)
			let span : SelSpan
			const hit = thoughtAt(thoughts.value, 0, unit.origin, unit.col)
			if (hit != null) {
				// 长按列命中想法区间：恢复该想法的完整选区（含划线区域，与阅读页「句间吸附前判定想法」同语义）
				span = spanOfThought(hit)
			} else {
				// 按句选取：句号结尾的才是一句，逗号行与句号行构成一联一起选中（与阅读页句间吸附同语义）
				span = {
					fromCid: 0,
					fromOrigin: range[0],
					fromStart: 0,
					toCid: 0,
					toOrigin: range[1],
					toEnd: LINE_CHAR_COUNT - 1
				} as SelSpan
			}
			// 起点段矩形按选区起点行取（跨行想法的估算基准落在起点行；锚点实测以端点动态查询为准）
			const sn = normalizeSpan(span)
			const fromRi = lineIndexOfOrigin(sn.fromOrigin)
			popoverRef.value?.beginSelection(span, rects[fromRi].left, rects[fromRi].top, clientX, LINE_CHAR_COUNT, 0)
		}).exec()
	}

	/** 锚点实测（组件 emit queryAnchors）：同批次查询选区两端字符单元与所在行矩形回传差分定位；
	 *  锚点按选区端点动态取字符单元（idx 0-6 字单元 / 7 行尾标点单元，id 恒按笔记行号编码）：
	 *  组件起点取左缘=字符左边界，终点取右缘（字盒右缘与下一字符左界差单元右距 15rpx，
	 *  标点包盒右缘=行尾），手柄随拖动后端点吸附 */
	function measureAnchors() : void {
		const s = selSpan.value
		if (s == null) {
			return
		}
		const n = normalizeSpan(s)
		uni.createSelectorQuery()
			.select('#poem-unit-' + n.fromOrigin + '-' + n.fromStart).boundingClientRect()
			.select('#poem-unit-' + n.toOrigin + '-' + n.toEnd).boundingClientRect()
			.select('#poem-line-' + lineIndexOfOrigin(n.fromOrigin)).boundingClientRect()
			.select('#poem-line-' + lineIndexOfOrigin(n.toOrigin)).boundingClientRect()
			.exec((res) => {
				const arr = res as Array<NodeInfo | null>
				if (arr[0] == null || arr[1] == null) {
					return
				}
				popoverRef.value?.setAnchors(n, arr[0]!, arr[1]!, arr[2]!, arr[3]!, 0, 0)
			})
	}

	/** 拖动开始（组件 emit dragStarted）：幂等刷新行矩形缓存（长按已预查，此处防御布局变化） */
	function onDragStarted() : void {
		uni.createSelectorQuery().selectAll('.poem-line').boundingClientRect((rects : NodeInfo[]) : void => {
			if (rects == null) {
				return
			}
			popoverRef.value?.setDragRects(buildDragRects(rects))
		}).exec()
	}

	/** 选区变化镜像（组件 spanChanged：建立/拖动/清除同步） */
	function onSpanChanged(s : SelSpan | null) : void {
		selSpan.value = s
	}

	/** 清除选区（选区真源在组件，守卫避免滚动高频触发重复复位） */
	function clearSelection() : void {
		if (selSpan.value == null) {
			return
		}
		popoverRef.value?.hideSelection()
	}

	// #ifdef WEB
	/** 桌面端无 touch 事件：鼠标桥接诗行长按（按下诗行 350ms 未移动即触发，对齐 uni-app longpress 时长） */
	let webLinePressTimer = -1
	let webLinePressX = 0
	let webLinePressY = 0
	/** 长按命中后抑制随后的合成 click（防止气泡出现即被行点击清除选区） */
	let webLineTapSuppressed = false

	function clearLinePressTimer() : void {
		if (webLinePressTimer >= 0) {
			clearTimeout(webLinePressTimer)
			webLinePressTimer = -1
		}
	}

	function onWebLineMouseDown(e : MouseEvent) : void {
		if (e.button != 0) {
			return
		}
		clearLinePressTimer()
		const target = e.target as Element
		if (target.closest == null) {
			return
		}
		const row = target.closest('.poem-line')
		if (row == null) {
			return
		}
		e.preventDefault()
		const li = parseInt(row.id.substring('poem-line-'.length))
		if (isNaN(li)) {
			return
		}
		webLinePressX = e.clientX
		webLinePressY = e.clientY
		webLinePressTimer = setTimeout(() : void => {
			webLinePressTimer = -1
			webLineTapSuppressed = true
			onLineLongPressAt(li, webLinePressX)
		}, 350)
	}

	function onWebLineMouseMove(e : MouseEvent) : void {
		if (webLinePressTimer >= 0 && (Math.abs(e.clientX - webLinePressX) > 10 || Math.abs(e.clientY - webLinePressY) > 10)) {
			clearLinePressTimer()
		}
	}

	function onWebLineMouseUp(_e : MouseEvent) : void {
		clearLinePressTimer()
	}

	onReady(() => {
		document.addEventListener('mousedown', onWebLineMouseDown)
		window.addEventListener('mousemove', onWebLineMouseMove)
		window.addEventListener('mouseup', onWebLineMouseUp)
	})

	onUnload(() => {
		document.removeEventListener('mousedown', onWebLineMouseDown)
		window.removeEventListener('mousemove', onWebLineMouseMove)
		window.removeEventListener('mouseup', onWebLineMouseUp)
	})
	// #endif

	/** 行点击：选区打开时清除（长按松手不触发 click，无冲突）；无选区时行级预筛想法后
	 *  按点击字符单元查表换算 origin/列精判命中——弹查看卡片（锚定该行上下，与阅读页点击查看同语义） */
	function onPoemTap(ri : number, e : UniPointerEvent) : void {
		// #ifdef WEB
		// 鼠标长按命中时吞掉随后的合成 click（防止气泡出现即被行点击清除选区）
		if (webLineTapSuppressed) {
			webLineTapSuppressed = false
			return
		}
		// #endif
		if (selSpan.value != null) {
			clearSelection()
			return
		}
		let hasThought = false
		const tapUnits = renderLines.value[ri].units
		for (const u of tapUnits) {
			for (const t of thoughts.value) {
				if (t.fromOrigin <= u.origin && u.origin <= t.toOrigin) {
					hasThought = true
					break
				}
			}
			if (hasThought) {
				break
			}
		}
		if (!hasThought) {
			return
		}
		uni.createSelectorQuery().select('#poem-line-' + ri).boundingClientRect((rect : NodeInfo | null) : void => {
			if (rect == null) {
				return
			}
			const units = renderLines.value[ri].units
			const ci = Math.max(0, Math.min(Math.floor((e.clientX - rect.left) / poemMetrics.value.charW), units.length - 1))
			const unit = units[ci]
			const hit = thoughtAt(thoughts.value, 0, unit.origin, unit.col)
			if (hit != null) {
				popoverRef.value?.showThoughtView(hit.quote, hit.content, rect.bottom, rect.top)
			}
		}).exec()
	}

	/** 滚动清除（锚点为视口坐标，滚动即错位） */
	function onScrollClear() : void {
		clearSelection()
	}

	/** ===== 首页诗笔记（虚拟书 0：进入页面锁定虚拟书，登录态云端拉取覆盖缓存，未登录/失败静默保缓存） ===== */

	/** 重读笔记镜像（划线/想法装饰刷新） */
	function reloadNotesMirror() : void {
		underlines.value = loadUnderlines()
		thoughts.value = loadThoughts()
	}

	/** 气泡写入（划线/写想法）后重读（组件 emit sync） */
	function onPopoverSync() : void {
		reloadNotesMirror()
	}

	/** 进入页面：锁定虚拟书 + 云端拉取覆盖缓存（与阅读页打开书籍同口径，拉取容错收口 readerTypes） */
	async function loadHomeNotes() : Promise<void> {
		setActiveBookId(VIRTUAL_BOOK_ID)
		reloadNotesMirror()
		await fetchNotesToCache(VIRTUAL_BOOK_ID)
		reloadNotesMirror()
	}

	/** 气泡动作提示（复制成功/失败、查询占位，经阅读提示卡片组件展示） */
	function showToast(msg : string) : void {
		toastRef.value?.show(msg)
	}
</script>

<style lang="scss">
	.page {
		flex: 1;
		background-color: $bai-canvas-soft;
	}

	.scroll {
		flex: 1;
	}

	/* 主内容容器（Figma: 左右边距 16px；底部预留悬浮导航区，滚动到底时卡片与导航保持 24px 间距；
	   限宽居中——首页主内容仅诗卡，WEB 端放宽到 750 以承载宽屏「每行一句」诗卡自适应扩展） */
	.main {
		width: 100%;
		max-width: 750px;
		margin-left: auto;
		margin-right: auto;
		box-sizing: border-box;
		padding-left: 31rpx;
		padding-right: 31rpx;
		padding-bottom: 196rpx;
		flex-direction: column;
		align-items: center;
	}

	/* 诗文卡片（令牌 poem-card: 白底、圆角 xl 24px、内边距 24x16；层级 2 柔和卡片靠表层对比承载高度，无阴影） */
	.poem-card {
		width: 688rpx;
		flex-direction: column;
		align-items: center;
		padding: 46rpx 31rpx;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-xl;
	}

	/* 诗文主体（Figma: 上下内边距 8px） */
	.poem-body {
		flex-direction: column;
		align-items: center;
		padding: 15rpx 0;
	}

	/* 诗行：7 字单元 + 标点，字间 8px，整体居中；relative 作为选区高亮条（absolute）的定位基准 */
	.poem-line {
		position: relative;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	/* 行距 margin 与汉字行高增量（50-31=19）联动压缩，保持总行距 54/69rpx 不变 */
	.poem-line-gap-inner {
		margin-top: 4rpx;
	}

	.poem-line-gap-outer {
		margin-top: 19rpx;
	}

	/* 字单元（Figma: 28px 宽 = 拼音区 14px + 汉字区 16px；右侧 15rpx 对应字间距 8px） */
	.poem-unit {
		width: 54rpx;
		margin-right: 15rpx;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	/* 拼音（Figma: 10px/10px 灰 #868685，上下留白 1.5/2.5px；字体为拼音注音黑体栈——
	 * 衬线宋体缺音标字形会回退他字体致拼音与汉字错位，两模式统一） */
	.poem-pinyin {
		font-size: 19rpx;
		line-height: 19rpx;
		padding-top: 3rpx;
		padding-bottom: 5rpx;
		color: $bai-mute;
		font-family: $bai-font-pinyin;
	}

	/* 汉字（Figma: 字面 16px 墨黑 #0E0F0C 衬线；行高 1.5em≥字号，官方建议防原生端字形上缘裁剪） */
	.poem-char {
		font-size: 33rpx;
		line-height: 50rpx;
		color: $bai-ink;
		font-family: $bai-font-serif;
	}

	/* 行尾标点单元（Figma: 14x19.66px，内容贴底、整体行内居中；
	 * 统一渲染单元模型后标点即为 poem-unit 加窄宽修饰类，保持行内容总宽 510rpx 口径） */
	.poem-unit--punct {
		width: 27rpx;
		margin-right: 0;
		height: 38rpx;
		justify-content: flex-end;
		padding-bottom: 4rpx;
	}

	.poem-punct {
		font-size: 19rpx;
		line-height: 19rpx;
		color: $bai-ink;
		font-family: $bai-font-serif;
	}

	/* 底部铭文（令牌 poem-meta: 元信息思源黑体，11px/16.5px 灰 #868685，与诗文主体间距 20px） */
	.inscription {
		margin-top: 38rpx;
		font-size: 21rpx;
		line-height: 33rpx;
		color: $bai-mute;
		font-family: $bai-font-ui;
	}

	/* 划词选区高亮条（对齐阅读页 para-highlight：正蓝 14% 背景微圆角；行内绝对定位连续条带，
	 * 纵向只盖汉字行盒——拼音区不着色；几何由 lineSelStyle 按字符步进精确计算） */
	.poem-sel-band {
		position: absolute;
		background-color: rgba($bai-positive, 0.14);
		border-radius: 4rpx;
	}

	/* 行内装饰条带：划线/想法的连续下划线（贴汉字行盒底，想法条带后渲染覆盖划线；几何由 bandStyle 计算。
	 *  高度用 2px 固定值：原 3rpx≈1.9px 处于 H5 亚像素临界，不同行渲染粗细不一） */
	.poem-line-band {
		position: absolute;
		bottom: 2px;
		height: 2px;
	}

	.poem-line-band-underline {
		background-color: $bai-mute;
	}

	.poem-line-band-thought {
		background-color: $bai-positive;
	}
</style>

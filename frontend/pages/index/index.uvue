<template>
	<view class="page">
		<scroll-view class="scroll" direction="vertical" :show-scrollbar="false">
			<view class="main" :style="'padding-top:' + topInset + 'px'">
				<!-- 诗文卡片（Figma: 白底 圆角28px 阴影 0 4 24 @3% 内边距 24x16） -->
				<view class="poem-card">
					<!-- 诗文主体：16 行，每行 7 字（拼音 + 汉字）+ 行尾标点 -->
					<view class="poem-body">
						<view
							v-for="(line, li) in poemLines"
							:key="li"
							class="poem-line"
							:class="lineClass(li)"
						>
							<view v-for="(c, ci) in line.chars" :key="ci" class="poem-unit">
								<text class="poem-pinyin">{{ c.pinyin }}</text>
								<text class="poem-char">{{ c.char }}</text>
							</view>
							<view class="poem-punct-wrap">
								<text class="poem-punct">{{ line.punct }}</text>
							</view>
						</view>
					</view>
					<!-- 底部铭文（Figma: 11px 灰色 衬线体） -->
					<text class="inscription">《无题》无足鸟著 2017年2月</text>
				</view>
			</view>
		</scroll-view>
		<BottomNavBar :items="navItems" :model-value="navActive" @change="onNavChange" />
	</view>
</template>

<script setup lang="uts">
	import BottomNavBar from '@/components/BottomNavBar/BottomNavBar.uvue'
	import { BottomNavItem } from '@/components/BottomNavBar/navItem.uts'


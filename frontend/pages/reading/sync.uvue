<template>
	<view class="page">
		<PageShell :title="t('sync.title')" :desc="t('sync.desc')">
			<!-- 门禁：未登录 / 非会员（黑铁及以上）不展示同步列表 -->
			<view v-if="userStore.userInfo == null" class="gate">
				<text class="gate-text">{{ t('sync.loginNeed') }}</text>
				<view class="gate-btn" @click="goLogin">
					<text class="gate-btn-text">{{ t('sync.goLogin') }}</text>
				</view>
			</view>
			<view v-else-if="!isMember" class="gate">
				<text class="gate-text">{{ t('sync.vipNeed') }}</text>
				<view class="gate-btn" @click="goVip">
					<text class="gate-btn-text">{{ t('sync.goVip') }}</text>
				</view>
			</view>
			<view v-else class="content">
				<!-- 可上传：云端已登记书籍且本设备有正文 -->
				<view class="section">
					<view class="section-head">
						<text class="section-title">{{ tf('sync.uploadable', [uploadList.length.toString()]) }}</text>
						<text v-if="uploadList.length > 0" class="section-action" @click="uploadAll">{{ t('sync.uploadAll') }}</text>
					</view>
					<view v-if="uploadList.length == 0" class="section-empty">
						<text class="section-empty-text">{{ t('sync.uploadEmpty') }}</text>
					</view>
					<view v-for="book in uploadList" :key="book.id" class="row">
						<view class="row-main">
							<text class="row-title">{{ book.title }}</text>
							<text class="row-meta">{{ book.format }} · {{ fmtSize(book.size) }}</text>
						</view>
						<view class="row-btn" @click="uploadOne(book)">
							<text class="row-btn-text">{{ t('sync.upload') }}</text>
						</view>
					</view>
				</view>
				<!-- 可下载：云端已登记、本设备无正文 -->
				<view class="section">
					<view class="section-head">
						<text class="section-title">{{ tf('sync.downloadable', [downloadList.length.toString()]) }}</text>
						<text v-if="downloadList.length > 0" class="section-action" @click="downloadAll">{{ t('sync.downloadAll') }}</text>
					</view>
					<view v-if="downloadList.length == 0" class="section-empty">
						<text class="section-empty-text">{{ t('sync.downloadEmpty') }}</text>
					</view>
					<view v-for="book in downloadList" :key="book.id" class="row">
						<view class="row-main">
							<text class="row-title">{{ book.title }}</text>
							<text class="row-meta">{{ book.format }} · {{ fmtSize(book.size) }}</text>
						</view>
						<view class="row-btn" @click="downloadOne(book)">
							<text class="row-btn-text">{{ t('sync.download') }}</text>
						</view>
					</view>
				</view>
				<!-- 已同步：本设备有正文且云端已登记 -->
				<view class="section">
					<view class="section-head">
						<text class="section-title">{{ tf('sync.synced', [syncedList.length.toString()]) }}</text>
					</view>
					<view v-if="syncedList.length == 0" class="section-empty">
						<text class="section-empty-text">{{ t('sync.syncedEmpty') }}</text>
					</view>
					<view v-for="book in syncedList" :key="book.id" class="row">
						<view class="row-main">
							<text class="row-title">{{ book.title }}</text>
							<text class="row-meta">{{ book.format }} · {{ fmtSize(book.size) }}</text>
						</view>
					</view>
				</view>
			</view>
		</PageShell>
	</view>
</template>

<script setup lang="uts">
	import PageShell from '@/components/common/PageShell.uvue'
	import { useUserStore } from '@/stores/user.uts'
	import { LocalBook, loadBooks, setBookFileLocal } from '@/utils/books.uts'
	import { hasAccessToken } from '@/utils/request.uts'
	import { fetchCloudObjects, fetchUploadUrl, fetchDownloadUrl } from '@/api/cos.uts'
	import { bookFilePath, readBookBytes, writeBookBytes, cosPut, cosGetBytes } from '@/utils/cloudsync.uts'
	import { t, tf } from '@/utils/i18n.uts'
	// 词典注册（同步页文案 + 公共段）
	import '@/utils/locales/sync.uts'
	import '@/utils/locales/common.uts'

	const userStore = useUserStore()

	/** 书架书籍缓存（onShow 读取；上传/下载后重读回填） */
	const books = ref<LocalBook[]>([])
	/** 云端已登记书名集合（清单对象读取结果） */
	const cloudTitles = ref<string[]>([])
	/** 同步进行中标记（防并发触发） */
	const busy = ref(false)

	// 会员判定：黑铁及以上（含管理员），与后端 cos_service 口径一致（令牌 roles 本地比对）
	const isMember = computed((): boolean => {
		const info = userStore.userInfo
		if (info == null) {
			return false
		}
		const roles = info.roles
		return roles.includes('admin') || roles.includes('iron') || roles.includes('bronze')
			|| roles.includes('silver') || roles.includes('gold')
	})

	/** 可上传：云端已登记书籍且本设备有正文 */
	const uploadList = computed((): LocalBook[] => {
		return books.value.filter((b : LocalBook): boolean => b.id > 0 && b.path.length > 0 && cloudTitles.value.indexOf(b.title) < 0)
	})

	/** 可下载：云端已登记、本设备无正文 */
	const downloadList = computed((): LocalBook[] => {
		return books.value.filter((b : LocalBook): boolean => b.id > 0 && b.path.length == 0 && cloudTitles.value.indexOf(b.title) >= 0)
	})

	/** 已同步：本设备有正文且云端已登记 */
	const syncedList = computed((): LocalBook[] => {
		return books.value.filter((b : LocalBook): boolean => b.id > 0 && b.path.length > 0 && cloudTitles.value.indexOf(b.title) >= 0)
	})

	onShow(() => {
		refresh()
	})

	/** 刷新书架缓存 + 云端清单（onShow 与每次同步落定后调用） */
	function refresh() : void {
		books.value = loadBooks()
		refreshCloud()
	}

	/** 拉取云端清单（失败保留旧集合，行内操作会再触发刷新） */
	async function refreshCloud() : Promise<void> {
		if (!hasAccessToken()) {
			return
		}
		try {
			const res = await fetchCloudObjects()
			if (res.code == 0 && res.data != null) {
				const titles : string[] = []
				const arr = res.data!.getArray('items')
				if (arr != null) {
					for (let i = 0; i < arr.length; i++) {
						const obj = arr[i] as UTSJSONObject
						const title = obj.getString('title')
						if (title != null && titles.indexOf(title) < 0) {
							titles.push(title)
						}
					}
				}
				cloudTitles.value = titles
			}
		} catch (e) {
			console.warn('云端清单拉取失败', e)
		}
	}

	/** 单本上传核心流程（不含 loading 与提示；失败抛错由调用方处理） */
	async function doUpload(book : LocalBook) : Promise<void> {
		const urlRes = await fetchUploadUrl(book.title, book.format.toLowerCase())
		if (urlRes.code != 0 || urlRes.data == null) {
			throw new Error(urlRes.msg)
		}
		const url = urlRes.data!.getString('url') ?? ''
		if (url.length == 0) {
			throw new Error('empty upload url')
		}
		const buf = await readBookBytes(book.path)
		await cosPut(url, buf)
	}

	/** 单本下载核心流程（不含 loading 与提示；失败抛错由调用方处理） */
	async function doDownload(book : LocalBook) : Promise<void> {
		const urlRes = await fetchDownloadUrl(book.title, book.format.toLowerCase())
		if (urlRes.code != 0 || urlRes.data == null) {
			throw new Error(urlRes.msg)
		}
		const url = urlRes.data!.getString('url') ?? ''
		if (url.length == 0) {
			throw new Error('empty download url')
		}
		const buf = await cosGetBytes(url)
		const path = bookFilePath(book.id, book.format)
		await writeBookBytes(path, buf)
		setBookFileLocal(book.id, path, buf.byteLength)
	}

	/** 上传单本（按钮入口：busy 守卫 + loading + 结果提示） */
	async function uploadOne(book : LocalBook) : Promise<void> {
		if (busy.value) {
			uni.showToast({ title: t('sync.busy'), icon: 'none' })
			return
		}
		busy.value = true
		uni.showLoading({ title: t('sync.uploading') })
		try {
			await doUpload(book)
			refresh()
			uni.hideLoading()
			uni.showToast({ title: t('sync.uploadDone'), icon: 'none' })
		} catch (e) {
			console.warn('上传失败', book.title, e)
			uni.hideLoading()
			uni.showToast({ title: t('sync.fail'), icon: 'none', duration: 2500 })
		} finally {
			busy.value = false
		}
	}

	/** 下载单本（按钮入口：busy 守卫 + loading + 结果提示） */
	async function downloadOne(book : LocalBook) : Promise<void> {
		if (busy.value) {
			uni.showToast({ title: t('sync.busy'), icon: 'none' })
			return
		}
		busy.value = true
		uni.showLoading({ title: t('sync.downloading') })
		try {
			await doDownload(book)
			refresh()
			uni.hideLoading()
			uni.showToast({ title: t('sync.downloadDone'), icon: 'none' })
		} catch (e) {
			console.warn('下载失败', book.title, e)
			uni.hideLoading()
			uni.showToast({ title: t('sync.fail'), icon: 'none', duration: 2500 })
		} finally {
			busy.value = false
		}
	}

	/** 全部上传（顺序执行，单本失败不中断后续；结束统一提示结果） */
	async function uploadAll() : Promise<void> {
		if (busy.value) {
			uni.showToast({ title: t('sync.busy'), icon: 'none' })
			return
		}
		const list = uploadList.value
		if (list.length == 0) {
			return
		}
		busy.value = true
		uni.showLoading({ title: t('sync.uploading') })
		let ok = 0
		for (let i = 0; i < list.length; i++) {
			try {
				await doUpload(list[i])
				ok++
			} catch (e) {
				console.warn('批量上传失败', list[i].title, e)
			}
		}
		refresh()
		uni.hideLoading()
		uni.showToast({ title: tf('sync.uploadedN', [ok.toString()]), icon: 'none' })
		busy.value = false
	}

	/** 全部下载（顺序执行，单本失败不中断后续；结束统一提示结果） */
	async function downloadAll() : Promise<void> {
		if (busy.value) {
			uni.showToast({ title: t('sync.busy'), icon: 'none' })
			return
		}
		const list = downloadList.value
		if (list.length == 0) {
			return
		}
		busy.value = true
		uni.showLoading({ title: t('sync.downloading') })
		let ok = 0
		for (let i = 0; i < list.length; i++) {
			try {
				await doDownload(list[i])
				ok++
			} catch (e) {
				console.warn('批量下载失败', list[i].title, e)
			}
		}
		refresh()
		uni.hideLoading()
		uni.showToast({ title: tf('sync.downloadedN', [ok.toString()]), icon: 'none' })
		busy.value = false
	}

	/** 字节数展示（B / KB / MB） */
	function fmtSize(size : number) : string {
		if (size >= 1048576) {
			return (size / 1048576.0).toFixed(1) + ' MB'
		}
		if (size >= 1024) {
			return Math.round(size / 1024.0).toString() + ' KB'
		}
		return size.toString() + ' B'
	}

	/** 门禁跳转 */
	function goLogin() : void {
		uni.navigateTo({ url: '/pages/user/login' })
	}

	function goVip() : void {
		uni.navigateTo({ url: '/pages/user/member-pay' })
	}
</script>

<style lang="scss">
	.page {
		min-height: 100vh;
		background-color: $bai-canvas-soft;
	}

	/* 门禁提示卡 */
	.gate {
		margin-top: 160rpx;
		align-items: center;
	}

	.gate-text {
		font-size: 28rpx;
		color: $bai-body;
		margin-bottom: 48rpx;
	}

	.gate-btn {
		background-color: $bai-ink;
		border-radius: $bai-rounded-pill;
		padding: 20rpx 64rpx;
	}

	.gate-btn-text {
		font-size: 28rpx;
		color: $bai-on-primary;
	}

	/* 分区卡片 */
	.section {
		background-color: $bai-canvas;
		border-radius: $bai-rounded-lg;
		padding: 8rpx 32rpx;
		margin-bottom: 32rpx;
	}

	.section-head {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 24rpx 0;
	}

	.section-title {
		font-size: 28rpx;
		font-weight: bold;
		color: $bai-ink;
	}

	.section-action {
		font-size: 26rpx;
		color: $bai-positive;
	}

	.section-empty {
		padding: 4rpx 0 32rpx;
	}

	.section-empty-text {
		font-size: 26rpx;
		color: $bai-mute;
	}

	/* 书籍行 */
	.row {
		flex-direction: row;
		align-items: center;
		padding: 20rpx 0;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: $bai-pale;
	}

	.row-main {
		flex: 1;
	}

	.row-title {
		font-size: 28rpx;
		color: $bai-ink;
		lines: 1;
		text-overflow: ellipsis;
	}

	.row-meta {
		font-size: 24rpx;
		color: $bai-mute;
		margin-top: 6rpx;
	}

	.row-btn {
		background-color: $bai-pale;
		border-radius: $bai-rounded-pill;
		padding: 12rpx 40rpx;
		margin-left: 24rpx;
	}

	.row-btn-text {
		font-size: 26rpx;
		color: $bai-ink;
	}
</style>

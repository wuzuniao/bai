</template>

<script setup lang="uts">
	import BackButton from '@/components/BackButton/BackButton.uvue'
	import PageHeader from '@/components/PageHeader/PageHeader.uvue'

	type PendingDay = {
		week: string
		reward: number
	}

	/** 待签日程（Stitch 示例：周三至周六，周日为大礼单独渲染） */
	const pendingDays = ref<PendingDay[]>([
		{ week: '周三', reward: 5 } as PendingDay,
		{ week: '周四', reward: 5 } as PendingDay,
		{ week: '周五', reward: 5 } as PendingDay,
		{ week: '周六', reward: 10 } as PendingDay
	])

	/** 顶部留白：返回按钮（状态栏高度 + 40px）之下再留 12px */
	const mainTop = ref(96)
	const win = uni.getWindowInfo()
	if (win.statusBarHeight > 0) {
		mainTop.value = win.statusBarHeight + 52
	}

	const toastVisible = ref(false)
	const toastMsg = ref('')
	let toastTimer = -1

	function showToast(msg: string) : void {
		toastMsg.value = msg
		toastVisible.value = true
		if (toastTimer >= 0) {
			clearTimeout(toastTimer)
		}
		toastTimer = setTimeout(() => {
			toastVisible.value = false
		}, 1500)
	}

	/** "去阅读"：进入阅读正文页继续累计时长 */
	function goReading() : void {
		uni.navigateTo({
			url: '/pages/reading/reader'
		})
	}
</script>


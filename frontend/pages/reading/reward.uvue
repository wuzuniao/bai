<template>
	<view class="page">
		<!-- 顶部返回 + 页面标题（与用户子包次级页面统一：BackButton + PageHeader） -->
		<BackButton />

		<scroll-view class="scroll" direction="vertical" :show-scrollbar="false">
			<view class="main" :style="'padding-top:' + mainTop + 'px'">
				<PageHeader :title="tr('reward.title')" :desc="tr('reward.desc')" />
				<!-- 资产总览卡（Stitch: 今日已获 + 总资产三项） -->
				<view class="asset-card">
					<view class="asset-top">
						<view class="asset-left">
							<text class="asset-label">{{ tr('reward.todayGained') }}</text>
							<view class="asset-num-row">
								<text class="asset-num">{{ todayGained }}</text>
								<text class="asset-unit">{{ tr('reward.copper') }}</text>
							</view>
						</view>
						<view class="use-btn" @click="goMemberPay">
							<text class="use-btn-text">{{ tr('reward.use') }}</text>
						</view>
					</view>
					<view class="asset-total">
						<text class="asset-total-label">{{ tr('reward.totalAssets') }}</text>
						<view class="coin-item">
							<text class="coin-num">{{ goldNum }}</text>
							<image class="coin-icon" src="/static/icons/coin-gold.svg" />
						</view>
						<view class="coin-item">
							<text class="coin-num">{{ silverNum }}</text>
							<image class="coin-icon" src="/static/icons/coin-silver.svg" />
						</view>
						<view class="coin-item">
							<text class="coin-num">{{ copperNum }}</text>
							<image class="coin-icon" src="/static/icons/coin-copper.svg" />
						</view>
					</view>
				</view>

				<!-- 连续签到卡（Stitch: 状态头 + 7 天胶囊 + 补签提示条；今日格点击签到） -->
				<view class="checkin-card">
					<view class="checkin-head">
						<view class="checkin-head-text">
							<view class="checkin-title-row">
								<text class="checkin-title">{{ tr('reward.streak') }}</text>
								<text class="checkin-days">{{ streakDays }}</text>
								<text class="checkin-title">{{ tr('reward.days') }}</text>
							</view>
							<text class="checkin-sub">{{ tr('reward.streakRule') }}</text>
						</view>
					</view>
					<view class="checkin-grid">
						<view
							v-for="(d, di) in days"
							:key="di"
							:class="dayClass(d)"
							@click="onDayTap(d)"
						>
							<text :class="dayWeekClass(d)">{{ weekLabel(d.weekday) }}</text>
							<view :class="dayCircleClass(d)">
								<image v-if="d.checked" class="day-check-icon" src="/static/icons/check-warning.svg" />
								<text v-else :class="dayRewardClass(d)">+{{ d.reward }}</text>
							</view>
							<text :class="dayStateClass(d)">{{ dayStateText(d) }}</text>
						</view>
					</view>
					<view class="makeup-bar">
						<text class="makeup-text">{{ makeupBarText }}</text>
						<text v-if="!isMember" class="makeup-btn" @click="goMemberPay">{{ tr('reward.view') }}</text>
					</view>
				</view>

				<!-- 阅读领铜币卡（Stitch: 头部 + 进度条 + 五档阶梯；已达成的档位可点击领取） -->
				<view class="reward-card">
					<view class="reward-head">
						<text class="reward-title">{{ tr('reward.readEarn') }}</text>
						<view class="reward-stat">
							<text class="reward-stat-line">{{ tr('reward.totalMinutes') }}<text class="reward-stat-num">{{ totalMinutes }}</text> {{ tr('rewards.minute') }}</text>
							<text class="reward-stat-line">{{ tr('reward.todayMinutes') }}<text class="reward-stat-num">{{ todayMinutes }}</text> {{ tr('rewards.minute') }}</text>
						</view>
					</view>
					<view class="progress-track">
						<view class="progress-fill" :style="'width:' + progressPercent + '%'"></view>
					</view>
					<view class="tier-list">
						<view v-for="(t, ti) in tiers" :key="ti" :class="tierClass(t)">
							<view class="tier-top">
								<view :class="tierBadgeClass(t)">
									<text :class="tierBadgeTextClass(t)">{{ t.badge }}</text>
								</view>
								<view class="tier-title-row">
									<text :class="tierTitleClass(t)">{{ tr(t.title) }}</text>
									<view :class="tierTagClass(t)">
										<text :class="tierTagTextClass(t)">{{ tierTagText(t) }}</text>
									</view>
								</view>
							</view>
							<view class="tier-bottom">
								<text :class="tierDescClass(t)">{{ tierDesc(t) }}</text>
								<view :class="tierBtnClass(t)" @click="onTierTap(t)">
									<text :class="tierBtnTextClass(t)">{{ tierBtnText(t) }}</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 轻提示 -->
		<view v-if="toastVisible" class="reward-toast">
			<text class="reward-toast-text">{{ toastMsg }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import BackButton from '@/components/common/BackButton.uvue'
	import PageHeader from '@/components/common/PageHeader.uvue'
	import { mainTopPx } from '@/utils/layout.uts'
	import { getTodayMinutes, getTotalMinutes } from '@/utils/books.uts'
	import { hasAccessToken, ApiResponse } from '@/utils/request.uts'
	import { fetchActivitySummary, postCheckin, postCheckinMakeup, claimReadingReward } from '@/api/activity.uts'
	import { REWARD_TIERS, fmtRemainMinutes, tierTotalReward } from '@/utils/rewards.uts'
	import { useUserStore, hasMembershipRole } from '@/stores/user.uts'
	// i18n：本页 v-for 变量名 t 与取词函数冲突，取词函数别名 tr
	import { t as tr, tf } from '@/utils/i18n.uts'
	// 词典注册（reward 页文案 + 公共段 + 奖励共享段）
	import '@/utils/locales/reward.uts'
	import '@/utils/locales/rewards.uts'
	import '@/utils/locales/common.uts'

	type DayView = {
		weekday: number
		date: string
		label: string
		reward: number
		checked: boolean
		isToday: boolean
	}

	type TierView = {
		minutes: number
		badge: string
		title: string
		base: number
		bonus: number
		state: string
	}

	/** 星期标签（周一~周日，自然周口径，index 0=周一；渲染期取词随语言切换刷新，词条 reward.week1~7，越界回落周日） */
	function weekLabel(weekday: number) : string {
		const idx = weekday >= 1 && weekday <= 7 ? weekday : 7
		return tr('reward.week' + idx.toString())
	}
	/** 每日签到奖励档（周一~周五 +5、周六 +10、周日大礼 +20；与后端 CHECKIN_REWARDS 同步维护，未登录兜底展示用） */
	const DEFAULT_WEEK_REWARDS: number[] = [5, 5, 5, 5, 5, 10, 20]
	/** 进度条满档分钟数（12h 最高档） */
	const FULL_DAY_MINUTES = 720

	// ==================== 页面状态 ====================

	const todayGained = ref(0)
	const goldNum = ref(0)
	const silverNum = ref(0)
	const copperNum = ref(0)
	/** 阅读时长（云端统计为准：onShow 拉取覆盖本地镜像；未登录走本地缓存） */
	const todayMinutes = ref(0)
	const totalMinutes = ref(0)
	const streakDays = ref(0)
	const checkedToday = ref(false)
	const days = ref<DayView[]>([])
	const tiers = ref<TierView[]>([])
	const checkinLoading = ref(false)
	const claimBusy = ref(false)
	/** 本月已补签次数（summary 回填；补签成功后以返回值刷新） */
	const makeupUsed = ref(0)
	/** 补签请求进行中锁（防重复点击） */
	const makeupBusy = ref(false)

	const userStore = useUserStore()

	/** 是否持有会员权益角色（黑铁及以上档位或管理员；本地即时判定做交互引导，后端补签时实时复核） */
	const isMember = computed((): boolean => {
		return hasMembershipRole(userStore.userInfo)
	})

	/** 本月剩余补签次数（会员每月 3 次，与后端 MAKEUP_QUOTA_PER_MONTH 同步维护） */
	const makeupLeft = computed((): number => {
		const left = 3 - makeupUsed.value
		return left > 0 ? left : 0
	})

	/** 补签提示条文案：非会员引导开通；会员展示剩余次数 */
	const makeupBarText = computed((): string => {
		if (!isMember.value) {
			return tr('reward.makeupGuide')
		}
		return tf('reward.makeupLeftN', [makeupLeft.value.toString()])
	})

	/** 顶部留白：返回按钮（状态栏高度 + 40px）之下再留 12px（计算逻辑见 utils/layout.uts） */
	const mainTop = ref(mainTopPx())

	/** 今日星期（1=周一 ... 7=周日，自然周口径） */
	function getTodayWeekday() : number {
		const day = new Date().getDay()
		return day == 0 ? 7 : day
	}

	/** 本周某天的日期串（YYYY-MM-DD；周一 = 今天 - (weekday - 今日星期)，跨月自动进位） */
	function weekDateOf(weekday: number) : string {
		const now = new Date()
		const offset = weekday - getTodayWeekday()
		const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + offset)
		const m = d.getMonth() + 1
		const day = d.getDate()
		return d.getFullYear() + '-' + (m < 10 ? '0' + m : '' + m) + '-' + (day < 10 ? '0' + day : '' + day)
	}

	// ==================== 数据加载 ====================

	// 微信小程序分享：转发好友与朋友圈（封面统一 /static/share-cover.png，复制自 yao 项目）
	// #ifdef MP-WEIXIN
	onShareAppMessage(() => {
		return { title: tr('reward.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	onShareTimeline(() => {
		return { title: tr('reward.shareTitle'), imageUrl: '/static/share-cover.png' }
	})
	// #endif

	onShow(() => {
		if (hasAccessToken()) {
			fetchActivitySummary().then((res: ApiResponse) => {
				if (res.code == 0 && res.data != null) {
					applySummary(res.data!)
				}
			}, (_e: Error) => {
				// 云端失败降级：阅读分钟走本地缓存，其余保持未签/未领取默认
				applyLocalFallback()
			})
		} else {
			applyLocalFallback()
		}
	})

	/** 云端聚合数据应用（嵌套对象经索引访问 + null 判断后 as 转换，见 request.uts uts2js 说明） */
	function applySummary(data: UTSJSONObject) : void {
		const balanceRaw = data['balance']
		if (balanceRaw != null) {
			const b = balanceRaw as UTSJSONObject
			goldNum.value = b.getNumber('gold') ?? 0
			silverNum.value = b.getNumber('silver') ?? 0
			copperNum.value = b.getNumber('copper') ?? 0
		}
		todayGained.value = data.getNumber('today_gained') ?? 0

		const readingRaw = data['reading']
		if (readingRaw != null) {
			const r = readingRaw as UTSJSONObject
			todayMinutes.value = r.getNumber('today_minutes') ?? 0
			totalMinutes.value = r.getNumber('total_minutes') ?? 0
		}

		const checkinRaw = data['checkin']
		if (checkinRaw != null) {
			const c = checkinRaw as UTSJSONObject
			streakDays.value = c.getNumber('streak_days') ?? 0
			checkedToday.value = c.getBoolean('checked_today') == true
			makeupUsed.value = c.getNumber('makeup_used') ?? makeupUsed.value
			const arr = c.getArray('days')
			const next: DayView[] = []
			if (arr != null && arr.length == 7) {
				for (let i = 0; i < arr.length; i++) {
					const item = arr[i]
					const weekday = item.getNumber('weekday') ?? (i + 1)
					next.push({
						weekday: weekday,
						date: weekDateOf(weekday),
						label: weekLabel(weekday),
						reward: item.getNumber('reward') ?? DEFAULT_WEEK_REWARDS[i],
						checked: item.getBoolean('checked') == true,
						isToday: weekday == getTodayWeekday()
					} as DayView)
				}
			} else {
				for (let i = 0; i < 7; i++) {
					next.push(buildDefaultDay(i + 1))
				}
			}
			days.value = next
		}

		const tierArr = data.getArray('reading_tiers')
		if (tierArr != null && tierArr.length > 0) {
			const next: TierView[] = []
			for (let i = 0; i < tierArr.length; i++) {
				const item = tierArr[i]
				const fallback = i < REWARD_TIERS.length ? REWARD_TIERS[i] : null
				next.push({
					minutes: item.getNumber('tier_minutes') ?? (fallback != null ? fallback.minutes : 0),
					badge: fallback != null ? fallback.badge : '',
					title: fallback != null ? fallback.title : '',
					base: item.getNumber('base') ?? (fallback != null ? fallback.base : 0),
					bonus: item.getNumber('bonus') ?? (fallback != null ? fallback.bonus : 0),
					state: item.getString('state') ?? 'locked'
				} as TierView)
			}
			tiers.value = next
		}
	}

	/** 未登录/云端失败兜底：阅读分钟走本地缓存，签到格全未签、档位按本地分钟推算 */
	function applyLocalFallback() : void {
		const local = getTodayMinutes()
		todayMinutes.value = local
		totalMinutes.value = getTotalMinutes()
		const nextDays: DayView[] = []
		for (let i = 0; i < 7; i++) {
			nextDays.push(buildDefaultDay(i + 1))
		}
		days.value = nextDays
		const nextTiers: TierView[] = []
		for (let i = 0; i < REWARD_TIERS.length; i++) {
			const t = REWARD_TIERS[i]
			nextTiers.push({
				minutes: t.minutes,
				badge: t.badge,
				title: t.title,
				base: t.base,
				bonus: t.bonus,
				state: local >= t.minutes ? 'claimable' : 'locked'
			} as TierView)
		}
		tiers.value = nextTiers
	}

	/** 默认签到格（未登录/兜底：按星期奖励档构建未签格） */
	function buildDefaultDay(weekday: number) : DayView {
		return {
			weekday: weekday,
			date: weekDateOf(weekday),
			label: weekLabel(weekday),
			reward: DEFAULT_WEEK_REWARDS[weekday - 1],
			checked: false,
			isToday: weekday == getTodayWeekday()
		} as DayView
	}

	/** 响应内余额与今日已获应用（签到/领取成功后回填） */
	function applyBalanceFromData(d: UTSJSONObject) : void {
		const balanceRaw = d['balance']
		if (balanceRaw != null) {
			const b = balanceRaw as UTSJSONObject
			goldNum.value = b.getNumber('gold') ?? goldNum.value
			silverNum.value = b.getNumber('silver') ?? silverNum.value
			copperNum.value = b.getNumber('copper') ?? copperNum.value
		}
		todayGained.value = d.getNumber('today_gained') ?? todayGained.value
	}

	// ==================== 签到 ====================

	function onDayTap(d: DayView) : void {
		if (!d.isToday) {
			if (isDayMissed(d)) {
				makeupDay(d)
			} else if (d.checked) {
				showToast(tr('toast.dayCheckedAlready'))
			} else {
				showToast(tr('toast.dayNotArrived'))
			}
			return
		}
		if (checkedToday.value) {
			showToast(tr('toast.todayCheckedAlready'))
			return
		}
		if (!hasAccessToken()) {
			showToast(tr('toast.loginFirst'))
			return
		}
		if (checkinLoading.value) {
			return
		}
		checkinLoading.value = true
		postCheckin().then((res: ApiResponse) => {
			checkinLoading.value = false
			if (res.code == 0 && res.data != null) {
				const data = res.data!
				const reward = data.getNumber('reward') ?? 0
				checkedToday.value = true
				streakDays.value = data.getNumber('streak_days') ?? (streakDays.value + 1)
				applyBalanceFromData(data)
				markDayChecked(getTodayWeekday())
				showToast(tf('toast.checkinOkN', [reward.toString()]))
			}
		}, (e: Error) => {
			checkinLoading.value = false
			showToast(e.message)
		})
	}

	/**
	 * 会员补签漏签日（黑铁及以上每月 3 次；奖励按被补日星期基准档发放）
	 * 前端本地 roles 判定仅做交互引导，会员身份与限额以后端令牌比对为准
	 */
	function makeupDay(d: DayView) : void {
		if (!hasAccessToken()) {
			showToast(tr('toast.makeupLoginFirst'))
			return
		}
		if (!isMember.value) {
			showToast(tr('toast.makeupMemberOnly'))
			return
		}
		if (makeupLeft.value <= 0) {
			showToast(tr('toast.makeupQuotaUsed'))
			return
		}
		if (makeupBusy.value) {
			return
		}
		makeupBusy.value = true
		postCheckinMakeup(d.date).then((res: ApiResponse) => {
			makeupBusy.value = false
			if (res.code == 0 && res.data != null) {
				const data = res.data!
				const reward = data.getNumber('reward') ?? 0
				makeupUsed.value = data.getNumber('makeup_used') ?? (makeupUsed.value + 1)
				streakDays.value = data.getNumber('streak_days') ?? streakDays.value
				applyBalanceFromData(data)
				markDayChecked(d.weekday)
				showToast(tf('toast.makeupOkN', [reward.toString()]))
			}
		}, (e: Error) => {
			makeupBusy.value = false
			showToast(e.message)
		})
	}

	/** 签到成功后本地格子状态更新（整体替换数组确保视图刷新） */
	function markDayChecked(weekday: number) : void {
		const list = days.value
		const next: DayView[] = []
		for (let i = 0; i < list.length; i++) {
			const d = list[i]
			if (d.weekday == weekday) {
				next.push({
					weekday: d.weekday,
					date: d.date,
					label: d.label,
					reward: d.reward,
					checked: true,
					isToday: d.isToday
				} as DayView)
			} else {
				next.push(d)
			}
		}
		days.value = next
	}

	// ==================== 阅读档位 ====================

	function onTierTap(t: TierView) : void {
		if (t.state == 'claimed') {
			return
		}
		if (t.state == 'claimable') {
			if (!hasAccessToken()) {
				showToast(tr('toast.claimLoginFirst'))
				return
			}
			if (claimBusy.value) {
				return
			}
			claimBusy.value = true
			claimReadingReward(t.minutes).then((res: ApiResponse) => {
				claimBusy.value = false
				if (res.code == 0 && res.data != null) {
					const data = res.data!
					const reward = data.getNumber('reward') ?? tierTotalReward(t)
					applyBalanceFromData(data)
					setTierState(t.minutes, 'claimed')
					showToast(tf('toast.claimOkN', [reward.toString()]))
				}
			}, (e: Error) => {
				claimBusy.value = false
				showToast(e.message)
			})
			return
		}
		// 未达成：去阅读累计时长
		goReading()
	}

	/** 档位状态更新（整体替换数组确保视图刷新） */
	function setTierState(minutes: number, state: string) : void {
		const list = tiers.value
		const next: TierView[] = []
		for (let i = 0; i < list.length; i++) {
			const t = list[i]
			if (t.minutes == minutes) {
				next.push({
					minutes: t.minutes,
					badge: t.badge,
					title: t.title,
					base: t.base,
					bonus: t.bonus,
					state: state
				} as TierView)
			} else {
				next.push(t)
			}
		}
		tiers.value = next
	}

	/** 当前目标档 = 第一个未领取的档位（已达成或未达成均可为当前目标） */
	function isCurrentTier(t: TierView) : boolean {
		const list = tiers.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].state != 'claimed') {
				return list[i].minutes == t.minutes
			}
		}
		return false
	}

	// ==================== 模板样式与文案绑定 ====================

	/** 漏签格：本周已过（weekday 早于今日）且未签；今日未签不算漏（当天尚未结束） */
	function isDayMissed(d: DayView) : boolean {
		return !d.checked && !d.isToday && d.weekday < getTodayWeekday()
	}

	/** 签到格状态类：已签 > 今日 > 漏签（负向红）> 周日大礼 > 待签（大礼格今日未签时同样可点击签到） */
	function dayClass(d: DayView) : string {
		if (d.checked) {
			return 'day-cell day-checked'
		}
		if (d.isToday) {
			return 'day-cell day-today'
		}
		if (isDayMissed(d)) {
			return 'day-cell day-missed'
		}
		if (d.weekday == 7) {
			return 'day-cell day-grand'
		}
		return 'day-cell day-pending'
	}

	function dayWeekClass(d: DayView) : string {
		if (d.checked) {
			return 'day-week day-week-dim'
		}
		if (isDayMissed(d)) {
			return 'day-week day-week-missed'
		}
		if (d.weekday == 7) {
			return 'day-week day-week-ink'
		}
		if (d.isToday) {
			return 'day-week day-week-amber'
		}
		return 'day-week'
	}

	/** 圆圈配色按奖励档分色：+20 墨黑圆白字（品牌强调）/ +10 琥珀圆墨字 / +5 灰圆；漏签负向浅红圆 */
	function dayCircleClass(d: DayView) : string {
		if (d.checked) {
			return 'day-circle day-circle-dim'
		}
		if (d.isToday) {
			return 'day-circle day-circle-accent'
		}
		if (isDayMissed(d)) {
			return 'day-circle day-circle-missed'
		}
		if (d.reward >= 20) {
			return 'day-circle day-circle-ink'
		}
		if (d.reward >= 10) {
			return 'day-circle day-circle-accent'
		}
		return 'day-circle day-circle-idle'
	}

	function dayRewardClass(d: DayView) : string {
		if (isDayMissed(d)) {
			return 'day-reward day-reward-missed'
		}
		if (d.isToday) {
			return 'day-reward day-reward-bold'
		}
		if (d.reward >= 20) {
			return 'day-reward day-reward-grand'
		}
		if (d.reward >= 10) {
			return 'day-reward day-reward-bold'
		}
		return 'day-reward'
	}

	/** 周末格文案按奖励档统一：+20「大礼」/ +10「双倍」/ +5「待签」（周六周日同映射） */
	function dayStateText(d: DayView) : string {
		if (d.checked) {
			return tr('reward.dayChecked')
		}
		if (d.isToday) {
			return tr('reward.dayToday')
		}
		if (isDayMissed(d)) {
			return tr('reward.dayMissed')
		}
		if (d.weekday >= 6) {
			if (d.reward >= 20) {
				return tr('reward.dayGrand')
			}
			if (d.reward >= 10) {
				return tr('reward.dayDouble')
			}
		}
		return tr('reward.dayPending')
	}

	function dayStateClass(d: DayView) : string {
		if (d.checked) {
			return 'day-state day-state-dim'
		}
		if (isDayMissed(d)) {
			return 'day-state day-state-missed'
		}
		if (d.isToday) {
			return 'day-state day-state-amber'
		}
		// 周末 +10/+20 档（双保/大礼）用墨色强调，+5 回归默认灰（与圆圈分档一致）
		if (d.weekday >= 6 && d.reward >= 10) {
			return 'day-state day-state-ink'
		}
		return 'day-state'
	}

	/** 进度条：今日已读 / 满档 12h，百分比一位小数封顶 100 */
	const progressPercent = computed((): number => {
		const p = todayMinutes.value / FULL_DAY_MINUTES * 100
		if (p >= 100) {
			return 100
		}
		return Math.round(p * 10) / 10
	})

	function tierClass(t: TierView) : string {
		if (t.state != 'claimed' && isCurrentTier(t)) {
			return 'tier-item tier-current'
		}
		return 'tier-item tier-dim'
	}

	function tierBadgeClass(t: TierView) : string {
		if (t.state != 'claimed' && isCurrentTier(t)) {
			return 'tier-badge tier-badge-ink'
		}
		return 'tier-badge tier-badge-dim'
	}

	function tierBadgeTextClass(t: TierView) : string {
		if (t.state != 'claimed' && isCurrentTier(t)) {
			return 'tier-badge-text tier-badge-text-white'
		}
		return 'tier-badge-text'
	}

	function tierTitleClass(t: TierView) : string {
		if (t.state == 'claimed') {
			return 'tier-title tier-title-dim'
		}
		if (isCurrentTier(t)) {
			return 'tier-title tier-title-strong'
		}
		return 'tier-title'
	}

	function tierTagClass(t: TierView) : string {
		if (t.state == 'claimed') {
			return 'tier-tag tier-tag-badge'
		}
		if (isCurrentTier(t)) {
			return 'tier-tag tier-tag-accent'
		}
		return 'tier-tag tier-tag-gray'
	}

	function tierTagTextClass(t: TierView) : string {
		if (t.state == 'claimed') {
			return 'tier-tag-text tier-tag-text-amber'
		}
		if (isCurrentTier(t)) {
			return 'tier-tag-text tier-tag-text-ink'
		}
		return 'tier-tag-text'
	}

	/** 奖励标签文案：+N 铜币（含额外赠送时追加说明） */
	function tierTagText(t: TierView) : string {
		let text = tf('reward.tagCopperN', [t.base.toString()])
		if (t.bonus > 0) {
			text += tf('reward.tagBonusN', [t.bonus.toString()])
		}
		return text
	}

	function tierDescClass(t: TierView) : string {
		if (t.state == 'locked' && isCurrentTier(t)) {
			return 'tier-desc tier-desc-text'
		}
		return 'tier-desc'
	}

	function tierDesc(t: TierView) : string {
		const total = tierTotalReward(t)
		if (t.state == 'claimed') {
			return tf('reward.tierClaimedN', [total.toString()])
		}
		if (t.state == 'claimable') {
			return tf('reward.tierClaimableN', [total.toString()])
		}
		return tf('reward.tierLocked', [fmtRemainMinutes(t.minutes - todayMinutes.value)])
	}

	function tierBtnClass(t: TierView) : string {
		if (t.state == 'claimed') {
			return 'tier-btn tier-btn-claimed'
		}
		if (t.state == 'claimable') {
			return 'tier-btn tier-btn-primary'
		}
		return 'tier-btn tier-btn-outline'
	}

	function tierBtnText(t: TierView) : string {
		if (t.state == 'claimed') {
			return tr('reward.btnClaimed')
		}
		if (t.state == 'claimable') {
			return tr('reward.btnClaim')
		}
		return tr('reward.btnRead')
	}

	function tierBtnTextClass(t: TierView) : string {
		if (t.state == 'claimed') {
			return 'tier-btn-text tier-btn-text-claimed'
		}
		if (t.state == 'claimable') {
			return 'tier-btn-text tier-btn-text-white'
		}
		return 'tier-btn-text'
	}

	// ==================== 导航与提示 ====================

	const toastVisible = ref(false)
	const toastMsg = ref('')
	let toastTimer = -1

	function showToast(msg: string) : void {
		toastMsg.value = msg
		toastVisible.value = true
		if (toastTimer >= 0) {
			clearTimeout(toastTimer)
		}
		toastTimer = setTimeout(() => {
			toastVisible.value = false
		}, 1500)
	}

	/** "去阅读"：跳书架选书（阅读器需指定书籍打开，无上下文不直达正文页） */
	function goReading() : void {
		uni.navigateTo({
			url: '/pages/reading/bookshelf'
		})
	}

	/** 补签"查看"：跳转会员支付页（月卡每月赠 3 次补签） */
	function goMemberPay() : void {
		uni.navigateTo({
			url: '/pages/user/member-pay'
		})
	}
</script>

<style lang="scss">
	.page {
		flex: 1;
		background-color: $bai-canvas-soft;
	}

	.scroll {
		flex: 1;
	}

	/* 主内容（Stitch: 左右 20px、顶部间距 24px、卡片间距 24px；宽屏限宽居中） */
	.main {
		width: 100%;
		/* #ifdef WEB */
		max-width: 480px;
		/* #endif */
		/* #ifndef WEB */
		max-width: 750px;
		/* #endif */
		margin-left: auto;
		margin-right: auto;
		box-sizing: border-box;
		padding: 46rpx 38rpx 60rpx 38rpx;
		flex-direction: column;
		gap: 46rpx;
	}

	/* 资产总览卡（令牌 card-content: 白底 圆角 xl 24px 内边距 24px；层级 2 表层对比承载高度，无边框无阴影）
	   margin-top 18rpx：叠加父级 gap 46rpx，标题区到首卡间距 64rpx，对齐帮助子页节奏 */
	.asset-card {
		margin-top: 18rpx;
		border-radius: $bai-rounded-xl;
		padding: 46rpx;
		background-color: $bai-canvas;
	}

	.asset-top {
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
	}

	.asset-label {
		font-size: 23rpx;
		color: $bai-mute;
	}

	.asset-num-row {
		flex-direction: row;
		align-items: flex-end;
		gap: 15rpx;
		margin-top: 15rpx;
	}

	.asset-num {
		font-size: 69rpx;
		font-weight: 600;
		color: $bai-ink;
	}

	.asset-unit {
		font-size: 23rpx;
		font-weight: 500;
		color: $bai-mute;
		padding-bottom: 6rpx;
	}

	.use-btn {
		padding: 15rpx 27rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-canvas-soft;
	}

	.use-btn-text {
		font-size: 23rpx;
		font-weight: 500;
		color: $bai-ink;
	}

	.asset-total {
		margin-top: 38rpx;
		padding-top: 31rpx;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: $bai-canvas-soft;
		flex-direction: row;
		align-items: center;
	}

	.asset-total-label {
		font-size: 21rpx;
		color: $bai-mute;
	}

	.coin-item {
		flex-direction: row;
		align-items: center;
		gap: 6rpx;
		margin-left: 23rpx;
	}

	.coin-icon {
		width: 31rpx;
		height: 31rpx;
	}

	.coin-num {
		font-size: 23rpx;
		font-weight: 500;
		color: $bai-body;
	}

	/* 连续签到卡（令牌 card-content: 白底 圆角 xl 24px 内边距 24px，7 天胶囊网格 + 补签提示条） */
	.checkin-card {
		border-radius: $bai-rounded-xl;
		padding: 46rpx;
		background-color: $bai-canvas;
		flex-direction: column;
		gap: 38rpx;
	}

	.checkin-title-row {
		flex-direction: row;
		align-items: baseline;
		gap: 8rpx;
	}

	.checkin-title {
		font-size: 35rpx;
		font-weight: 600;
		color: $bai-ink;
	}

	.checkin-days {
		font-size: 46rpx;
		font-weight: 700;
		color: $bai-ink;
	}

	.checkin-sub {
		margin-top: 8rpx;
		font-size: 23rpx;
		color: $bai-mute;
	}

	/* 7 天胶囊网格（Stitch: 7 列 间距 6px，项高 92px 圆角 16px） */
	.checkin-grid {
		flex-direction: row;
		gap: 12rpx;
		margin-top: 8rpx;
	}

	.day-cell {
		flex: 1;
		min-height: 177rpx;
		padding: 23rpx 8rpx;
		border-radius: $bai-rounded-lg;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
	}

	.day-week {
		font-size: 19rpx;
		color: $bai-mute;
	}

	.day-week-dim {
		color: rgba($bai-on-primary, 0.7);
	}

	.day-week-amber {
		font-weight: 600;
		color: $bai-warning-deep;
	}

	.day-week-ink {
		font-weight: 500;
		color: $bai-ink;
	}

	.day-week-missed {
		color: $bai-negative-deep;
	}

	.day-circle {
		width: 46rpx;
		height: 46rpx;
		border-radius: $bai-rounded-pill;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.day-circle-dim {
		background-color: rgba($bai-on-primary, 0.2);
	}

	.day-circle-accent {
		background-color: $bai-warning;
	}

	/* +20 大礼圆：墨黑底白字（品牌唯一强调色，区别于 +10 的琥珀圆） */
	.day-circle-ink {
		background-color: $bai-ink;
	}

	/* 漏签圆：负向红弱化浅底（示意错过/损失，不炸眼） */
	.day-circle-missed {
		background-color: rgba($bai-negative, 0.12);
	}

	.day-circle-idle {
		background-color: $bai-canvas;
		border: 1px solid $bai-pale;
	}

	.day-check-icon {
		width: 27rpx;
		height: 27rpx;
	}

	.day-reward {
		font-size: 21rpx;
		font-weight: 500;
		color: $bai-body;
	}

	.day-reward-bold {
		font-weight: 700;
		color: $bai-ink;
	}

	/* +20 奖励额：墨黑圆上的白色粗体 */
	.day-reward-grand {
		font-weight: 700;
		color: $bai-on-primary;
	}

	.day-reward-missed {
		color: $bai-negative-deep;
	}

	.day-state {
		font-size: 19rpx;
		color: $bai-mute;
	}

	.day-state-dim {
		font-weight: 500;
		color: rgba($bai-on-primary, 0.9);
	}

	.day-state-amber {
		font-weight: 500;
		color: $bai-warning-deep;
	}

	.day-state-ink {
		font-weight: 500;
		color: $bai-ink;
	}

	.day-state-missed {
		color: $bai-negative-deep;
	}

	/* Day 状态底色（Stitch: 已签墨黑 / 今日警示浅底 / 待签画布灰 / 大礼画布灰） */
	.day-checked {
		background-color: $bai-ink;
	}

	.day-today {
		background-color: $bai-warning-tint;
		border: 1px solid rgba($bai-warning, 0.5);
	}

	.day-pending {
		background-color: $bai-canvas-soft;
	}

	.day-grand {
		background-color: $bai-canvas-soft;
		border: 1px solid $bai-pale;
	}

	/* 漏签格（本周已过未签）：画布灰底 + 负向红描边，弱化损失提示 */
	.day-missed {
		background-color: $bai-canvas-soft;
		border: 1px solid rgba($bai-negative, 0.35);
	}

	/* 补签提示条（Stitch: 画布灰底 圆角 lg 16px 两端分布） */
	.makeup-bar {
		padding: 19rpx 27rpx;
		border-radius: $bai-rounded-lg;
		background-color: $bai-canvas-soft;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.makeup-text {
		font-size: 21rpx;
		color: $bai-body;
	}

	.makeup-btn {
		font-size: 21rpx;
		font-weight: 500;
		color: $bai-ink;
		text-decoration: underline;
	}

	/* 阅读领铜币卡（令牌 card-content: 白底 圆角 xl 24px 内边距 24px + 进度条 + 五档阶梯） */
	.reward-card {
		border-radius: $bai-rounded-xl;
		padding: 46rpx;
		background-color: $bai-canvas;
		flex-direction: column;
		gap: 23rpx;
	}

	.reward-title {
		font-size: 35rpx;
		font-weight: 600;
		color: $bai-ink;
	}

	.reward-stat {
		margin-top: 8rpx;
		flex-direction: column;
		gap: 15rpx;
	}

	.reward-stat-line {
		font-size: 23rpx;
		color: $bai-mute;
	}

	.reward-stat-num {
		font-weight: 500;
		color: $bai-ink;
	}

	.progress-track {
		width: 100%;
		height: 12rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-pale;
		overflow: hidden;
	}

	.progress-fill {
		width: 0%;
		height: 12rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-ink;
	}

	.tier-list {
		margin-top: 15rpx;
		flex-direction: column;
		gap: 27rpx;
	}

	.tier-item {
		border-radius: $bai-rounded-lg;
		padding: 31rpx;
		flex-direction: column;
		gap: 19rpx;
	}

	.tier-dim {
		background-color: $bai-canvas-soft;
	}

	/* 当前目标档（item-card: 白卡置于白卡之上，靠 1px 浅灰描边区分层级，不加阴影） */
	.tier-current {
		background-color: $bai-canvas;
		border: 1px solid $bai-pale;
	}

	.tier-top {
		flex-direction: row;
		align-items: center;
		gap: 23rpx;
	}

	.tier-badge {
		width: 62rpx;
		height: 62rpx;
		border-radius: $bai-rounded-pill;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.tier-badge-dim {
		background-color: $bai-canvas;
		border: 1px solid $bai-pale;
	}

	.tier-badge-ink {
		background-color: $bai-ink;
	}

	.tier-badge-text {
		font-size: 23rpx;
		font-weight: 600;
		color: $bai-mute;
	}

	.tier-badge-text-white {
		color: $bai-on-primary;
	}

	.tier-title-row {
		flex-direction: row;
		align-items: center;
		gap: 15rpx;
		/* 占满徽标右侧剩余宽度（宽度有界），档位标签一行放不下时整体换到标题下一行 */
		flex: 1;
		flex-wrap: wrap;
	}

	.tier-title {
		font-size: 23rpx;
		font-weight: 500;
		color: $bai-body;
	}

	.tier-title-dim {
		color: $bai-ink;
	}

	.tier-title-strong {
		font-weight: 600;
		color: $bai-ink;
	}

	.tier-tag {
		padding: 4rpx 15rpx;
		border-radius: $bai-rounded-sm;
		/* 极窄屏下标签自身超宽时约束到行宽，「再额外赠送」小字自动换行 */
		max-width: 100%;
	}

	.tier-tag-badge {
		background-color: $bai-warning-tint;
	}

	.tier-tag-accent {
		background-color: $bai-warning;
	}

	.tier-tag-gray {
		background-color: $bai-pale;
	}

	.tier-tag-text {
		font-size: 19rpx;
		font-weight: 500;
		color: $bai-body;
	}

	.tier-tag-text-amber {
		color: $bai-warning-deep;
	}

	.tier-tag-text-ink {
		font-weight: 600;
		color: $bai-ink;
	}

	.tier-bottom {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-top: 8rpx;
		padding-left: 85rpx;
	}

	.tier-desc {
		font-size: 21rpx;
		color: $bai-mute;
	}

	.tier-desc-text {
		color: $bai-body;
	}

	.tier-desc-strong {
		font-weight: 600;
		color: $bai-ink;
	}

	.tier-btn {
		border-radius: $bai-rounded-pill;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.tier-btn-claimed {
		padding: 12rpx 27rpx;
		background-color: $bai-pale;
	}

	.tier-btn-primary {
		padding: 12rpx 31rpx;
		background-color: $bai-ink;
	}

	.tier-btn-outline {
		padding: 12rpx 27rpx;
		background-color: $bai-canvas;
		border: 1px solid $bai-pale;
	}

	.tier-btn-text {
		font-size: 21rpx;
		font-weight: 500;
		color: $bai-body;
	}

	.tier-btn-text-claimed {
		color: $bai-mute;
	}

	.tier-btn-text-white {
		font-weight: 400;
		color: $bai-on-primary;
	}

	/* 轻提示（同阅读页样式） */
	.reward-toast {
		position: fixed;
		left: 0;
		right: 0;
		top: 185rpx;
		flex-direction: row;
		justify-content: center;
		z-index: 60;
	}

	.reward-toast-text {
		font-size: 23rpx;
		color: $bai-on-primary;
		padding: 15rpx 31rpx;
		border-radius: $bai-rounded-pill;
		background-color: rgba($bai-ink, 0.9);
	}
</style>

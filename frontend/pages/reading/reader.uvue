	}

	.bottom-nav-text {
		font-size: 21rpx;
	}

	/* 划词气泡（Stitch: 黑底圆角 12px 内边距 12x8，操作项竖排图标+文字，底部 7px 三角） */
	.selection-popover {
		position: fixed;
		left: 0;
		right: 0;
		top: 480rpx;
		flex-direction: row;
		justify-content: center;
		z-index: 60;
	}

	.popover-body {
		position: relative;
		flex-direction: row;
		align-items: center;
		gap: 23rpx;
		padding: 15rpx 23rpx;
		/* 背景内联绑定（夜间提亮一档与暗底区分，日间墨黑） */
		border-radius: $bai-rounded-md;
		box-shadow: $bai-shadow-popover;
	}

	.popover-btn {
		flex-direction: column;
		align-items: center;
		gap: 6rpx;
		padding: 8rpx 23rpx;
	}

	.popover-icon {
		width: 31rpx;
		height: 31rpx;
	}

	.popover-text {

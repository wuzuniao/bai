		font-weight: 500;
		color: $bai-on-primary;
	}

	.popover-divider {
		width: 1px;
		height: 46rpx;
		background-color: rgba($bai-on-primary, 0.2);
	}

	.popover-arrow {
		position: absolute;
		left: 50%;
		bottom: -12rpx;
		margin-left: -13rpx;
		width: 0;
		height: 0;
		border-left-width: 13rpx;
		border-left-style: solid;
		border-left-color: transparent;
		border-right-width: 13rpx;
		border-right-style: solid;
		border-right-color: transparent;
		border-top-width: 13rpx;
		border-top-style: solid;
		border-top-color: $bai-ink;
	}

	/* 目录抽屉（控制栏内容块：与设置面板一致随控制栏从底部弹出，高度内联绑定恢复独立浮层时期尺寸；顶部间距与设置面板一致） */
	.drawer-panel {
		padding-top: 23rpx;
		flex-direction: column;
	}

	.drawer-header {
		flex-direction: row;
		align-items: center;
		gap: 46rpx;

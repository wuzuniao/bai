<template>
	<view class="page" :style="'background-color:' + readerBg">
		<!-- 阅读内容区：点击空白切换菜单显隐 / 清除划词 / 收起设置；左右滑动翻页（切换章节） -->
		<view
		class="content"
		:class="pullSettling ? 'content-settle' : ''"
		:style="'transform:translateY(' + pullOffset + 'px)'"
		@click="onContentTap"
		@touchstart="onContentTouchStart"
		@touchmove="onContentTouchMove"
		@touchend="onContentTouchEnd"
	>
			<!-- 上下滚动模式：整章连续滚动（滚轮/触摸拖拽，滚动多少显示多少） -->
			<scroll-view
					v-if="pageTurn === '滚动'"
					class="scroll-mode"
					direction="vertical"
					:show-scrollbar="false"
					:scroll-top="scrollModeTop"
					:scroll-into-view="scrollIntoView"
					@scroll="onScrollModeScroll"
					@scrolltolower="onScrollToLower"
					@scrolltoupper="onScrollToUpper"
				>
					<view class="scroll-mode-inner">
						<!-- 章前间距锚点：前插上一章后 scroll-into-view 锚定此锚点，视口完整呈现「上一章尾部 → 间距 → 标题」 -->
						<view
							v-for="(cid, ci) in scrollChapters"
							:key="cid"
							class="scroll-chapter"
							:id="'scroll-ch-' + cid"
						>
							<view :id="'scroll-gap-' + cid" class="scroll-chapter-anchor" :style="ci > 0 ? 'height:140rpx' : ''"></view>
							<view class="chapter-header">
								<view class="chapter-label-row">
									<view class="chapter-label-dot"></view>
									<text class="chapter-label" :style="'color:' + labelColor">{{ chapters[cid].label }}</text>
								</view>
								<text class="chapter-title" :style="'color:' + titleColor">{{ chapters[cid].contentTitle }}</text>
								<view class="chapter-divider"></view>
							</view>
							<view class="novel-body" :style="'font-size:' + fontSize + 'px;color:' + bodyColor + ';font-family:' + fontFamily">
								<view
									v-for="(item, vi) in chapterParagraphItems(cid)"
									:key="cid + '-' + item.origin"
									class="novel-paragraph"
									@longpress="onLongPress(item.origin)"
								>
									<text class="novel-text">
										<text v-if="item.underlined" class="para-underlined">{{ item.text }}</text>
										<text v-else-if="selectedIdx === item.origin && currentChapterId === cid">
											<text>{{ selBefore }}</text>
											<text class="para-highlight">{{ selSelected }}</text>
											<text>{{ selAfter }}</text>
										</text>
										<text v-else>{{ item.text }}</text>
									</text>
								</view>
							</view>
						</view>
					</view>
				</scroll-view>
			<!-- 分页模式：双层页面翻页（仿真/覆盖/平移） -->
			<view v-else class="page-stack">
				<!-- 当前页层 -->
				<view class="page-layer" :class="flipSettling ? 'page-layer-settle' : ''" :style="currentLayerStyle">
					<view class="content-inner">
						<view v-if="pageIndex === 0" class="chapter-header" :style="paragraphCurlStyle(0, curlTotal)">
							<view class="chapter-label-row">
								<view class="chapter-label-dot"></view>
								<text class="chapter-label" :style="'color:' + labelColor">{{ chapterLabel }}</text>
							</view>
							<text class="chapter-title" :style="'color:' + titleColor">{{ contentTitle }}</text>
							<view class="chapter-divider"></view>
						</view>
						<view class="novel-body" :style="'font-size:' + fontSize + 'px;color:' + bodyColor + ';font-family:' + fontFamily">
							<view
								v-for="(item, vi) in currentPageItems"
								:key="item.origin"
								class="novel-paragraph"
								:style="paragraphCurlStyle((pageIndex === 0 ? 1 : 0) + vi, curlTotal)"
								@longpress="onLongPress(item.origin)"
							>
								<text class="novel-text">
									<text v-if="item.underlined" class="para-underlined">{{ item.text }}</text>
									<text v-else-if="selectedIdx === item.origin">
										<text>{{ selBefore }}</text>
										<text class="para-highlight">{{ selSelected }}</text>
										<text>{{ selAfter }}</text>
									</text>
									<text v-else>{{ item.text }}</text>
								</text>
							</view>
						</view>
					</view>
					<view v-if="pageTurn === '仿真' && flipDir == -1 && flipOffset > 0" class="page-layer-shadow"></view>
				</view>
				<!-- 目标页层（跟手翻页时从页外滑入） -->
				<view v-if="flipTargetIndex >= 0" class="page-layer" :style="targetLayerStyle">
						<view v-if="pageTurn === '仿真' && flipDir == 1 && flipOffset > 0" class="page-curl-shadow" :style="curlShadowStyle"></view>
						<view class="content-inner">
						<view v-if="flipTargetIndex === 0" class="chapter-header">
							<view class="chapter-label-row">
								<view class="chapter-label-dot"></view>
								<text class="chapter-label" :style="'color:' + labelColor">{{ chapterLabel }}</text>
							</view>
							<text class="chapter-title" :style="'color:' + titleColor">{{ contentTitle }}</text>
							<view class="chapter-divider"></view>
						</view>
						<view class="novel-body" :style="'font-size:' + fontSize + 'px;color:' + bodyColor + ';font-family:' + fontFamily">
							<view
								v-for="(item, vi) in flipTargetItems"
								:key="item.origin"
								class="novel-paragraph"
							>
								<text class="novel-text">{{ item.text }}</text>
							</view>
						</view>
					</view>
					<view v-if="pageTurn === '仿真' && flipDir == 1" class="page-layer-shadow"></view>
				</view>
			</view>
			<!-- 底部进度（Stitch: 时间 + 章节进度 + 百分比标签） -->
			<view class="reader-footer">
				<view class="footer-left">
					<view class="footer-dot"></view>
					<text class="footer-time">14:30</text>
				</view>
				<view class="footer-right">
					<text class="footer-progress">{{ footerProgress }}</text>
					<text class="footer-percent">{{ footerPercent }}</text>
				</view>
			</view>
		</view>

		<!-- 划词气泡（Stitch: 黑底圆角 12px，复制/写想法/划线竖排图标+文字，底部三角指向选区） -->
		<view v-if="selectedIdx >= 0" class="selection-popover" @click="clearSelection">
			<view class="popover-body" :style="'background-color:' + popoverBg">
				<view class="popover-btn" @click="onPopoverAction('copy')">
					<image class="popover-icon" src="/static/icons/popover-copy.svg" />
					<text class="popover-text">复制</text>
				</view>
				<view class="popover-divider"></view>
				<view class="popover-btn" @click="onPopoverAction('idea')">
					<image class="popover-icon" src="/static/icons/popover-idea.svg" />
					<text class="popover-text">写想法</text>
				</view>
				<view class="popover-divider"></view>
				<view class="popover-btn" @click="onPopoverAction('underline')">
					<image class="popover-icon" src="/static/icons/popover-underline.svg" />
					<text class="popover-text">划线</text>
				</view>
				<view class="popover-arrow"></view>
			</view>
		</view>

		<!-- 顶部导航菜单（Stitch: 返回/书名，呼出态从顶部滑入；内容行与小程序胶囊同行） -->
		<view
			class="menu-top"
			:class="menuVisible && !settingsOpen ? '' : 'menu-top-hidden'"
			:style="'background-color:' + menuTopBg + ';border-color:' + menuBorderColor + ';padding-top:' + navTop + 'px'"
		>
			<view class="menu-top-inner" :style="'height:' + navHeight + 'px'">
				<view class="menu-top-left">
					<view class="round-btn" @click="onBackTap">
						<image class="round-btn-icon" :src="themeIcon('arrow-back')" />
					</view>
					<text class="book-name" :style="'color:' + titleColor">星渊行者</text>
				</view>
			</view>
		</view>

		<!-- 底部控制面板（Stitch: 设置面板 + 听书悬浮球 + 三项导航，呼出态从底部滑入；抽屉打开时保持显示，三控制项不随子项变化） -->
		<view
			class="menu-bottom"
			:class="menuVisible || drawerOpen ? '' : 'menu-bottom-hidden'"
			:style="'background-color:' + menuBottomBg + ';border-color:' + menuBorderColor + ';box-shadow:' + panelShadow"
		>
			<!-- 目录抽屉（与设置面板一致：作为控制栏内容块向上弹出，与设置面板互斥） -->
			<view v-if="drawerOpen" class="drawer-panel" :style="'height:' + drawerPanelHeight + 'px'">
					<view class="settings-grip-row">
						<view class="settings-grip"></view>
					</view>
					<view class="drawer-header">
					<view :class="drawerTab === 'catalog' ? 'drawer-tab-active' : 'drawer-tab-plain'" @click="switchDrawerTab('catalog')">
						<text :class="drawerTab === 'catalog' ? 'drawer-tab-title' : 'drawer-tab-plain'">目录</text>
						<text v-if="drawerTab === 'catalog'" class="drawer-tab-sort" @click="onSortTap($event)">{{ orderDesc ? '↓↑' : '⇅' }}</text>
					</view>
					<text class="drawer-tab-plain" @click="showToast('暂无想法与划线记录')">想法/划线</text>
					<view :class="drawerTab === 'bookmark' ? 'drawer-tab-active' : 'drawer-tab-plain'" @click="switchDrawerTab('bookmark')">
						<text :class="drawerTab === 'bookmark' ? 'drawer-tab-title' : 'drawer-tab-plain'">书签</text>
					</view>
				</view>
				<scroll-view class="drawer-list" direction="vertical" :show-scrollbar="false">
					<!-- 目录页 -->
					<template v-if="drawerTab === 'catalog'">
						<view
							v-for="(ch, ci) in displayChapters"
							:key="ch.id"
							class="chapter-item"
							@click="selectChapter(ch)"
						>
							<text class="chapter-item-text" :class="ch.active ? 'chapter-item-text-active' : ''" :style="'color:' + (ch.active ? activeBlue : chapterTextColor)">{{ ch.title }}</text>
						</view>
					</template>
					<!-- 书签页 -->
					<template v-else>
						<view v-if="bookmarks.length == 0" class="bookmark-empty">
							<text class="bookmark-empty-text" :style="'color:' + mutedColor">书签列表为空，正文下滑即可添加书签</text>
						</view>
						<view
							v-for="(bm, bi) in bookmarks"
							:key="bi"
							class="bookmark-item"
							@click="goToBookmark(bm)"
						>
							<image class="bookmark-item-icon" :src="themeIcon('reader-bookmark-active')" />
							<text class="bookmark-item-text" :style="'color:' + chapterTextColor">{{ bookmarkLabel(bm) }}</text>
						</view>
					</template>
				</scroll-view>
			</view>
			<!-- 设置面板（Stitch: 字号/背景/翻页，展开时隐藏顶栏与听书球） -->
			<view v-if="settingsOpen" class="settings-panel">
				<view class="settings-grip-row">
					<view class="settings-grip"></view>
				</view>
				<view class="settings-row">
					<text class="settings-label" :style="'color:' + mutedColor">字号</text>
					<view class="settings-row-body">
						<view class="stepper-group">
							<view class="stepper-btn" :style="'background-color:' + controlBg + ';border-color:' + controlBorder" @click="changeFontSize(-1)">
								<text class="stepper-text" :style="'color:' + controlText">A⁻</text>
							</view>
							<text class="stepper-val" :style="'color:' + titleColor">{{ fontSize }}</text>
							<view class="stepper-btn" :style="'background-color:' + controlBg + ';border-color:' + controlBorder" @click="changeFontSize(1)">
								<text class="stepper-text" :style="'color:' + controlText">A⁺</text>
							</view>
						</view>
						<view class="font-btn" :style="'background-color:' + controlBg + ';border-color:' + controlBorder" @click="toggleFontList">
							<text class="font-btn-text" :style="'color:' + controlText">{{ fontListOpen ? '请选择' : currentFontLabel }}</text>
						</view>
					</view>
				</view>
				<!-- 字体选择列表（选择后点保存本地持久化） -->
				<view v-if="fontListOpen" class="font-select">
					<view class="font-select-list">
						<view
							v-for="(f, fi) in fontOptions"
							:key="f.key"
							class="page-turn-btn font-option"
							:class="pendingFontKey === f.key ? 'page-turn-active' : 'page-turn-idle'"
							:style="pendingFontKey === f.key ? '' : 'background-color:' + controlBg + ';border-color:' + controlBorder"
							@click="selectFont(f.key)"
						>
							<text class="page-turn-text" :class="pendingFontKey === f.key ? 'page-turn-text-active' : ''" :style="pendingFontKey === f.key ? '' : 'color:' + controlText">{{ f.label }}</text>
						</view>
					</view>
					<view class="font-save-row">
						<view class="font-cancel-btn" @click="cancelFontSelect">
							<text class="font-cancel-btn-text">取消</text>
						</view>
						<view class="font-save-btn" :style="nightMode ? 'background-color:#f3f4f6' : ''" @click="saveFont">
							<text class="font-save-btn-text" :style="nightMode ? 'color:#0e0f0c' : ''">保存</text>
						</view>
					</view>
				</view>
				<view class="settings-row">
					<text class="settings-label" :style="'color:' + mutedColor">背景</text>
					<view class="settings-row-body">
						<view class="swatch-group">
							<view
								class="swatch swatch-white"
								:class="selectedBg === READER_THEME_LIGHT.readerBg ? 'swatch-active' : ''"
								@click="changeReaderBg(READER_THEME_LIGHT.readerBg, READER_THEME_LIGHT.bodyColor)"
							></view>
							<view
								class="swatch swatch-milky"
								:class="selectedBg === READER_THEME_PAPER.readerBg ? 'swatch-active' : ''"
								@click="changeReaderBg(READER_THEME_PAPER.readerBg, READER_THEME_PAPER.bodyColor)"
							></view>
						</view>
					</view>
				</view>
				<view class="settings-row">
					<text class="settings-label" :style="'color:' + mutedColor">翻页</text>
					<view class="page-turn-group">
						<view
							v-for="(m, mi) in pageTurnModes"
							:key="mi"
							class="page-turn-btn"
							:class="pageTurn === m ? 'page-turn-active' : 'page-turn-idle'"
							:style="pageTurn === m ? '' : 'background-color:' + controlBg + ';border-color:' + controlBorder"
							@click="selectPageTurn(m)"
						>
							<text class="page-turn-text" :class="pageTurn === m ? 'page-turn-text-active' : ''" :style="pageTurn === m ? '' : 'color:' + controlText">{{ m }}</text>
						</view>
					</view>
				</view>
			</view>
			<!-- 听书悬浮球（Stitch: 黑底 64px 圆，"听" 28px/900，设置/抽屉展开时隐藏） -->
			<view v-if="!settingsOpen && !drawerOpen" class="listen-wrap">
				<view class="listen-btn" @click="showToast('听书模式即将上线')">
					<text class="listen-text">听</text>
				</view>
			</view>
			<!-- 底部三项导航（Stitch: 目录/夜间/设置） -->
			<view class="bottom-nav">
				<view class="bottom-nav-btn" @click="toggleDrawer">
					<image class="bottom-nav-icon" :src="themeIcon('reader-catalog')" />
					<text class="bottom-nav-text" :style="'color:' + titleColor">目录</text>
				</view>
				<view class="bottom-nav-btn" @click="toggleNightMode">
					<image class="bottom-nav-icon" :src="nightMode ? '/static/icons/reader-sun.svg' : themeIcon('reader-moon')" />
					<text class="bottom-nav-text" :style="'color:' + titleColor">{{ nightMode ? '日间' : '夜间' }}</text>
				</view>
				<view class="bottom-nav-btn" @click="toggleSettings">
					<image class="bottom-nav-icon" :src="themeIcon('reader-settings')" />
					<text class="bottom-nav-text" :style="'color:' + titleColor">设置</text>
				</view>
			</view>
		</view>

		<!-- 书签下拉/移除遮罩（顶部半透明提示条：高度即内容位移量，填补内容下移留出的空白；书签图标在遮罩内右上角随动作变化） -->
			<view
				v-if="pullState != 'none' || pullSettling"
				class="bookmark-mask"
				:class="pullSettling ? 'bookmark-mask-settle' : ''"
				:style="'height:' + maskHeight + 'px;background-color:' + maskBg"
			>
				<image class="bookmark-mask-icon" :src="maskIconSrc" />
				<view class="bookmark-mask-row">
					<text class="bookmark-mask-text" :style="'color:' + maskTextColor">{{ maskText }}</text>
				</view>
			</view>

		<!-- 全局提示（页面正中卡片弹窗，1.5s 自动消失；夜间提亮卡片底色） -->
		<view v-if="toastVisible" class="reader-toast">
			<text class="reader-toast-text" :style="nightMode ? 'background-color:rgba(44, 44, 44, 0.98)' : ''">{{ toastMsg }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { READER_THEME_LIGHT, READER_THEME_NIGHT, READER_THEME_PAPER } from '@/utils/theme.uts'

	type Paragraph = {
		text: string
		/** 划线标记（气泡"划线"后持久为波浪下划线样式） */
		underlined: boolean
	}

	/** 当前页渲染项（origin 为段落在章内的索引，划词状态按其定位） */
	type PageItem = {
		origin: number
		text: string
		underlined: boolean
	}

	type Chapter = {
		id: number
		/** 目录标题（第1章 灵魂融合） */
		title: string
		/** 正文页章节标签（第 1 章 / 扉页） */
		label: string
		/** 正文页大标题 */
		contentTitle: string
		/** 当前阅读章节高亮（由 currentChapterId 驱动） */
		active: boolean
	}

	/** 章节正文示例内容（Stitch 原型 7 段 + 剧情延续示例；后续接入后端按章加载） */
	const paragraphs = ref<Paragraph[]>([
		{ text: '深秋时节，黄叶飘落，恰逢秋雨绵绵，冷风一吹，怎一个愁字了得。', underlined: false } as Paragraph,
		{ text: '李唯独自一人走在公园的小路上，就像是一只被遗弃的流浪狗，从里到外，都是湿漉漉，冰凉凉的。', underlined: false } as Paragraph,
		{ text: '灰败的心情，灰败的天地，像极了他注定灰败的一生。', underlined: false } as Paragraph,
		{ text: '正麻木时。', underlined: false } as Paragraph,
		{ text: '“嘀！”的一声在耳畔响起，这本是寻常的声音，但不知为何，他却有一种时间都被暂停的错觉。', underlined: false } as Paragraph,
		{ text: '连那细密的雨雾，在此刻都清晰可见的被定住。', underlined: false } as Paragraph,
		{ text: '然后，一张灰扑扑的卡片出现在眼前。', underlined: false } as Paragraph,
		{ text: '李唯怔怔地望着那张卡片，卡片表面粗糙得像是被砂纸打磨过，边角处还沾着一点怎么也洗不掉的泥渍。', underlined: false } as Paragraph,
		{ text: '他下意识地环顾四周，公园里空无一人，连方才那种雨雾凝滞的错觉也消失得无影无踪。', underlined: false } as Paragraph,
		{ text: '就在他以为自己出现了幻觉的时候，卡片正中央忽然亮起了一行淡金色的字。', underlined: false } as Paragraph,
		{ text: '【签到成功，获得新手礼包一份】', underlined: false } as Paragraph,
		{ text: '字迹浮现的瞬间，一段陌生的记忆如同潮水般涌进了他的脑海。', underlined: false } as Paragraph
	])

	/** 目录章节与正文页章节信息（Stitch 示例） */
	const chapters = ref<Chapter[]>([
		{ id: 0, title: '扉页', label: '扉页', contentTitle: '扉页', active: false } as Chapter,
		{ id: 1, title: '第1章 灵魂融合', label: '第 1 章', contentTitle: '灵魂融合', active: false } as Chapter,
		{ id: 2, title: '第2章 必须要挖到的第一桶金', label: '第 2 章', contentTitle: '农夫卡', active: true } as Chapter,
		{ id: 3, title: '第3章 临江道院', label: '第 3 章', contentTitle: '临江道院', active: false } as Chapter,
		{ id: 4, title: '第4章 论知识的重要性', label: '第 4 章', contentTitle: '论知识的重要性', active: false } as Chapter,
		{ id: 5, title: '第5章 灵能手臂', label: '第 5 章', contentTitle: '灵能手臂', active: false } as Chapter,
		{ id: 6, title: '第6章 噬生魔', label: '第 6 章', contentTitle: '噬生魔', active: false } as Chapter,
		{ id: 7, title: '第7章 天眷之火', label: '第 7 章', contentTitle: '天眷之火', active: false } as Chapter,
		{ id: 8, title: '第8章 孤注一掷', label: '第 8 章', contentTitle: '孤注一掷', active: false } as Chapter,
		{ id: 9, title: '第9章 第一单买卖', label: '第 9 章', contentTitle: '第一单买卖', active: false } as Chapter,
		{ id: 10, title: '第10章 事实俱在', label: '第 10 章', contentTitle: '事实俱在', active: false } as Chapter,
		{ id: 11, title: '第11章 未来之路', label: '第 11 章', contentTitle: '未来之路', active: false } as Chapter
	])

	/** 当前阅读章节 id（Stitch 展示态：第 2 章 农夫卡；左右滑动翻页切换） */
	const currentChapterId = ref(2)

	/** 当前章节信息（标签/标题/底部进度均由此派生） */
	const currentChapter = computed(() : Chapter => {
		return chapters.value[currentChapterId.value]
	})

	const chapterLabel = computed(() : string => {
		return currentChapter.value.label
	})

	const contentTitle = computed(() : string => {
		return currentChapter.value.contentTitle
	})

	const footerProgress = computed(() : string => {
		return currentChapter.value.label + ' / 共 150 章'
	})

	const footerPercent = computed(() : string => {
		const percent = currentChapterId.value / 150 * 100
		return percent.toFixed(1) + '%'
	})

	/** 当前页码（章内 0-based，左右滑动翻页切换） */
	const pageIndex = ref(0)

	/** 每页字数预算（对应原型一屏排版密度约 160 字；段落不跨页拆分） */
	const PAGE_CHAR_BUDGET = 160

	/** 分页结果：每页的章内段落索引数组 */
	const pageBreaks = computed(() : number[][] => {
		const paras = paragraphs.value
		const pages: number[][] = []
		let current: number[] = []
		let count = 0
		for (let i = 0; i < paras.length; i++) {
			current.push(i)
			count += paras[i].text.length
			if (count >= PAGE_CHAR_BUDGET) {
				pages.push(current)
				current = []
				count = 0
			}
		}
		if (current.length > 0) {
			pages.push(current)
		}
		return pages
	})

	/** 指定页渲染项 */
	function pageItemsAt(pi : number) : PageItem[] {
		const paras = paragraphs.value
		const breaks = pageBreaks.value
		const page = pi >= 0 && pi < breaks.length ? breaks[pi] : []
		return page.map((i) : PageItem => {
			return { origin: i, text: paras[i].text, underlined: paras[i].underlined } as PageItem
		})
	}

	/** 当前页渲染项（随 pageIndex 变化） */
	const currentPageItems = computed(() : PageItem[] => {
		return pageItemsAt(pageIndex.value)
	})

	/** 上下滚动模式：整章段落连续渲染（滚动多少显示多少） */
	const allParagraphItems = computed(() : PageItem[] => {
		return paragraphs.value.map((p, i) : PageItem => {
			return { origin: i, text: p.text, underlined: p.underlined } as PageItem
		})
	})

	/** 滚动模式程序滚动位置（绑 :scroll-top，仅切章复位/置底时更新，避免与原生滚动形成反馈循环） */
	const scrollModeTop = ref(0)
	/** 滚动模式实际阅读位置（@scroll 实时记录，用于进度持久化） */
	const scrollModePos = ref(0)
	/** 滚动模式已加载的章节 id 序列（滚到底自动追加下一章，滚到顶自动前插上一章） */
	const scrollChapters = ref<number[]>([currentChapterId.value])
	/** 滚动锚点：前插上一章后定位回原首章顶部，视口保持不跳 */
	const scrollIntoView = ref('')

	/** ===== 阅读进度（章节/页码/滚动位置）本地持久化 ===== */
	type ReaderProgress = {
		chapterId: number
		pageIndex: number
		scrollTop: number
	}

	const STORAGE_PROGRESS = 'reader_progress'

	function saveProgress() : void {
		const p = { chapterId: currentChapterId.value, pageIndex: pageIndex.value, scrollTop: scrollModePos.value } as ReaderProgress
		uni.setStorageSync(STORAGE_PROGRESS, JSON.stringify(p))
	}

	/** 滚动模式实时滚动位置（仅内存记录，随 onHide/onUnload 持久化） */
	function onScrollModeScroll(e : UniScrollEvent) : void {
		scrollModePos.value = e.detail.scrollTop
	}

	/** 启动恢复上次阅读进度（章节/页码/滚动位置） */
	{
		const stored : any = uni.getStorageSync(STORAGE_PROGRESS)
		if (typeof stored == 'string' && (stored as string).length > 0) {
			const p = JSON.parse<ReaderProgress>(stored as string)
			if (p != null && p.chapterId >= 0 && p.chapterId < chapters.value.length) {
				currentChapterId.value = p.chapterId
				if (p.pageIndex >= 0 && p.pageIndex < pageBreaks.value.length) {
					pageIndex.value = p.pageIndex
				}
				scrollChapters.value = [p.chapterId]
				scrollModeTop.value = p.scrollTop > 0 ? p.scrollTop : 0
				scrollModePos.value = scrollModeTop.value
			}
		}
	}

	onUnload(() => {
		saveProgress()
	})

	onHide(() => {
		saveProgress()
	})

	/** 滚动到底：自动加载下一章；末章给出到底提示 */
	function onScrollToLower() : void {
		const last = scrollChapters.value[scrollChapters.value.length - 1]
		if (last < chapters.value.length - 1) {
			const next = last + 1
			scrollChapters.value.push(next)
			currentChapterId.value = next
			saveProgress()
		} else {
			showToast('已经是最后一章')
		}
	}

	/** 滚动到顶：自动前插上一章；首章给出到顶提示 */
	function onScrollToUpper() : void {
		const first = scrollChapters.value[0]
		if (first > 0) {
			scrollIntoView.value = ''
			scrollChapters.value.unshift(first - 1)
			currentChapterId.value = first - 1
			saveProgress()
			setTimeout(() => {
				scrollIntoView.value = 'scroll-ch-' + first
			}, 50)
		} else {
			showToast('已经是第一章')
		}
	}

	/** 指定章的段落渲染项（key 带章 id 防止多章同段落索引冲突） */
	function chapterParagraphItems(cid : number) : PageItem[] {
		return paragraphs.value.map((p, i) : PageItem => {
			return { origin: i, text: p.text, underlined: p.underlined } as PageItem
		})
	}

	/** ===== 翻页动画（仿真/覆盖/平移/上下：跟手位移 + 松手落定/回弹） ===== */
	const flipActive = ref(false)
	/** 翻页方向：1 下一页 / -1 上一页 */
	const flipDir = ref(0)
	/** 跟手位移（px，0 至页宽/页高） */
	const flipOffset = ref(0)
	const flipSettling = ref(false)
	/** 仿真卷曲旋转轴纵向位置（触点 Y 百分比） */
	const curlOriginY = ref(100)

	/** 跟手目标页索引（仅章内有效；越章界为 -1，目标层不渲染，松手走 flipPage 边界逻辑） */
	const flipTargetIndex = computed(() : number => {
		if (!flipActive.value || flipDir.value == 0) {
			return -1
		}
		const t = pageIndex.value + flipDir.value
		if (t < 0 || t > pageBreaks.value.length - 1) {
			return -1
		}
		return t
	})

	const flipTargetItems = computed(() : PageItem[] => {
		const t = flipTargetIndex.value
		if (t < 0) {
			return []
		}
		return pageItemsAt(t)
	})

	/** 当前页层样式：按翻页模式产生位移/卷曲与层级（跟手与回弹共用） */
	const currentLayerStyle = computed(() : string => {
		if (!flipActive.value && !flipSettling.value) {
			return ''
		}
		const o = flipOffset.value
		const d = flipDir.value
		const mode = pageTurn.value
		if (mode == '平移') {
			return 'transform:translateX(' + (d * o * -1) + 'px);z-index:1'
		}
		if (mode == '仿真') {
			if (d == 1) {
				// 前翻：整层静置（波次卷曲由页内各段落分别变换），左缘投影随卷曲层
				return 'z-index:2;box-shadow:-10px 0 30px rgba(0, 0, 0, 0.3)'
			}
			if (d == -1) {
				// 回翻：当前页向右滑出露出下层旧页
				return 'transform:translateX(' + o + 'px);z-index:2'
			}
			return 'z-index:1'
		}
		if (mode == '覆盖') {
			if (d == -1) {
				return 'transform:translateX(' + o + 'px);z-index:2'
			}
			return 'z-index:1'
		}
		return ''
	})

	/** 目标页层样式：按翻页模式从页外滑入或静置下层 */
	const targetLayerStyle = computed(() : string => {
		if (!flipActive.value || flipDir.value == 0) {
			return ''
		}
		const d = flipDir.value
		const mode = pageTurn.value
		if (mode == '平移') {
			const o = flipOffset.value
			return 'transform:translateX(' + (d * (pageW.value - o)) + 'px);z-index:2'
		}
		if (mode == '覆盖') {
			if (d == 1) {
				const o = flipOffset.value
				// 前翻：目标页自右侧滑入覆盖
				return 'transform:translateX(' + (pageW.value - o) + 'px);z-index:2'
			}
			return 'z-index:1'
		}
		if (mode == '仿真') {
			// 仿真：目标页静置下层，被卷起的当前页覆盖其上
			return 'z-index:1'
		}
		return ''
	})

	/** 当前页卷曲波次行数（章节头 + 段落数） */
	const curlTotal = computed(() : number => {
		return currentPageItems.value.length + (pageIndex.value === 0 ? 1 : 0)
	})

	/** 仿真卷曲：段落波次变换（页尾先卷起，向前传播；j=0 为章节头） */
	function paragraphCurlStyle(j : number, total : number) : string {
		if (pageTurn.value != '仿真' || flipDir.value != 1 || !flipActive.value) {
			return ''
		}
		const p = pageW.value > 0 ? flipOffset.value / pageW.value : 0
		const pj = Math.max(0, Math.min(1, p * total - (total - 1 - j)))
		if (pj <= 0) {
			return ''
		}
		return 'transform:translateX(' + (-60 * pj) + 'px);opacity:' + (1 - 0.4 * pj).toFixed(2)
	}

	/** 仿真投影样式：跟随卷曲前缘落在下层页面上 */
	const curlShadowStyle = computed(() : string => {
		if (pageTurn.value != '仿真' || flipDir.value != 1) {
			return ''
		}
		const p = pageW.value > 0 ? flipOffset.value / pageW.value : 0
		const frontX = pageW.value * (1 - p)
		return 'left:' + Math.max(0, frontX - 60) + 'px;opacity:' + Math.min(1, p * 2).toFixed(2)
	})

	/** 主题状态（色值唯一定义于 utils/theme.uts：日间=画布令牌，夜间/纸张为阅读专用主题） */
	const nightMode = ref(false)
	const readerBg = ref(READER_THEME_LIGHT.readerBg)
	const bodyColor = ref(READER_THEME_LIGHT.bodyColor)
	const titleColor = ref(READER_THEME_LIGHT.titleColor)
	/** 章节标签色：原型内联样式为墨色（覆盖灰色类），日间墨色、夜间浅灰 */
	const labelColor = ref(READER_THEME_LIGHT.labelColor)
	const mutedColor = ref(READER_THEME_LIGHT.mutedColor)
	const chapterTextColor = ref(READER_THEME_LIGHT.chapterTextColor)
	const menuTopBg = ref(READER_THEME_LIGHT.menuTopBg)
	const menuBottomBg = ref(READER_THEME_LIGHT.menuBottomBg)
	const menuBorderColor = ref(READER_THEME_LIGHT.menuBorderColor)
	const activeBlue = ref(READER_THEME_LIGHT.activeBlue)
	/** 书签遮罩背景与文字色（夜间浅白遮罩 + 深色文字，与暗底视觉区分） */
	const maskBg = ref(READER_THEME_LIGHT.maskBg)
	const maskTextColor = ref(READER_THEME_LIGHT.maskTextColor)
	/** 划词气泡背景（夜间提亮与暗底区分） */
	const popoverBg = ref(READER_THEME_LIGHT.popoverBg)
	/** 设置面板控件色（夜间灰底白字突出，日间白底墨字） */
	const controlBg = ref('#ffffff')
	const controlBorder = ref('#e9e9e6')
	const controlText = ref('#0e0f0c')
	/** 底部控制栏投影（夜间切换白色微光） */
	const panelShadow = ref(READER_THEME_LIGHT.panelShadow)

	/** 阅读设置（Stitch: 字号 12-36、背景色板、翻页模式） */
	const fontSize = ref(18)
	const selectedBg = ref(READER_THEME_LIGHT.readerBg)
	const pageTurnModes = ref<string[]>(['仿真', '覆盖', '平移', '滚动'])
	const pageTurn = ref('仿真')
	/** 当前主题 key：light / night / paper */
	const themeKey = ref('light')

	/** 浮层状态（进入阅读默认正文全屏，点击正文空白切换控制项显隐） */
	const menuVisible = ref(false)
	const settingsOpen = ref(false)
	const drawerOpen = ref(false)
	const orderDesc = ref(false)
	/** 抽屉当前页签：catalog 目录 / bookmark 书签 */
	const drawerTab = ref('catalog')

	/** 顶部导航内容行（px）：与小程序胶囊同行对齐（同子页 BackButton 口径：状态栏高度起、行高 40px） */
	const navTop = ref(44)
	const navHeight = ref(40)
	/** 目录抽屉高度（px）：抽屉顶对齐小程序控制项（胶囊）下方 8px，并扣除控制行自身高度（152rpx） */
	const drawerPanelHeight = ref(500)
	/** 翻页行程：页面内容宽/高（px） */
	const pageW = ref(0)
	const pageH = ref(0)
	{
		const win = uni.getWindowInfo()
		if (win.statusBarHeight > 0) {
			navTop.value = win.statusBarHeight
		}
		pageW.value = win.windowWidth - uni.upx2px(124)
		pageH.value = win.windowHeight
		const navH = uni.upx2px(152)
		// #ifdef MP-WEIXIN
		const capsule = uni.getMenuButtonBoundingClientRect()
		if (capsule.height > 0) {
			drawerPanelHeight.value = win.windowHeight - (capsule.top + capsule.height + 8) - navH
		} else {
			drawerPanelHeight.value = win.windowHeight - (navTop.value + navHeight.value + 8) - navH
		}
		// #endif
		// #ifndef MP-WEIXIN
		drawerPanelHeight.value = win.windowHeight - (navTop.value + navHeight.value + 8) - navH
		// #endif
	}

	/** ===== 书签（正文下滑切换：无书签时添加、有书签时删除；本地持久化） ===== */
	type Bookmark = {
		chapterId: number
		/** 章内页码（0-based） */
		pageIndex: number
	}

	const STORAGE_BOOKMARKS = 'reader_bookmarks'

	const bookmarks = ref<Bookmark[]>([])

	/** 读取本地书签 */
	{
		const stored : any = uni.getStorageSync(STORAGE_BOOKMARKS)
		if (typeof stored == 'string' && (stored as string).length > 0) {
			const list = JSON.parse<Array<Bookmark>>(stored as string)
			if (list != null) {
				bookmarks.value = list
			}
		}
	}

	/** 当前页是否已有书签 */
	function indexOfBookmark() : number {
		for (let i = 0; i < bookmarks.value.length; i++) {
			const b = bookmarks.value[i]
			if (b.chapterId == currentChapterId.value && b.pageIndex == pageIndex.value) {
				return i
			}
		}
		return -1
	}

	/** 书签标记（右上角旗帜）是否展示：滚动模式无页码概念，仅分页模式展示 */
	const bookmarkFlagVisible = computed(() : boolean => {
		if (pageTurn.value == '滚动') {
			return false
		}
		return indexOfBookmark() >= 0
	})

	/** 下拉添加进行中：正文纵向下拉超阈值时顶部出现「下拉添加书签」遮罩，松手落定 */
	const pullState = ref('none')
	/** 下拉位移量（px，阻尼映射）：正文内容跟手下移，顶部遮罩同步增高填补空白 */
	const pullOffset = ref(0)
	/** 松手回弹中：位移与遮罩高度以过渡动画归零（添加落定或取消取消均回弹归位） */
	const pullSettling = ref(false)
	/** 遮罩总高（px）：等于内容位移量（遮罩从 0 随下拉长出，内容顶贴遮罩底缘） */
	const maskHeight = computed(() : number => {
		return pullOffset.value
	})

	/** 遮罩提示文案（随添加/移除态切换） */
	const maskText = computed(() : string => {
		if (pullState.value == 'removing') {
			return '↑ 松手移除书签'
		}
		return '↓ 下拉添加书签'
	})

	/** 遮罩内书签图标：夜间浅白遮罩上用墨色描边的日间版图标保证对比，其余用主题变体 */
	const maskIconSrc = computed(() : string => {
		const name = pullState.value == 'removing' ? 'reader-bookmark-active' : 'reader-bookmark'
		return nightMode.value ? '/static/icons/' + name + '.svg' : themeIcon(name)
	})

	/** ===== 正文字体（默认思源黑体，未安装时经回退链落到系统黑体；选择后本地持久化） ===== */
	type FontOption = {
		key: string
		label: string
		/** CSS 字体栈：缺失字体自动回退到后续项，末位 sans-serif 即系统黑体 */
		family: string
	}

	const STORAGE_FONT = 'reader_font'

	const fontOptions : FontOption[] = [
		{ key: 'sourcehan', label: '思源黑体', family: "'Source Han Sans SC', 'Noto Sans SC', sans-serif" } as FontOption,
		{ key: 'system', label: '系统黑体', family: 'sans-serif' } as FontOption,
		{ key: 'songti', label: '宋体', family: "'Source Han Serif SC', 'SimSun', serif" } as FontOption,
		{ key: 'kaiti', label: '楷体', family: 'KaiTi, STKaiti, serif' } as FontOption
	]

	const fontKey = ref('sourcehan')
	/** 字体列表中的待保存选择 */
	const pendingFontKey = ref('sourcehan')
	const fontListOpen = ref(false)

	{
		const stored : any = uni.getStorageSync(STORAGE_FONT)
		if (typeof stored == 'string') {
			const key = stored as string
			for (let i = 0; i < fontOptions.length; i++) {
				if (fontOptions[i].key == key) {
					fontKey.value = key
					pendingFontKey.value = key
					break
				}
			}
		}
	}

	function fontOptionOf(key : string) : FontOption {
		for (let i = 0; i < fontOptions.length; i++) {
			if (fontOptions[i].key == key) {
				return fontOptions[i]
			}
		}
		return fontOptions[0]
	}

	/** 当前生效字体名（字体按钮展示） */
	const currentFontLabel = computed(() : string => {
		return fontOptionOf(fontKey.value).label
	})

	/** 当前生效字体栈（应用至正文） */
	const fontFamily = computed(() : string => {
		return fontOptionOf(fontKey.value).family
	})

	/** 展开/收起字体列表（展开时待保存选择重置为当前生效值） */
	function toggleFontList() : void {
		fontListOpen.value = !fontListOpen.value
		pendingFontKey.value = fontKey.value
	}

	function selectFont(key : string) : void {
		pendingFontKey.value = key
	}

	/** 保存字体选择并应用 */
	function saveFont() : void {
		fontKey.value = pendingFontKey.value
		uni.setStorageSync(STORAGE_FONT, fontKey.value)
		fontListOpen.value = false
		showToast('字体已保存')
	}

	/** 取消字体选择：放弃待保存选择并收起列表 */
	function cancelFontSelect() : void {
		pendingFontKey.value = fontKey.value
		fontListOpen.value = false
	}

	function saveBookmarks() : void {
		uni.setStorageSync(STORAGE_BOOKMARKS, JSON.stringify(bookmarks.value))
	}

	function addBookmark() : void {
		if (indexOfBookmark() >= 0) {
			return
		}
		bookmarks.value.push({ chapterId: currentChapterId.value, pageIndex: pageIndex.value } as Bookmark)
		saveBookmarks()
	}

	function removeBookmark() : void {
		const i = indexOfBookmark()
		if (i < 0) {
			return
		}
		bookmarks.value.splice(i, 1)
		saveBookmarks()
	}

	/** 书签条目文案（章节标签 · 第 N 页，页码 1-based 展示） */
	function bookmarkLabel(bm : Bookmark) : string {
		const ch = bm.chapterId >= 0 && bm.chapterId < chapters.value.length ? chapters.value[bm.chapterId] : chapters.value[0]
		return ch.title + ' · 第 ' + (bm.pageIndex + 1) + ' 页'
	}

	/** 跳转到书签所在章节页并关闭抽屉 */
	function goToBookmark(bm : Bookmark) : void {
		goToChapter(bm.chapterId, false)
		pageIndex.value = bm.pageIndex
		saveProgress()
		drawerOpen.value = false
	}

	/** 抽屉页签切换（进入目录页签时恢复正序浏览态由 orderDesc 独立控制） */
	function switchDrawerTab(tab : string) : void {
		drawerTab.value = tab
	}

	/** 目录页签排序箭头：阻止冒泡后切换正/倒序 */
	function onSortTap(e : UniPointerEvent) : void {
		e.stopPropagation()
		toggleOrder()
	}

	/** 划词状态（Stitch: 长按选中段落 22%-72% 区间） */
	const selectedIdx = ref(-1)
	const selBefore = ref('')
	const selSelected = ref('')
	const selAfter = ref('')

	/** 启动恢复本地设置（字号/翻页模式/主题） */
	{
		const stored : any = uni.getStorageSync(STORAGE_SETTINGS)
		if (typeof stored == 'string' && (stored as string).length > 0) {
			const s = JSON.parse<ReaderSettings>(stored as string)
			if (s != null) {
				if (s.fontSize >= 12 && s.fontSize <= 36) {
					fontSize.value = s.fontSize
				}
				if (s.pageTurn == '仿真' || s.pageTurn == '覆盖' || s.pageTurn == '平移' || s.pageTurn == '滚动') {
					pageTurn.value = s.pageTurn
				}
				if (s.theme == 'night' || s.theme == 'paper') {
					applyReaderTheme(s.theme)
				}
			}
		}
	}

	/** Toast（Stitch: 顶部 96px 黑底胶囊 1.5s 自动消失） */
	const toastVisible = ref(false)
	const toastMsg = ref('')
	let toastTimer = -1

	/** 主题图标路径：夜间使用 -light 白色变体 */
	function themeIcon(name: string) : string {
		return '/static/icons/' + name + (nightMode.value ? '-light' : '') + '.svg'
	}

	/** 目录抽屉内目录按钮图标（日间蓝/夜间浅蓝） */
	const drawerCatalogIcon = computed(() : string => {
		return nightMode.value ? '/static/icons/reader-catalog-blue-light.svg' : '/static/icons/reader-catalog-blue.svg'
	})

	/** 目录正/倒序展示（Stitch: ⇅/↓↑ 切换） */
	/** 目录正/倒序展示（Stitch: ⇅/↓↑ 切换；当前阅读章节蓝色高亮由 currentChapterId 驱动） */
	const displayChapters = computed(() : Chapter[] => {
		const list = chapters.value
		const marked = list.map((c) : Chapter => {
			return {
				id: c.id,
				title: c.title,
				label: c.label,
				contentTitle: c.contentTitle,
				active: c.id === currentChapterId.value
			} as Chapter
		})
		if (!orderDesc.value) {
			return marked
		}
		return marked.slice().reverse()
	})

	/** 左右滑动翻页手势（Stitch 设置面板"翻页"模式：左滑下一章、右滑上一章，水平位移阈值避免与纵向滚动冲突） */
	let touchStartX = 0
	let touchStartY = 0

	function onContentTouchStart(e: UniTouchEvent) : void {
		pullSettling.value = false
		flipSettling.value = false
		touchStartX = e.touches[0].clientX
		touchStartY = e.touches[0].clientY
	}

	function onContentTouchMove(e: UniTouchEvent) : void {
		if (e.touches.length == 0 || pageTurn.value == '滚动') {
			// 上下滚动模式：滚动由 scroll-view 原生处理，不启用翻页/书签手势
			return
		}
		const dx = e.touches[0].clientX - touchStartX
		const dy = e.touches[0].clientY - touchStartY
		// 翻页跟手：按模式取主轴（上下模式取纵向，其余取横向）
		const verticalMode = pageTurn.value == '滚动'
		const primary = verticalMode ? dy : dx
		const secondary = verticalMode ? dx : dy
		const gesture = Math.abs(primary) > 20 && Math.abs(primary) > Math.abs(secondary) * 1.5
		if (gesture) {
			const dir = primary < 0 ? 1 : -1
			flipSettling.value = false
			flipActive.value = true
			flipDir.value = dir
			// 翻页跟手开始：默认隐藏上下控制项（落定后保持正文全屏，点击正文重新呼出）
			menuVisible.value = false
			if (pageTurn.value == '仿真' && dir == 1 && !verticalMode) {
				// 仿真前翻：卷曲进度与旋转轴跟随触点绝对位置（手指位置即卷曲位置）
				const relX = e.touches[0].clientX - uni.upx2px(62)
				flipOffset.value = Math.max(0, Math.min(pageW.value, pageW.value - relX))
				curlOriginY.value = Math.max(20, Math.min(100, e.touches[0].clientY / pageH.value * 100))
			} else {
				// 回翻/其他模式：按手势位移映射
				const span = verticalMode ? pageH.value : pageW.value
				flipOffset.value = Math.min(Math.abs(primary), span)
			}
			return
		}
		// 无书签：下拉进入「添加」提示态；有书签：下拉进入「移除」提示态——位移均跟手（阻尼映射）
		const vertical = dy > 40 && dy > Math.abs(dx) * 1.5
		if (bookmarkFlagVisible.value) {
			if (vertical) {
				pullOffset.value = Math.min((dy - 40) * 0.6, 240)
				pullState.value = 'removing'
			} else if (pullState.value == 'removing') {
				pullOffset.value = 0
				pullState.value = 'none'
			}
			return
		}
		if (vertical) {
			pullOffset.value = Math.min((dy - 40) * 0.6, 240)
			pullState.value = 'adding'
		} else if (pullState.value == 'adding') {
			// 拖回阈值内：位移跟手收回，松手即取消
			pullOffset.value = 0
			pullState.value = 'none'
		}
	}

	function onContentTouchEnd(e: UniTouchEvent) : void {
		if (pageTurn.value == '滚动') {
			return
		}
		const dx = e.changedTouches[0].clientX - touchStartX
		const dy = e.changedTouches[0].clientY - touchStartY
		// 翻页跟手收尾：位移过阈值（或快速轻扫）落定翻页，否则回弹归位
		if (flipActive.value) {
			const done = flipOffset.value > pageW.value * 0.35 || Math.abs(dx) > 80
			if (done) {
				flipSettling.value = true
				flipActive.value = false
				const d = flipDir.value
				flipDir.value = 0
				flipOffset.value = 0
				flipPage(d)
				setTimeout(() => {
					flipSettling.value = false
				}, 300)
			} else {
				flipSettling.value = true
				flipOffset.value = 0
				setTimeout(() => {
					flipSettling.value = false
					flipActive.value = false
					flipDir.value = 0
				}, 300)
			}
			return
		}
		// 快速水平轻扫（未进入跟手态）：直接翻页
		if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 2) {
			flipPage(dx < 0 ? 1 : -1)
			settlePull()
			return
		}
		const vertical = dy > 40 && dy > Math.abs(dx) * 1.5
		// 下拉态松手：仍拉起则落定（添加/移除书签），否则为取消——两者均回弹归位
		if (pullState.value == 'adding') {
			if (vertical) {
				addBookmark()
			}
			settlePull()
		} else if (pullState.value == 'removing') {
			if (vertical) {
				removeBookmark()
			}
			settlePull()
		}
	}

	/** 回弹归位：内容位移与遮罩高度以过渡动画归零（松手后触发，触摸重新按下时立即恢复跟手） */
	function settlePull() : void {
		if (pullOffset.value == 0 && pullState.value == 'none') {
			return
		}
		pullSettling.value = true
		pullOffset.value = 0
		pullState.value = 'none'
		setTimeout(() => {
			pullSettling.value = false
		}, 350)
	}

	/** 翻页（左滑下一页、右滑上一页；章首/章尾越界时切换上一章末页/下一章首页，Stitch 边界 toast 提示） */
	function flipPage(delta: number) : void {
		const totalPages = pageBreaks.value.length
		const next = pageIndex.value + delta
		if (next < 0) {
			if (currentChapterId.value === 0) {
				showToast('已经是第一章')
				return
			}
			goToChapter(currentChapterId.value - 1, true)
			return
		}
		if (next > totalPages - 1) {
			if (currentChapterId.value === chapters.value.length - 1) {
				showToast('已经是最后一章')
				return
			}
			goToChapter(currentChapterId.value + 1, false)
			return
		}
		pageIndex.value = next
		clearSelection()
		saveProgress()
	}

	/** 切换章节并定位页（进入新章默认首页，回退上一章定位末页；滚动模式复位章节序列与滚动位置） */
	function goToChapter(id: number, atLastPage: boolean) : void {
		currentChapterId.value = id
		pageIndex.value = atLastPage ? pageBreaks.value.length - 1 : 0
		scrollChapters.value = [id]
		scrollModeTop.value = atLastPage ? 999999 : 0
		scrollModePos.value = scrollModeTop.value
		scrollIntoView.value = ''
		clearSelection()
		saveProgress()
	}

	function showToast(msg: string) : void {
		toastMsg.value = msg
		toastVisible.value = true
		if (toastTimer >= 0) {
			clearTimeout(toastTimer)
		}
		toastTimer = setTimeout(() => {
			toastVisible.value = false
		}, 1500)
	}

	/** 点击正文空白（Stitch: 抽屉打开→收起；划词激活→清除；设置展开→收起；否则切换菜单显隐） */
	function onContentTap() : void {
		if (drawerOpen.value) {
			closeDrawer()
			menuVisible.value = true
			return
		}
		if (selectedIdx.value >= 0) {
			clearSelection()
			return
		}
		if (settingsOpen.value) {
			closeSettings()
			return
		}
		menuVisible.value = !menuVisible.value
		if (menuVisible.value) {
			settingsOpen.value = false
		}
	}

	function onBackTap() : void {
		uni.navigateBack()
	}

	/** 长按段落：选中 22%-72% 区间（Stitch: triggerSelectionOnElement） */
	function onLongPress(pi: number) : void {
		const p = paragraphs.value[pi]
		menuVisible.value = false
		settingsOpen.value = false
		if (p.text.length > 8) {
			const startIdx = Math.floor(p.text.length * 0.22)
			const endIdx = Math.floor(p.text.length * 0.72)
			selBefore.value = p.text.slice(0, startIdx)
			selSelected.value = p.text.slice(startIdx, endIdx)
			selAfter.value = p.text.slice(endIdx)
		} else {
			selBefore.value = ''
			selSelected.value = p.text
			selAfter.value = ''
		}
		selectedIdx.value = pi
	}

	function clearSelection() : void {
		selectedIdx.value = -1
	}

	/** 划词气泡操作（Stitch: 复制/写想法/划线） */
	function onPopoverAction(action: string) : void {
		if (action === 'copy') {
			uni.setClipboardData({
				data: selSelected.value,
				success: () => {
					showToast('已复制到剪贴板')
				}
			})
			setTimeout(() => {
				clearSelection()
			}, 500)
		} else if (action === 'idea') {
			showToast('进入想法编辑器')
			setTimeout(() => {
				clearSelection()
			}, 500)
		} else {
			const p = paragraphs.value[selectedIdx.value]
			if (p != null) {
				p.underlined = true
			}
			showToast('已划线标注')
			selectedIdx.value = -1
		}
	}

	/** 设置面板开关（Stitch: 展开时隐藏顶栏与听书球） */
	function toggleSettings() : void {
		settingsOpen.value = !settingsOpen.value
		if (settingsOpen.value) {
			// 与目录抽屉互斥：打开设置时收起抽屉并回到菜单呼出态（控制栏保留展示设置表单）
			drawerOpen.value = false
			menuVisible.value = true
		}
	}

	function closeSettings() : void {
		settingsOpen.value = false
	}

	/** 字号调节（Stitch: 12-36px 范围，实时作用于正文） */
	function changeFontSize(delta: number) : void {
		const next = fontSize.value + delta
		if (next < 12 || next > 36) {
			return
		}
		fontSize.value = next
		saveReaderSettings()
	}

	/** 背景色板切换（Stitch: 纯白/暖米黄，正文与标题色跟随；浮层重置为日间主题） */
	/** 本地设置（字号/翻页模式/主题）持久化 */
	type ReaderSettings = {
		fontSize: number
		pageTurn: string
		theme: string
	}

	const STORAGE_SETTINGS = 'reader_settings'

	/** 应用阅读主题（整组成组切换：正文/浮层/遮罩/控件色） */
	function applyReaderTheme(key : string) : void {
		let theme = READER_THEME_LIGHT
		if (key == 'night') {
			theme = READER_THEME_NIGHT
		} else if (key == 'paper') {
			theme = READER_THEME_PAPER
		}
		themeKey.value = key
		nightMode.value = key == 'night'
		readerBg.value = theme.readerBg
		selectedBg.value = theme.readerBg
		bodyColor.value = theme.bodyColor
		titleColor.value = theme.titleColor
		labelColor.value = theme.labelColor
		mutedColor.value = theme.mutedColor
		chapterTextColor.value = theme.chapterTextColor
		menuTopBg.value = theme.menuTopBg
		menuBottomBg.value = theme.menuBottomBg
		menuBorderColor.value = theme.menuBorderColor
		activeBlue.value = theme.activeBlue
		maskBg.value = theme.maskBg
		maskTextColor.value = theme.maskTextColor
		popoverBg.value = theme.popoverBg
		panelShadow.value = theme.panelShadow
		if (key == 'night') {
			// 夜间：控件灰底白字，与暗面板区分且文字突出
			controlBg.value = '#3a3a3a'
			controlBorder.value = 'rgba(255, 255, 255, 0.12)'
			controlText.value = '#f3f4f6'
		} else {
			controlBg.value = '#ffffff'
			controlBorder.value = '#e9e9e6'
			controlText.value = '#0e0f0c'
		}
	}

	function saveReaderSettings() : void {
		const s = { fontSize: fontSize.value, pageTurn: pageTurn.value, theme: themeKey.value } as ReaderSettings
		uni.setStorageSync(STORAGE_SETTINGS, JSON.stringify(s))
	}

	function changeReaderBg(bg: string, text: string) : void {
		selectedBg.value = bg
		applyReaderTheme(bg == READER_THEME_PAPER.readerBg ? 'paper' : 'light')
		saveReaderSettings()
	}

	/** 翻页模式选择（Stitch: 单选高亮 + toast；切至滚动模式以当前章初始化章节序列） */
	function selectPageTurn(mode: string) : void {
		pageTurn.value = mode
		if (mode == '滚动') {
			scrollChapters.value = [currentChapterId.value]
			scrollModeTop.value = 0
		}
		saveReaderSettings()
		showToast('已切换至【' + mode + '】模式')
	}

	/** 日/夜切换（主题成组取自 utils/theme.uts） */
	function toggleNightMode() : void {
		applyReaderTheme(nightMode.value ? 'light' : 'night')
		saveReaderSettings()
		showToast(nightMode.value ? '已切换至夜间模式' : '已切换至日间模式')
	}

	/** 目录抽屉（Stitch: 遮罩渐显 + 抽屉顶部下滑 0.32s） */
	/** 目录按钮：切换抽屉（打开时顶部控制栏收起、抽屉标题位于小程序控制项下方；再次点击收起抽屉、回到菜单呼出态，控制项保留） */
	function toggleDrawer() : void {
		if (drawerOpen.value) {
			closeDrawer()
			menuVisible.value = true
			return
		}
		// 与设置面板互斥：打开抽屉时收起设置面板与顶部控制栏
		settingsOpen.value = false
		menuVisible.value = false
		drawerTab.value = 'catalog'
		drawerOpen.value = true
	}

	function closeDrawer() : void {
		drawerOpen.value = false
	}

	/** 目录正/倒序（Stitch: ⇅/↓↑ 图标 + toast） */
	function toggleOrder() : void {
		orderDesc.value = !orderDesc.value
		showToast(orderDesc.value ? '已切换至倒序排列' : '已切换至正序排列')
	}

	/** 章节点击（Stitch: 高亮切换 + toast + 260ms 后收起抽屉） */
	function selectChapter(ch: Chapter) : void {
		goToChapter(ch.id, false)
		if (ch.title.indexOf('第1章') >= 0) {
			showToast('当前正在阅读此章节')
		} else {
			showToast('已跳转至 ' + ch.title)
		}
		setTimeout(() => {
			drawerOpen.value = false
		}, 260)
	}
</script>

<style lang="scss">
	.page {
		flex: 1;
		position: relative;
		overflow: hidden;
	}

	/* 阅读内容区（Stitch: 左右 32px、上 80px、下 16px，上下两端分布） */
	.content {
		flex: 1;
		padding-left: 62rpx;
		padding-right: 62rpx;
		padding-top: 154rpx;
		padding-bottom: 31rpx;
		flex-direction: column;
		justify-content: space-between;
	}

	/* 页面层堆叠容器：翻页动画的舞台（溢出裁剪） */
	.page-stack {
		flex: 1;
		overflow: hidden;
	}

	/* 上下滚动模式：整章连续滚动容器（滚轮/触摸原生滚动） */
	.scroll-mode {
		flex: 1;
	}

	.scroll-mode-inner {
		padding-bottom: 31rpx;
		flex-direction: column;
	}

	/* 章前间距锚点（140rpx）：前插上一章后 scroll-into-view 锚定此锚点，视口完整呈现「上一章尾部 → 间距 → 标题」 */
	.scroll-chapter-anchor {
		height: 140rpx;
	}

	.page-layer {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
	}

	/* 松手回弹/落定：层位移以过渡动画归位 */
	.page-layer-settle {
		transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* 仿真模式阴影条：跟随移动页前缘模拟纸张翻起的投影 */
	.page-layer-shadow {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 40rpx;
		background-image: linear-gradient(90deg, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0));
	}

	/* 仿真卷曲投影：落在下层页面上、跟随卷曲前缘的横向渐变暗带 */
	.page-curl-shadow {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 60px;
		background-image: linear-gradient(90deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.35));
	}

	/* 章节头部（Stitch: 标签行 + 大标题 + 分隔条，与正文间距 56px） */
	.chapter-header {
		margin-bottom: 108rpx;
	}

	.chapter-label-row {
		flex-direction: row;
		align-items: center;
		gap: 15rpx;
		margin-bottom: 15rpx;
	}

	.chapter-label-dot {
		width: 12rpx;
		height: 12rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-positive;
	}

	.chapter-label {
		font-size: 25rpx;
		font-weight: 600;
	}

	.chapter-title {
		font-size: 69rpx;
		font-weight: 900;
		margin-bottom: 31rpx;
	}

	.chapter-divider {
		width: 92rpx;
		height: 8rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-ink;
		opacity: 0.9;
	}

	/* 正文（Stitch: 行距 1.95、首行缩进 2em、字距 0.02em、两端对齐、段落间距 21px） */
	.novel-body {
		flex-direction: column;
		gap: 40rpx;
	}

	.novel-paragraph {
		position: relative;
	}

	.novel-text {
		line-height: 1.95;
		letter-spacing: 0.4rpx;
		text-align: justify;
	}

	/* 划线标注（Stitch: 划线持久为下划线样式，颜色取弱文本 mute） */
	.para-underlined {
		text-decoration: underline;
		text-decoration-style: wavy;
		text-decoration-color: $bai-mute;
	}

	/* 划词高亮（Stitch: 正蓝 14% 背景；微圆角 2px，rounded 令牌未覆盖，保留字面值） */
	.para-highlight {
		background-color: rgba($bai-positive, 0.14);
		border-radius: 4rpx;
	}

	/* 底部进度（Stitch: 上 40px 下 24px 两端分布） */
	.reader-footer {
		padding-top: 77rpx;
		padding-bottom: 46rpx;
		padding-left: 8rpx;
		padding-right: 8rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.footer-left {
		flex-direction: row;
		align-items: center;
		gap: 15rpx;
	}

	.footer-dot {
		width: 12rpx;
		height: 12rpx;
		border-radius: $bai-rounded-pill;
		background-color: rgba($bai-mute, 0.4);
	}

	.footer-time {
		font-size: 25rpx;
		color: $bai-mute;
	}

	.footer-right {
		flex-direction: row;
		align-items: center;
		gap: 15rpx;
	}

	.footer-progress {
		font-size: 25rpx;
		color: $bai-mute;
	}

	.footer-percent {
		font-size: 21rpx;
		color: $bai-mute;
		padding: 4rpx 12rpx;
		border-radius: $bai-rounded-sm;
		background-color: $bai-pale;
	}

	/* 顶部导航菜单（Stitch: 毛玻璃背景、底边框、底部圆角 16px，呼出/隐藏滑移动效） */
	.menu-top {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		/* 内容行高与顶部内边距由内联绑定（状态栏起 40px 行，与胶囊垂直居中对齐） */
		padding-left: 38rpx;
		padding-right: 38rpx;
		padding-bottom: 27rpx;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-left-radius: $bai-rounded-lg;
		border-bottom-right-radius: $bai-rounded-lg;
		z-index: 40;
		transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.menu-top-hidden {
		transform: translateY(-110%);
		opacity: 0;
	}

	.menu-top-inner {
		flex-direction: row;
		align-items: center;
	}

	.menu-top-left {
		flex-direction: row;
		align-items: center;
		gap: 23rpx;
	}

	/* 返回按钮与其他子页统一：图标 80rpx */
	.round-btn {
		width: 80rpx;
		height: 80rpx;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.round-btn-icon {
		width: 80rpx;
		height: 80rpx;
	}

	.book-name {
		font-size: 29rpx;
		font-weight: 600;
	}

	/* 书签列表（抽屉书签页签） */
	.bookmark-empty {
		padding: 64rpx 38rpx;
		align-items: center;
	}

	.bookmark-empty-text {
		font-size: 27rpx;
		text-align: center;
	}

	.bookmark-item {
		flex-direction: row;
		align-items: center;
		padding: 27rpx 38rpx;
	}

	.bookmark-item-icon {
		width: 38rpx;
		height: 38rpx;
	}

	.bookmark-item-text {
		margin-left: 23rpx;
		font-size: 27rpx;
		font-weight: 500;
	}

	/* 书签下拉/移除遮罩（顶部半透明提示条：高度内联绑定，随下拉从 0 长出，书签图标在遮罩内右上角随动作变化） */
	.bookmark-mask {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		overflow: hidden;
		background-color: rgba($bai-ink, 0.65);
		z-index: 50;
	}

	.bookmark-mask-row {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 90rpx;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	/* 松手回弹：位移与遮罩高度以过渡动画归零（添加落定 / 取消均回弹归位） */
	.content-settle {
		transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.bookmark-mask-settle {
		transition: height 0.32s cubic-bezier(0.16, 1, 0.3, 1);
	}

	/* 书签图标（固定于遮罩右上角，不随遮罩高度增长移动；随添加/移除动作切换普通/红色激活形态） */
	.bookmark-mask-icon {
		position: absolute;
		right: 38rpx;
		top: 3rpx;
		width: 56rpx;
		height: 84rpx;
	}

	.bookmark-mask-text {
		font-size: 27rpx;
		font-weight: 600;
		color: $bai-on-primary;
	}

	/* 全局提示（页面正中卡片弹窗：视口居中、圆角卡片、日间墨底/夜间深灰底白字） */
	.reader-toast {
		position: fixed;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		z-index: 90;
		max-width: 70%;
	}

	.reader-toast-text {
		font-size: 27rpx;
		line-height: 42rpx;
		color: $bai-on-primary;
		padding: 27rpx 38rpx;
		border-radius: $bai-rounded-lg;
		background-color: rgba($bai-ink, 0.85);
		text-align: center;
	}

	/* 底部控制面板（令牌: 顶部圆角 xl 24px、毛玻璃、浮层提升阴影，呼出/隐藏滑移动效） */
	.menu-bottom {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		border-top-left-radius: $bai-rounded-xl;
		border-top-right-radius: $bai-rounded-xl;
		z-index: 30;
		/* 投影内联绑定（夜间切换白色微光） */
		transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.menu-bottom-hidden {
		transform: translateY(110%);
		opacity: 0;
	}

	/* 设置面板（Stitch: 顶部药丸指示器 + 字号/背景/翻页三行） */
	.settings-panel {

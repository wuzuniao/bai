	/* 底部三项导航（Stitch: 三等分，图标 20px + 文字 11px） */
	.bottom-nav {
		flex-direction: row;
		padding: 23rpx 46rpx 54rpx 46rpx;
	}

	.bottom-nav-btn {
		flex: 1;
		flex-direction: column;

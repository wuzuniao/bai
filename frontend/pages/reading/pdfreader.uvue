<template>
	<view class="page" @touchstart="onPageTouchStart">
		<!-- 正文：逐页等比图（渲染完成后展示） -->
		<scroll-view
			class="content"
			direction="vertical"
			:show-scrollbar="false"
			:scroll-into-view="scrollIntoView"
			@scroll="onScroll"
			@click="onContentTap"
		>
			<view v-for="p in pageItems" :key="p.num" class="pdf-page" :id="'pdf-page-' + p.num" :style="'height:' + pageWrapperH + 'px'">
				<image class="pdf-page-image" :src="p.src" mode="aspectFit" :style="'height:' + pageWrapperH + 'px'" />
			</view>
		</scroll-view>

		<!-- 渲染中提示（覆盖内容区中央；渲染完成前无内容可滚） -->
		<view v-if="!ready" class="pdf-loading">
			<text class="pdf-loading-text">{{ renderTip }}</text>
		</view>

		<!-- 顶栏：返回 + 书名（呼出态滑入） -->
		<view class="topbar" :class="menuVisible ? '' : 'topbar-hidden'" :style="'padding-top:' + navTop + 'px'">
			<view class="topbar-inner" :style="'height:' + navHeight + 'px'">
				<view class="topbar-back" @click="goBack">
					<image class="topbar-back-icon" src="/static/icons/arrow-back.svg" />
				</view>
				<text class="topbar-title">{{ bookTitle }}</text>
			</view>
		</view>

		<!-- 底部进度（与顶栏同呼出态） -->
		<view class="footer" :class="menuVisible ? '' : 'footer-hidden'">
			<text class="footer-text">{{ tf('pdfreader.pageN', [curPage.toString(), percentLabel]) }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { mpCapsuleRect, CONTENT_CAP_PX, scheduleResizeReload } from '@/utils/layout.uts'
	import { findBook, loadPdfProgress, savePdfProgress, updateBookReading, createReadingClock } from '@/utils/books.uts'
	import { openPdfSession } from '@/utils/pdfrender.uts'
	import { t, tf } from '@/utils/i18n.uts'
	// 词典注册（reader/pdfreader 页文案）
	import '@/utils/locales/reader.uts'
	import '@/utils/locales/common.uts'

	/** 页渲染数据（渲染就绪后填充） */
	type PageEntry = {
		num: number
		src: string
	}

	const bookId = ref(0)
	const bookTitle = ref('')
	/** 总页数 */
	const pageCount = ref(0)
	/** 首页高/宽比（页 wrapper 等比布局依据；宽=屏宽铺满，高=屏宽×ratio） */
	const pageRatio = ref(0)
	const pageItems = ref<PageEntry[]>([])
	/** 渲染就绪（完成前内容区显示进度提示） */
	const ready = ref(false)
	const renderTip = ref(t('pdfreader.preparing'))
	/** 当前阅读状态（onScroll 实时计算，onHide/onUnload 落库） */
	const curPercent = ref(0)
	const curPage = ref(1)
	/** 顶栏/底栏呼出态（点击内容切换；滚动收起） */
	const menuVisible = ref(true)
	/** 程序定位目标页（恢复进度一次性设置） */
	const scrollIntoView = ref('')

	/** 顶栏避让（px）：小程序端与胶囊对齐，其余端状态栏下 */
	const navTop = ref(44)
	const navHeight = ref(40)
	/** 窗口尺寸（px，onLoad 固化；宽屏限宽 CONTENT_CAP_PX（Web 480/App 750）居中，正文区实宽取 min(窗口宽, 上限)；
	 *  winW 用 ref 承载：折叠屏/拖宽后 pageWrapperH 随动重算） */
	const winW = ref(0)
	let winH = 0
	/** 页面已卸载（渲染调度中断标志） */
	let disposed = false
	/** 阅读时长起算（onShow 起算，onHide/onUnload 结算，与 reader 共用同一时钟收口 utils/books.uts） */
	const readingClock = createReadingClock('pdf')

	/** 页 wrapper 高（px）：屏宽 × 页比例，等比缩放的布局基准（固定高保证 scroll-into-view 定位与页码推算准确） */
	const pageWrapperH = computed(() : number => {
		if (pageRatio.value > 0 && winW.value > 0) {
			return Math.round(winW.value * pageRatio.value)
		}
		return 0
	})

	const percentLabel = computed(() : string => {
		return Math.round(curPercent.value) + '%'
	})

	/** 页图缓存目录 */
	function cacheDirOf(bid : number) : string {
		return uni.env.USER_DATA_PATH + '/pdf_cache/' + bid
	}

	// 微信小程序分享：转发好友与朋友圈（封面统一 /static/share-cover.png，复制自 yao 项目）
	// #ifdef MP-WEIXIN
	onShareAppMessage(() => {
		return { title: t('pdfreader.title'), imageUrl: '/static/share-cover.png' }
	})
	onShareTimeline(() => {
		return { title: t('pdfreader.title'), imageUrl: '/static/share-cover.png' }
	})
	// #endif

	onLoad((options : OnLoadOptions) : void => {
		const win = uni.getWindowInfo()
		winW.value = Math.min(win.windowWidth, CONTENT_CAP_PX)
		winH = win.windowHeight
		// 小程序端顶栏与胶囊对齐，其余端状态栏下（App/Web：statusBarHeight 恒 0 时保持默认）
		const capsule = mpCapsuleRect()
		if (capsule != null) {
			navTop.value = capsule.top
			navHeight.value = capsule.height
		} else if (win.statusBarHeight > 0) {
			navTop.value = win.statusBarHeight
		}
		const bid = options['bookId']
		const bidNum = bid != null ? parseInt(bid) : 0
		// 0/非法为异常入参；负数 id 为离线导入待同步书籍，正常打开
		if (bidNum == 0 || isNaN(bidNum)) {
			uni.showToast({ title: t('reader.bookMissing'), icon: 'none' })
			setTimeout(() => {
				uni.navigateBack()
			}, 1200)
			return
		}
		openPdfBook(bidNum)
	})

	onShow(() => {
		readingClock.onShown()
	})

	/** 折叠屏展开/折叠、旋转、桌面拖宽：更新正文区实宽，页 wrapper 高随动重算。
	 *  页图按旧宽度渲染的位图经 aspectFit 等比缩放展示（轻微清晰度差异接受）；
	 *  App 端暂无 onResize 事件（vapor 暂不支持），重开页面自动按新尺寸初始化 */
	// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
	onResize(() : void => {
		const win = uni.getWindowInfo()
		const w = Math.min(win.windowWidth, CONTENT_CAP_PX)
		if (w == winW.value) {
			return
		}
		winW.value = w
		// 微信端折叠切换自愈（其他端空实现）：页图布局按新窗口重载（进度持久化自动恢复）
		scheduleResizeReload(win.windowWidth, '/pages/reading/pdfreader?bookId=' + bookId.value)
	})
	// #endif

	/** 根节点触摸：记录操作时间；距上次操作超 10 分钟则上一会话以「最后操作+10min」入账并重新起算 */
	function onPageTouchStart() : void {
		readingClock.onActive(bookId.value)
	}

	onHide(() => {
		persistReading()
	})

	onUnload(() => {
		disposed = true
		persistReading()
	})

	/** 打开 PDF 书：校验 → 恢复布局参数 → 补渲染缺失页 → 构建页列表 → 定位恢复进度 */
	async function openPdfBook(bid : number) : Promise<void> {
		const book = findBook(bid)
		if (book == null || book.format != 'PDF') {
			uni.showToast({ title: t('reader.bookMissingOrDeleted'), icon: 'none' })
			setTimeout(() => {
				uni.navigateBack()
			}, 1200)
			return
		}
		bookId.value = book.id
		bookTitle.value = book.title
		pageCount.value = book.chapterCount
		if (pageCount.value <= 0) {
			renderTip.value = t('pdfreader.dataBroken')
			return
		}
		// 恢复上次布局与进度（页比例在渲染前就绪，页高确定后才能准确定位）
		const saved = loadPdfProgress(bid)
		if (saved != null && saved.ratio > 0) {
			pageRatio.value = saved.ratio
		}
		const dir = cacheDirOf(book.id)
		const have = countCached(dir)
		if (have < pageCount.value) {
			const ok = await renderAll(book.path, dir)
			if (!ok) {
				if (!disposed) {
					renderTip.value = t('pdfreader.renderFail')
				}
				return
			}
		}
		// 无历史比例时取首页尺寸兜底
		if (pageRatio.value <= 0) {
			try {
				const session = await openPdfSession(book.path)
				const dim = await session.pageSize(0)
				session.close()
				pageRatio.value = dim.h / dim.w
			} catch (e) {
				renderTip.value = t('pdfreader.openFail')
				return
			}
		}
		buildPages(dir)
		ready.value = true
		if (saved != null && saved.percent > 0) {
			const target = Math.min(pageCount.value, Math.max(1, Math.round(saved.percent / 100 * pageCount.value)))
			// 布局完成后再定位（scroll-into-view 需目标节点已挂载）
			setTimeout(() => {
				scrollIntoView.value = 'pdf-page-' + target
				curPage.value = target
				curPercent.value = saved.percent
			}, 150)
		}
	}

	/** 统计已缓存的页图数（缓存齐全则跳过渲染） */
	function countCached(dir : string) : number {
		try {
			const files = uni.getFileSystemManager().readdirSync(dir)
			return files != null ? files.length : 0
		} catch (e) {
			return 0
		}
	}

	/** 构建逐页渲染项（src 指向沙盒页图缓存） */
	function buildPages(dir : string) : void {
		const items : PageEntry[] = []
		for (let i = 1; i <= pageCount.value; i++) {
			items.push({ num: i, src: dir + '/p' + i + '.jpg' } as PageEntry)
		}
		pageItems.value = items
	}

	/** 逐页渲染全部缺失页：主线程 setTimeout 分片调度（单页数十毫秒，间歇让出保持交互），中断（页面卸载）即停 */
	function renderAll(pdfPath : string, dir : string) : Promise<boolean> {
		return new Promise<boolean>((resolve) => {
			try {
				uni.getFileSystemManager().mkdirSync(dir, true)
			} catch (e) {
				// 目录已存在属正常
			}
			openPdfSession(pdfPath).then((session) => {
				if (session.pageCount != pageCount.value) {
					// 以实际页数为准（书架记录异常时自愈）
					pageCount.value = session.pageCount
				}
				const total = session.pageCount
				session.pageSize(0).then((dim) => {
					if (pageRatio.value <= 0) {
						pageRatio.value = dim.h / dim.w
					}
					// 渲染分辨率：屏逻辑宽 × dpr，上限 1440（清晰度与体积平衡）
					const dpr = uni.getWindowInfo().devicePixelRatio
					const targetW = Math.min(1440, Math.max(720, Math.round(winW.value * (dpr > 0 ? dpr : 2))))
					const renderNext = (index : number) : void => {
						if (disposed) {
							session.close()
							resolve(false)
							return
						}
						if (index >= total) {
							session.close()
							resolve(true)
							return
						}
						renderTip.value = tf('pdfreader.rendering', [(index + 1).toString(), total.toString()])
						session.renderPage(index, dir + '/p' + (index + 1) + '.jpg', targetW).then(() => {
							setTimeout(() => {
								renderNext(index + 1)
							}, 0)
						}, (_e) => {
							session.close()
							resolve(false)
						})
					}
					renderNext(0)
				}, (_e) => {
					session.close()
					resolve(false)
				})
			}, (_e) => {
				resolve(false)
			})
		})
	}

	/** 滚动实时记录阅读位置（百分比 + 当前页码；滚动收起顶栏/底栏） */
	function onScroll(e : UniScrollEvent) : void {
		const maxScroll = e.detail.scrollHeight - winH
		if (maxScroll > 0) {
			curPercent.value = Math.min(100, Math.max(0, e.detail.scrollTop / maxScroll * 100))
		}
		if (pageWrapperH.value > 0) {
			curPage.value = Math.min(pageCount.value, Math.max(1, Math.floor(e.detail.scrollTop / pageWrapperH.value) + 1))
		}
		if (menuVisible.value) {
			menuVisible.value = false
		}
	}

	/** 点击内容切换顶栏/底栏呼出态 */
	function onContentTap() : void {
		menuVisible.value = !menuVisible.value
	}

	/** 结算阅读：进度百分比落库（书籍记录云端跟随） + 回写最近阅读状态 + 累计今日时长（onHide 先于 onUnload，时钟结算防双计） */
	function persistReading() : void {
		if (bookId.value == 0) {
			return
		}
		savePdfProgress(bookId.value, { percent: curPercent.value, ratio: pageRatio.value } as PdfProgress)
		updateBookReading(bookId.value, -1, Math.round(curPercent.value))
		readingClock.settle(bookId.value, false)
	}

	// #ifdef WEB
	onReady(() => {
		// 时长结算兜底：uni-app x H5 页面级 onHide/onUnload 不随浏览器切标签/关标签触发（实测），
		// 切走即结算（页面存活，普通上报链路可靠），切回重新起算；直接关标签/刷新经 pagehide 安静结算
		document.addEventListener('visibilitychange', onWebVisibilityChange)
		window.addEventListener('pagehide', onWebPageHide)
	})

	/** 切走标签页/最小化：结算本次阅读（含进度回写）；切回重新起算。onShow 若被框架同场景触发，
	 *  settle 防双计与 onShown 幂等重置均无害 */
	function onWebVisibilityChange() : void {
		if (document.visibilityState == 'hidden') {
			persistReading()
		} else {
			readingClock.onShown()
		}
	}

	/** 直接关闭标签页/刷新（未经 visibilitychange hidden）：安静结算，仅写本地进度与离线流水队列，
	 *  时长经下次进入书架补传聚合；云端回写由下次结算/书架刷新覆盖 */
	function onWebPageHide() : void {
		if (bookId.value == 0) {
			return
		}
		savePdfProgress(bookId.value, { percent: curPercent.value, ratio: pageRatio.value } as PdfProgress)
		readingClock.settle(bookId.value, true)
	}
	// #endif

	/** 返回书架 */
	function goBack() : void {
		uni.navigateBack()
	}
</script>

<style lang="scss">
	.page {
		flex: 1;
		position: relative;
		background-color: $bai-canvas-soft;
	}

	.content {
		flex: 1;
		width: 100%;
		/* #ifdef WEB */
		max-width: 480px;
		/* #endif */
		/* #ifndef WEB */
		max-width: 750px;
		/* #endif */
		margin-left: auto;
		margin-right: auto;
	}

	/* 页容器：高按首页比例等比换算（px 内联绑定），白底页图与软灰底区分页界（宽随 .content 限宽） */
	.pdf-page {
		width: 100%;
		background-color: $bai-canvas;
	}

	.pdf-page-image {
		width: 100%;
		height: 750rpx;
	}

	/* 渲染中提示：覆盖内容区中央 */
	.pdf-loading {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		align-items: center;
		justify-content: center;
	}

	.pdf-loading-text {
		font-size: 27rpx;
		font-weight: 500;
		color: $bai-mute;
	}

	/* 顶栏（对齐 reader 顶栏：白底浮层，呼出态滑入；宽屏限宽居中） */
	.topbar {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		/* #ifdef WEB */
		max-width: 480px;
		/* #endif */
		/* #ifndef WEB */
		max-width: 750px;
		/* #endif */
		margin-left: auto;
		margin-right: auto;
		background-color: $bai-canvas;
		border-bottom: 1px solid $bai-pale;
		z-index: 20;
		transition-property: transform;
		transition-duration: 200ms;
	}

	.topbar-hidden {
		transform: translateY(-150%);
	}

	.topbar-inner {
		flex-direction: row;
		align-items: center;
		padding-left: 23rpx;
	}

	.topbar-back {
		width: 77rpx;
		height: 77rpx;
		border-radius: $bai-rounded-pill;
		align-items: center;
		justify-content: center;
	}

	.topbar-back-icon {
		width: 40rpx;
		height: 40rpx;
	}

	.topbar-title {
		flex: 1;
		font-size: 31rpx;
		font-weight: 700;
		color: $bai-ink;
		margin-right: 38rpx;
		/* 单行省略：长书名（app 端 lines 生效，小程序端 white-space 系生效） */
		lines: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* 底部进度条（与顶栏同呼出态；宽屏限宽居中） */
	.footer {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		/* #ifdef WEB */
		max-width: 480px;
		/* #endif */
		/* #ifndef WEB */
		max-width: 750px;
		/* #endif */
		margin-left: auto;
		margin-right: auto;
		padding-top: 15rpx;
		padding-bottom: 15rpx;
		align-items: center;
		background-color: $bai-canvas;
		border-top: 1px solid $bai-pale;
		z-index: 20;
		transition-property: transform;
		transition-duration: 200ms;
	}

	.footer-hidden {
		transform: translateY(150%);
	}

	.footer-text {
		font-size: 23rpx;
		font-weight: 500;
		color: $bai-mute;
	}
</style>

<template>
	<view class="page">
		<scroll-view class="scroll" :direction="dragIndex >= 0 ? 'none' : 'vertical'" :show-scrollbar="false">
			<!-- 顶部导航：书架标题（含排序下拉）+ 内联搜索栏 + 搜索/添加按钮（小程序端与胶囊同行，右侧避让胶囊） -->
			<view class="nav" :style="'padding-top:' + navTop + 'px' + (navRight > 0 ? ';padding-right:' + navRight + 'px' : '')">
				<view class="nav-inner" :style="'height:' + navHeight + 'px'">
					<!-- 书架标题（Stitch: 点击展开排序菜单，箭头旋转 180°） -->
					<view class="nav-title-btn" @click="toggleMenu">
						<text class="nav-title">书架</text>
						<image class="nav-chevron" :class="menuOpen ? 'nav-chevron-open' : ''" src="/static/icons/chevron-down.svg" />
					</view>
					<!-- 内联搜索栏（Stitch: 点搜索图标展开于标题右侧，含清空与取消） -->
					<view v-if="searchOpen" class="header-search">
						<view class="search-field" :class="searchFocused ? 'search-field-focus' : ''">
							<image class="search-field-icon" src="/static/icons/search-gray.svg" />
							<input
								class="search-input"
								v-model="searchText"
								placeholder="搜索书名..."
								:placeholder-style="PLACEHOLDER_STYLE"
								:focus="true"
								@focus="onSearchFocus"
								@blur="onSearchBlur"
							/>
							<image v-if="searchText.length > 0" class="search-clear" src="/static/icons/close.svg" @click="clearSearch" />
						</view>
						<text class="search-cancel" @click="closeSearch">取消</text>
					</view>
					<!-- 编辑模式：完成按钮；其余：搜索 / 添加按钮 -->
					<view v-if="editMode" class="nav-finish" @click="finishEdit">
						<text class="nav-finish-text">完成</text>
					</view>
					<view v-else class="nav-actions">
						<view v-if="!searchOpen" class="nav-action-btn" @click="openSearch">
							<image class="nav-action-search" src="/static/icons/search.svg" />
						</view>
						<view class="nav-action-btn nav-action-btn-second" @click="togglePlusMenu">
							<image class="nav-action-plus" src="/static/icons/plus-small.svg" />
						</view>
					</view>
				</view>
			</view>
			<!-- 主内容 -->
			<view class="main">
				<!-- 阅读统计卡 -->
				<view class="stats-card">
					<view class="stats-left">
						<view class="stats-num-row">
							<text class="stats-num">{{ todayMinutes }}</text>
							<text class="stats-unit">分钟</text>
						</view>
						<text class="stats-label">今日已读</text>
					</view>
					<view class="stats-pill" @click="openReward">
						<text class="stats-pill-text">再读 5 分钟</text>
						<view class="stats-pill-dot"></view>
						<text class="stats-pill-coin">领 1</text>
						<image class="stats-pill-coin-icon" src="/static/icons/coin-copper.svg" />
					</view>
				</view>
				<!-- 编辑工具行：卡片样式选择 + 批量删除 -->
				<view v-if="editMode" class="edit-tools">
					<view class="edit-styles">
						<view class="style-btn" :class="shelfStyle === 'plain' ? 'style-btn-on' : ''" @click="setStyle('plain')">
							<view class="style-dot style-dot-light"></view>
							<text class="style-btn-text" :class="shelfStyle === 'plain' ? 'style-btn-text-on' : ''">白卡</text>
						</view>
						<view class="style-btn" :class="shelfStyle === 'photo' ? 'style-btn-on' : ''" @click="setStyle('photo')">
							<view class="style-dot style-dot-dark"></view>
							<text class="style-btn-text" :class="shelfStyle === 'photo' ? 'style-btn-text-on' : ''">深灰</text>
						</view>
					</view>
					<view v-if="selectedKeys.length > 0" class="edit-delete" @click="deleteSelected">
						<text class="edit-delete-text">删除 {{ selectedKeys.length }} 本</text>
					</view>
				</view>
				<!-- 书架网格（3 列，编辑模式可选可拖拽；添加格独立于数据循环渲染，固定在网格末尾） -->
				<view class="shelf-grid">
					<view v-for="(row, ri) in shelfRows" :key="ri" class="shelf-row" :class="ri > 0 ? 'shelf-row-gap' : ''">
						<view
							v-for="(book, bi) in row"
							:key="book.id"
							class="book-item"
							:class="cardClass(ri * 3 + bi, book)"
							:id="'book-card-' + (ri * 3 + bi)"
							:style="cardStyle(ri * 3 + bi)"
							@click="onCardTap(book)"
							@touchstart="onCardTouchStart($event, ri * 3 + bi)"
							@touchmove="onCardTouchMove($event, ri * 3 + bi)"
							@touchend="onCardTouchEnd"
						>
							<!-- 书籍封面（包装层承载右下角勾选点） -->
							<view class="cover-wrap">
								<!-- 白卡样式 -->
								<view v-if="shelfStyle === 'plain'" class="cover-plain">
									<text class="cover-plain-title">{{ book.title }}</text>
									<text class="cover-plain-format">{{ book.format }}</text>
								</view>
								<!-- 深灰卡样式 -->
								<view v-else class="cover-photo">
									<text class="cover-photo-format">{{ book.format }}</text>
									<view class="cover-info">
										<text class="cover-title">{{ book.title }}</text>
										<text class="cover-author">{{ book.author }}</text>
									</view>
								</view>
								<!-- 编辑勾选点（封面右下角） -->
								<view
									v-if="editMode"
									class="card-check"
									:class="isSelected(book) ? 'card-check-on' : ''"
									@click="onCheckTap(book, $event)"
								>
									<text v-if="isSelected(book)" class="card-check-icon">✓</text>
								</view>
							</view>
							<!-- 书名与阅读进度 -->
							<view class="book-text">
								<text class="book-title">{{ book.title }}</text>
								<text class="book-meta">{{ metaOf(book) }}</text>
							</view>
						</view>
						<!-- 末行有空位：行内补添加格 -->
						<view
							v-if="addCellInLastRow && ri == shelfRows.length - 1"
							class="book-item"
							:class="editMode ? 'book-item-dim' : ''"
							id="book-card-add"
							@click="onAddCellTap"
						>
							<view class="cover-add">
								<image class="cover-add-icon" src="/static/icons/plus-large.svg" />
							</view>
						</view>
					</view>
					<!-- 空书架或末行满员：新起一行放添加格 -->
					<view v-if="addCellNewRow" class="shelf-row" :class="shelfRows.length > 0 ? 'shelf-row-gap' : ''">
						<view
							class="book-item"
							:class="editMode ? 'book-item-dim' : ''"
							id="book-card-add"
							@click="onAddCellTap"
						>
							<view class="cover-add">
								<image class="cover-add-icon" src="/static/icons/plus-large.svg" />
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 浮层遮罩：菜单打开时覆盖全屏，点击外部关闭（Stitch: 全局点击 dismiss） -->
		<view v-if="menuOpen || plusMenuOpen" class="menu-mask" @click="closeMenus" />
		<!-- 排序下拉菜单（置于页面根、scroll-view 外，避免滚动容器裁剪；悬浮于标题下方 8px） -->
		<view v-if="menuOpen" class="shelf-menu" :style="'top:' + (navTop + navHeight + 8) + 'px'">
			<view
				v-for="(opt, oi) in sortOptions"
				:key="oi"
				class="menu-item"
				@click="onSelectSort(opt)"
			>
				<text class="menu-item-text" :class="currentSort === opt ? 'menu-item-text-active' : ''">{{ opt }}</text>
			</view>
		</view>
		<!-- 加号浮动菜单（Stitch: 导入书籍 / 编辑书架，右对齐悬浮） -->
		<view v-if="plusMenuOpen" class="plus-menu" :style="'left:' + plusMenuLeft + 'px;top:' + (navTop + navHeight + 8) + 'px'">
			<view class="plus-menu-item" @click="onImportTap">
				<text class="plus-menu-item-text">导入书籍</text>
			</view>
			<view class="plus-menu-item" @click="enterEdit">
				<text class="plus-menu-item-text">编辑书架</text>
			</view>
		</view>

		<BottomNavBar active="bookshelf" @change="closeMenus" />
	</view>
</template>

<script setup lang="uts">
	import BottomNavBar from '@/components/BottomNavBar/BottomNavBar.uvue'
	import { PLACEHOLDER_STYLE } from '@/utils/theme.uts'
	import { LocalBook, loadBooks, saveBooks, removeBookData, getTodayMinutes } from '@/utils/books.uts'
	import { importBook } from '@/utils/bookparse.uts'

	/** 书架卡片统一样式：plain 白卡 / photo 深灰卡 */
	const STORAGE_STYLE = 'bookshelf_style'

	/** 书架书籍（本地导入列表，顺序即手动排序结果；未导入时仅显示添加格） */
	const books = ref<LocalBook[]>([])
	/** 今日已读分钟数（阅读页结算，onShow 刷新） */
	const todayMinutes = ref(0)
	/** 书架卡片统一样式：plain 白卡 / photo 深灰卡 */
	const shelfStyle = ref('plain')

	/** 网格分行（每行 3 本，仅真实书籍；添加格在模板中独立于数据渲染） */
	const shelfRows = computed<LocalBook[][]>(() : LocalBook[][] => {
		const rows : LocalBook[][] = []
		const list = books.value
		const n = list.length
		for (let r = 0; r < Math.ceil(n / 3); r++) {
			rows.push(list.slice(r * 3, Math.min(n, r * 3 + 3)))
		}
		return rows
	})

	/** 末行是否行内补添加格（有书且末行未满 3；条件在 UTS 侧算好，模板仅消费布尔） */
	const addCellInLastRow = computed(() : boolean => {
		const n = books.value.length
		return n > 0 && n % 3 != 0
	})

	/** 是否新起一行放添加格（空书架或末行满员；与 addCellInLastRow 恒互斥） */
	const addCellNewRow = computed(() : boolean => {
		return books.value.length % 3 == 0
	})

	/** 读取本地书架与样式（onShow 每次刷新：阅读返回后进度/时长/新增书均同步） */
	function loadShelf() : void {
		books.value = loadBooks()
		todayMinutes.value = getTodayMinutes()
		const storedStyle : any = uni.getStorageSync(STORAGE_STYLE)
		if (typeof storedStyle == 'string' && ((storedStyle as string) == 'plain' || (storedStyle as string) == 'photo')) {
			shelfStyle.value = storedStyle as string
		}
	}

	/** 书架顺序与样式本地持久化 */
	function saveShelf() : void {
		saveBooks(books.value)
		uni.setStorageSync(STORAGE_STYLE, shelfStyle.value)
	}

	/** 书架卡片下方的进度文案（txt：未读 / 第 N 章 / 共 M 章；PDF：共 N 页 / 已读 X% · 共 N 页） */
	function metaOf(book : LocalBook) : string {
		if (book.format == 'PDF') {
			if (book.lastReadAt > 0 && book.lastPercent > 0) {
				return '已读 ' + Math.round(book.lastPercent) + '% · 共 ' + book.chapterCount + ' 页'
			}
			return '共 ' + book.chapterCount + ' 页'
		}
		if (book.lastReadAt <= 0 || book.lastChapter < 0) {
			return '未读'
		}
		return '第 ' + (book.lastChapter + 1) + ' 章 / 共 ' + book.chapterCount + ' 章'
	}

	/** 切换书架卡片统一样式并保存 */
	function setStyle(style : string) : void {
		if (shelfStyle.value == style) {
			return
		}
		shelfStyle.value = style
		saveShelf()
	}

	/** 顶部导航行顶部（px）：小程序端与右上角胶囊同行，Web/App 端为状态栏下 14px */
	const navTop = ref(14)
	/** 顶部导航行高（px）：小程序端取胶囊高度，其余端为 40px 设计值 */
	const navHeight = ref(40)
	/** 右侧胶囊避让边距（px）：操作按钮右缘置于胶囊左侧 8px；非小程序端 0（沿用样式默认 38rpx） */
	const navRight = ref(0)

	/** 加号弹窗左缘（px）：与 + 号按钮左缘齐平——+ 号为按钮组末位元素，左缘即行右缘（避让后）减按钮自身宽 77rpx */
	const plusMenuLeft = computed(() : number => {
		const win = uni.getWindowInfo()
		const rowRight = navRight.value > 0 ? win.windowWidth - navRight.value : win.windowWidth - uni.upx2px(38)
		return rowRight - uni.upx2px(77)
	})

	/** 编辑模式：卡片可勾选删除、可拖拽调序 */
	const editMode = ref(false)
	/** 编辑模式选中的书籍 id 集合 */
	const selectedKeys = ref<string[]>([])

	function isSelected(book : LocalBook) : boolean {
		return selectedKeys.value.indexOf(book.id) >= 0
	}

	function toggleSelect(book : LocalBook) : void {
		const i = selectedKeys.value.indexOf(book.id)
		if (i >= 0) {
			selectedKeys.value.splice(i, 1)
		} else {
			selectedKeys.value.push(book.id)
		}
	}

	/** 进入编辑模式（+ 菜单「编辑书架」） */
	function enterEdit() : void {
		editMode.value = true
		selectedKeys.value = []
		plusMenuOpen.value = false
		closeMenus()
	}

	/** 完成编辑并保存 */
	function finishEdit() : void {
		editMode.value = false
		selectedKeys.value = []
		saveShelf()
	}

	/** 删除选中书籍（正文文件与阅读进度一并清理）并保存 */
	function deleteSelected() : void {
		if (selectedKeys.value.length == 0) {
			return
		}
		for (let i = 0; i < books.value.length; i++) {
			const b = books.value[i]
			if (b.id != 'add' && selectedKeys.value.indexOf(b.id) >= 0) {
				removeBookData(b)
			}
		}
		books.value = books.value.filter((b : LocalBook) : boolean => selectedKeys.value.indexOf(b.id) < 0)
		selectedKeys.value = []
		saveShelf()
	}

	/** ===== 拖拽排序（编辑模式，长按按住即拖） ===== */
	/** 拖拽中的书籍全局索引；-1 为未拖拽 */
	const dragIndex = ref(-1)
	/** 拖拽位移（px，相对卡片当前布局位） */
	const dragX = ref(0)
	const dragY = ref(0)
	/** 触摸是否已判定为拖动（区分点击选中；拖后拦截误触 click） */
	let dragMoved = false
	let dragStartX = 0
	let dragStartY = 0
	/** 拖拽卡片的初始布局位（视口坐标，touchstart 时经 SelectorQuery 异步取得） */
	let dragOriginX = 0
	let dragOriginY = 0
	/** 布局基准是否已就位（rect 异步回调返回前不响应拖动） */
	let dragOriginReady = false

	/** 勾选点点击：阻止冒泡后切换选中（避免触发卡片自身点击） */
	function onCheckTap(book : LocalBook, e : UniPointerEvent) : void {
		e.stopPropagation()
		if (!editMode.value) {
			return
		}
		toggleSelect(book)
	}

	/** 卡片动态 class：编辑模式的暗显/选中/拖拽态 */
	function cardClass(gi : number, book : LocalBook) : string {
		if (!editMode.value) {
			return ''
		}
		if (dragIndex.value == gi) {
			return 'book-item-dragging'
		}
		return isSelected(book) ? 'book-item-selected' : 'book-item-dim'
	}

	/** 拖拽卡片的位移内联样式（px） */
	function cardStyle(gi : number) : string {
		if (dragIndex.value != gi) {
			return ''
		}
		return 'transform:translate(' + dragX.value + 'px,' + dragY.value + 'px)'
	}

	function onCardTouchStart(e : UniTouchEvent, gi : number) : void {
		if (!editMode.value || dragIndex.value != -1 || e.touches.length == 0) {
			return
		}
		if (gi >= books.value.length) {
			return
		}
		dragMoved = false
		dragOriginReady = false
		dragStartX = e.touches[0].clientX
		dragStartY = e.touches[0].clientY
		dragIndex.value = gi
		dragX.value = 0
		dragY.value = 0
		// 异步取卡片当前布局位置作为拖拽基准
		uni.createSelectorQuery().select('#book-card-' + gi).boundingClientRect((rect : NodeInfo | null) : void => {
			if (rect != null && dragIndex.value == gi) {
				dragOriginX = rect.left
				dragOriginY = rect.top
				dragOriginReady = true
			}
		}).exec()
	}

	function onCardTouchMove(e : UniTouchEvent, gi : number) : void {
		if (dragIndex.value != gi || e.touches.length == 0 || !dragOriginReady) {
			return
		}
		const dx = e.touches[0].clientX - dragStartX
		const dy = e.touches[0].clientY - dragStartY
		if (!dragMoved && Math.abs(dx) + Math.abs(dy) <= 6) {
			return
		}
		dragMoved = true
		// 网格几何（px）：卡宽 206 / 卡高 360（封面 285 + 文字 75）/ 列距 28 / 行距 38 / 内容左缘 38（rpx）
		const cellW = uni.upx2px(206)
		const cellH = uni.upx2px(360)
		const gapX = uni.upx2px(28)
		const gapY = uni.upx2px(38)
		dragX.value = dx
		dragY.value = dy
		// 由浮动卡片中心计算目标格位（浮点卡左上角 = 原点 + 位移；格位序号 = 中心相对网格首行左缘的步距取整），实时重排让位
		const rowCount = Math.ceil(books.value.length / 3)
		const col = Math.max(0, Math.min(2, Math.round((dragOriginX + dx - uni.upx2px(38)) / (cellW + gapX))))
		const row0 = Math.floor(gi / 3)
		const row0Top = dragOriginY - row0 * (cellH + gapY)
		const row = Math.max(0, Math.min(rowCount - 1, Math.round((dragOriginY + dy - row0Top) / (cellH + gapY))))
		const target = Math.max(0, Math.min(books.value.length - 1, row * 3 + col))
		if (target == gi) {
			return
		}
		const item = books.value[gi]
		books.value.splice(gi, 1)
		books.value.splice(target, 0, item)
		// 布局原点随重排跳变，触摸基准同步补偿，保持卡片屏幕位置连续
		dragStartX += (target % 3 - gi % 3) * (cellW + gapX)
		dragStartY += (Math.floor(target / 3) - row0) * (cellH + gapY)
		dragIndex.value = target
		dragX.value = e.touches[0].clientX - dragStartX
		dragY.value = e.touches[0].clientY - dragStartY
	}

	function onCardTouchEnd() : void {
		if (dragIndex.value == -1) {
			return
		}
		dragIndex.value = -1
		dragX.value = 0
		dragY.value = 0
		if (dragMoved) {
			saveShelf()
		}
	}

	/** 卡片点击：编辑模式切换选中（拦截拖拽后误触），非编辑模式进入阅读 */
	function onCardTap(book : LocalBook) : void {
		if (dragMoved) {
			dragMoved = false
			return
		}
		if (!editMode.value) {
			openBook(book)
			return
		}
		toggleSelect(book)
	}

	/** 添加格点击：非编辑模式下触发导入（与 + 菜单同功能）；编辑模式无动作 */
	function onAddCellTap() : void {
		if (!editMode.value) {
			startImport()
		}
	}

	/** 排序下拉菜单（Stitch: 手动顺序/最近阅读/添加时间，默认手动顺序） */
	const sortOptions = ref<string[]>(['手动顺序', '最近阅读', '添加时间'])
	const currentSort = ref('手动顺序')
	const menuOpen = ref(false)
	const plusMenuOpen = ref(false)

	/** 内联搜索栏状态（Stitch: 打开时隐藏搜索图标，输入显示清空钮） */
	const searchOpen = ref(false)
	const searchText = ref('')
	const searchFocused = ref(false)

	onLoad(() => {
		const win = uni.getWindowInfo()
		// #ifdef MP-WEIXIN
		// 胶囊按钮矩形：导航行与胶囊同行（顶部/高度对齐），右侧按钮避让到胶囊左边 8px
		const capsule = uni.getMenuButtonBoundingClientRect()
		if (capsule.height > 0) {
			navTop.value = capsule.top
			navHeight.value = capsule.height
			navRight.value = win.windowWidth - capsule.left + 8
		} else if (win.statusBarHeight > 0) {
			navTop.value = win.statusBarHeight + 14
		}
		// #endif
		// #ifdef APP-ANDROID || APP-IOS
		navTop.value = win.statusBarHeight + 14
		// #endif
	})

	onShow(() => {
		loadShelf()
	})

	/** 关闭全部浮层（点击遮罩或底部导航触发） */
	function closeMenus() : void {
		menuOpen.value = false
		plusMenuOpen.value = false
	}

	function toggleMenu() : void {
		menuOpen.value = !menuOpen.value
		plusMenuOpen.value = false
	}

	function onSelectSort(opt: string) : void {
		currentSort.value = opt
		menuOpen.value = false
	}

	function togglePlusMenu() : void {
		plusMenuOpen.value = !plusMenuOpen.value
		menuOpen.value = false
	}

	/** ===== 导入书籍（+ 菜单与书架添加格同入口） ===== */
	/** 导入进行中（防重复触发） */
	const importing = ref(false)

	/** 按当前端唤起文件选择：微信小程序=聊天会话文件（wx.chooseMessageFile），App=系统文件选择器；选择后统一落盘解析入库 */
	function startImport() : void {
		if (importing.value) {
			return
		}
		plusMenuOpen.value = false
		closeMenus()
		// #ifdef MP-WEIXIN || APP-ANDROID || APP-IOS
		uni.chooseFile({
			count: 9,
			success: (res : ChooseFileSuccess) => {
				handlePickedFiles(res.tempFiles)
			},
			fail: (_e) => {
				// 用户取消静默
			}
		})
		// #endif
	}

	/** 逐本导入所选文件并汇总结果（扩展名过滤与格式提示在 importBook 内统一处理） */
	async function handlePickedFiles(files : ChooseFileTempFile[]) : Promise<void> {
		if (files.length == 0) {
			return
		}
		importing.value = true
		uni.showLoading({ title: '正在导入', mask: true })
		let okCount = 0
		let firstErr = ''
		for (let i = 0; i < files.length; i++) {
			const f = files[i]
			try {
				await importBook(f.name, f.path, f.size)
				okCount++
			} catch (e) {
				if (firstErr.length == 0) {
					firstErr = e instanceof Error ? e.message : '导入失败'
				}
			}
		}
		uni.hideLoading()
		importing.value = false
		loadShelf()
		if (okCount > 0 && firstErr.length == 0) {
			uni.showToast({ title: '已导入 ' + okCount + ' 本', icon: 'none' })
		} else if (firstErr.length > 0) {
			uni.showToast({ title: firstErr + (okCount > 0 ? '（其余 ' + okCount + ' 本已导入）' : ''), icon: 'none', duration: 2500 })
		}
	}

	/** 加号菜单「导入书籍」 */
	function onImportTap() : void {
		startImport()
	}

	function openSearch() : void {
		searchOpen.value = true
		closeMenus()
	}

	function closeSearch() : void {
		searchOpen.value = false
		searchText.value = ''
		searchFocused.value = false
	}

	function clearSearch() : void {
		searchText.value = ''
	}

	function onSearchFocus() : void {
		searchFocused.value = true
	}

	function onSearchBlur() : void {
		searchFocused.value = false
	}

	/** 点击书籍进入阅读：txt 进文本阅读器，PDF 进原文件渲染页（携带书籍 id） */
	function openBook(book: LocalBook) : void {
		if (book.format == 'PDF') {
			uni.navigateTo({
				url: '/pages/reading/pdfreader?bookId=' + book.id
			})
			return
		}
		uni.navigateTo({
			url: '/pages/reading/reader?bookId=' + book.id
		})
	}

	/** 点击"领 1 铜币"进入赠币福利页（编辑模式禁用） */
	function openReward() : void {
		if (editMode.value) {
			return
		}
		uni.navigateTo({
			url: '/pages/reading/reward'
		})
	}
</script>

<style lang="scss">
	.page {
		flex: 1;
		position: relative;
		background-color: $bai-canvas-soft;
	}

	.scroll {
		flex: 1;
	}

	/* 顶部导航（Stitch: 左右内边距 20px，上下 14px；顶部动态避让状态栏/小程序胶囊） */
	.nav {
		padding-left: 38rpx;
		padding-right: 38rpx;
		padding-bottom: 27rpx;
	}

	/* 行高内联绑定（小程序端对齐胶囊 32px，其余端 40px 设计值），浮层菜单 top 由此推导（navTop + navHeight + 8） */
	.nav-inner {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	/* 标题按钮（Stitch: "书架" 20px/900 + 16px 实心箭头，间距 6px） */
	.nav-title-btn {
		flex-shrink: 0;
		flex-direction: row;
		align-items: center;
	}

	.nav-title {
		font-size: 38rpx;
		line-height: 54rpx;
		font-weight: 900;
		color: $bai-ink;
	}

	.nav-chevron {
		margin-left: 12rpx;
		width: 31rpx;
		height: 31rpx;
	}

	.nav-chevron-open {
		transform: rotate(180deg);
	}

	/* 浮层遮罩：全屏透明，点击外部关闭菜单 */
	.menu-mask {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		z-index: 40;
	}

	/* 排序下拉菜单（Stitch: 宽 144px 白底 圆角 lg 16px 浮层描边 浅灰 #E9E9E6 阴影 xl；置于页面根，top 由内联样式按状态栏动态计算） */
	.shelf-menu {
		position: absolute;
		left: 38rpx;
		padding: 12rpx;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-lg;
		border: 1px solid $bai-pale;
		box-shadow: $bai-shadow-dropdown;
		z-index: 50;
	}

	.menu-item {
		flex-direction: row;
		align-items: center;
		padding: 15rpx 23rpx;
		border-radius: $bai-rounded-md;
	}

	.menu-item-text {
		font-size: 27rpx;
		font-weight: 500;
		color: $bai-mute;
	}

	.menu-item-text-active {
		font-weight: 700;
		color: $bai-ink;
	}

	/* 加号浮动菜单（Stitch: 宽 128px 白底 圆角 16px 边框 #E9E9E6 阴影 0 12 32 @12%，右对齐悬浮） */
	.plus-menu {
		position: absolute;
		/* left 由内联绑定（+ 号左缘），宽度随菜单文字自适应 */
		padding: 12rpx;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-lg;
		border: 1px solid $bai-pale;
		box-shadow: $bai-shadow-plus-menu;
		z-index: 50;
	}

	.plus-menu-item {
		padding: 19rpx 27rpx;
		border-radius: $bai-rounded-md;
	}

	.plus-menu-item-text {
		font-size: 27rpx;
		font-weight: 500;
		color: $bai-ink;
	}

	/* 内联搜索栏（Stitch: 占据标题右侧空间，白胶囊 + 清空 + 取消） */
	.header-search {
		flex: 1;
		margin-left: 15rpx;
		flex-direction: row;
		align-items: center;
	}

	.search-field {
		flex: 1;
		flex-direction: row;
		align-items: center;
		padding: 8rpx 23rpx;
		background-color: $bai-canvas;
		border: 1px solid $bai-pale;
		border-radius: $bai-rounded-pill;
		box-shadow: $bai-shadow-search;
	}

	.search-field-focus {
		border-color: $bai-ink;
	}

	.search-field-icon {
		margin-right: 12rpx;
		width: 35rpx;
		height: 35rpx;
	}

	.search-input {
		flex: 1;
		height: 34rpx;
		font-size: 23rpx;
		color: $bai-ink;
		background-color: transparent;
	}

	.search-clear {
		margin-left: 8rpx;
		width: 31rpx;
		height: 31rpx;
	}

	.search-cancel {
		margin-left: 8rpx;
		padding: 8rpx 12rpx;
		font-size: 23rpx;
		font-weight: 500;
		color: $bai-body;
	}

	/* 右侧圆形操作按钮（Stitch: 40x40，间距 4px） */
	.nav-actions {
		flex-direction: row;
		align-items: center;
		margin-left: 15rpx;
	}

	.nav-action-btn {
		width: 77rpx;
		height: 77rpx;
		border-radius: $bai-rounded-pill;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.nav-action-btn-second {
		margin-left: 8rpx;
	}

	.nav-action-search {
		width: 34rpx;
		height: 34rpx;
	}

	.nav-action-plus {
		width: 28rpx;
		height: 28rpx;
	}

	/* 主内容（Stitch: 左右内边距 20px，底部预留悬浮导航区 128px） */
	.main {
		padding-left: 38rpx;
		padding-right: 38rpx;
		/* 底部留白与首页一致（196rpx）：覆盖悬浮导航胶囊顶（约屏底上方 150rpx）+ 46rpx 间隙；
		   固定值写在滚动内容上，内容增多出现滚动后间距不变 */
		padding-bottom: 196rpx;
		flex-direction: column;
	}

	/* 阅读统计卡（令牌 card-content: 白底 圆角 xl 24px 内边距 16x20；层级 2 表层对比承载高度，无边框无阴影） */
	.stats-card {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 31rpx 38rpx;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-xl;
	}

	.stats-left {
		flex-direction: column;
	}

	/* 阅读时长（Stitch: "11" 24px/900 + "分钟" 12px/600 基线对齐，间距 4px） */
	.stats-num-row {
		flex-direction: row;
		align-items: flex-end;
	}

	.stats-num {
		font-size: 46rpx;
		line-height: 46rpx;
		font-weight: 900;
		color: $bai-ink;
	}

	.stats-unit {
		margin-left: 8rpx;
		padding-bottom: 2rpx;
		font-size: 23rpx;
		line-height: 23rpx;
		font-weight: 600;
		color: $bai-ink;
	}

	.stats-label {
		margin-top: 8rpx;
		font-size: 19rpx;
		line-height: 19rpx;
		font-weight: 500;
		color: $bai-mute;
	}

	/* 再读胶囊（令牌 button-secondary: 背景 canvas-soft 圆角 pill 内边距 6x12 间距 6px，无边框） */
	.stats-pill {
		flex-direction: row;
		align-items: center;
		padding: 12rpx 23rpx;
		background-color: $bai-canvas-soft;
		border-radius: $bai-rounded-pill;
	}

	.stats-pill-text {
		font-size: 23rpx;
		line-height: 23rpx;
		font-weight: 500;
		color: $bai-ink;
	}

	.stats-pill-dot {
		margin-left: 12rpx;
		width: 8rpx;
		height: 8rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-mute;
		opacity: 0.5;
	}

	.stats-pill-coin {
		margin-left: 12rpx;
		font-size: 23rpx;
		line-height: 23rpx;
		font-weight: 600;
		color: $bai-warning-deep;
	}

	.stats-pill-coin-icon {
		margin-left: 6rpx;
		width: 27rpx;
		height: 27rpx;
	}

	/* 书架网格（Stitch: 3 列，列间距 14px，行间距 20px，与统计卡间距 24px） */
	.shelf-grid {
		margin-top: 46rpx;
		flex-direction: column;
	}

	/* 列间距 28rpx 与三本满行时 space-between 等效；不满行时卡片紧挨补位，不再两端分布 */
	.shelf-row {
		flex-direction: row;
		align-items: flex-start;
		gap: 28rpx;
	}

	.shelf-row-gap {
		margin-top: 38rpx;
	}

	.book-item {
		width: 206rpx;
		flex-direction: column;
		position: relative;
	}

	/* 白封面（令牌 item-card: 白底 圆角 xl 24px 边框 浅灰 #E9E9E6 内边距 14px，左上书名 14px/500；上下两端分布承载左下角格式水印） */
	.cover-plain {
		height: 285rpx;
		box-sizing: border-box;
		padding: 27rpx;
		background-color: $bai-canvas;
		border-radius: $bai-rounded-xl;
		border: 1px solid $bai-pale;
		justify-content: space-between;
	}

	.cover-plain-title {
		font-size: 27rpx;
		line-height: 37rpx;
		font-weight: 500;
		letter-spacing: 1rpx;
		color: $bai-ink;
	}

	/* 左下角导入格式水印（浅灰超大字，装饰性低对比；48rpx 保证 EPUB 四字符不溢出卡片内宽） */
	.cover-plain-format {
		font-size: 48rpx;
		line-height: 56rpx;
		font-weight: 700;
		letter-spacing: 1rpx;
		color: $bai-pale;
	}

	/* 图封面（中性灰底白字样式：mute #868685 为墨到白灰阶中值；圆角与其他书籍卡片一致 xl 24px，接入真实数据时替换为 image 封面） */
	.cover-photo {
		height: 285rpx;
		box-sizing: border-box;
		position: relative;
		overflow: hidden;
		border-radius: $bai-rounded-xl;
		background-color: $bai-mute;
		flex-direction: column;
		justify-content: flex-end;
		padding: 15rpx;
	}

	/* 右上角文件格式水印（与白封面左下角水印对应：同 48rpx/700/字距 1rpx，深底上弱白低对比） */
	.cover-photo-format {
		position: absolute;
		right: 15rpx;
		top: 15rpx;
		font-size: 48rpx;
		line-height: 56rpx;
		font-weight: 700;
		letter-spacing: 1rpx;
		color: rgba($bai-on-primary, 0.3);
	}

	/* 封面底部信息（Stitch: 内边距 8px 底对齐；黑底上白书名、作者白 70%） */
	.cover-info {
		flex-direction: column;
	}

	.cover-title {
		font-size: 27rpx;
		line-height: 38rpx;
		font-weight: 900;
		color: $bai-on-primary;
	}

	.cover-author {
		font-size: 15rpx;
		line-height: 23rpx;
		color: rgba($bai-on-primary, 0.7);
	}

	/* 添加格（令牌: 圆角 xl 24px 边框 1px 中性灰 #A3A3A0，中央加号图标） */
	.cover-add {
		height: 285rpx;
		box-sizing: border-box;
		border-radius: $bai-rounded-xl;
		border: 1px solid $bai-neutral;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.cover-add-icon {
		width: 48rpx;
		height: 48rpx;
	}

	/* 书名与阅读进度（Stitch: 书名 12px/700 与封面间距 8px；进度 10px/500 灰） */
	.book-text {
		margin-top: 15rpx;
		flex-direction: column;
	}

	.book-title {
		font-size: 23rpx;
		line-height: 31rpx;
		font-weight: 700;
		color: $bai-ink;
	}

	.book-meta {
		font-size: 19rpx;
		line-height: 29rpx;
		font-weight: 500;
		color: $bai-mute;
	}

	/* ===== 编辑模式 ===== */
	/* 完成按钮（导航行右缘，替换搜索/添加按钮组） */
	.nav-finish {
		padding: 12rpx 31rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-ink;
	}

	.nav-finish-text {
		font-size: 23rpx;
		line-height: 23rpx;
		font-weight: 600;
		color: $bai-on-primary;
	}

	/* 编辑工具行：样式选择 + 批量删除（网格上方） */
	.edit-tools {
		margin-top: 34rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.edit-styles {
		flex-direction: row;
		align-items: center;
		gap: 15rpx;
	}

	.style-btn {
		flex-direction: row;
		align-items: center;
		padding: 12rpx 23rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-canvas;
		border: 1px solid $bai-pale;
	}

	.style-btn-on {
		background-color: $bai-ink;
		border-color: $bai-ink;
	}

	.style-dot {
		width: 23rpx;
		height: 23rpx;
		border-radius: $bai-rounded-pill;
	}

	.style-dot-light {
		background-color: $bai-canvas;
		border: 1px solid $bai-pale;
	}

	.style-dot-dark {
		background-color: $bai-mute;
	}

	.style-btn-text {
		margin-left: 8rpx;
		font-size: 23rpx;
		line-height: 23rpx;
		font-weight: 500;
		color: $bai-body;
	}

	.style-btn-text-on {
		color: $bai-on-primary;
	}

	.edit-delete {
		padding: 12rpx 27rpx;
		border-radius: $bai-rounded-pill;
		background-color: rgba($bai-negative, 0.1);
	}

	.edit-delete-text {
		font-size: 23rpx;
		line-height: 23rpx;
		font-weight: 600;
		color: $bai-negative;
	}

	/* 卡片编辑态：未选中暗显 / 选中恢复 / 拖拽置顶加影 */
	.book-item-dim {
		opacity: 0.7;
	}

	.book-item-selected {
		opacity: 1;
	}

	.book-item-dragging {
		position: relative;
		z-index: 30;
		opacity: 1;
		box-shadow: $bai-shadow-dropdown;
		border-radius: $bai-rounded-xl;
	}

	/* 封面包装层：承载右下角勾选点定位 */
	.cover-wrap {
		position: relative;
	}

	/* 勾选点（封面右下角，距边界 12rpx） */
	.card-check {
		position: absolute;
		right: 12rpx;
		bottom: 12rpx;
		width: 40rpx;
		height: 40rpx;
		border-radius: $bai-rounded-pill;
		background-color: $bai-canvas;
		border: 1px solid $bai-mute;
		align-items: center;
		justify-content: center;
		z-index: 5;
	}

	.card-check-on {
		background-color: $bai-ink;
		border-color: $bai-ink;
	}

	.card-check-icon {
		font-size: 24rpx;
		line-height: 38rpx;
		font-weight: 900;
		color: $bai-on-primary;
	}
</style>
